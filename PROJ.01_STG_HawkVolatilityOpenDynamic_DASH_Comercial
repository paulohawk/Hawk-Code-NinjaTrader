        // DEBUG ONLY — NEVER USE FOR DECISION LOGIC (logs/audit only)
        private DateTime ConvertFeedToBrasilia(DateTime feedTimeRaw)
        {
            var brTz = GetBrasiliaTimeZone();
            if (brTz == null)
                return feedTimeRaw;
            DateTime utc = ConvertFeedToUtc(feedTimeRaw);
            DateTime utcUnspecified = DateTime.SpecifyKind(utc, DateTimeKind.Unspecified);
            return ConvertFromTimeZone(utcUnspecified, TimeZoneInfo.Utc, brTz);
        }

        // DEBUG ONLY — NEVER USE FOR DECISION LOGIC (logs/audit only)
        private string BuildTimeTruthAudit(string tag, DateTime tFeedRaw)
        {
            var feedTz = GetBarTimeZone();
            var brTz = GetBrasiliaTimeZone();
            DateTime tFeed = NormalizeFeedTime(tFeedRaw);
            DateTime tUtc = feedTz != null ? ConvertFromTimeZone(tFeed, feedTz, TimeZoneInfo.Utc) : tFeedRaw;
            DateTime tUtcUnspecified = DateTime.SpecifyKind(tUtc, DateTimeKind.Unspecified);
            DateTime tBr = brTz != null ? ConvertFromTimeZone(tUtcUnspecified, TimeZoneInfo.Utc, brTz) : tFeedRaw;
            double deltaHours = (tBr - tFeed).TotalHours;
            return
                $"tag={tag} tFeedRaw={tFeedRaw:O} kind={tFeedRaw.Kind} feedTZ={feedTz?.Id ?? "Unknown"} " +
                $"tFeed={tFeed:O} tUtc={tUtc:O} tBr={tBr:O} brTZ={brTz?.Id ?? "Unknown"} deltaBrMinusFeedHours={deltaHours:0.##}";
        }

        // DEBUG ONLY — NEVER USE FOR DECISION LOGIC (logs/audit only)
        private string BuildOverlayWindowAudit(DateTime nowFeedRaw, DateTime overlayStartFeedRaw, DateTime overlayEndFeedRaw, DateTime cutoffFeedRaw)
        {
            DateTime nowFeed = NormalizeFeedTime(nowFeedRaw);
            DateTime startFeed = NormalizeFeedTime(overlayStartFeedRaw);
            DateTime endFeed = NormalizeFeedTime(overlayEndFeedRaw);
            DateTime cutoffFeed = NormalizeFeedTime(cutoffFeedRaw);

            DateTime nowUtc = ConvertFeedToUtc(nowFeed);
            DateTime startUtc = ConvertFeedToUtc(startFeed);
            DateTime endUtc = ConvertFeedToUtc(endFeed);
            DateTime cutoffUtc = ConvertFeedToUtc(cutoffFeed);

            DateTime nowBr = ConvertFeedToBrasilia(nowFeed);
            DateTime startBr = ConvertFeedToBrasilia(startFeed);
            DateTime endBr = ConvertFeedToBrasilia(endFeed);
            DateTime cutoffBr = ConvertFeedToBrasilia(cutoffFeed);

            string feedTz = GetBarTimeZone()?.Id ?? "Unknown";
            string brTz = GetBrasiliaTimeZone()?.Id ?? "Unknown";
            double deltaHours = (nowBr - nowFeed).TotalHours;
            return
                $"nowFeed={nowFeed:O} feedTZ={feedTz} nowUtc={nowUtc:O} nowBR={nowBr:O} brTZ={brTz} " +
                $"windowFeed={startFeed:HH\\:mm}-{endFeed:HH\\:mm} windowUtc={startUtc:HH\\:mm}-{endUtc:HH\\:mm} windowBR={startBr:HH\\:mm}-{endBr:HH\\:mm} " +
                $"cutoffFeed={cutoffFeed:HH\\:mm} cutoffUtc={cutoffUtc:HH\\:mm} cutoffBR={cutoffBr:HH\\:mm} deltaBrMinusFeedHours={deltaHours:0.##}";
        }

        // DEBUG ONLY — NEVER USE FOR DECISION LOGIC (logs/audit only)
        private string BuildOverlayTimeAudit(DateTime nowFeed, DateTime overlayStartFeed, DateTime overlayEndFeed, DateTime cutoffFeed)
        {
            return $"{BuildTimeTruthAudit("Overlay", nowFeed)} {BuildOverlayWindowAudit(nowFeed, overlayStartFeed, overlayEndFeed, cutoffFeed)}";
