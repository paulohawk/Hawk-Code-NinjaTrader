        private void GetOverlayWindowDecision(DateTime nowDecision, out DateTime tradingDay, out DateTime overlayStart, out DateTime overlayEnd, out DateTime cutoff)
        {
            GetOverlayWindow(nowDecision, out tradingDay, out overlayStart, out overlayEnd);
            cutoff = overlayStart.Add(OverlayAnchorOffset);
        }

        private bool IsInsideWindow(DateTime nowDecision, DateTime start, DateTime end)
        {
            return nowDecision >= start && nowDecision < end;
        }

        private void GetOverlayWindow(DateTime referenceTime, out DateTime tradingDay, out DateTime overlayStart, out DateTime overlayEnd)
        {
            tradingDay = GetTradingDay(referenceTime);
            DateTime baseDate = referenceTime.Date;
            overlayStart = new DateTime(baseDate.Year, baseDate.Month, baseDate.Day,
                OverlayStartTime.Hours, OverlayStartTime.Minutes, OverlayStartTime.Seconds, DateTimeKind.Unspecified);
            overlayEnd = new DateTime(baseDate.Year, baseDate.Month, baseDate.Day,
                OverlayEndTime.Hours, OverlayEndTime.Minutes, OverlayEndTime.Seconds, DateTimeKind.Unspecified);
        }

