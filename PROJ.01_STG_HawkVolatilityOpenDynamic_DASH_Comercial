        private sealed class RiskOverlayHelper
        {
            private Window riskOverlayWindow;
            private DispatcherTimer riskOverlayTimer;
            private DateTime riskOverlayLastDate = DateTime.MinValue;
            private ChartControl chartControl;

            public void TryShow(HawkVolatilityOpen owner)
            {
                if (owner == null)
                    return;
                if (owner.State != State.Realtime)
                    return;
                if (owner.ChartControl == null)
                    return;

                DateTime now = owner.GetSafeTime();
                // Overlay exibido no máximo uma vez por dia operacional.
                if (now.Date == riskOverlayLastDate.Date)
                    return;
                if (now.TimeOfDay <= new TimeSpan(11, 0, 0))
                    return;

                riskOverlayLastDate = now.Date;
                owner.ChartControl.Dispatcher.BeginInvoke(new Action(() => CreateAndShow(owner.ChartControl)));
            }

            public void Remove()
            {
                if (riskOverlayWindow == null)
                    return;

                if (riskOverlayWindow.Dispatcher == null || riskOverlayWindow.Dispatcher.HasShutdownStarted)
                {
                    Cleanup();
                    return;
                }

                riskOverlayWindow.Dispatcher.BeginInvoke(new Action(Cleanup));
            }

            private void CreateAndShow(ChartControl chartControl)
            {
                if (riskOverlayWindow != null || chartControl == null)
                    return;

                this.chartControl = chartControl;
                var chartWindow = Window.GetWindow(chartControl);
                if (chartWindow == null)
                    return;

                // Window recebe hit test; conteúdo não captura interação.
                var overlayGrid = new Grid
                {
                    Background = new SolidColorBrush(Color.FromRgb(0, 0, 0)),
                    Opacity = 0.75,
                    IsHitTestVisible = false
                };

                var stack = new StackPanel
                {
                    HorizontalAlignment = HorizontalAlignment.Center,
                    VerticalAlignment = VerticalAlignment.Center
                };

                var titleText = new TextBlock
                {
                    Text = "AVISO AO TRADER",
                    FontSize = 22,
                    FontWeight = FontWeights.SemiBold,
                    Foreground = Brushes.Red,
                    TextAlignment = TextAlignment.Center,
                    HorizontalAlignment = HorizontalAlignment.Center
                };

                var bodyText = new TextBlock
                {
                    Text = "Você ativou esta automação fora do horário operacional recomendado.\n\n" +
                           "Para máxima estabilidade, recomenda-se manter a estratégia ativa antes das 11:00 ou utilizar VPS dedicada.\n\n" +
                           "Ao prosseguir, você assume os riscos operacionais desta decisão.",
                    FontSize = 16,
                    Foreground = Brushes.White,
                    TextAlignment = TextAlignment.Center,
                    HorizontalAlignment = HorizontalAlignment.Center,
                    Margin = new Thickness(0, 16, 0, 0)
                };

                stack.Children.Add(titleText);
                stack.Children.Add(bodyText);
                overlayGrid.Children.Add(stack);

                riskOverlayWindow = new Window
                {
                    WindowStyle = WindowStyle.None,
                    AllowsTransparency = true,
                    Background = Brushes.Transparent,
                    Topmost = true,
                    ShowInTaskbar = false,
                    ResizeMode = ResizeMode.NoResize,
                    Content = overlayGrid,
                    Owner = chartWindow,
                    WindowStartupLocation = WindowStartupLocation.Manual,
                    ShowActivated = false,
                    Focusable = false,
                    IsHitTestVisible = false
                };

                UpdateOverlayBounds(chartControl);
                chartControl.SizeChanged += OnChartControlSizeChanged;
                chartControl.LayoutUpdated += OnChartControlLayoutUpdated;

                riskOverlayWindow.Show();

                riskOverlayTimer = new DispatcherTimer { Interval = TimeSpan.FromSeconds(20) };
                riskOverlayTimer.Tick += (s, e) => Remove();
                riskOverlayTimer.Start();
            }

            private void UpdateOverlayBounds(ChartControl chartControl)
            {
                if (riskOverlayWindow == null || chartControl == null)
                    return;

                Point topLeft = chartControl.PointToScreen(new Point(0, 0));
                riskOverlayWindow.Left = topLeft.X;
                riskOverlayWindow.Top = topLeft.Y;
                riskOverlayWindow.Width = chartControl.ActualWidth;
                riskOverlayWindow.Height = chartControl.ActualHeight;
            }

            private void OnChartControlSizeChanged(object sender, SizeChangedEventArgs e) => UpdateOverlayBounds(chartControl);

            private void OnChartControlLayoutUpdated(object sender, EventArgs e) => UpdateOverlayBounds(chartControl);

            private void Cleanup()
            {
                if (riskOverlayTimer != null)
                {
                    riskOverlayTimer.Stop();
                    riskOverlayTimer = null;
                }

                if (chartControl != null)
                {
                    chartControl.SizeChanged -= OnChartControlSizeChanged;
                    chartControl.LayoutUpdated -= OnChartControlLayoutUpdated;
                    chartControl = null;
                }

                if (riskOverlayWindow != null)
                {
                    riskOverlayWindow.Close();
                    riskOverlayWindow = null;
                }
            }
        }

