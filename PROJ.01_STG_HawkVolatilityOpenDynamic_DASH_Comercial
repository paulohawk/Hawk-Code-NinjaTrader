                {
                    try
                    {
                        Directory.CreateDirectory(IOPath.GetDirectoryName(auditLogPath));
                        File.AppendAllText(auditLogPath, baseMsg + Environment.NewLine);
                    }
                    catch { }
                }
            }
            catch { }
        }

        private void DebugLog(string key, string msg, bool force = false)
        {
            if (!EnableDebugLog) return;
            try
            {
                if (!force)
                {
                    var now = DateTime.UtcNow;
                    if (debugThrottle.TryGetValue(key, out var last))
                    {
                        if ((now - last).TotalSeconds < Math.Max(1, LogThrottleSeconds))
                            return;
                    }
                    debugThrottle[key] = now;
                }
                Print($"[HVO-DEBUG] {msg}");
            }
            catch { }
        }

        private bool ShouldThrottleAudit(string key, int seconds)
        {
            if (seconds <= 0) return false;
            try
            {
                var now = DateTime.UtcNow;
                if (debugThrottle.TryGetValue(key, out var last) && (now - last).TotalSeconds < seconds)
                    return true;

                debugThrottle[key] = now;
            }
            catch { }

            return false;
        }

        private bool WatchdogCooldownOk()
        {
            if (BracketWatchdogCooldownSeconds <= 0) return true;
            var nowUtc = DateTime.UtcNow;
            return (nowUtc - lastWatchdogAttemptUtc).TotalSeconds >= BracketWatchdogCooldownSeconds;
        }

        private void UpdateHeartbeat(string source)
        {
            var now = DateTime.UtcNow;
            if (source == "OnBarUpdate") lastOnBarUpdateTime = now;
            else if (source == "OnOrderUpdate") lastOrderUpdateTime = now;
            else if (source == "OnExecutionUpdate") lastExecutionUpdateTime = now;
            else if (source == "OnPositionUpdate") lastPositionUpdateTime = now;
            else if (source == "OnMarketData") lastMarketDataTime = now;
        }

        private bool IsHeartbeatStale()
        {
            if (State != State.Realtime) return false;
            DateTime now = DateTime.UtcNow;
            DateTime last = lastOnBarUpdateTime;
            if (lastOrderUpdateTime > last) last = lastOrderUpdateTime;
            if (lastExecutionUpdateTime > last) last = lastExecutionUpdateTime;
            if (lastPositionUpdateTime > last) last = lastPositionUpdateTime;
            if (lastMarketDataTime > last) last = lastMarketDataTime;

            if (last == Core.Globals.MinDate) return false;
            return (now - last).TotalSeconds > HeartbeatStaleSeconds;
        }

        private void StartRecoveryWindow(string reason, string source)
        {
            recoveryInProgress = true;
            recoveryWindowUntil = DateTime.UtcNow.AddSeconds(RecoveryWindowSeconds);
            Log("RECOVERY", $"RECOVERY_WINDOW_START reason={reason} source={source} until={recoveryWindowUntil:O}");
            EnterSafeMode(reason, source);
        }

        private void EnterSafeMode(string reason, string source)
        {
            if (IsReplayMode())
                return;

            if (safeModeEnabled && safeModeReason == reason)
                return;

            safeModeEnabled = true;
            safeModeReason = reason ?? "";
            safeModeSince = DateTime.UtcNow;
            Log("SAFE_MODE", $"SAFE_MODE_ENTER reason={safeModeReason} source={source}");
        }

        private void ExitSafeMode(string reason, string source)
        {
            if (!safeModeEnabled)
                return;

            safeModeEnabled = false;
            safeModeReason = "";
            safeModeSince = Core.Globals.MinDate;
            Log("SAFE_MODE", $"SAFE_MODE_EXIT reason={reason} source={source}");
        }

        private bool IsEntryBlocked(out string reason)
        {
            if (safeModeEnabled)
            {
                reason = $"SAFE_MODE ({safeModeReason})";
                return true;
            }
            if (recoveryInProgress)
            {
                reason = "RECOVERY_WINDOW";
                return true;
            }
            if (IsHeartbeatStale())
            {
                reason = "STALE_HEARTBEAT";
                return true;
            }

            reason = "";
            return false;
        }

        private bool ActionCooldownOk(string actionKey, int seconds)
        {
            if (seconds <= 0) return true;
            var now = DateTime.UtcNow;
            if (lastActionTime.TryGetValue(actionKey, out var last) && (now - last).TotalSeconds < seconds)
                return false;

            lastActionTime[actionKey] = now;
            return true;
        }

        private bool HasOrphanBracketOrders()
        {
            if (Position != null && Position.MarketPosition != MarketPosition.Flat)
                return false;

            return IsOrderActive(ordemStopLong) || IsOrderActive(ordemStopShort)
                || IsOrderActive(ordemTPLong) || IsOrderActive(ordemTPShort);
        }

        private void ReconcileNow(string reason, string source)
        {
            if (State != State.Realtime)
                return;

            Log("RECONCILE", $"RECONCILE_START reason={reason} source={source}");

            MarketPosition mktPos = Position?.MarketPosition ?? MarketPosition.Flat;
            int posQtyAbs = Position != null ? Math.Abs(Position.Quantity) : 0;

            if (mktPos != MarketPosition.Flat && posQtyAbs > 0)
            {
                if (ActionCooldownOk("REBUILD_BRACKET", ActionCooldownSeconds))
                {
                    EnsureBracketAlive(source, "ReconcileMissingOrDead");
                    Log("RECONCILE", "RECONCILE_ACTION key=REBUILD_BRACKET result=CHECKED");
                }

                if (invertStopEntryOrder != null && IsOrderActive(invertStopEntryOrder))
                {
                    if (ActionCooldownOk("CANCEL_HEDGE_FLOATERS", ActionCooldownSeconds))
                    {
                        try { CancelOrder(invertStopEntryOrder); } catch { }
                        Log("HEDGE", "RECONCILE_ACTION key=CANCEL_HEDGE_FLOATERS result=SUBMITTED");
                    }
                }

            }
            else
            {
                if (HasOrphanBracketOrders() && ActionCooldownOk("CANCEL_ORPHANS", ActionCooldownSeconds))
                {
                    TryCancelBracketOrder(ordemStopLong, "ReconcileOrphans", source, true);
                    TryCancelBracketOrder(ordemStopShort, "ReconcileOrphans", source, true);
                    TryCancelBracketOrder(ordemTPLong, "ReconcileOrphans", source, true);
                    TryCancelBracketOrder(ordemTPShort, "ReconcileOrphans", source, true);
                    Log("ORPHAN", "RECONCILE_ACTION key=CANCEL_ORPHANS result=SUBMITTED");
                }
            }

            if (invertPlanArmed && !invertStopTriggered && (invertStopEntryOrder == null || !IsOrderActive(invertStopEntryOrder)))
            {
                Log("HEDGE", "ORDER_MISSING detected");
                StartRecoveryWindow("HEDGE_ORDER_MISSING", source);

                if (ActionCooldownOk("RECREATE_HEDGE_ORDER", ActionCooldownSeconds))
                {
                    DateTime now = GetReplayNowOrFallback(GetSafeTime());
                    DateTime tradingDay = GetReplayTradingDayOrFallback(now);
                    bool hedgeWindowOk = false;
                    DateTime hedgeTradingDay;
                    DateTime hedgeAnchorLocal;
                    DateTime hedgeCutoffLocal;

                    if (GetEffectiveInvertMode() == InvertModeType.InvertedStopEntry
                        && plannedTradeDate.Date == tradingDay.Date
                        && TryGetHedgeCutoff(now, out hedgeTradingDay, out hedgeAnchorLocal, out hedgeCutoffLocal)
                        && now <= hedgeCutoffLocal)
                    {
                        hedgeWindowOk = true;
                    }

                    double stopEntryPrice = plannedStopPrice;
                    if (!hedgeWindowOk)
                    {
                        Log("HEDGE", $"RECREATE_ORDER_SKIPPED reason=OUTSIDE_WINDOW td={tradingDay:yyyy-MM-dd} planDay={plannedTradeDate:yyyy-MM-dd}");
                    }
                    else if (plannedDirection == MarketPosition.Long && plannedQty > 0 && stopEntryPrice > 0)
                    {
                        invertStopEntryOrder = EnterShortStopMarket(0, true, plannedQty, stopEntryPrice, "InvertStopEntry");
                        Log("HEDGE", $"RECREATE_ORDER_ATTEMPT price={F0(stopEntryPrice)} qty={plannedQty} side={plannedDirection}");
                    }
                    else if (plannedDirection == MarketPosition.Short && plannedQty > 0 && stopEntryPrice > 0)
                    {
                        invertStopEntryOrder = EnterLongStopMarket(0, true, plannedQty, stopEntryPrice, "InvertStopEntry");
                        Log("HEDGE", $"RECREATE_ORDER_ATTEMPT price={F0(stopEntryPrice)} qty={plannedQty} side={plannedDirection}");
                    }
                    else
                        Log("HEDGE", $"RECREATE_ORDER_SKIPPED reason=INVALID_PLAN side={plannedDirection} qty={plannedQty} price={F0(stopEntryPrice)}");
                }
            }
        }

        protected override void OnMarketData(MarketDataEventArgs e)
        {
            if (e == null)
                return;

            UpdateHeartbeat("OnMarketData");

            if (!IsRealtimeLive())
                return;

            if (!IsHedgeActive())
                return;

            if (e.MarketDataType != MarketDataType.Last)
                return;

            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return;

            EnsureCycleSynced(Position, Position.AveragePrice);
            AttemptRealtimeLiveBracketCreate(Position, Position.AveragePrice, "RT_LIVE_TICK");
            ApplyRealtimeLiveBreakEven(e.Price);
        }

        private void MaybeRunReconcile(string reason, string source)
        {
            var now = DateTime.UtcNow;
            if ((now - lastReconcileUtc).TotalSeconds < ReconcileIntervalSeconds)
                return;

            lastReconcileUtc = now;
            ReconcileNow(reason, source);
        }

        private void EvaluateRecoveryWindow()
        {
            if (!recoveryInProgress)
                return;

            if (DateTime.UtcNow >= recoveryWindowUntil)
            {
                recoveryInProgress = false;
                Log("RECOVERY", "RECOVERY_WINDOW_END");
            }
        }

        private void EvaluateSafeModeExit()
        {
            if (!safeModeEnabled)
                return;
            if (recoveryInProgress)
                return;
            if (IsHeartbeatStale())
                return;

            bool bracketMissing = IsBracketMissingOrDead();
            bool orphanOrders = HasOrphanBracketOrders();
            if (!bracketMissing && !orphanOrders)
                ExitSafeMode("coherent_again", "Watchdog");
        }

        private bool IsHedgeBracketProtectionRequired()
        {
            if (!IsRealtimeLive())
                return false;

            if (!IsHedgeActive())
                return false;

            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return false;

            if (IsBracketModificationInProgress())
                return false;

            bool stopOrderMissing = Position.MarketPosition == MarketPosition.Long
                ? !IsOrderLiveOrPending(ordemStopLong)
                : !IsOrderLiveOrPending(ordemStopShort);
            bool targetOrderMissing = Position.MarketPosition == MarketPosition.Long
                ? !IsOrderLiveOrPending(ordemTPLong)
                : !IsOrderLiveOrPending(ordemTPShort);

            return !bracketConfirmed || stopOrderMissing || targetOrderMissing;
        }

        private void TryCreateReplayHedgeBracket(Position position, double averagePrice)
        {
            if (!IsReplayMode() || !IsHedgeActive())
                return;

            if (position == null || position.MarketPosition == MarketPosition.Flat)
                return;

            int posQtyAbs = Math.Abs(position.Quantity);
            if (posQtyAbs <= 0)
                return;

            if (bracketCycleId == 0 || cycleSide == MarketPosition.Flat)
                return;

            if (replayBracketLoggedCycleId == bracketCycleId)
                return;

            bool isLong = position.MarketPosition == MarketPosition.Long;
            Order stop = isLong ? ordemStopLong : ordemStopShort;
            Order tp = isLong ? ordemTPLong : ordemTPShort;
            if (IsOrderLiveOrPending(stop) && IsOrderLiveOrPending(tp))
            {
                replayBracketLoggedCycleId = bracketCycleId;
                return;
            }

            if (replayBracketAttempts >= ReplayBracketMaxAttemptsPerCycle)
                return;

            replayBracketAttempts++;

            double stopTicks;
            double targetTicks;
            double stopDollars;
            ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);

            DateTime tradingDay = GetTradingDay(GetSafeTime());
            SubmitBracketOrders(position, averagePrice, posQtyAbs, tradingDay, stopTicks, targetTicks, stopDollars, "REPLAY_BRACKET_CREATE", "Replay", false);

            stop = isLong ? ordemStopLong : ordemStopShort;
            tp = isLong ? ordemTPLong : ordemTPShort;
            bool hasRefs = stop != null && tp != null;
            bool hasActiveBracket = IsOrderLiveOrPending(stop) && IsOrderLiveOrPending(tp);
            if (!hasRefs && !hasActiveBracket)
                return;

            double stopPriceAudit;
            double targetPriceAudit;
            GetBracketPrices(position.MarketPosition, out stopPriceAudit, out targetPriceAudit);
            Log("BRACKET_REPLAY_CREATED",
                $"cycleId={bracketCycleId} stop={F0(stopPriceAudit)} target={F0(targetPriceAudit)} mode=Hedge env=Replay");

            replayBracketLoggedCycleId = bracketCycleId;
        }

        private bool IsBracketMissingOrDead()
        {
            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return false;

            if (IsBracketModificationInProgress())
                return false;

            int posQtyAbs = Math.Abs(Position.Quantity);
            if (posQtyAbs <= 0)
                return true;

            if (Position.AveragePrice <= 0)
                return true;

            bool isLong = Position.MarketPosition == MarketPosition.Long;
            Order stop = isLong ? ordemStopLong : ordemStopShort;
            Order tp = isLong ? ordemTPLong : ordemTPShort;

            if (stop == null && tp == null)
                return true;

            bool stopLive = IsOrderLiveOrPending(stop);
            bool tpLive = IsOrderLiveOrPending(tp);

            if (!stopLive && !tpLive)
                return true;

            if (!stopLive || !tpLive)
                return false;

            if (Math.Abs(stop.Quantity) != posQtyAbs || Math.Abs(tp.Quantity) != posQtyAbs)
                return true;

            if (lastBracketQty != posQtyAbs)
                return true;

            return false;
        }

        private bool AreBracketOrdersActive()
        {
            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return false;

            bool isLong = Position.MarketPosition == MarketPosition.Long;
            Order stop = isLong ? ordemStopLong : ordemStopShort;
            Order tp = isLong ? ordemTPLong : ordemTPShort;

            return IsOrderActive(stop) && IsOrderActive(tp);
        }

        private void ComputeBracketMetrics(out double stopTicks, out double targetTicks, out double stopDollars)
        {
            double tickSize = Instrument.MasterInstrument.TickSize;
            double tickValue = Instrument.MasterInstrument.PointValue * tickSize;

            if (invertStopTriggered && plannedStopTicks > 0 && plannedTargetTicks > 0)
            {
                stopTicks = plannedStopTicks;
                targetTicks = plannedTargetTicks;
                stopDollars = stopTicks * tickValue;
            }
            else
            {
                if (UseStopATR && lastAtrVal > 0)
                {
                    stopDollars = lastAtrVal * ATRFactor;
                }
                else
                {
                    stopDollars = StopPerContract;
                }

                stopTicks = Math.Round(stopDollars / tickValue, 0);
                targetTicks = stopTicks * TargetFactor;
            }
        }

        private void SubmitBracketOrders(Position position, double averagePrice, int posQtyAbs, DateTime tradingDay, double stopTicks,
            double targetTicks, double stopDollars, string reason, string context, bool isWatchdog)
        {
            BeginBracketModification(reason, context);
            bool cancelDenied = false;
            if (ordemStopLong != null && !TryCancelBracketOrder(ordemStopLong, reason, "BracketController")) cancelDenied = true;
            if (ordemStopShort != null && !TryCancelBracketOrder(ordemStopShort, reason, "BracketController")) cancelDenied = true;
            if (ordemTPLong != null && !TryCancelBracketOrder(ordemTPLong, reason, "BracketController")) cancelDenied = true;
            if (ordemTPShort != null && !TryCancelBracketOrder(ordemTPShort, reason, "BracketController")) cancelDenied = true;

            if (cancelDenied)
            {
                BracketLog("DENY_CREATE", reason, "BracketController", $"context={context}");
                return;
            }
            SetBracketState(BracketState.Pending, "CreateBracket", "BracketController");

            double tickSize = Instrument.MasterInstrument.TickSize;
            double stopPrice = 0, targetPrice = 0;
            double bid = 0;
            double ask = 0;
            bool hasQuotes = false;

            try
            {
                bid = GetCurrentBid();
                ask = GetCurrentAsk();
                hasQuotes = (bid > 0 && ask > 0);
            }
            catch
            {
                hasQuotes = false;
            }

            bool bracketSubmitted = false;
            string fromSignal = GetActiveEntrySignal(tradingDay);

            if (position.MarketPosition == MarketPosition.Long)
            {
                stopPrice = averagePrice - stopTicks * tickSize;
                targetPrice = averagePrice + targetTicks * tickSize;

                if (hasQuotes)
                {
                    double originalStop = stopPrice;
                    double originalTarget = targetPrice;

                    if (stopPrice >= bid) stopPrice = bid - tickSize;
                    if (targetPrice <= ask) targetPrice = ask + tickSize;

                    if (Math.Abs(originalStop - stopPrice) > 0 || Math.Abs(originalTarget - targetPrice) > 0)
                    {
                        string adjustMsg = FormatBracketAudit(reason, context, MarketPosition.Long, posQtyAbs, averagePrice, stopPrice, targetPrice,
                            $"bid={F0(bid)} ask={F0(ask)} originalStop={F0(originalStop)} originalTarget={F0(originalTarget)}");
                        Audit("BracketPriceAdjusted",
                            adjustMsg);
                    }
                }

                string fe = string.IsNullOrEmpty(fromSignal) ? "AutoLong" : fromSignal;
                ordemStopLong = ExitLongStopMarket(0, true, posQtyAbs, stopPrice, "StopLoss", fe);
                ordemTPLong = ExitLongLimit(0, true, posQtyAbs, targetPrice, "TakeProfit", fe);
                ordemStopShort = null;
                ordemTPShort = null;
                bracketSubmitted = true;
            }
            else if (position.MarketPosition == MarketPosition.Short)
            {
                stopPrice = averagePrice + stopTicks * tickSize;
                targetPrice = averagePrice - targetTicks * tickSize;

                if (hasQuotes)
                {
                    double originalStop = stopPrice;
                    double originalTarget = targetPrice;

                    if (stopPrice <= ask) stopPrice = ask + tickSize;
                    if (targetPrice >= bid) targetPrice = bid - tickSize;

                    if (Math.Abs(originalStop - stopPrice) > 0 || Math.Abs(originalTarget - targetPrice) > 0)
                    {
                        string adjustMsg = FormatBracketAudit(reason, context, MarketPosition.Short, posQtyAbs, averagePrice, stopPrice, targetPrice,
                            $"bid={F0(bid)} ask={F0(ask)} originalStop={F0(originalStop)} originalTarget={F0(originalTarget)}");
                        Audit("BracketPriceAdjusted",
                            adjustMsg);
                    }
                }

                string fe = string.IsNullOrEmpty(fromSignal) ? "AutoShort" : fromSignal;
                ordemStopShort = ExitShortStopMarket(0, true, posQtyAbs, stopPrice, "StopLoss", fe);
                ordemTPShort = ExitShortLimit(0, true, posQtyAbs, targetPrice, "TakeProfit", fe);
                ordemStopLong = null;
                ordemTPLong = null;
                bracketSubmitted = true;
            }

            if (!bracketSubmitted)
                return;

            BracketLog("CREATE", reason, "BracketController", $"context={context} side={position.MarketPosition} qty={posQtyAbs}");
            Order stopCheck = (position.MarketPosition == MarketPosition.Long) ? ordemStopLong : ordemStopShort;
            Order tpCheck = (position.MarketPosition == MarketPosition.Long) ? ordemTPLong : ordemTPShort;

            if (IsOrderActive(stopCheck) && IsOrderActive(tpCheck))
                lastBracketQty = posQtyAbs;
            else
                lastBracketQty = 0;

            double riskDollars = stopDollars * posQtyAbs;
            double targetDollars = riskDollars * TargetFactor;
            double stopAuditPrice = position.MarketPosition == MarketPosition.Long
                ? ordemStopLong?.StopPrice ?? stopPrice
                : ordemStopShort?.StopPrice ?? stopPrice;
            double targetAuditPrice = position.MarketPosition == MarketPosition.Long
                ? ordemTPLong?.LimitPrice ?? targetPrice
                : ordemTPShort?.LimitPrice ?? targetPrice;

            if (isWatchdog)
            {
                pendingWatchdogRebuild = true;
                lastWatchdogReason = reason;
                lastWatchdogContext = context;
                string rebuildMsg = FormatBracketAudit(reason, context, position.MarketPosition, posQtyAbs, averagePrice, stopAuditPrice, targetAuditPrice,
                    $"stopTicks={stopTicks} targetTicks={targetTicks} riskDollars={F0(riskDollars)} targetDollars={F0(targetDollars)}");
                Audit("BracketWatchdogRebuildSubmitted",
                    rebuildMsg);
                return;
            }

            string bracketMsg = FormatBracketAudit(reason, context, position.MarketPosition, posQtyAbs, averagePrice, stopAuditPrice, targetAuditPrice,
                $"stopTicks={stopTicks} targetTicks={targetTicks} riskDollars={F0(riskDollars)} targetDollars={F0(targetDollars)} useATR={UseStopATR} atr={F(lastAtrVal, "0.000")} stopDollars={F0(stopDollars)}");
                Audit("BracketSet",
                bracketMsg);
        }

        private bool IsPositionClosingFinal()
        {
            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return false;

            bool isLong = Position.MarketPosition == MarketPosition.Long;
            Order stop = isLong ? ordemStopLong : ordemStopShort;
            Order tp = isLong ? ordemTPLong : ordemTPShort;

            bool stopFinal = stop != null && (stop.OrderState == OrderState.Filled || stop.OrderState == OrderState.PartFilled);
            bool tpFinal = tp != null && (tp.OrderState == OrderState.Filled || tp.OrderState == OrderState.PartFilled);

            return stopFinal || tpFinal;
        }

        private bool IsLiveAccount()
        {
            if (Account == null)
                return false;

            string name = Account.Name ?? string.Empty;
            if (name.IndexOf("Sim", StringComparison.OrdinalIgnoreCase) >= 0)
                return false;

            return true;
        }

        private void BeginBracketModification(string reason, string source)
        {
            bracketModificationInProgress = true;
            bracketModificationStartedUtc = DateTime.UtcNow;
        }

        private void EndBracketModification(string reason, string source)
        {
            bracketModificationInProgress = false;
            bracketModificationStartedUtc = Core.Globals.MinDate;
        }

        private bool IsBracketModificationInProgress()
        {
            if (!bracketModificationInProgress)
                return false;

            if (bracketModificationStartedUtc != Core.Globals.MinDate &&
                (DateTime.UtcNow - bracketModificationStartedUtc).TotalSeconds > BracketModificationTimeoutSeconds)
            {
                bracketModificationInProgress = false;
                bracketModificationStartedUtc = Core.Globals.MinDate;
                return false;
            }

            return true;
        }

        private bool IsOrderLiveOrPending(Order order)
        {
            if (order == null)
                return false;

            return order.OrderState == OrderState.Working
                || order.OrderState == OrderState.Accepted
                || order.OrderState == OrderState.Submitted
                || order.OrderState == OrderState.PartFilled
                || order.OrderState == OrderState.ChangeSubmitted
                || order.OrderState == OrderState.CancelSubmitted;
        }

        private void EnsureBracketAlive(string context, string reason)
        {
            if (!EnableBracketWatchdog) return;
            if (State != State.Realtime) return;
            if (IsReplayMode()) return;
            if (IsRealtimeLive() && IsLiveAccount()) return;
            if (Position == null || Position.MarketPosition == MarketPosition.Flat) return;
            if (IsPositionClosingFinal()) return;
            if (IsBracketModificationInProgress()) return;
            if (pendingWatchdogRebuild)
            {
                if (!IsBracketMissingOrDead() || !WatchdogCooldownOk())
                    return;

                pendingWatchdogRebuild = false;
            }
            if (!WatchdogCooldownOk()) return;
            if (!IsBracketMissingOrDead()) return;

            MarkBracketBroken("MISSING_OR_DEAD", context, $"reason={reason}");

            lastWatchdogAttemptUtc = DateTime.UtcNow;
            lastWatchdogPositionQty = Math.Abs(Position.Quantity);
            lastWatchdogMktPos = Position.MarketPosition;
            lastWatchdogReason = reason;
            lastWatchdogContext = context;

            DateTime tradingDay = GetTradingDay(GetSafeTime());
            if (watchdogTradingDay.Date != tradingDay.Date)
            {
                watchdogTradingDay = tradingDay.Date;
                watchdogRebuildCountToday = 0;
            }
            watchdogRebuildCountToday++;

            double bid = 0;
            double ask = 0;
            bool hasQuotes = false;
            try
            {
                bid = GetCurrentBid();
                ask = GetCurrentAsk();
                hasQuotes = (bid > 0 && ask > 0);
            }
            catch
            {
                hasQuotes = false;
            }

            if (!ShouldThrottleAudit($"WATCHDOG_{tradingDay:yyyyMMdd}", LogThrottleSeconds))
            {
                double stopPriceAudit;
                double targetPriceAudit;
                GetBracketPrices(lastWatchdogMktPos, out stopPriceAudit, out targetPriceAudit);
                string watchdogMsg = FormatBracketAudit(reason, context, lastWatchdogMktPos, lastWatchdogPositionQty, Position.AveragePrice, stopPriceAudit, targetPriceAudit,
                    $"hasQuotes={hasQuotes} bid={F0(bid)} ask={F0(ask)} lastBracketQty={lastBracketQty} rebuildCountToday={watchdogRebuildCountToday}");
                Audit("BracketWatchdogTriggered",
                    watchdogMsg);
            }

            double stopTicks;
            double targetTicks;
            double stopDollars;
            ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);

            if (frozenEntryPrice <= 0)
                frozenEntryPrice = Position.AveragePrice;
            if (frozenRiskPoints <= 0)
            {
                frozenRiskPoints = stopTicks * Instrument.MasterInstrument.TickSize;
                frozenStopPrice = lastWatchdogMktPos == MarketPosition.Long
                    ? frozenEntryPrice - frozenRiskPoints
                    : frozenEntryPrice + frozenRiskPoints;
            }
            precoEntradaAtual = frozenEntryPrice;
            riscoPrecoAtual = frozenRiskPoints;

            lastBracketQty = 0;
            SubmitBracketOrders(Position, Position.AveragePrice, Math.Abs(Position.Quantity), tradingDay, stopTicks, targetTicks, stopDollars, reason, context, true);
        }

        private void Log(string tag, string message, DateTime? when = null)
        {
