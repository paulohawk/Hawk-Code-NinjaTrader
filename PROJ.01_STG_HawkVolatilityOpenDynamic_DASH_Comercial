        private bool EvaluateOverlayWindow(string context, out DateTime windowsNow, out DateTime ninjaNow, out DateTime tradingDay, out DateTime overlayStart, out DateTime overlayEnd, out DateTime overlayCutoff)
        {
            windowsNow = GetWindowsNow();
            ninjaNow = GetSafeTime();
            LogTimeSource(context, windowsNow, ninjaNow);

            ComputeOverlayWindow(windowsNow, out tradingDay, out overlayStart, out overlayEnd, out overlayCutoff);
            return IsInsideWindow(windowsNow, overlayStart, overlayEnd);
        }

        private bool EvaluateOverlayPenalty(string context, out DateTime windowsNow, out DateTime ninjaNow, out DateTime tradingDay, out DateTime overlayStart, out DateTime overlayEnd, out DateTime overlayCutoff)
        {
            bool nowInWindow = EvaluateOverlayWindow(context, out windowsNow, out ninjaNow, out tradingDay, out overlayStart, out overlayEnd, out overlayCutoff);

            CaptureOverlayEnableLatch(context, windowsNow);

            DateTime td = GetTradingDay(windowsNow);
            if (overlayEnableTradingDay.Date != td.Date)
                CaptureOverlayEnableLatch(context + "_ResetTD", windowsNow);

            if (!overlayPenaltyArmedToday)
            {
                HideOverlayIfNeeded("NOT_ARMED", windowsNow, overlayStart, overlayEnd);
                return false;
            }

            if (nowInWindow)
            {
                ShowOverlayIfNeeded("ARMED_AND_IN_WINDOW", tradingDay, windowsNow, overlayStart, overlayEnd);
                return true;
            }

            HideOverlayIfNeeded("ARMED_BUT_OUTSIDE_WINDOW", windowsNow, overlayStart, overlayEnd);
            return false;
        }

        private void ShowOverlayIfNeeded(string reason, DateTime tradingDay, DateTime windowsNow, DateTime overlayStart, DateTime overlayEnd)
        {
            if (!overlayAttentionActive)
            {
                string enableText = overlayEnableTimeLocal == Core.Globals.MinDate
                    ? "n/a"
                    : overlayEnableTimeLocal.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                Log("OverlayDiag",
                    "SHOWN reason=" + reason
                    + " windowsNow=" + windowsNow.ToString("O", CultureInfo.InvariantCulture)
                    + " start=" + overlayStart.ToString("O", CultureInfo.InvariantCulture)
                    + " end=" + overlayEnd.ToString("O", CultureInfo.InvariantCulture)
                    + " armed=" + overlayPenaltyArmedToday
                    + " enable=" + enableText);
                overlayAttentionActive = true;
            }

            riskOverlayHelper?.TryShow(this, tradingDay, windowsNow, overlayStart, overlayEnd);
        }

        private void HideOverlayIfNeeded(string reason, DateTime windowsNow, DateTime overlayStart, DateTime overlayEnd)
        {
            if (overlayAttentionActive)
            {
                string enableText = overlayEnableTimeLocal == Core.Globals.MinDate
                    ? "n/a"
                    : overlayEnableTimeLocal.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                Log("OverlayDiag",
                    "HIDDEN reason=" + reason
                    + " windowsNow=" + windowsNow.ToString("O", CultureInfo.InvariantCulture)
                    + " start=" + overlayStart.ToString("O", CultureInfo.InvariantCulture)
                    + " end=" + overlayEnd.ToString("O", CultureInfo.InvariantCulture)
                    + " armed=" + overlayPenaltyArmedToday
                    + " enable=" + enableText);
                overlayAttentionActive = false;
            }

            riskOverlayHelper?.Remove();
        }

