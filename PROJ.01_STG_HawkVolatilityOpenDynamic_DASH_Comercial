                    + " overlayStart=" + overlayStart.ToString("O", CultureInfo.InvariantCulture)
                    + " cutoff=" + overlayCutoff.ToString("O", CultureInfo.InvariantCulture)
                    + " overlayEnd=" + overlayEnd.ToString("O", CultureInfo.InvariantCulture)
                    + " armed=" + overlayPenaltyArmedToday
                    + " inside=" + isInsideOperationalWindow
                    + " replay=" + isPlayback);
