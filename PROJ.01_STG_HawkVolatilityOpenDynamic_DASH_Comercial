        private void Audit(string eventName, string msg)
        {
            if (!EnableTradeAuditLog) return;
            try
            {
                DateTime t = GetSafeTime();
                DateTime auditNow = GetReplayNowOrFallback(t);
                DateTime auditTradingDay = GetReplayTradingDayOrFallback(auditNow);
                string baseMsg = $"[HVO-AUDIT] time={auditNow:O} inst={Instrument?.FullName} acc={Account?.Name} td={auditTradingDay:yyyy-MM-dd} state={State} bip={BarsInProgress} event={eventName} {msg}";
                Print(baseMsg);
