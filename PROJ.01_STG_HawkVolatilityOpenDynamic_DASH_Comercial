        private void DrawExitSimple(string tagBase, double price, bool isRight, string label, Brush brush)
        {
            int L = Math.Max(1, LineLengthBars);
            double tick = Instrument.MasterInstrument.TickSize;

            double lineY = price + LabelTickOffset * tick;
            double arrowY = lineY - 1.0 * tick;
            double labelY = lineY + 1.0 * tick;

            string arrowGlyph = label != null && label.Equals("SL", StringComparison.OrdinalIgnoreCase) ? "▼" : "▲";

            if (isRight)
            {
                Draw.Line(this, tagBase + "_line", 0, lineY, -L, lineY, brush);
                int arrowBarsAgo = -(L + 2);
                int labelBarsAgo = -(L + 9);
                Draw.Text(this, tagBase + "_arrow", arrowGlyph, arrowBarsAgo, arrowY, brush);
                Draw.Text(this, tagBase + "_lbl", label, labelBarsAgo, labelY, brush);
            }
            else
            {
                Draw.Line(this, tagBase + "_line", L, lineY, 0, lineY, brush);
                int arrowBarsAgo = L + 3;
                int labelBarsAgo = L + 9;
                Draw.Text(this, tagBase + "_arrow", arrowGlyph, arrowBarsAgo, arrowY, brush);
                Draw.Text(this, tagBase + "_lbl", label, labelBarsAgo, labelY, brush);
            }
        }

        private DateTime ConvertToBrasilia(DateTime dt)
        {
            try
            {
                TimeZoneInfo brt = null;
                string[] possibleIds = new string[] { "E. South America Standard Time", "America/Sao_Paulo", "SA Eastern Standard Time" };
                foreach (var id in possibleIds)
                {
                    try { brt = TimeZoneInfo.FindSystemTimeZoneById(id); if (brt != null) break; } catch { }
                }

                if (brt == null) return dt.ToLocalTime();

                if (dt.Kind == DateTimeKind.Utc) return TimeZoneInfo.ConvertTimeFromUtc(dt, brt);
                if (dt.Kind == DateTimeKind.Local)
                {
                    DateTime utc = dt.ToUniversalTime();
                    return TimeZoneInfo.ConvertTimeFromUtc(utc, brt);
                }
                else
                {
                    DateTime utc = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
                    return TimeZoneInfo.ConvertTimeFromUtc(utc, brt);
                }
            }
            catch { return dt; }
        }

        private TimeZoneInfo GetBrasiliaTimeZone()
        {
            if (brasiliaTimeZone != null)
                return brasiliaTimeZone;

            // Windows: "E. South America Standard Time" (Brasília/São Paulo)
            // IANA: "America/Sao_Paulo"
            string[] ids = new string[] { "E. South America Standard Time", "America/Sao_Paulo", "SA Eastern Standard Time" };
            foreach (var id in ids)
            {
                try
                {
                    brasiliaTimeZone = TimeZoneInfo.FindSystemTimeZoneById(id);
                    if (brasiliaTimeZone != null)
                        break;
                }
                catch { }
            }

            return brasiliaTimeZone;
        }

        private DateTime ConvertFromTimeZone(DateTime dt, TimeZoneInfo fromTz, TimeZoneInfo toTz)
        {
            try
            {
                if (fromTz == null || toTz == null) return dt;
                // dt deve ser "Unspecified" para TimeZoneInfo aplicar regras corretamente
                var unspecified = DateTime.SpecifyKind(dt, DateTimeKind.Unspecified);
                return TimeZoneInfo.ConvertTime(unspecified, fromTz, toTz);
            }
            catch { return dt; }
        }

        /// <summary>
        /// Converte um TimeSpan (horário de Brasília) para o TimeSpan equivalente no timezone do feed,
        /// respeitando a data do tradingDay (DST US e regras do Brasil pela TZ).
        /// </summary>
        private TimeSpan ConvertBrasiliaTodToFeedTod(DateTime tradingDay, TimeSpan brasiliaTod)
        {
            // AutoClose nasce em Brasília e só é convertido uma vez para o clock do data feed,
            // garantindo consistência entre Replay, Realtime, VPS e Analyzer.
            var brTz = GetBrasiliaTimeZone();
            var feedTz = GetBarTimeZone();
            if (brTz == null || feedTz == null)
            {
                if (!ShouldThrottleAudit($"AUTOCLOSE_TZ_FALLBACK_{tradingDay:yyyyMMdd}", LogThrottleSeconds))
                    Log("AutoCloseTZ", "Fallback usado: conversão BR->Feed indisponível");
                return brasiliaTod;
            }

            // A data usada deve ser do tradingDay (mesmo dia lógico de operação em Brasília)
            var brDt = new DateTime(tradingDay.Year, tradingDay.Month, tradingDay.Day,
                brasiliaTod.Hours, brasiliaTod.Minutes, brasiliaTod.Seconds,
                DateTimeKind.Unspecified);

            var feedDt = ConvertFromTimeZone(brDt, brTz, feedTz);
            return feedDt.TimeOfDay;
        }

        private TimeZoneInfo GetBarTimeZone()
        {
            try
            {
                return Bars?.TradingHours?.TimeZoneInfo ?? TimeZoneInfo.Local;
            }
            catch { return TimeZoneInfo.Local; }
        }

        private TimeZoneInfo GetUsEasternTimeZone()
        {
            if (usEasternTimeZone != null) return usEasternTimeZone;

            string[] possibleIds = new string[] { "Eastern Standard Time", "America/New_York" };
            foreach (var id in possibleIds)
            {
                try
                {
                    usEasternTimeZone = TimeZoneInfo.FindSystemTimeZoneById(id);
                    if (usEasternTimeZone != null) break;
                }
                catch { }
            }

            return usEasternTimeZone;
        }

        private DateTime ConvertToUsEastern(DateTime dt)
        {
            try
            {
                TimeZoneInfo eastern = GetUsEasternTimeZone();
                if (eastern == null) return dt.ToLocalTime();

                if (dt.Kind == DateTimeKind.Utc) return TimeZoneInfo.ConvertTimeFromUtc(dt, eastern);
                if (dt.Kind == DateTimeKind.Local) return TimeZoneInfo.ConvertTime(dt, TimeZoneInfo.Local, eastern);

                TimeZoneInfo sourceTimeZone = GetBarTimeZone();
                return TimeZoneInfo.ConvertTime(dt, sourceTimeZone, eastern);
            }
            catch { return dt; }
        }

        private bool IsUsaDstForTradingDay(DateTime tradingDay)
        {
            TimeZoneInfo eastern = GetUsEasternTimeZone();
            if (eastern == null) return false;

            var easternDate = new DateTime(tradingDay.Year, tradingDay.Month, tradingDay.Day, 12, 0, 0, DateTimeKind.Unspecified);
            return eastern.IsDaylightSavingTime(easternDate);
        }

        private bool TryGetAutoCloseSchedule(DateTime referenceTime, out DateTime tradingDay, out DateTime entryTimeLocal, out DateTime scheduledCloseLocal)
        {
            entryTimeLocal = autoCloseEntryTimeLocal;
            if (entryTimeLocal == Core.Globals.MinDate)
            {
                tradingDay = referenceTime.Date;
                scheduledCloseLocal = Core.Globals.MinDate;
                return false;
            }

            tradingDay = autoCloseEntryTradingDay != Core.Globals.MinDate
                ? autoCloseEntryTradingDay.Date
                : entryTimeLocal.Date;
            scheduledCloseLocal = entryTimeLocal.Add(AutoCloseMaxDuration);
            return true;
        }

