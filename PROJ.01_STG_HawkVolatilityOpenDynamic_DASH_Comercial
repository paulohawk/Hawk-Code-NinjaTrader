        // DEBUG ONLY — NEVER USE FOR DECISION LOGIC (logs/audit only)
        private DateTime ConvertFeedToUtc(DateTime feedTimeRaw)
        {
            var feedTz = GetBarTimeZone();
            if (feedTz == null)
                return feedTimeRaw;
            DateTime feedTime = NormalizeFeedTime(feedTimeRaw);
            return ConvertFromTimeZone(feedTime, feedTz, TimeZoneInfo.Utc);
