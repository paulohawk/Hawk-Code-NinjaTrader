                int labelBarsAgo = L + 9;
                Draw.Text(this, tagBase + "_arrow", arrowGlyph, arrowBarsAgo, arrowY, brush);
                Draw.Text(this, tagBase + "_lbl", label, labelBarsAgo, labelY, brush);
            }
        }

        private DateTime ConvertToBrasilia(DateTime dt)
        {
            try
            {
                TimeZoneInfo brt = null;
                string[] possibleIds = new string[] { "E. South America Standard Time", "America/Sao_Paulo", "SA Eastern Standard Time" };
                foreach (var id in possibleIds)
                {
                    try { brt = TimeZoneInfo.FindSystemTimeZoneById(id); if (brt != null) break; } catch { }
                }

                if (brt == null) return dt.ToLocalTime();

                if (dt.Kind == DateTimeKind.Utc) return TimeZoneInfo.ConvertTimeFromUtc(dt, brt);
                if (dt.Kind == DateTimeKind.Local)
                {
                    DateTime utc = dt.ToUniversalTime();
                    return TimeZoneInfo.ConvertTimeFromUtc(utc, brt);
                }
                else
                {
                    DateTime utc = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
                    return TimeZoneInfo.ConvertTimeFromUtc(utc, brt);
                }
            }
            catch { return dt; }
        }

        private TimeZoneInfo GetBarTimeZone()
        {
            try
            {
                return Bars?.TradingHours?.TimeZoneInfo ?? TimeZoneInfo.Local;
            }
            catch { return TimeZoneInfo.Local; }
        }

        private TimeZoneInfo GetUsEasternTimeZone()
        {
            if (usEasternTimeZone != null) return usEasternTimeZone;

            string[] possibleIds = new string[] { "Eastern Standard Time", "America/New_York" };
            foreach (var id in possibleIds)
            {
                try
                {
                    usEasternTimeZone = TimeZoneInfo.FindSystemTimeZoneById(id);
                    if (usEasternTimeZone != null) break;
                }
                catch { }
            }

            return usEasternTimeZone;
        }

        private DateTime ConvertToUsEastern(DateTime dt)
        {
            try
            {
                TimeZoneInfo eastern = GetUsEasternTimeZone();
                if (eastern == null) return dt.ToLocalTime();

                if (dt.Kind == DateTimeKind.Utc) return TimeZoneInfo.ConvertTimeFromUtc(dt, eastern);
                if (dt.Kind == DateTimeKind.Local) return TimeZoneInfo.ConvertTime(dt, TimeZoneInfo.Local, eastern);

                TimeZoneInfo sourceTimeZone = GetBarTimeZone();
                return TimeZoneInfo.ConvertTime(dt, sourceTimeZone, eastern);
            }
            catch { return dt; }
        }

        private void TryAutoCloseIfScheduled(DateTime barTime)
        {
            if (!AutoCloseEnabled) return;

            DateTime brasiliaNow = ConvertToBrasilia(barTime);
            DateTime tradingDay = GetTradingDay(barTime); // usa trading day da série principal

            // já executou neste trading day?
            if (lastAutoCloseDate.Date == tradingDay.Date) return;

            TimeSpan scheduled;
            try
            {
                var parts = AutoCloseTimeHHmmss.Split(':');
                scheduled = new TimeSpan(int.Parse(parts[0]), int.Parse(parts[1]), int.Parse(parts[2]));
            }
            catch { scheduled = new TimeSpan(17, 55, 0); }

            if (brasiliaNow.TimeOfDay < scheduled) return;

            // Se não há posição, cancela plano pendente e sai
            if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
            {
                if (invertPlanArmed)
                {
                    CancelInvertPlan("EOD", tradingDay);
                    Audit("AutoClose", $"scheduled={scheduled} brNow={brasiliaNow:HH\\:mm\\:ss} action=CancelInvertPlan");
                }

                lastAutoCloseDate = tradingDay.Date;
                autoCloseTriggeredToday = true;
                PublishPanelSnapshot("AutoClose_flat");
                return;
            }

            // Marca dia e executa
            lastAutoCloseDate = tradingDay.Date;
            autoCloseTriggeredToday = true;
            exitReasonHint = "AutoClose";
            exitReasonHintTradingDay = tradingDay;

            Audit("AutoClose", $"scheduled={scheduled} brNow={brasiliaNow:HH\\:mm\\:ss} side={Position.MarketPosition} qty={Position.Quantity} avg={F0(Position.AveragePrice)}");

            try
            {
                try { if (ordemTPLong != null) CancelOrder(ordemTPLong); } catch { }
                try { if (ordemTPShort != null) CancelOrder(ordemTPShort); } catch { }
                try { if (ordemStopLong != null) CancelOrder(ordemStopLong); } catch { }
                try { if (ordemStopShort != null) CancelOrder(ordemStopShort); } catch { }

                string fromSignal = GetActiveEntrySignal(tradingDay);

                if (Position.MarketPosition == MarketPosition.Long && Position.Quantity > 0)
                {
                    if (!string.IsNullOrEmpty(fromSignal))
                        ExitLong("AutoClose", fromSignal);
                    else
                        ExitLong("AutoClose");
                }
                else if (Position.MarketPosition == MarketPosition.Short && Position.Quantity > 0)
                {
                    if (!string.IsNullOrEmpty(fromSignal))
                        ExitShort("AutoClose", fromSignal);
                    else
                        ExitShort("AutoClose");
                }

                PublishPanelSnapshot("AutoClose");
            }
            catch (Exception ex)
            {
                Log("AutoClose", $"Exception while attempting auto-close: {ex.Message}");
            }
        }

