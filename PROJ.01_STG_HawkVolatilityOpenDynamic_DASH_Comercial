        private void UpdateStreaksIfClosedTradesChanged()
        {
            try
            {
                int count = SystemPerformance.AllTrades.Count;
                if (count <= lastTradesCount) return;

                var lastTrade = SystemPerformance.AllTrades[count - 1];
                if (lastTrade != null)
                {
                    double pl = lastTrade.ProfitCurrency;
                    if (pl > 0)
                    {
                        if (currentStreak >= 0) currentStreak += 1; else currentStreak = 1;
                        if (currentStreak > maxGainStreak) maxGainStreak = currentStreak;
                    }
                    else if (pl < 0)
                    {
                        if (currentStreak <= 0) currentStreak -= 1; else currentStreak = -1;
                        if (Math.Abs(currentStreak) > maxLossStreak) maxLossStreak = Math.Abs(currentStreak);
                    }
                    else
                    {
                        currentStreak = 0;
                    }
                }
                lastTradesCount = count;
            }
            catch (Exception ex)
            {
                Log("Streaks", $"Erro ao atualizar streaks: {ex.Message}");
            }
        }

        private string ComputeTakeDollarText()
        {
            try
            {
                double? targetPrice = null;
                if (ordemTPLong != null && ordemTPLong.LimitPrice > 0) targetPrice = ordemTPLong.LimitPrice;
                if (ordemTPShort != null && ordemTPShort.LimitPrice > 0) targetPrice = ordemTPShort.LimitPrice;
                if (!targetPrice.HasValue) return "-";

                int qty = Position.Quantity != 0 ? Math.Abs(Position.Quantity) :
                          (ordemTPLong != null ? Math.Abs(ordemTPLong.Quantity) : (ordemTPShort != null ? Math.Abs(ordemTPShort.Quantity) : 0));
                if (qty <= 0 || Position.MarketPosition == MarketPosition.Flat) return "-";

                double avg = Position.AveragePrice;
                double tickSize = Instrument.MasterInstrument.TickSize;
                double tickValue = Instrument.MasterInstrument.PointValue * tickSize;
                double priceDiff = Math.Abs(targetPrice.Value - avg);
                double ticks = priceDiff / tickSize;
                double dollars = ticks * tickValue * qty;
                return dollars.ToString("0.00");
            }
            catch
            {
                return "-";
            }
        }

        private double ComputeRiskDollars(double entry, double stop, int qty)
        {
            try
            {
                double tickSize = Instrument.MasterInstrument.TickSize;
                double tickValue = Instrument.MasterInstrument.PointValue * tickSize;
                double priceRisk = Math.Abs(entry - stop);
                double ticks = priceRisk / tickSize;
                return ticks * tickValue * qty;
            }
            catch
            {
                return 0.0;
            }
        }

        private void RecalcPnLIfNeeded()
        {
            try
            {
                var trades = SystemPerformance.AllTrades;
                int count = trades != null ? trades.Count : 0;
                double intervalSec = Math.Max(1, PanelPublishIntervalSeconds);
                var now = DateTime.UtcNow;
                bool shouldCalc = (count != lastPnlTradesCount) || ((now - lastPnlCalcUtc).TotalSeconds >= intervalSec);

                if (!shouldCalc) return;

                double pnlTotalVal = SystemPerformance.AllTrades.TradesPerformance.Currency.CumProfit;
                cachedPnlTotal = pnlTotalVal.ToString("0.00");

                DateTime nowLocal = GetSafeTime();

                double pnlDayVal = 0.0;
                double pnlMesVal = 0.0;

                if (trades != null)
                {
                    for (int i = 0; i < trades.Count; i++)
                    {
                        var t = trades[i];
                        if (t != null && t.Exit != null)
                        {
                            if (t.Exit.Time.Date == nowLocal.Date)
                                pnlDayVal += t.ProfitCurrency;
                            if (t.Exit.Time.Month == nowLocal.Month && t.Exit.Time.Year == nowLocal.Year)
                                pnlMesVal += t.ProfitCurrency;
                        }
                    }
                }

                cachedPnlDay = pnlDayVal.ToString("0.00");
                cachedPnlMonth = pnlMesVal.ToString("0.00");

                lastPnlTradesCount = count;
                lastPnlCalcUtc = now;
            }
            catch (Exception ex)
            {
                Log("PnLCalc", $"Erro ao recalcular PnL: {ex.Message}");
            }
        }

        private HVO_PanelStateHub.PanelSnapshot BuildSnapshot(bool offSnapshot, string statusOverride = null)
        {
            var snap = new HVO_PanelStateHub.PanelSnapshot();
            snap.LastUpdatedUtc = DateTime.UtcNow;
            snap.StrategyName = BuildPanelTitle();
            snap.StrategyKey = cacheKey;

            snap.EndDayText = AutoCloseEnabled ? AutoCloseTimeHHmmss : "-";
            snap.ATREnabled = UseStopATR;
            if (UseStopATR && lastAtrVal > 0)
            {
                double atrPoints = lastAtrVal;
                double atrDollars = atrPoints * Instrument.MasterInstrument.PointValue;
                snap.AtrDisplayText = string.Format(
                    System.Globalization.CultureInfo.InvariantCulture,
                    "{0:0.00} ({1:0.00} USD/ct)",
                    atrPoints,
                    atrDollars
                );
            }
            else
            {
                snap.AtrDisplayText = "-";
            }
            snap.MainEnabled = !offSnapshot;
            snap.HedgeEnabled = GetEffectiveInvertMode() != InvertModeType.Disabled;

            // Aviso persistente no painel quando ligado fora do horário operacional
            try
            {
                if (!offSnapshot)
                {
                    DateTime now = GetSafeTime();
                    snap.RiskWarningText = (now.TimeOfDay > new TimeSpan(11, 0, 0))
                        ? "Atenção: automação ligada fora do horário operacional."
                        : null;
                }
                else
                {
                    snap.RiskWarningText = null;
                }
            }
            catch
            {
                snap.RiskWarningText = null;
            }

            RecalcPnLIfNeeded();
            snap.PnLDiaText = cachedPnlDay;
            snap.PnLMesText = cachedPnlMonth;
            snap.PnLTotalText = cachedPnlTotal;

            UpdateStreaksIfClosedTradesChanged();
            snap.MaxGainStreak = maxGainStreak;
            snap.MaxLossStreak = maxLossStreak;

            string statusSentence = statusOverride ?? dayStatus;
            snap.DayTradeStatus = statusSentence;
            snap.StatusText = statusSentence;

            snap.DayQuantity = dayQtyCache;
            snap.DayStopDollar = dayStopDollars;
            snap.DayTargetDollar = dayTargetDollars;
            snap.DayBreakevenDollar = dayBreakevenDollars;
            snap.DayMaxGain = maxGainStreak;
            snap.DayMaxLoss = maxLossStreak;

            snap.TakeDollarText = ComputeTakeDollarText();

            if (offSnapshot)
            {
                snap.EntryPrice = null;
                snap.StopChart = null;
                snap.ExitTarget = null;
                snap.Qty = null;
                snap.BEEnabled = false;

                snap.PendingEntryPrice = null;
                snap.PendingStopPrice = null;
                snap.PendingTargetPrice = null;
                snap.PendingQty = null;

                snap.FinancialStopText = "-";
                snap.TakeDollarText = "-";
                snap.AtrDisplayText = "-";
                snap.PnLDiaText = "-";
                snap.PnLMesText = "-";
                snap.PnLTotalText = "-";
                snap.DayStopDollar = "-";
                snap.DayTargetDollar = "-";
                snap.DayBreakevenDollar = "-";
                snap.DayTradeStatus = "Waiting";
                snap.StatusText = "Waiting";
                snap.MainEnabled = false;
                snap.ATREnabled = UseStopATR;
                snap.HedgeEnabled = GetEffectiveInvertMode() != InvertModeType.Disabled;
                return snap;
            }

            // Quando em posição: preencher Entry/Stop/Exit/Qty
            if (Position.MarketPosition != MarketPosition.Flat)
            {
                snap.EntryPrice = Position.AveragePrice;
                snap.Qty = Math.Abs(Position.Quantity);

                double? stop = null;
                double? tp = null;
                if (Position.MarketPosition == MarketPosition.Long && ordemStopLong != null) stop = ordemStopLong.StopPrice;
                if (Position.MarketPosition == MarketPosition.Short && ordemStopShort != null) stop = ordemStopShort.StopPrice;
                if (Position.MarketPosition == MarketPosition.Long && ordemTPLong != null) tp = ordemTPLong.LimitPrice;
                if (Position.MarketPosition == MarketPosition.Short && ordemTPShort != null) tp = ordemTPShort.LimitPrice;

                snap.StopChart = stop;
                snap.ExitTarget = tp;

                try
                {
                    if (stop.HasValue && Position.Quantity != 0)
                    {
                        snap.FinancialStopText = ComputeRiskDollars(Position.AveragePrice, stop.Value, Math.Abs(Position.Quantity)).ToString("0.00");
                    }
                    else snap.FinancialStopText = "-";
                }
                catch { snap.FinancialStopText = "-"; }

                snap.PendingEntryPrice = null;
                snap.PendingStopPrice = null;
                snap.PendingTargetPrice = null;
                snap.PendingQty = null;
            }
            else
            {
                // flat: valores reais nulos; pending (se existir) também nulos por ora
                snap.EntryPrice = null;
                snap.StopChart = null;
                snap.ExitTarget = null;
                snap.Qty = null;

                snap.PendingEntryPrice = null;
                snap.PendingStopPrice = null;
                snap.PendingTargetPrice = null;
                snap.PendingQty = null;

                snap.FinancialStopText = "-";
            }

            snap.BEEnabled = breakevenAtivado;
            snap.DayQuantity = snap.Qty ?? dayQtyCache;
            return snap;
        }

