        private bool IsDayResumHydrated(int qtyAbs)
        {
            if (qtyAbs <= 0) return false;
            if (!dayQtyCache.HasValue) return false;
            if (dayQtyCache.Value != qtyAbs) return false;
            if (frozenEntryPrice <= 0) return false;
            if (frozenRiskPoints <= 0) return false;
            if (string.IsNullOrWhiteSpace(dayStopDollars) || dayStopDollars == "-") return false;
            if (string.IsNullOrWhiteSpace(dayTargetDollars) || dayTargetDollars == "-") return false;
            return true;
        }

        private void HydrateDayResumOnOpen(MarketPosition side, int qtyAbs, double avgPrice, DateTime tradingDay, string reason, string context)
        {
            if (side == MarketPosition.Flat || qtyAbs <= 0)
                return;

            if (frozenEntryPrice <= 0)
            {
                if (avgPrice > 0)
                    frozenEntryPrice = avgPrice;
                else if (Position != null)
                    frozenEntryPrice = Position.AveragePrice;
            }

            if (frozenRiskPoints <= 0)
            {
                double stopPriceAudit;
                double targetPriceAudit;
                GetBracketPrices(side, out stopPriceAudit, out targetPriceAudit);

                if (stopPriceAudit > 0)
                {
                    frozenStopPrice = stopPriceAudit;
                    frozenRiskPoints = Math.Abs(frozenEntryPrice - frozenStopPrice);
                }
                else
                {
                    double stopTicks;
                    double targetTicks;
                    double stopDollars;
                    ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);
                    double tickSize = Instrument.MasterInstrument.TickSize;
                    frozenRiskPoints = stopTicks * tickSize;
                    if (frozenRiskPoints > 0)
                    {
                        frozenStopPrice = (side == MarketPosition.Long)
                            ? frozenEntryPrice - frozenRiskPoints
                            : frozenEntryPrice + frozenRiskPoints;
                    }
                }
            }

            if (frozenEntryPrice <= 0 || frozenRiskPoints <= 0)
                return;

            precoEntradaAtual = frozenEntryPrice;
            riscoPrecoAtual = frozenRiskPoints;
            dayQtyCache = qtyAbs;

            double stopTicks2;
            double targetTicks2;
            double stopDollarsPerContract;
            ComputeBracketMetrics(out stopTicks2, out targetTicks2, out stopDollarsPerContract);

            double riskDollars = (frozenStopPrice > 0)
                ? ComputeRiskDollars(frozenEntryPrice, frozenStopPrice, qtyAbs)
                : stopDollarsPerContract * qtyAbs;
            dayStopDollars = riskDollars > 0 ? riskDollars.ToString("0.00") : "-";

            double targetDollars = riskDollars * TargetFactor;
            dayTargetDollars = targetDollars > 0 ? targetDollars.ToString("0.00") : "-";

            dayBreakevenDollars = "-";

            string throttleKey = $"DAYRESUM_HYDRATE_{tradingDay:yyyyMMdd}_{bracketCycleId}_{side}_{qtyAbs}";
            if (!ShouldThrottleAudit(throttleKey, LogThrottleSeconds))
            {
                Audit("DayResumHydrated",
                    $"side={side} qty={qtyAbs} entry={F0(frozenEntryPrice)} riskPx={F(frozenRiskPoints)} stop$={dayStopDollars} target$={dayTargetDollars} reason={reason} ctx={context} mode={GetModeTag()} env={GetEnvTag()}");
            }

            PublishPanelSnapshot("DayResum_Hydrated");
        }

        private void RecalcPnLIfNeeded()
        {
            try
            {
                var trades = SystemPerformance.AllTrades;
                int count = trades != null ? trades.Count : 0;
                double intervalSec = Math.Max(1, PanelPublishIntervalSeconds);
                var now = DateTime.UtcNow;
                bool shouldCalc = (count != lastPnlTradesCount) || ((now - lastPnlCalcUtc).TotalSeconds >= intervalSec);

                if (!shouldCalc) return;

                double pnlTotalVal = SystemPerformance.AllTrades.TradesPerformance.Currency.CumProfit;
                cachedPnlTotal = pnlTotalVal.ToString("0.00");

                DateTime nowLocal = GetSafeTime();

                double pnlDayVal = 0.0;
                double pnlMesVal = 0.0;

                if (trades != null)
                {
                    for (int i = 0; i < trades.Count; i++)
                    {
                        var t = trades[i];
                        if (t != null && t.Exit != null)
                        {
                            if (t.Exit.Time.Date == nowLocal.Date)
                                pnlDayVal += t.ProfitCurrency;
                            if (t.Exit.Time.Month == nowLocal.Month && t.Exit.Time.Year == nowLocal.Year)
                                pnlMesVal += t.ProfitCurrency;
                        }
                    }
                }

                cachedPnlDay = pnlDayVal.ToString("0.00");
                cachedPnlMonth = pnlMesVal.ToString("0.00");

                lastPnlTradesCount = count;
                lastPnlCalcUtc = now;
            }
            catch (Exception ex)
            {
                Log("PnLCalc", $"Erro ao recalcular PnL: {ex.Message}");
            }
        }

        private HVO_PanelStateHub.PanelSnapshot BuildSnapshot(bool offSnapshot, string statusOverride = null)
        {
            var snap = new HVO_PanelStateHub.PanelSnapshot();
            snap.LastUpdatedUtc = DateTime.UtcNow;
            snap.StrategyName = BuildPanelTitle();
            snap.StrategyKey = cacheKey;

            if (AutoCloseEnabled)
            {
                if (GetEffectiveInvertMode() == InvertModeType.InvertedStopEntry)
                {
                    DateTime cutoff = hedgeCutoffLocal;
                    if (cutoff == Core.Globals.MinDate)
                    {
                        DateTime td = GetTradingDay(GetSafeTime());
                        cutoff = BuildHedgeCutoffLocal(td);
                    }
                    snap.EndDayText = $"{cutoff:HH\\:mm\\:ss} BR";
                }
                else if (autoCloseEntryTimeLocal != Core.Globals.MinDate)
                {
                    DateTime scheduledClose = autoCloseEntryTimeLocal.Add(AutoCloseMaxDuration);
                    snap.EndDayText = $"{scheduledClose:HH\\:mm\\:ss} BR";
                }
                else
                {
                    snap.EndDayText = GetDefaultAutoCloseDisplayTimeBR();
                }
            }
            else
            {
                snap.EndDayText = "-";
            }
            snap.ATREnabled = UseStopATR;
            if (UseStopATR && lastAtrVal > 0)
            {
                double atrPoints = lastAtrVal;
                double atrDollars = atrPoints * Instrument.MasterInstrument.PointValue;
                snap.AtrDisplayText = string.Format(
                    System.Globalization.CultureInfo.InvariantCulture,
                    "{0:0.00} ({1:0.00} USD/ct)",
                    atrPoints,
                    atrDollars
                );
            }
            else
            {
                snap.AtrDisplayText = "-";
            }
            snap.MainEnabled = !offSnapshot;
            snap.HedgeEnabled = GetEffectiveInvertMode() != InvertModeType.Disabled;

            // Bloco unificado de status/atenção no painel (estrutura sempre presente)
            bool overlayAttention = false;
            if (!offSnapshot && State == State.Realtime)
            {
                DateTime windowsNow;
                DateTime ninjaNow;
                DateTime overlayTradingDay;
                DateTime overlayStart;
                DateTime overlayEnd;
                DateTime overlayCutoff;
                overlayAttention = EvaluateOverlayPenalty("OverlayEval", out windowsNow, out ninjaNow, out overlayTradingDay, out overlayStart, out overlayEnd, out overlayCutoff);
            }
            snap.RiskWarningIsAttention = overlayAttention;
            snap.RiskWarningText = overlayAttention
                ? "Execução da automação em horário crítico.\nMonitore possíveis falhas de stop e alvo."
                : "Status: sistema ativo e monitorando condições de mercado.";

            RecalcPnLIfNeeded();
            snap.PnLDiaText = cachedPnlDay;
            snap.PnLMesText = cachedPnlMonth;
            snap.PnLTotalText = cachedPnlTotal;

            UpdateStreaksIfClosedTradesChanged();
            snap.MaxGainStreak = maxGainStreak;
            snap.MaxLossStreak = maxLossStreak;

            string statusSentence = statusOverride ?? dayStatus;
            snap.DayTradeStatus = statusSentence;
            snap.StatusText = statusSentence;

            snap.DayQuantity = dayQtyCache;
            snap.DayStopDollar = dayStopDollars;
            snap.DayTargetDollar = dayTargetDollars;
            snap.DayBreakevenDollar = dayBreakevenDollars;
            snap.DayMaxGain = maxGainStreak;
            snap.DayMaxLoss = maxLossStreak;

            snap.TakeDollarText = ComputeTakeDollarText();

            if (offSnapshot)
            {
                snap.EntryPrice = null;
                snap.StopChart = null;
                snap.ExitTarget = null;
                snap.Qty = null;
                snap.BEEnabled = false;

                snap.PendingEntryPrice = null;
                snap.PendingStopPrice = null;
                snap.PendingTargetPrice = null;
                snap.PendingQty = null;

                snap.FinancialStopText = "-";
                snap.TakeDollarText = "-";
                snap.AtrDisplayText = "-";
                snap.PnLDiaText = "-";
                snap.PnLMesText = "-";
                snap.PnLTotalText = "-";
                snap.DayStopDollar = "-";
                snap.DayTargetDollar = "-";
                snap.DayBreakevenDollar = "-";
                snap.DayTradeStatus = "Waiting";
                snap.StatusText = "Waiting";
                snap.RiskWarningIsAttention = false;
                snap.RiskWarningText = "Status: sistema ativo e monitorando condições de mercado.";
                snap.MainEnabled = false;
                snap.ATREnabled = UseStopATR;
                snap.HedgeEnabled = GetEffectiveInvertMode() != InvertModeType.Disabled;
                return snap;
            }

            // Quando em posição: preencher Entry/Stop/Exit/Qty
            if (Position.MarketPosition != MarketPosition.Flat)
            {
                snap.EntryPrice = Position.AveragePrice;
                snap.Qty = Math.Abs(Position.Quantity);

                double? stop = null;
                double? tp = null;
                if (Position.MarketPosition == MarketPosition.Long && ordemStopLong != null) stop = ordemStopLong.StopPrice;
                if (Position.MarketPosition == MarketPosition.Short && ordemStopShort != null) stop = ordemStopShort.StopPrice;
                if (Position.MarketPosition == MarketPosition.Long && ordemTPLong != null) tp = ordemTPLong.LimitPrice;
                if (Position.MarketPosition == MarketPosition.Short && ordemTPShort != null) tp = ordemTPShort.LimitPrice;

                snap.StopChart = stop;
                snap.ExitTarget = tp;

                try
                {
                    if (stop.HasValue && Position.Quantity != 0)
                    {
                        snap.FinancialStopText = ComputeRiskDollars(Position.AveragePrice, stop.Value, Math.Abs(Position.Quantity)).ToString("0.00");
                    }
                    else snap.FinancialStopText = "-";
                }
                catch { snap.FinancialStopText = "-"; }

                snap.PendingEntryPrice = null;
                snap.PendingStopPrice = null;
                snap.PendingTargetPrice = null;
                snap.PendingQty = null;
            }
            else
            {
                // flat: valores reais nulos; pending (se existir) também nulos por ora
                snap.EntryPrice = null;
                snap.StopChart = null;
                snap.ExitTarget = null;
                snap.Qty = null;

                snap.PendingEntryPrice = null;
                snap.PendingStopPrice = null;
                snap.PendingTargetPrice = null;
                snap.PendingQty = null;

                snap.FinancialStopText = "-";
            }

            snap.BEEnabled = breakevenAtivado;
            snap.DayQuantity = snap.Qty ?? dayQtyCache;
            return snap;
        }

