        private void ArmInvertPlan(DateTime tradingDay, MarketPosition direction, int qty, double stopTicks, double targetTicks,
            double breakEvenAtRR, double breakEvenLockRR, double entryReference, double stopPrice, double targetPrice)
        {
            plannedDirection = direction;
            plannedQty = qty;
            plannedStopTicks = stopTicks;
            plannedTargetTicks = targetTicks;
            plannedBreakEvenAtRR = breakEvenAtRR;
            plannedBreakEvenLockRR = breakEvenLockRR;
            plannedEntryPriceReference = entryReference;
            plannedStopPrice = stopPrice;
            plannedTargetPrice = targetPrice;
            plannedTradeDate = tradingDay;
            invertPlanArmed = true;
            invertPlanBeArmed = false;
            invertStopTriggered = false;

            Audit("InvertPlanArmed",
                $"td={tradingDay:yyyy-MM-dd} dir={direction} qty={qty} entryRef={F0(entryReference)} stopPx={F0(stopPrice)} targetPx={F0(targetPrice)} stopTicks={stopTicks} targetTicks={targetTicks}");

            double tickSize = Instrument.MasterInstrument.TickSize;
            int offsetTicks = Math.Max(1, InvertStopOffsetTicks);
            double stopEntryPrice = 0;

            if (direction == MarketPosition.Long)
            {
                stopEntryPrice = stopPrice - offsetTicks * tickSize;
                invertStopEntryOrder = EnterShortStopMarket(0, true, qty, stopEntryPrice, "InvertStopEntry");
            }
            else if (direction == MarketPosition.Short)
            {
                stopEntryPrice = stopPrice + offsetTicks * tickSize;
                invertStopEntryOrder = EnterLongStopMarket(0, true, qty, stopEntryPrice, "InvertStopEntry");
            }
            else
            {
                Audit("InvertPlanError",
                    $"Invalid plannedDirection={direction}. Invert plan aborted.");
                ClearInvertPlanSnapshot();
                return;
            }

            Audit("InvertStopOrderPlaced",
                $"td={tradingDay:yyyy-MM-dd} dir={direction} stopEntry={F0(stopEntryPrice)} offsetTicks={offsetTicks}");
        }

        private void EvaluateInvertPlanLifecycle(DateTime closeTime, DateTime tradingDay)
        {
            if (!invertPlanArmed || invertStopTriggered || plannedDirection == MarketPosition.Flat)
                return;

            double tickSize = Instrument.MasterInstrument.TickSize;
            double riskPx = plannedStopTicks * tickSize;

            if (!invertPlanBeArmed && plannedBreakEvenAtRR > 0 && plannedBreakEvenLockRR > 0)
            {
                if (plannedDirection == MarketPosition.Long)
                {
                    if (High[0] >= plannedEntryPriceReference + riskPx * plannedBreakEvenAtRR)
                        invertPlanBeArmed = true;
                }
                else if (plannedDirection == MarketPosition.Short)
                {
                    if (Low[0] <= plannedEntryPriceReference - riskPx * plannedBreakEvenAtRR)
                        invertPlanBeArmed = true;
                }
            }

            if (plannedDirection == MarketPosition.Long)
            {
                if (High[0] >= plannedTargetPrice)
                {
                    CancelInvertPlan("TP", tradingDay);
                    return;
                }

                if (invertPlanBeArmed)
                {
                    double beStop = plannedEntryPriceReference + riskPx * plannedBreakEvenLockRR;
                    if (beStop > plannedTargetPrice) beStop = plannedTargetPrice;
                    if (Low[0] <= beStop)
                        CancelInvertPlan("BE", tradingDay);
                }
            }
            else if (plannedDirection == MarketPosition.Short)
            {
                if (Low[0] <= plannedTargetPrice)
                {
                    CancelInvertPlan("TP", tradingDay);
                    return;
                }

                if (invertPlanBeArmed)
                {
                    double beStop = plannedEntryPriceReference - riskPx * plannedBreakEvenLockRR;
                    if (beStop < plannedTargetPrice) beStop = plannedTargetPrice;
                    if (High[0] >= beStop)
                        CancelInvertPlan("BE", tradingDay);
                }
            }

            if (AutoCloseEnabled && lastInvertPlanCancelDate.Date != tradingDay.Date)
            {
                DateTime brasiliaNow = ConvertToBrasilia(closeTime);
                TimeSpan scheduled;
                try
                {
                    var parts = AutoCloseTimeHHmmss.Split(':');
                    scheduled = new TimeSpan(int.Parse(parts[0]), int.Parse(parts[1]), int.Parse(parts[2]));
                }
                catch { scheduled = new TimeSpan(17, 55, 0); }

                if (brasiliaNow.TimeOfDay >= scheduled)
                    CancelInvertPlan("EOD", tradingDay);
            }
        }

        protected override void OnBarUpdate()
        {
            // Processa BIP do SuperTrend para memo
            if (BarsInProgress == STSeriesIndex)
            {
                if (CurrentBars[STSeriesIndex] > Math.Max(STPeriod, STSmooth))
                {
                    var st = TSSuperTrend(
                        Closes[STSeriesIndex],
                        SuperTrendMode.ATR,
                        STPeriod,
                        STFactor,
                        STMaType,
                        STSmooth,
                        false,
                        false,
                        false);

                    memoSuperTrendUpValue = st.UpTrend[0];
                    memoSuperTrendDownValue = st.DownTrend[0];
                    double closeST = Closes[STSeriesIndex][0];

                    memoSuperTrendUpTrend =
                        ((memoSuperTrendDownValue == 0 && memoSuperTrendUpValue > 0) ||
                         (memoSuperTrendDownValue > 0 && closeST >= memoSuperTrendDownValue));

                    memoSuperTrendDownTrend =
                        ((memoSuperTrendUpValue == 0 && memoSuperTrendDownValue > 0) ||
                         (memoSuperTrendUpValue > 0 && closeST <= memoSuperTrendUpValue));

                    memoSuperTrendReady = true;
                    memoSuperTrendTime = Times[STSeriesIndex][0];
                }
                return;
            }

            // Processa BIP do ATR para memo
            if (BarsInProgress == ATRSeriesIndex)
            {
                if (CurrentBars[ATRSeriesIndex] > ATRPeriod)
                {
                    lastAtrVal = ATR(BarsArray[ATRSeriesIndex], ATRPeriod)[0];
                }
                return;
            }

            // BIP principal
            if (BarsInProgress != 0) return;
            if (CurrentBars == null || CurrentBars.Length == 0) return;
            if (CurrentBars[0] < 2) return;

            DateTime closeTime = Times[0][0];
            DateTime tradingDay = GetTradingDay(closeTime);

            if (lastTradeDate != tradingDay)
            {
                ResetDayCaches(tradingDay);
            }

            TryAutoCloseIfScheduled(closeTime);
            EvaluateInvertPlanLifecycle(closeTime, tradingDay);

            string entryHms = IsUsaDst(closeTime) ? EntryTimeDstUsaHHmmss : EntryTimeNormalHHmmss;

            DateTime scheduledTime;
            try
            {
                var hms = entryHms.Split(':');
                scheduledTime = new DateTime(tradingDay.Year, tradingDay.Month, tradingDay.Day,
                            int.Parse(hms[0]), int.Parse(hms[1]), int.Parse(hms[2]));
            }
            catch
            {
                Log("Error", "Formato do horário inválido! Use HH:mm:ss.");
                PublishSnapshotHeartbeat("InvalidSchedule");
                return;
            }

            DateTime scheduledTimeMax = scheduledTime.AddMinutes(1);

            bool liberarLong = false;
            bool liberarShort = false;

            if (UseSuperTrend && SuperTrendOnBarClose)
            {
                if (!memoSuperTrendReady)
                {
                    liberarLong = true;
                    liberarShort = true;
                }
                else
                {
                    liberarLong = memoSuperTrendUpTrend;
                    liberarShort = memoSuperTrendDownTrend;
                }
            }
            else if (UseSuperTrend && !SuperTrendOnBarClose)
            {
                if (CurrentBars.Length > STSeriesIndex && CurrentBars[STSeriesIndex] > Math.Max(STPeriod, STSmooth))
                {
                    var supertrendRealtime = TSSuperTrend(
                        Closes[STSeriesIndex],
                        SuperTrendMode.ATR,
                        STPeriod,
                        STFactor,
                        STMaType,
                        STSmooth,
                        false,
                        false,
                        false);

                    double pxSt = Closes[STSeriesIndex][0];

                    liberarLong = supertrendRealtime.UpTrend[0] > 0.0 && pxSt > supertrendRealtime.UpTrend[0];
                    liberarShort = supertrendRealtime.DownTrend[0] > 0.0 && pxSt < supertrendRealtime.DownTrend[0];
                }
                else
                {
                    liberarLong = true;
                    liberarShort = true;
                }
            }
            else
            {
                liberarLong = true;
                liberarShort = true;
            }

            if (Position.MarketPosition != MarketPosition.Flat &&
                riscoPrecoAtual > 0 &&
                !breakevenAtivado &&
                GetEffectiveBreakEvenAtRR() > 0 &&
                GetEffectiveBreakEvenLockRR() > 0)
            {
                AplicarBreakEvenSeAtingiuRR();
            }

            if (!tradedToday && Position.MarketPosition == MarketPosition.Flat)
            {
                if (!Bars.IsFirstBarOfSession &&
                    closeTime >= scheduledTime &&
                    closeTime <= scheduledTimeMax)
                {
                    actualContractsForDay = Contracts;

                    double stopDollarsPerContract = StopPerContract;

                    if (UseStopATR)
                    {
                        if (lastAtrVal > 0)
                            stopDollarsPerContract = lastAtrVal * ATRFactor;
                        else
                            stopDollarsPerContract = StopPerContract;
                    }

                    if (UseStopATR && MaxRiskPerTrade > 0)
                    {
                        double riscoMaximoComQtdMax = stopDollarsPerContract * Contracts;
                        if (riscoMaximoComQtdMax > MaxRiskPerTrade)
                        {
                            int qtdCalc = (int)Math.Floor(MaxRiskPerTrade / stopDollarsPerContract);
                            if (qtdCalc < 1) qtdCalc = 1;
                            actualContractsForDay = qtdCalc;
                        }
                    }

                    bool sinalCompra = liberarLong;
                    bool sinalVenda = liberarShort;

                    double tickSize = Instrument.MasterInstrument.TickSize;
                    double tickValue = Instrument.MasterInstrument.PointValue * tickSize;
                    double stopTicks = Math.Round(stopDollarsPerContract / tickValue, 0);
                    double targetTicks = stopTicks * TargetFactor;

                    InvertModeType invertMode = GetEffectiveInvertMode();
                    bool entrarLong = false;
                    bool entrarShort = false;

                    if (invertMode == InvertModeType.Disabled)
                    {
                        entrarLong = sinalCompra;
                        entrarShort = sinalVenda;
                    }
                    else if (invertMode == InvertModeType.InvertedImmediate)
                    {
                        entrarLong = sinalVenda;
                        entrarShort = sinalCompra;
                    }

                    string chosen = entrarLong ? "Long" : (entrarShort ? "Short" : "None");
                    if (invertMode == InvertModeType.InvertedStopEntry && (sinalCompra || sinalVenda))
                        chosen = sinalCompra ? "InvertStopEntryLong" : "InvertStopEntryShort";

                    // Garantia de decisão antes do submit
                    Audit("EntryDecision",
                        $"scheduled={entryHms} invertMode={invertMode} enterInverted={EnterInverted} useST={UseSuperTrend} stOnClose={SuperTrendOnBarClose} stReady={memoSuperTrendReady} stBull={memoSuperTrendUpTrend} stBear={memoSuperTrendDownTrend} liberarLong={liberarLong} liberarShort={liberarShort} chosen={chosen} qtyPlanned={actualContractsForDay} stopPerCt={F(stopDollarsPerContract)} atr={F(lastAtrVal, "0.000")} atrFactor={F(ATRFactor)}");

                    if (invertMode == InvertModeType.InvertedStopEntry && (sinalCompra || sinalVenda))
                    {
                        if (!invertPlanArmed && !invertStopTriggered)
                        {
                            MarketPosition planDirection = sinalCompra ? MarketPosition.Long : MarketPosition.Short;
                            double entryRef = Close[0];
                            double stopPrice = planDirection == MarketPosition.Long
                                ? entryRef - stopTicks * tickSize
                                : entryRef + stopTicks * tickSize;
                            double targetPrice = planDirection == MarketPosition.Long
                                ? entryRef + targetTicks * tickSize
                                : entryRef - targetTicks * tickSize;

                            ArmInvertPlan(tradingDay, planDirection, actualContractsForDay, stopTicks, targetTicks,
                                BreakEvenAtRR, BreakEvenLockRR, entryRef, stopPrice, targetPrice);
                        }

                        tradedToday = true;
                        lastTradeDate = tradingDay;
                    }
                    else if (entrarLong)
                    {
                        Audit("EntrySubmit", $"side=Long qty={actualContractsForDay} signal=AutoLong");
                        EnterLong(actualContractsForDay, "AutoLong");
                        contextoHojeIsLong = true;
                        tradedToday = true;
                        lastTradeDate = tradingDay;
                    }
                    else if (entrarShort)
                    {
                        Audit("EntrySubmit", $"side=Short qty={actualContractsForDay} signal=AutoShort");
                        EnterShort(actualContractsForDay, "AutoShort");
                        contextoHojeIsShort = true;
                        tradedToday = true;
                        lastTradeDate = tradingDay;
                    }
                    else
                    {
                    }
                }
            }

            if (Position.MarketPosition == MarketPosition.Flat)
            {
                dayStatus = tradedToday ? "Closed" : "Waiting";
            }
            else
            {
                dayStatus = "Open";
                dayQtyCache = Math.Abs(Position.Quantity);
            }

            if (Position != null && Position.MarketPosition != MarketPosition.Flat)
                EnsureBracketAlive("OnBarUpdate", "MissingOrDead");

            PublishSnapshotHeartbeat("OnBarUpdate");
        }

        protected override void OnPositionUpdate(Position position, double averagePrice, int quantity, MarketPosition marketPosition)
        {
            if (position.Account != Account || position.Instrument != Instrument)
                return;

            DateTime tradingDay = GetTradingDay(Times[0][0]);

            if (marketPosition == MarketPosition.Flat)
            {
                bool drawn = false;
                string exitReason = "Unknown";

                if (ordemTPLong != null && ordemTPLong.OrderState == OrderState.Filled)
                {
                    DrawExitSimple("TP_Long_" + CurrentBar, ordemTPLong.LimitPrice, true, "TP", TakeProfitBrush);
                    drawn = true;
                    exitReason = "TP";
                }

                if (!drawn && ordemStopLong != null && ordemStopLong.OrderState == OrderState.Filled)
                {
                    string name = ordemStopLong.Name ?? "";
                    if (name.Equals("BreakEven", StringComparison.OrdinalIgnoreCase))
                    {
                        DrawExitSimple("BE_Long_" + CurrentBar, ordemStopLong.StopPrice, true, ShortLabelText, BreakEvenBrush);
                        exitReason = "BE";
                    }
                    else if (name.Equals("StopLoss", StringComparison.OrdinalIgnoreCase))
                    {
                        DrawExitSimple("SL_Long_" + CurrentBar, ordemStopLong.StopPrice, false, "SL", StopLossBrush);
                        exitReason = "SL";
                    }
                    drawn = true;
                }

                if (!drawn && ordemTPShort != null && ordemTPShort.OrderState == OrderState.Filled)
                {
                    DrawExitSimple("TP_Short_" + CurrentBar, ordemTPShort.LimitPrice, true, "TP", TakeProfitBrush);
                    drawn = true;
                    exitReason = "TP";
                }

                if (!drawn && ordemStopShort != null && ordemStopShort.OrderState == OrderState.Filled)
                {
                    string name = ordemStopShort.Name ?? "";
                    if (name.Equals("BreakEven", StringComparison.OrdinalIgnoreCase))
                    {
                        DrawExitSimple("BE_Short_" + CurrentBar, ordemStopShort.StopPrice, true, ShortLabelText, BreakEvenBrush);
                        exitReason = "BE";
                    }
                    else if (name.Equals("StopLoss", StringComparison.OrdinalIgnoreCase))
                    {
                        DrawExitSimple("SL_Short_" + CurrentBar, ordemStopShort.StopPrice, false, "SL", StopLossBrush);
                        exitReason = "SL";
                    }
                    drawn = true;
                }

                if (exitReason == "Unknown" && autoCloseTriggeredToday)
                    exitReason = "AutoClose";

                if (exitReason == "Unknown")
                {
                    if (exitReasonHint != null && exitReasonHintTradingDay.Date == tradingDay.Date)
                        exitReason = exitReasonHint;
                }

                lastExitReason = exitReason;

                lastBracketQty = 0;
                riscoPrecoAtual = 0;
                precoEntradaAtual = 0;
                breakevenAtivado = false;
                activeEntrySignal = "";
                activeEntrySignalDay = DateTime.MinValue;
                pendingWatchdogRebuild = false;
                lastWatchdogReason = "";
                lastWatchdogContext = "";
                ordemStopLong = null;
                ordemStopShort = null;
                ordemTPLong = null;
                ordemTPShort = null;

                dayQtyCache = null;
                dayStatus = tradedToday ? "Closed" : "Waiting";

                Audit("PositionClosed", $"side={lastOpenSide} qty={lastOpenQty} avgEntry={F0(lastOpenAvg)} exitReason={exitReason} dayStatus={dayStatus}");

                exitReasonHint = null;
                exitReasonHintTradingDay = DateTime.MinValue;
                if (invertStopTriggered)
                    ClearInvertPlanSnapshot();

                PublishPanelSnapshot("OnPositionUpdate_flat");
                return;
            }

            dayStatus = "Open";
            dayQtyCache = Math.Abs(position.Quantity);

            int posQtyAbs = Math.Abs(position.Quantity);
            if (posQtyAbs <= 0) return;

            if (string.IsNullOrEmpty(activeEntrySignal))
            {
                if (invertStopTriggered)
                    activeEntrySignal = "InvertStopEntry";
                else
                    activeEntrySignal = (position.MarketPosition == MarketPosition.Long) ? "AutoLong" : "AutoShort";
                activeEntrySignalDay = tradingDay.Date;
            }

            Order stopRef = (position.MarketPosition == MarketPosition.Long) ? ordemStopLong : ordemStopShort;
            Order tpRef = (position.MarketPosition == MarketPosition.Long) ? ordemTPLong : ordemTPShort;

            bool hasStopRef = stopRef != null;
            bool hasTpRef = tpRef != null;

            bool stopBad = !IsOrderActive(stopRef) || (stopRef != null && Math.Abs(stopRef.Quantity) != posQtyAbs);
            bool tpBad = !IsOrderActive(tpRef) || (tpRef != null && Math.Abs(tpRef.Quantity) != posQtyAbs);

            bool mustRebuild =
                (posQtyAbs != lastBracketQty)
                || !hasStopRef
                || !hasTpRef
                || stopBad
                || tpBad;

            double tickSize = Instrument.MasterInstrument.TickSize;
            double stopTicks;
            double targetTicks;
            double stopDollars;
            ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);

            riscoPrecoAtual = stopTicks * tickSize;
            precoEntradaAtual = averagePrice;
            breakevenAtivado = false;

            double riskDollars = stopDollars * posQtyAbs;
            dayStopDollars = riskDollars > 0 ? riskDollars.ToString("0.00") : "-";
            double targetDollars = riskDollars * TargetFactor;
            dayTargetDollars = targetDollars > 0 ? targetDollars.ToString("0.00") : "-";
            dayBreakevenDollars = "-";

            lastOpenSide = position.MarketPosition.ToString();
            lastOpenQty = posQtyAbs;
            lastOpenAvg = averagePrice;

            Audit("PositionOpen", $"side={position.MarketPosition} qty={posQtyAbs} avg={F0(averagePrice)} ctxLong={contextoHojeIsLong} ctxShort={contextoHojeIsShort}");

            if (mustRebuild)
            {
                SubmitBracketOrders(position, averagePrice, posQtyAbs, tradingDay, stopTicks, targetTicks, stopDollars, "PositionOpen", "OnPositionUpdate", false);
            }

            PublishPanelSnapshot("OnPositionUpdate_bracket");
        }

        protected override void OnOrderUpdate(Order order, double limitPrice, double stopPrice, int quantity, int filled,
            double averageFillPrice, OrderState orderState, DateTime time, ErrorCode error, string nativeError)
        {
            if (order == null)
                return;

            if (order.Account != Account || order.Instrument != Instrument)
                return;

            string orderName = order.Name ?? string.Empty;
            bool isExit = orderName.IndexOf("StopLoss", StringComparison.OrdinalIgnoreCase) >= 0
                || orderName.IndexOf("TakeProfit", StringComparison.OrdinalIgnoreCase) >= 0
                || orderName.IndexOf("BreakEven", StringComparison.OrdinalIgnoreCase) >= 0
                || orderName.IndexOf("AutoClose", StringComparison.OrdinalIgnoreCase) >= 0;

            if (EnableTradeAuditLog && (isExit || orderState == OrderState.Rejected || orderState == OrderState.Cancelled))
            {
                Audit("OrderUpdate",
                    $"name={orderName} state={orderState} action={order.OrderAction} type={order.OrderType} qty={quantity} filled={filled} lim={F0(limitPrice)} stop={F0(stopPrice)} avgFill={F0(averageFillPrice)} fromSignal={order.FromEntrySignal} error={error} nativeError={nativeError}");
            }

            bool isBracket = order == ordemStopLong || order == ordemStopShort || order == ordemTPLong || order == ordemTPShort;
            if ((orderState == OrderState.Rejected || orderState == OrderState.Cancelled) && isBracket)
            {
                MarketPosition side = GetAuditMarketPosition();
                int qty = GetAuditQty();
                double avg = GetAuditAvg();
                double stopPriceAudit;
                double targetPriceAudit;
                GetBracketPrices(side, out stopPriceAudit, out targetPriceAudit);
                string deadMsg = FormatBracketAudit(orderState.ToString(), "OnOrderUpdate", side, qty, avg, stopPriceAudit, targetPriceAudit,
                    $"source=OnOrderUpdate name={orderName} error={error} nativeError={nativeError}");
                Audit("BracketOrderDead",
                    deadMsg);

                if (order == ordemStopLong) ordemStopLong = null;
                if (order == ordemStopShort) ordemStopShort = null;
                if (order == ordemTPLong) ordemTPLong = null;
                if (order == ordemTPShort) ordemTPShort = null;

                lastBracketQty = 0;
                pendingWatchdogRebuild = false;

                EnsureBracketAlive("OnOrderUpdate", "OrderDead");
            }

            if (pendingWatchdogRebuild && isBracket &&
                (orderState == OrderState.Accepted || orderState == OrderState.Working || orderState == OrderState.Submitted))
            {
                if (Position != null && Position.MarketPosition != MarketPosition.Flat && AreBracketOrdersActive())
                {
                    double stopPriceAudit;
                    double targetPriceAudit;
                    GetBracketPrices(Position.MarketPosition, out stopPriceAudit, out targetPriceAudit);
                    string okMsg = FormatBracketAudit(
                        string.IsNullOrWhiteSpace(lastWatchdogReason) ? "WatchdogRebuildOk" : lastWatchdogReason,
                        string.IsNullOrWhiteSpace(lastWatchdogContext) ? "OnOrderUpdate" : lastWatchdogContext,
                        Position.MarketPosition,
                        Math.Abs(Position.Quantity),
                        Position.AveragePrice,
                        stopPriceAudit,
                        targetPriceAudit);
                    Audit("BracketWatchdogRebuildOk",
                        okMsg);
                    pendingWatchdogRebuild = false;
                    lastWatchdogReason = "";
                    lastWatchdogContext = "";
                }
            }
        }

        protected override void OnExecutionUpdate(Execution execution, string executionId, double price, int quantity,
            MarketPosition marketPosition, string orderId, DateTime time)
        {
            if (execution == null || execution.Order == null)
                return;

            Order order = execution.Order;

            if (order.Account != Account || order.Instrument != Instrument)
                return;

            string orderName = order.Name ?? string.Empty;

            if (order == invertStopEntryOrder)
            {
                if (order.OrderState == OrderState.Filled || order.OrderState == OrderState.PartFilled)
                {
                    activeEntrySignal = "InvertStopEntry";
                    activeEntrySignalDay = GetTradingDay(time);
                    invertStopTriggered = true;
                    invertPlanArmed = false;
                    invertPlanBeArmed = false;
                    invertStopEntryOrder = null;

                    if (plannedDirection == MarketPosition.Long)
                    {
                        contextoHojeIsShort = true;
                        contextoHojeIsLong = false;
                    }
                    else if (plannedDirection == MarketPosition.Short)
                    {
                        contextoHojeIsLong = true;
                        contextoHojeIsShort = false;
                    }

                    Audit("InvertStopTriggered",
                        $"dir={plannedDirection} execId={executionId} qty={quantity} price={F0(price)}");
                }
                else if (order.OrderState == OrderState.Cancelled || order.OrderState == OrderState.Rejected)
                {
                    DateTime tradingDay = GetTradingDay(time);
                    Audit("InvertPlanCancelled_EOD",
                        $"td={tradingDay:yyyy-MM-dd} state={order.OrderState} execId={executionId}");
                    CancelInvertPlan("EOD", tradingDay);
                }
                return;
            }

            if (orderName.Equals("AutoLong", StringComparison.OrdinalIgnoreCase)
                || orderName.Equals("AutoShort", StringComparison.OrdinalIgnoreCase))
            {
                if (order.OrderState == OrderState.Filled || order.OrderState == OrderState.PartFilled)
                {
                    activeEntrySignal = orderName;
                    activeEntrySignalDay = GetTradingDay(time);
                }
            }

            bool isStop = orderName.Equals("StopLoss", StringComparison.OrdinalIgnoreCase)
                || orderName.Equals("BreakEven", StringComparison.OrdinalIgnoreCase);
            bool isTp = orderName.Equals("TakeProfit", StringComparison.OrdinalIgnoreCase);

            if (!isStop && !isTp)
                return;

            if (order.OrderState == OrderState.Rejected || order.OrderState == OrderState.Cancelled)
            {
                MarketPosition side = GetAuditMarketPosition();
                int qty = GetAuditQty();
                double avg = GetAuditAvg();
                double stopPriceAudit;
                double targetPriceAudit;
                GetBracketPrices(side, out stopPriceAudit, out targetPriceAudit);
                string deadMsg = FormatBracketAudit(order.OrderState.ToString(), "OnExecutionUpdate", side, qty, avg, stopPriceAudit, targetPriceAudit,
                    $"name={orderName} execId={executionId} qtyExec={quantity} priceExec={F0(price)}");
                Audit("BracketOrderDead",
                    deadMsg);

                if (order == ordemStopLong) ordemStopLong = null;
                if (order == ordemStopShort) ordemStopShort = null;
                if (order == ordemTPLong) ordemTPLong = null;
                if (order == ordemTPShort) ordemTPShort = null;

                lastBracketQty = 0;
                pendingWatchdogRebuild = false;

                PublishPanelSnapshot("OnExecutionUpdate_dead");
                EnsureBracketAlive("OnExecutionUpdate", "OrderDead");
            }
        }

        private void AplicarBreakEvenSeAtingiuRR()
        {
            double high = High[0];
            double low = Low[0];

            DateTime td = GetTradingDay(Times[0][0]);
            string fromSignal = GetActiveEntrySignal(td);
            if (string.IsNullOrEmpty(fromSignal))
                fromSignal = Position.MarketPosition == MarketPosition.Long ? "AutoLong" : "AutoShort";

            double effectiveAtRR = GetEffectiveBreakEvenAtRR();
            double effectiveLockRR = GetEffectiveBreakEvenLockRR();

            if (Position.MarketPosition == MarketPosition.Long && ordemStopLong != null && !breakevenAtivado && effectiveAtRR > 0 && effectiveLockRR > 0)
            {
                double trigger = precoEntradaAtual + riscoPrecoAtual * effectiveAtRR;

                if (high >= trigger)
                {
                    double novoStop = precoEntradaAtual + riscoPrecoAtual * effectiveLockRR;
                    double maxStop = precoEntradaAtual + riscoPrecoAtual * TargetFactor;
                    if (novoStop > maxStop) novoStop = maxStop;

                    int qty = Math.Abs(Position.Quantity) > 0 ? Math.Abs(Position.Quantity) : Math.Abs(ordemStopLong.Quantity);
                    double tickSize = Instrument.MasterInstrument.TickSize;

                    try { CancelOrder(ordemStopLong); } catch { }

                    double bid = 0;
                    double ask = 0;
                    bool hasQuotes = false;

                    try
                    {
                        bid = GetCurrentBid();
                        ask = GetCurrentAsk();
                        hasQuotes = (bid > 0 && ask > 0);
                    }
                    catch
                    {
                        hasQuotes = false;
                    }

                    if (hasQuotes)
                    {
                        double originalStop = novoStop;

                        if (novoStop >= bid)
                            novoStop = bid - tickSize;

                        if (Math.Abs(originalStop - novoStop) > 0)
                        {
                            Audit("BreakEvenPriceAdjusted",
                                $"side=Long bid={F0(bid)} ask={F0(ask)} newStop={F0(novoStop)}");
                        }
                    }

                    ordemStopLong = ExitLongStopMarket(0, true, qty, novoStop, "BreakEven", fromSignal);
                    breakevenAtivado = true;

                    double locked = ComputeRiskDollars(precoEntradaAtual, novoStop, Math.Abs(qty));
                    dayBreakevenDollars = locked.ToString("0.00");

                    exitReasonHint = "BE";
                    exitReasonHintTradingDay = GetTradingDay(Times[0][0]);

                    Audit("BreakEvenTriggered", $"side=Long trigger={F0(trigger)} entry={F0(precoEntradaAtual)} riskPx={F(riscoPrecoAtual)} newStop={F0(novoStop)} lockedDollars={F0(locked)} rrTrigger={F(effectiveAtRR)} rrLock={F(effectiveLockRR)}");

                    PublishPanelSnapshot("BreakEven_Long");
                }
            }
            else if (Position.MarketPosition == MarketPosition.Short && ordemStopShort != null && !breakevenAtivado && effectiveAtRR > 0 && effectiveLockRR > 0)
            {
                double trigger = precoEntradaAtual - riscoPrecoAtual * effectiveAtRR;

                if (low <= trigger)
                {
                    double novoStop = precoEntradaAtual - riscoPrecoAtual * effectiveLockRR;
                    double minStop = precoEntradaAtual - riscoPrecoAtual * TargetFactor;
                    if (novoStop < minStop) novoStop = minStop;

                    int qty = Math.Abs(Position.Quantity) > 0 ? Math.Abs(Position.Quantity) : Math.Abs(ordemStopShort.Quantity);
                    double tickSize = Instrument.MasterInstrument.TickSize;

                    try { CancelOrder(ordemStopShort); } catch { }

                    double bid = 0;
                    double ask = 0;
                    bool hasQuotes = false;

                    try
                    {
                        bid = GetCurrentBid();
                        ask = GetCurrentAsk();
                        hasQuotes = (bid > 0 && ask > 0);
                    }
                    catch
                    {
                        hasQuotes = false;
                    }

                    if (hasQuotes)
                    {
                        double originalStop = novoStop;

                        if (novoStop <= ask)
                            novoStop = ask + tickSize;

                        if (Math.Abs(originalStop - novoStop) > 0)
                        {
                            Audit("BreakEvenPriceAdjusted",
                                $"side=Short bid={F0(bid)} ask={F0(ask)} newStop={F0(novoStop)}");
                        }
                    }

                    ordemStopShort = ExitShortStopMarket(0, true, qty, novoStop, "BreakEven", fromSignal);
                    breakevenAtivado = true;

                    double locked = ComputeRiskDollars(precoEntradaAtual, novoStop, Math.Abs(qty));
                    dayBreakevenDollars = locked.ToString("0.00");

                    exitReasonHint = "BE";
                    exitReasonHintTradingDay = GetTradingDay(Times[0][0]);

                    Audit("BreakEvenTriggered", $"side=Short trigger={F0(trigger)} entry={F0(precoEntradaAtual)} riskPx={F(riscoPrecoAtual)} newStop={F0(novoStop)} lockedDollars={F0(locked)} rrTrigger={F(effectiveAtRR)} rrLock={F(effectiveLockRR)}");

                    PublishPanelSnapshot("BreakEven_Short");
                }
            }
        }

        private bool IsOrderActive(Order order)
        {
            if (order == null) return false;

            return order.OrderState == OrderState.Working
                || order.OrderState == OrderState.Accepted
                || order.OrderState == OrderState.Submitted
                || order.OrderState == OrderState.PartFilled;
        }

        private double GetEffectiveBreakEvenAtRR()
        {
            return invertStopTriggered ? plannedBreakEvenAtRR : BreakEvenAtRR;
        }

        private double GetEffectiveBreakEvenLockRR()
        {
            return invertStopTriggered ? plannedBreakEvenLockRR : BreakEvenLockRR;
        }

        private bool IsUsaDst(DateTime dataBrasilia)
        {
            TimeZoneInfo eastern = GetUsEasternTimeZone();
            if (eastern == null) return false;

            DateTime nyTime = ConvertToUsEastern(dataBrasilia);
            return eastern.IsDaylightSavingTime(nyTime);
        }
