        private void MarkBracketBroken(string reason, string source, string extra = "")
        {
            if (bracketCycleId == 0 || cycleSide == MarketPosition.Flat)
                return;

            if (lastBracketBrokenCycleId == bracketCycleId && string.Equals(lastBracketBrokenReason, reason, StringComparison.OrdinalIgnoreCase))
                return;

            lastBracketBrokenCycleId = bracketCycleId;
            lastBracketBrokenReason = reason;

            string suffix = string.IsNullOrWhiteSpace(extra) ? "" : $" {extra}";
            Log("BRACKET_BROKEN",
                $"cycleId={bracketCycleId} side={cycleSide} qty={cycleQty} reason={reason} source={source}{suffix} mode={GetModeTag()} env={GetEnvTag()}");

            bracketConfirmed = false;
            stopWorking = false;
            targetWorking = false;
            bracketCreateArmed = true;

            bool stopMissing = cycleSide == MarketPosition.Long ? !IsOrderActive(ordemStopLong) : !IsOrderActive(ordemStopShort);
            if (stopMissing && breakEvenAppliedCycleId == bracketCycleId)
            {
                breakEvenApplied = true;
                breakEvenArmed = false;
            }
        }

        private void UpdateBracketConfirmation(Order order, OrderState orderState, string source)
        {
            if (order == null)
                return;

            bool isStop = order == ordemStopLong || order == ordemStopShort;
            bool isTarget = order == ordemTPLong || order == ordemTPShort;
            if (!isStop && !isTarget)
                return;

            bool seenSubmitted = orderState == OrderState.Submitted
                || orderState == OrderState.Accepted
                || orderState == OrderState.Working
                || orderState == OrderState.PartFilled;
            bool seenWorkingNow = orderState == OrderState.Accepted
                || orderState == OrderState.Working
                || orderState == OrderState.PartFilled;

            if (isStop)
            {
                if (seenSubmitted) stopSeenSubmitted = true;
                if (seenWorkingNow) stopSeenWorking = true;
                stopWorking = seenWorkingNow;
            }

            if (isTarget)
            {
                if (seenSubmitted) targetSeenSubmitted = true;
                if (seenWorkingNow) targetSeenWorking = true;
                targetWorking = seenWorkingNow;
            }

            bool hasEvidence = stopSeenSubmitted && targetSeenSubmitted && stopSeenWorking && targetSeenWorking;
            if (!bracketConfirmed && hasEvidence)
            {
                bracketConfirmed = true;
                bracketCreateArmed = false;
                bracketBarRetryArmed = false;
                    double stopPriceAudit;
                double targetPriceAudit;
                GetBracketPrices(cycleSide, out stopPriceAudit, out targetPriceAudit);
                Log("BRACKET_CONFIRMED",
                    $"cycleId={bracketCycleId} stop={F0(stopPriceAudit)} target={F0(targetPriceAudit)} source={source} mode={GetModeTag()} env={GetEnvTag()}");
                if (attemptsTick > 0)
                    Log("BRACKET_RT_TICK_SUCCESS", $"cycleId={bracketCycleId} attemptsTick={attemptsTick} attemptsBar={attemptsBar}");
                if (attemptsBar > 0)
                    Log("BRACKET_BAR_SUCCESS", $"cycleId={bracketCycleId} attemptsBar={attemptsBar}");
            }
        }

        private void EnsureCycleSynced(Position position, double averagePrice)
        {
            if (position == null || position.MarketPosition == MarketPosition.Flat)
                return;

            int posQtyAbs = Math.Abs(position.Quantity);
            double stopTicks;
            double targetTicks;
            double stopDollars;
            ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);

            if (cycleSide == MarketPosition.Flat || cycleQty == 0 || cycleSide != position.MarketPosition)
            {
                StartBracketCycle(position, averagePrice, posQtyAbs, stopTicks);
                return;
            }

            if (cycleQty != posQtyAbs)
            {
                MarkBracketBroken("QTY_MISMATCH", "CycleSync", $"posQty={posQtyAbs}");
                StartBracketCycle(position, averagePrice, posQtyAbs, stopTicks);
            }
        }

        private bool IsBracketAttemptEligible(DateTime nowUtc)
        {
            if (bracketNextEligibleAttemptUtc != Core.Globals.MinDate && nowUtc < bracketNextEligibleAttemptUtc)
                return false;

            return true;
        }

        private void ScheduleBracketAttemptCooldown(DateTime nowUtc, TimeSpan interval)
        {
            bracketNextEligibleAttemptUtc = nowUtc.Add(interval);
            lastBracketCreateAttemptUtc = nowUtc;
        }
        private void AttemptRealtimeLiveBracketCreate(Position position, double averagePrice, string reason)
        {
            if (!IsRealtimeLive() || !IsHedgeActive())
                return;

            if (IsHedgeBracketProtectionRequired())
                bracketCreateArmed = true;

            if (!bracketCreateArmed || bracketConfirmed)
                return;

            if (position == null || position.MarketPosition == MarketPosition.Flat)
                return;

            int posQtyAbs = Math.Abs(position.Quantity);
            if (posQtyAbs <= 0)
                return;

            if (cycleQty != posQtyAbs)
            {
                MarkBracketBroken("QTY_MISMATCH", "BracketCreate", $"posQty={posQtyAbs}");
                return;
            }

            var nowUtc = DateTime.UtcNow;

            if (!IsBracketAttemptEligible(nowUtc))
                return;

            if ((nowUtc - bracketTickWindowStartUtc) > BracketTickWindow || attemptsTick >= BracketTickMaxAttempts)
            {
                bracketBarRetryArmed = true;
                bracketCreateArmed = false;
                Log("BRACKET_RT_TICK_FAIL_ESCALATE",
                    $"cycleId={bracketCycleId} attemptsTick={attemptsTick} windowMs={(int)BracketTickWindow.TotalMilliseconds} reason={reason} mode={GetModeTag()} env={GetEnvTag()}");
                return;
            }

            bracketCreateAttempts++;
            attemptsTick++;
            ScheduleBracketAttemptCooldown(nowUtc, BracketTickMinInterval);

            double stopTicks;
            double targetTicks;
            double stopDollars;
            ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);

            DateTime tradingDay = GetTradingDay(GetSafeTime());
            SubmitBracketOrders(position, averagePrice, posQtyAbs, tradingDay, stopTicks, targetTicks, stopDollars, reason, "RealtimeLiveTick", false);
        }

        private bool ShouldStartBarRetryWindow()
        {
            if (cycleFillAtUtc == Core.Globals.MinDate)
                return false;

            return CurrentBar > cycleFillBarNumber;
        }

        private void TryBracketBarCheckpoint(DateTime barTime)
        {
            _ = barTime;

            if (!IsRealtimeLive() || !IsHedgeActive())
                return;

            if (IsHedgeBracketProtectionRequired())
                bracketCreateArmed = true;

            if (!bracketBarRetryArmed || bracketConfirmed)
                return;

            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return;

            if (!ShouldStartBarRetryWindow())
                return;

            if (lastBracketBarCheck == CurrentBar)
                return;

            lastBracketBarCheck = CurrentBar;

            bool hasStop = Position.MarketPosition == MarketPosition.Long
                ? IsOrderLiveOrPending(ordemStopLong)
                : IsOrderLiveOrPending(ordemStopShort);
            bool hasTarget = Position.MarketPosition == MarketPosition.Long
                ? IsOrderLiveOrPending(ordemTPLong)
                : IsOrderLiveOrPending(ordemTPShort);

            int barsSinceFill = cycleFillBarNumber >= 0 ? Math.Max(0, CurrentBar - cycleFillBarNumber) : 0;

            if (hasStop && hasTarget)
                return;

            if (attemptsBar >= BracketBarMaxRetries)
            {
                Log("BRACKET_BAR_FAIL_ESCALATE",
                    $"cycleId={bracketCycleId} attemptsBar={attemptsBar} barIndexSinceFill={barsSinceFill} reason=MAX_BARS mode={GetModeTag()} env={GetEnvTag()}");
                TryHardRebuildBracket("BAR_RETRY_EXHAUSTED", "OnBarUpdate");
                return;
            }

            DateTime nowUtc = DateTime.UtcNow;
            if (!IsBracketAttemptEligible(nowUtc))
                return;

            attemptsBar++;
            bracketCreateAttempts++;
            ScheduleBracketAttemptCooldown(nowUtc, TimeSpan.FromSeconds(30));
            double stopTicks;
            double targetTicks;
            double stopDollars;
            ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);

            DateTime tradingDay = GetTradingDay(GetSafeTime());
            SubmitBracketOrders(Position, Position.AveragePrice, Math.Abs(Position.Quantity), tradingDay, stopTicks, targetTicks, stopDollars, "RT_LIVE_BAR", "OnBarUpdate", false);
        }

        private void TryHardRebuildBracket(string reason, string source)
        {
            if (!IsRealtimeLive() || !IsHedgeActive())
                return;

            if (attemptsRebuild >= BracketRebuildMaxAttempts)
            {
                EnterSafeMode("BRACKET_PERSISTENT_FAILURE", source);
                return;
            }

            DateTime nowUtc = DateTime.UtcNow;
            if (!IsBracketAttemptEligible(nowUtc))
                return;

            attemptsRebuild++;
            bracketCreateAttempts++;
            ScheduleBracketAttemptCooldown(nowUtc, TimeSpan.FromSeconds(1));

            Log("BRACKET_HARD_REBUILD_START",
                $"cycleId={bracketCycleId} attemptRebuild={attemptsRebuild} reason={reason} source={source} mode={GetModeTag()} env={GetEnvTag()}");

            ordemStopLong = null;
            ordemStopShort = null;
            ordemTPLong = null;
            ordemTPShort = null;
            stopWorking = false;
            targetWorking = false;
            stopSeenSubmitted = false;
            targetSeenSubmitted = false;
            stopSeenWorking = false;
            targetSeenWorking = false;
            bracketConfirmed = false;
            bracketCreateArmed = false;
            bracketBarRetryArmed = true;

            double stopTicks;
            double targetTicks;
            double stopDollars;
            ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);

            DateTime tradingDay = GetTradingDay(GetSafeTime());
            SubmitBracketOrders(Position, Position.AveragePrice, Math.Abs(Position.Quantity), tradingDay, stopTicks, targetTicks, stopDollars, reason, source, true);
            Log("BRACKET_HARD_REBUILD_RESULT",
                $"cycleId={bracketCycleId} attemptRebuild={attemptsRebuild} result=SUBMITTED mode={GetModeTag()} env={GetEnvTag()}");
        }

        private void EvaluateSafeModeBracketRecovery()
        {
            if (!IsRealtimeLive() || !IsHedgeActive())
                return;

            if (!safeModeEnabled)
                return;

            if (safeModeReason != "BRACKET_PERSISTENT_FAILURE")
                return;

            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return;

            DateTime nowUtc = DateTime.UtcNow;
            if (lastSafeModeBracketAttemptUtc != Core.Globals.MinDate && (nowUtc - lastSafeModeBracketAttemptUtc) < BracketSafeModeRetryCooldown)
                return;

            lastSafeModeBracketAttemptUtc = nowUtc;
            Log("SAFE_MODE_STATUS",
                $"cycleId={bracketCycleId} pos={Position.MarketPosition} bracketConfirmed={bracketConfirmed} reason={safeModeReason} retryCooldownSec={(int)BracketSafeModeRetryCooldown.TotalSeconds}");
            TryHardRebuildBracket("SAFE_MODE_PERIODIC_RETRY", "SafeMode");
        }

        private void ApplyRealtimeLiveBreakEven(double lastPrice)
        {
            if (!breakEvenArmed || breakEvenApplied || breakEvenAppliedCycleId == bracketCycleId)
                return;

            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return;

            if (cycleSide == MarketPosition.Flat || cycleQty == 0)
                return;

            double effectiveAtRR = GetEffectiveBreakEvenAtRR();
            double effectiveLockRR = GetEffectiveBreakEvenLockRR();
            if (effectiveAtRR <= 0 || effectiveLockRR <= 0)
                return;

            if (frozenEntryPrice <= 0)
                frozenEntryPrice = entryPrice > 0 ? entryPrice : Position.AveragePrice;

            if (frozenRiskPoints <= 0)
            {
                double stopPriceAudit;
                double targetPriceAudit;
                GetBracketPrices(cycleSide, out stopPriceAudit, out targetPriceAudit);

                double stopTicks;
                double targetTicks;
                double stopDollars;
                ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);

                if (stopPriceAudit > 0)
                {
                    frozenStopPrice = stopPriceAudit;
                    frozenRiskPoints = Math.Abs(frozenEntryPrice - frozenStopPrice);
                }
                else
                {
                    frozenRiskPoints = stopTicks * Instrument.MasterInstrument.TickSize;
                    frozenStopPrice = cycleSide == MarketPosition.Long
                        ? frozenEntryPrice - frozenRiskPoints
                        : frozenEntryPrice + frozenRiskPoints;
                }
            }

            initialRiskPoints = frozenRiskPoints;
            beTriggerPrice = cycleSide == MarketPosition.Long
                ? frozenEntryPrice + frozenRiskPoints * effectiveAtRR
                : frozenEntryPrice - frozenRiskPoints * effectiveAtRR;
            beStopPrice = cycleSide == MarketPosition.Long
                ? frozenEntryPrice + frozenRiskPoints * effectiveLockRR
                : frozenEntryPrice - frozenRiskPoints * effectiveLockRR;

            if (!ShouldThrottleAudit($"BE_CALC_{bracketCycleId}", 2))
            {
                Log("BE_CALC",
                    $"cycleId={bracketCycleId} side={cycleSide} entry={F0(frozenEntryPrice)} stop0={F0(frozenStopPrice)} riskPx={F(frozenRiskPoints)} trigger={F0(beTriggerPrice)} stopNew={F0(beStopPrice)} mode={GetModeTag()} env={GetEnvTag()}");
            }

            bool triggerHit = cycleSide == MarketPosition.Long
                ? lastPrice >= beTriggerPrice
                : lastPrice <= beTriggerPrice;

            if (!triggerHit)
                return;

            Log("BE_TRIGGER_HIT",
                $"cycleId={bracketCycleId} side={cycleSide} trigger={F0(beTriggerPrice)} priceNow={F0(lastPrice)} mode={GetModeTag()} env={GetEnvTag()}");

            Order stopOrder = cycleSide == MarketPosition.Long ? ordemStopLong : ordemStopShort;
            if (!IsOrderActive(stopOrder))
            {
                MarkBracketBroken("STOP_MISSING_BE", "RealtimeLive", $"priceNow={F0(lastPrice)}");
                return;
            }

            int qty = Math.Abs(Position.Quantity) > 0 ? Math.Abs(Position.Quantity) : Math.Abs(stopOrder.Quantity);
            double tickSize = Instrument.MasterInstrument.TickSize;

            double bid = 0;
            double ask = 0;
            bool hasQuotes = false;
            try
            {
                bid = GetCurrentBid();
                ask = GetCurrentAsk();
                hasQuotes = (bid > 0 && ask > 0);
            }
            catch
            {
                hasQuotes = false;
            }

            double newStop = beStopPrice;
            if (hasQuotes)
            {
                if (cycleSide == MarketPosition.Long && newStop >= bid)
                    newStop = bid - tickSize;
                if (cycleSide == MarketPosition.Short && newStop <= ask)
                    newStop = ask + tickSize;
            }

            bool changeOk = TryChangeStopOrder(stopOrder, qty, newStop, "BreakEvenAdjust", "RealtimeLive");
            if (!changeOk)
            {
                BracketLog("DENY_CHANGE", "BreakEvenAdjust", "RealtimeLive", $"side={cycleSide}");
                BeginBracketModification("CancelOrder", "BreakEvenAdjust");
                try { CancelOrder(stopOrder); } catch { }

                string fromSignal = GetActiveEntrySignal(GetTradingDay(GetSafeTime()));
                if (string.IsNullOrEmpty(fromSignal))
                    fromSignal = cycleSide == MarketPosition.Long ? "AutoLong" : "AutoShort";

                if (cycleSide == MarketPosition.Long)
                    ordemStopLong = ExitLongStopMarket(0, true, qty, newStop, "BreakEven", fromSignal);
                else
                    ordemStopShort = ExitShortStopMarket(0, true, qty, newStop, "BreakEven", fromSignal);
            }

            breakEvenApplied = true;
            breakEvenAppliedCycleId = bracketCycleId;
            breakEvenArmed = false;
            breakevenAtivado = true;
            stopWorking = false;

            double locked = ComputeRiskDollars(entryPrice, newStop, Math.Abs(qty));
            dayBreakevenDollars = locked.ToString("0.00");
            exitReasonHint = "BE";
            exitReasonHintTradingDay = GetTradingDay(Times[0][0]);

            Log("BE_APPLIED",
                $"cycleId={bracketCycleId} trigger={F0(beTriggerPrice)} stopNew={F0(newStop)} priceNow={F0(lastPrice)} mode={GetModeTag()} env={GetEnvTag()}");

            PublishPanelSnapshot("BreakEven_RT");
        }

        private void SetBracketState(BracketState nextState, string reason, string source)
        {
            if (bracketState == nextState)
                return;

            bracketState = nextState;
            bracketStateChangedUtc = DateTime.UtcNow;
            BracketLog("STATE_CHANGE", reason, source, $"newState={nextState}");
        }

        private void UpdateBracketState(string reason, string source)
        {
            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
            {
                SetBracketState(BracketState.Closed, reason, source);
                return;
            }

            if (AreBracketOrdersActive())
            {
                SetBracketState(BracketState.Active, reason, source);
                return;
            }

            if (bracketState == BracketState.None || bracketState == BracketState.Closed)
                SetBracketState(BracketState.Pending, reason, source);
        }

        private bool CanCancelBracket(string reason, string source, bool force)
        {
            if (force)
                return true;

            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return true;

            if (bracketState == BracketState.Active || bracketState == BracketState.Locked)
            {
                BracketLog("DENY_CANCEL", reason, source);
                return false;
            }

            return true;
        }

        private bool TryCancelBracketOrder(Order order, string reason, string source, bool force = false)
        {
            if (order == null)
                return false;

            if (!CanCancelBracket(reason, source, force))
                return false;

            BracketLog("CANCEL", reason, source, $"order={order.Name} state={order.OrderState}");
            BeginBracketModification(reason, source);
            try { CancelOrder(order); } catch { }
            return true;
        }

        private bool TryChangeStopOrder(Order order, int qty, double newStop, string reason, string source)
        {
            if (order == null)
                return false;

            if (!IsOrderActive(order))
            {
                BracketLog("DENY_CHANGE", reason, source, $"order={order.Name} state={order.OrderState}");
                return false;
            }

            BracketLog("CHANGE_STOP", reason, source, $"order={order.Name} qty={qty} newStop={F0(newStop)}");
            BeginBracketModification(reason, source);
            try
            {
                ChangeOrder(order, qty, order.LimitPrice, newStop);
                return true;
            }
            catch
            {
                return false;
            }
        }

