        private void CaptureOverlayEnableLatch(string source, DateTime nowLocal)
        {
            DateTime td = GetTradingDay(nowLocal);

            if (overlayEnableTradingDay.Date == td.Date && overlayEnableTimeLocal != Core.Globals.MinDate)
                return;

            overlayEnableTimeLocal = nowLocal;
            overlayEnableTradingDay = td.Date;
            overlayPenaltyArmedToday = IsWithinOverlayWindow(nowLocal.TimeOfDay);

            Log("OverlayLatch",
                "CAPTURE td=" + td.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                + " enable=" + nowLocal.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
                + " armed=" + overlayPenaltyArmedToday
                + " source=" + source);
        }

