            else if (State == State.Configure)
            {
                if (DefaultMode)
                    ApplyDefaultModel();
                else if (HedgeMode)
                    ApplyHedgeModel();

                hedgeModelFrozen = true;
                defaultModelFrozen = true;

                if (ATRTimeFrame > 0)
                {
                    AddDataSeries(Data.BarsPeriodType.Minute, ATRTimeFrame);
                }
                if (STTimeFrame > 0)
                {
                    AddDataSeries(Data.BarsPeriodType.Minute, STTimeFrame);
                }
            }
            else if (State == State.DataLoaded)
            {
                isStrategyActive = true;
                sessionIterator = new SessionIterator(Bars);

                chartToken = (ChartControl != null)
                    ? RuntimeHelpers.GetHashCode(ChartControl).ToString("X")
                    : "HEADLESS";

                cacheKey = GetCacheKey();
                auditLogPath = IOPath.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "NinjaTrader 8", "logs", "hvo_audit.log");

                if (ChartControl != null)
                {
                    panelHelper = new HVO_PanelHelper(EnablePanelDiagnostics)
                    {
                        LogAction = msg => Print(msg),
                        CacheKey = cacheKey
                    };
                    panelHelper.Init(ChartControl);
                }
                riskOverlayHelper = new RiskOverlayHelper();

            }
            else if (State == State.Realtime)
            {
                isStrategyActive = true;
                lastTradesCount = SystemPerformance.AllTrades.Count;
                PublishPanelSnapshot("StateRealtime");
                riskOverlayHelper?.TryShow(this);
            }
            else if (State == State.Terminated)
            {
                if (terminatedHandled)
                    return;
                terminatedHandled = true;

                isStrategyActive = false;
                PublishPanelOffSnapshot("Terminated");
                try { panelHelper?.Dispose(); panelHelper = null; } catch { }
                riskOverlayHelper?.Remove();
            }
        }

