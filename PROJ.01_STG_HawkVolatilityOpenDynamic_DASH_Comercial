        private bool IsBracketMissingOrDead()
        {
            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return false;

            int posQtyAbs = Math.Abs(Position.Quantity);
            if (posQtyAbs <= 0)
                return true;

            if (Position.AveragePrice <= 0)
                return true;

            bool isLong = Position.MarketPosition == MarketPosition.Long;
            Order stop = isLong ? ordemStopLong : ordemStopShort;
            Order tp = isLong ? ordemTPLong : ordemTPShort;

            if (stop == null || tp == null)
                return true;

            if (stop.OrderState == OrderState.Cancelled || stop.OrderState == OrderState.Rejected)
                return true;
            if (tp.OrderState == OrderState.Cancelled || tp.OrderState == OrderState.Rejected)
                return true;

            bool stopActive = IsOrderActive(stop);
            bool tpActive = IsOrderActive(tp);

            if (!stopActive || !tpActive)
                return true;

            if (Math.Abs(stop.Quantity) != posQtyAbs || Math.Abs(tp.Quantity) != posQtyAbs)
                return true;

            if (lastBracketQty != posQtyAbs)
                return true;

            return false;
        }

        private bool AreBracketOrdersActive()
        {
            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return false;

            bool isLong = Position.MarketPosition == MarketPosition.Long;
            Order stop = isLong ? ordemStopLong : ordemStopShort;
            Order tp = isLong ? ordemTPLong : ordemTPShort;

            return IsOrderActive(stop) && IsOrderActive(tp);
        }

        private void ComputeBracketMetrics(out double stopTicks, out double targetTicks, out double stopDollars)
        {
            double tickSize = Instrument.MasterInstrument.TickSize;
            double tickValue = Instrument.MasterInstrument.PointValue * tickSize;

            if (invertStopTriggered && plannedStopTicks > 0 && plannedTargetTicks > 0)
            {
                stopTicks = plannedStopTicks;
                targetTicks = plannedTargetTicks;
                stopDollars = stopTicks * tickValue;
            }
            else
            {
                if (UseStopATR && lastAtrVal > 0)
                {
                    stopDollars = lastAtrVal * ATRFactor;
                }
                else
                {
                    stopDollars = StopPerContract;
                }

                stopTicks = Math.Round(stopDollars / tickValue, 0);
                targetTicks = stopTicks * TargetFactor;
            }
        }

        private void SubmitBracketOrders(Position position, double averagePrice, int posQtyAbs, DateTime tradingDay, double stopTicks,
            double targetTicks, double stopDollars, string reason, string context, bool isWatchdog)
        {
            try { if (ordemStopLong != null) CancelOrder(ordemStopLong); } catch { }
            try { if (ordemStopShort != null) CancelOrder(ordemStopShort); } catch { }
            try { if (ordemTPLong != null) CancelOrder(ordemTPLong); } catch { }
            try { if (ordemTPShort != null) CancelOrder(ordemTPShort); } catch { }

            double tickSize = Instrument.MasterInstrument.TickSize;
            double stopPrice = 0, targetPrice = 0;
            double bid = 0;
            double ask = 0;
            bool hasQuotes = false;

            try
            {
                bid = GetCurrentBid();
                ask = GetCurrentAsk();
                hasQuotes = (bid > 0 && ask > 0);
            }
            catch
            {
                hasQuotes = false;
            }

            bool bracketSubmitted = false;
            string fromSignal = GetActiveEntrySignal(tradingDay);

            if (position.MarketPosition == MarketPosition.Long)
            {
                stopPrice = averagePrice - stopTicks * tickSize;
                targetPrice = averagePrice + targetTicks * tickSize;

                if (hasQuotes)
                {
                    double originalStop = stopPrice;
                    double originalTarget = targetPrice;

                    if (stopPrice >= bid) stopPrice = bid - tickSize;
                    if (targetPrice <= ask) targetPrice = ask + tickSize;

                    if (Math.Abs(originalStop - stopPrice) > 0 || Math.Abs(originalTarget - targetPrice) > 0)
                    {
                        string adjustMsg = FormatBracketAudit(reason, context, MarketPosition.Long, posQtyAbs, averagePrice, stopPrice, targetPrice,
                            $"bid={F0(bid)} ask={F0(ask)} originalStop={F0(originalStop)} originalTarget={F0(originalTarget)}");
                        Audit("BracketPriceAdjusted",
                            adjustMsg);
                    }
                }

                string fe = string.IsNullOrEmpty(fromSignal) ? "AutoLong" : fromSignal;
                ordemStopLong = ExitLongStopMarket(0, true, posQtyAbs, stopPrice, "StopLoss", fe);
                ordemTPLong = ExitLongLimit(0, true, posQtyAbs, targetPrice, "TakeProfit", fe);
                ordemStopShort = null;
                ordemTPShort = null;
                bracketSubmitted = true;
            }
            else if (position.MarketPosition == MarketPosition.Short)
            {
                stopPrice = averagePrice + stopTicks * tickSize;
                targetPrice = averagePrice - targetTicks * tickSize;

                if (hasQuotes)
                {
                    double originalStop = stopPrice;
                    double originalTarget = targetPrice;

                    if (stopPrice <= ask) stopPrice = ask + tickSize;
                    if (targetPrice >= bid) targetPrice = bid - tickSize;

                    if (Math.Abs(originalStop - stopPrice) > 0 || Math.Abs(originalTarget - targetPrice) > 0)
                    {
                        string adjustMsg = FormatBracketAudit(reason, context, MarketPosition.Short, posQtyAbs, averagePrice, stopPrice, targetPrice,
                            $"bid={F0(bid)} ask={F0(ask)} originalStop={F0(originalStop)} originalTarget={F0(originalTarget)}");
                        Audit("BracketPriceAdjusted",
                            adjustMsg);
                    }
                }

                string fe = string.IsNullOrEmpty(fromSignal) ? "AutoShort" : fromSignal;
                ordemStopShort = ExitShortStopMarket(0, true, posQtyAbs, stopPrice, "StopLoss", fe);
                ordemTPShort = ExitShortLimit(0, true, posQtyAbs, targetPrice, "TakeProfit", fe);
                ordemStopLong = null;
                ordemTPLong = null;
                bracketSubmitted = true;
            }

            if (!bracketSubmitted)
                return;

            Order stopCheck = (position.MarketPosition == MarketPosition.Long) ? ordemStopLong : ordemStopShort;
            Order tpCheck = (position.MarketPosition == MarketPosition.Long) ? ordemTPLong : ordemTPShort;

            if (IsOrderActive(stopCheck) && IsOrderActive(tpCheck))
                lastBracketQty = posQtyAbs;
            else
                lastBracketQty = 0;

            double riskDollars = stopDollars * posQtyAbs;
            double targetDollars = riskDollars * TargetFactor;
            double stopAuditPrice = position.MarketPosition == MarketPosition.Long
                ? ordemStopLong?.StopPrice ?? stopPrice
                : ordemStopShort?.StopPrice ?? stopPrice;
            double targetAuditPrice = position.MarketPosition == MarketPosition.Long
                ? ordemTPLong?.LimitPrice ?? targetPrice
                : ordemTPShort?.LimitPrice ?? targetPrice;

            if (isWatchdog)
            {
                pendingWatchdogRebuild = true;
                lastWatchdogReason = reason;
                lastWatchdogContext = context;
                string rebuildMsg = FormatBracketAudit(reason, context, position.MarketPosition, posQtyAbs, averagePrice, stopAuditPrice, targetAuditPrice,
                    $"stopTicks={stopTicks} targetTicks={targetTicks} riskDollars={F0(riskDollars)} targetDollars={F0(targetDollars)}");
                Audit("BracketWatchdogRebuildSubmitted",
                    rebuildMsg);
                return;
            }

            string bracketMsg = FormatBracketAudit(reason, context, position.MarketPosition, posQtyAbs, averagePrice, stopAuditPrice, targetAuditPrice,
                $"stopTicks={stopTicks} targetTicks={targetTicks} riskDollars={F0(riskDollars)} targetDollars={F0(targetDollars)} useATR={UseStopATR} atr={F(lastAtrVal, "0.000")} stopDollars={F0(stopDollars)}");
            Audit("BracketSet",
                bracketMsg);
        }

        private bool IsPositionClosingFinal()
        {
            if (Position == null || Position.MarketPosition == MarketPosition.Flat)
                return false;

            bool isLong = Position.MarketPosition == MarketPosition.Long;
            Order stop = isLong ? ordemStopLong : ordemStopShort;
            Order tp = isLong ? ordemTPLong : ordemTPShort;

            bool stopFinal = stop != null && (stop.OrderState == OrderState.Filled || stop.OrderState == OrderState.PartFilled);
            bool tpFinal = tp != null && (tp.OrderState == OrderState.Filled || tp.OrderState == OrderState.PartFilled);

            return stopFinal || tpFinal;
        }

        private void EnsureBracketAlive(string context, string reason)
        {
            if (!EnableBracketWatchdog) return;
            if (State != State.Realtime) return;
            if (Position == null || Position.MarketPosition == MarketPosition.Flat) return;
            if (IsPositionClosingFinal()) return;
            if (pendingWatchdogRebuild)
            {
                if (!IsBracketMissingOrDead() || !WatchdogCooldownOk())
                    return;

                pendingWatchdogRebuild = false;
            }
            if (!WatchdogCooldownOk()) return;
            if (!IsBracketMissingOrDead()) return;

            lastWatchdogAttemptUtc = DateTime.UtcNow;
            lastWatchdogPositionQty = Math.Abs(Position.Quantity);
            lastWatchdogMktPos = Position.MarketPosition;
            lastWatchdogReason = reason;
            lastWatchdogContext = context;

            DateTime tradingDay = GetTradingDay(GetSafeTime());
            if (watchdogTradingDay.Date != tradingDay.Date)
            {
                watchdogTradingDay = tradingDay.Date;
                watchdogRebuildCountToday = 0;
            }
            watchdogRebuildCountToday++;

            double bid = 0;
            double ask = 0;
            bool hasQuotes = false;
            try
            {
                bid = GetCurrentBid();
                ask = GetCurrentAsk();
                hasQuotes = (bid > 0 && ask > 0);
            }
            catch
            {
                hasQuotes = false;
            }

            if (!ShouldThrottleAudit($"WATCHDOG_{tradingDay:yyyyMMdd}", LogThrottleSeconds))
            {
                double stopPriceAudit;
                double targetPriceAudit;
                GetBracketPrices(lastWatchdogMktPos, out stopPriceAudit, out targetPriceAudit);
                string watchdogMsg = FormatBracketAudit(reason, context, lastWatchdogMktPos, lastWatchdogPositionQty, Position.AveragePrice, stopPriceAudit, targetPriceAudit,
                    $"hasQuotes={hasQuotes} bid={F0(bid)} ask={F0(ask)} lastBracketQty={lastBracketQty} rebuildCountToday={watchdogRebuildCountToday}");
                Audit("BracketWatchdogTriggered",
                    watchdogMsg);
            }

            double stopTicks;
            double targetTicks;
            double stopDollars;
            ComputeBracketMetrics(out stopTicks, out targetTicks, out stopDollars);

            if (precoEntradaAtual <= 0)
                precoEntradaAtual = Position.AveragePrice;
            if (riscoPrecoAtual <= 0)
                riscoPrecoAtual = stopTicks * Instrument.MasterInstrument.TickSize;

            lastBracketQty = 0;
            SubmitBracketOrders(Position, Position.AveragePrice, Math.Abs(Position.Quantity), tradingDay, stopTicks, targetTicks, stopDollars, reason, context, true);
        }

