        private void LogAutoCloseGate(string reason, DateTime barTime, DateTime ninjaNow, DateTime entryTimeLocal, DateTime scheduledCloseLocal, DateTime tradingDay, bool triggered, string extra = "")
        {
            if (ShouldThrottleAudit($"AUTOCLOSE_GATE_{reason}_{tradingDay:yyyyMMdd}", LogThrottleSeconds))
                return;

            string mode = IsHedgeActive() ? "Hedge" : "Default";
            string sourceTz = GetBarTimeZone()?.Id ?? "Unknown";
            var marketPosition = Position?.MarketPosition ?? MarketPosition.Flat;
            var quantity = Position?.Quantity ?? 0;
            string mainTime = "n/a";
            string autoCloseTime = "n/a";
            try { mainTime = Times[0][0].ToString("O"); } catch { }
            try
            {
                if (Times != null && Times.Length > BIP_AUTOCLOSE && Times[BIP_AUTOCLOSE] != null && Times[BIP_AUTOCLOSE].Count > 0)
                    autoCloseTime = Times[BIP_AUTOCLOSE][0].ToString("O");
            }
            catch { }
            string msg = $"reason={reason} mode={mode} entryTime={entryTimeLocal:O} scheduledClose={scheduledCloseLocal:O} ninjaNow={ninjaNow:O} triggered={triggered} state={State} bip={BarsInProgress} barTimeBip={barTime:O} ninjaNowTod={ninjaNow:HH\\:mm\\:ss} lastAutoCloseTradingDay={lastAutoCloseTradingDay:yyyy-MM-dd} tradingDay={tradingDay:yyyy-MM-dd} pos={marketPosition} qty={quantity} autoCloseSent={autoCloseExitSentToday} autoCloseSentTime={autoCloseExitSentTimeFeed:O} attemptCount={autoCloseExitAttemptCountToday} mainTime={mainTime} autoCloseTime={autoCloseTime} sourceTZ={sourceTz}";
            if (!string.IsNullOrWhiteSpace(extra))
                msg = $"{msg} {extra}";

            Log("AutoCloseDiag", msg);
        }

        private void TryAutoCloseIfScheduled(DateTime barTime)
        {
            if (!AutoCloseEnabled) return;

            DateTime ninjaNow = GetReplayNowOrFallback(barTime);
            DateTime tradingDay = Core.Globals.MinDate;
            DateTime entryTimeLocal = Core.Globals.MinDate;
            DateTime scheduledCloseLocal = Core.Globals.MinDate;
            bool wasSentToday = false;
            if (GetEffectiveInvertMode() == InvertModeType.InvertedStopEntry)
            {
                DateTime hedgeTradingDay;
                DateTime hedgeAnchorLocal;
                DateTime hedgeCutoff;
                DateTime anchorCandidateTradingDay = GetReplayTradingDayOrFallback(ninjaNow);
                if (hedgeSessionTradingDay.Date != anchorCandidateTradingDay.Date)
                {
                    DateTime anchorCandidate = BuildHedgeAnchorLocal(ninjaNow, anchorCandidateTradingDay);
                    if (ninjaNow >= anchorCandidate)
                        SetHedgeSessionAnchor(anchorCandidate, anchorCandidateTradingDay);
                }

                bool hasCutoff = TryGetHedgeCutoff(ninjaNow, out hedgeTradingDay, out hedgeAnchorLocal, out hedgeCutoff);
                if (!hasCutoff)
                {
                    if (EnableDebugLog)
                        DebugLog("AutoCloseDiag", $"mode=Hedge schedule=missing bip={BarsInProgress} barTime={barTime:O} ninjaNow={ninjaNow:O}");
                    return;
                }

                string hedgeFillText = hedgeFillTimeLocal == Core.Globals.MinDate ? "n/a" : hedgeFillTimeLocal.ToString("O");
                if (EnableDebugLog)
                {
                    string sourceTz = GetBarTimeZone()?.Id ?? "Unknown";
                    DebugLog("AutoCloseDiag", $"mode=Hedge anchor={hedgeAnchorLocal:O} cutoff={hedgeCutoff:O} hedgeFill={hedgeFillText} sourceTZ={sourceTz} bip={BarsInProgress} mainTime={Times[0][0]:O} barTime={barTime:O} ninjaNow={ninjaNow:O} tradingDay={hedgeTradingDay:yyyy-MM-dd} invertPlanArmed={invertPlanArmed} entryOrderPending={(invertStopEntryOrder != null)}");
                }

                if (ninjaNow < hedgeCutoff)
                {
                    LogAutoCloseGate("HEDGE_BEFORE_CUTOFF", barTime, ninjaNow, hedgeAnchorLocal, hedgeCutoff, hedgeTradingDay, autoCloseTriggeredToday, $"hedgeFill={hedgeFillText}");
                    return;
                }

                if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
                {
                    if (invertPlanArmed || invertStopEntryOrder != null)
                    {
                        CancelInvertPlan("EOD", hedgeTradingDay);
                        Audit("HedgeEODCancelPendingEntry", "action=CancelInvertPlan+CancelEntryOrder");
                        lastAutoCloseTradingDay = hedgeTradingDay;
                        autoCloseTriggeredToday = true;
                        LogAutoCloseGate("HEDGE_FLAT_CANCEL_PLAN", barTime, ninjaNow, hedgeAnchorLocal, hedgeCutoff, hedgeTradingDay, autoCloseTriggeredToday, $"hedgeFill={hedgeFillText}");
                    }
                    else
                    {
                        LogAutoCloseGate("HEDGE_FLAT_NO_PLAN", barTime, ninjaNow, hedgeAnchorLocal, hedgeCutoff, hedgeTradingDay, autoCloseTriggeredToday, $"hedgeFill={hedgeFillText}");
                    }

                    return;
                }

                tradingDay = hedgeTradingDay;
                entryTimeLocal = hedgeAnchorLocal;
                scheduledCloseLocal = hedgeCutoff;

                if (autoCloseAttemptTradingDay.Date != tradingDay.Date)
                {
                    autoCloseAttemptTradingDay = tradingDay;
                    autoCloseExitSentToday = false;
                    autoCloseExitSentTimeFeed = DateTime.MinValue;
                    autoCloseExitSentTradingDay = Core.Globals.MinDate;
                    autoCloseExitAttemptCountToday = 0;
                    lastAutoCloseAttemptUtc = Core.Globals.MinDate;
                    autoCloseExitSignalName = "";
                }

                if (lastAutoCloseTradingDay.Date == tradingDay.Date && (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0))
                {
                    LogAutoCloseGate("HEDGE_ALREADY_DONE_TRADINGDAY", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday, $"hedgeFill={hedgeFillText}");
                    return;
                }

                if (autoCloseExitAttemptCountToday >= AutoCloseMaxAttempts)
                {
                    lastAutoCloseTradingDay = tradingDay;
                    LogAutoCloseGate("HEDGE_EXIT_SKIP_MAX_ATTEMPTS", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday, $"maxAttempts={AutoCloseMaxAttempts} hedgeFill={hedgeFillText}");
                    return;
                }

                if (AutoCloseResendCooldownSeconds > 0 && lastAutoCloseAttemptUtc != Core.Globals.MinDate)
                {
                    var nowUtc = DateTime.UtcNow;
                    if ((nowUtc - lastAutoCloseAttemptUtc).TotalSeconds < AutoCloseResendCooldownSeconds)
                    {
                        LogAutoCloseGate("HEDGE_EXIT_RESENT_COOLDOWN", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday, $"cooldownSeconds={AutoCloseResendCooldownSeconds} hedgeFill={hedgeFillText}");
                        return;
                    }
                }

                autoCloseTriggeredToday = true;
                exitReasonHint = "AutoClose";
                exitReasonHintTradingDay = tradingDay;
                wasSentToday = autoCloseExitSentToday;

                Audit("AutoClose", $"entryTime={entryTimeLocal:HH\\:mm\\:ss} scheduledClose={scheduledCloseLocal:HH\\:mm\\:ss} hedgeFill={hedgeFillText} ninjaNow={ninjaNow:HH\\:mm\\:ss} side={Position.MarketPosition} qty={Position.Quantity} avg={F0(Position.AveragePrice)}");

                try
                {
                    Log("AutoCloseSnapshot", $"stage=PreCancel ninjaNow={ninjaNow:O} tpLong={FormatOrderSnapshot(ordemTPLong)} tpShort={FormatOrderSnapshot(ordemTPShort)} stopLong={FormatOrderSnapshot(ordemStopLong)} stopShort={FormatOrderSnapshot(ordemStopShort)}");
                    TryCancelBracketOrder(ordemTPLong, "AutoClose", "AutoClose", true);
                    TryCancelBracketOrder(ordemTPShort, "AutoClose", "AutoClose", true);
                    TryCancelBracketOrder(ordemStopLong, "AutoClose", "AutoClose", true);
                    TryCancelBracketOrder(ordemStopShort, "AutoClose", "AutoClose", true);
                    Log("AutoCloseSnapshot", $"stage=PostCancel ninjaNow={ninjaNow:O} tpLong={FormatOrderSnapshot(ordemTPLong)} tpShort={FormatOrderSnapshot(ordemTPShort)} stopLong={FormatOrderSnapshot(ordemStopLong)} stopShort={FormatOrderSnapshot(ordemStopShort)}");

                    string fromSignal = GetActiveEntrySignal(tradingDay);
                    autoCloseExitSignalName = fromSignal;

                    if (Position.MarketPosition == MarketPosition.Long && Position.Quantity > 0)
                    {
                        if (!string.IsNullOrEmpty(fromSignal))
                            ExitLong("AutoClose", fromSignal);
                        else
                            ExitLong("AutoClose");
                    }
                    else if (Position.MarketPosition == MarketPosition.Short && Position.Quantity > 0)
                    {
                        if (!string.IsNullOrEmpty(fromSignal))
                            ExitShort("AutoClose", fromSignal);
                        else
                            ExitShort("AutoClose");
                    }

                    autoCloseExitSentToday = true;
                    autoCloseExitSentTimeFeed = ninjaNow;
                    autoCloseExitSentTradingDay = tradingDay;
                    autoCloseExitAttemptCountToday++;
                    lastAutoCloseAttemptUtc = DateTime.UtcNow;
                    string action = wasSentToday ? "ExitResent" : "ExitSent";
                    Audit("AutoClose", $"action={action} side={Position.MarketPosition} qty={Position.Quantity} avg={F0(Position.AveragePrice)} attempt={autoCloseExitAttemptCountToday} fromSignal={autoCloseExitSignalName}");
                    LogAutoCloseGate(wasSentToday ? "HEDGE_EXIT_RESENT" : "HEDGE_EXIT_SENT", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday,
                        $"attempt={autoCloseExitAttemptCountToday} fromSignal={autoCloseExitSignalName} hedgeFill={hedgeFillText}");
                    PublishPanelSnapshot("AutoClose_exit_sent");
                    PublishPanelSnapshot("AutoClose");
                }
                catch (Exception ex)
                {
                    LogAutoCloseGate("HEDGE_EXIT_EXCEPTION", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday, $"error={ex.Message} hedgeFill={hedgeFillText}");
                    Log("AutoClose", $"Exception while attempting auto-close: {ex.Message}");
                }

                return;
            }

            bool hasSchedule = TryGetAutoCloseSchedule(ninjaNow, out tradingDay, out entryTimeLocal, out scheduledCloseLocal);
            if (!hasSchedule && Position != null && Position.MarketPosition != MarketPosition.Flat)
            {
                entryTimeLocal = ninjaNow;
                autoCloseEntryTimeLocal = entryTimeLocal;
                autoCloseEntryTradingDay = tradingDay;
                scheduledCloseLocal = entryTimeLocal.Add(AutoCloseMaxDuration);
                hasSchedule = true;
            }

            if (!hasSchedule)
            {
                if (EnableDebugLog)
                    DebugLog("AutoCloseDiag", $"mode={(IsHedgeActive() ? "Hedge" : "Default")} schedule=missing bip={BarsInProgress} barTime={barTime:O} ninjaNow={ninjaNow:O}");
                return;
            }

            // já executou neste trading day?
            if (autoCloseAttemptTradingDay.Date != tradingDay.Date)
            {
                autoCloseAttemptTradingDay = tradingDay;
                autoCloseExitSentToday = false;
                autoCloseExitSentTimeFeed = DateTime.MinValue;
                autoCloseExitSentTradingDay = Core.Globals.MinDate;
                autoCloseExitAttemptCountToday = 0;
                lastAutoCloseAttemptUtc = Core.Globals.MinDate;
                autoCloseExitSignalName = "";
            }

            if (EnableDebugLog)
            {
                string mode = IsHedgeActive() ? "Hedge" : "Default";
                string sourceTz = GetBarTimeZone()?.Id ?? "Unknown";
                DebugLog("AutoCloseDiag", $"mode={mode} entryTime={entryTimeLocal:O} scheduledClose={scheduledCloseLocal:O} sourceTZ={sourceTz} bip={BarsInProgress} mainTime={Times[0][0]:O} barTime={barTime:O} ninjaNow={ninjaNow:O} tradingDay={tradingDay:yyyy-MM-dd}");
            }

            TimeSpan windowDelta = ninjaNow - scheduledCloseLocal;
            if (Math.Abs(windowDelta.TotalMinutes) <= 2)
            {
                if (!ShouldThrottleAudit($"AUTOCLOSE_WINDOW_{tradingDay:yyyyMMdd}", LogThrottleSeconds))
                {
                    var marketPosition = Position?.MarketPosition ?? MarketPosition.Flat;
                    var quantity = Position?.Quantity ?? 0;
                    Log("AutoCloseWindow", $"barTime={barTime:O} ninjaNow={ninjaNow:O} scheduledClose={scheduledCloseLocal:O} bip={BarsInProgress} state={State} pos={marketPosition} qty={quantity}");
                }
            }

            DateTime snapshotStart = scheduledCloseLocal.AddMinutes(-2);
            DateTime snapshotEnd = scheduledCloseLocal.AddMinutes(AutoCloseMaxWindowMinutes);
            if (ninjaNow >= snapshotStart && ninjaNow <= snapshotEnd)
            {
                if (!ShouldThrottleAudit($"AUTOCLOSE_SNAPSHOT_{tradingDay:yyyyMMdd}", LogThrottleSeconds))
                {
                    var marketPosition = Position?.MarketPosition ?? MarketPosition.Flat;
                    var quantity = Position?.Quantity ?? 0;
                    double last = 0;
                    double pnl = 0;
                    bool hasPnl = false;
                    try { last = Closes[0][0]; } catch { }
                    try
                    {
                        if (Position != null && Position.MarketPosition != MarketPosition.Flat)
                        {
                            pnl = Position.GetUnrealizedProfitLoss(PerformanceUnit.Currency, Close[0]);
                            hasPnl = true;
                        }
                    }
                    catch { }

                    string snapshot =
                        $"ninjaNow={ninjaNow:O} scheduledClose={scheduledCloseLocal:O} state={State} bip={BarsInProgress} pos={marketPosition} qty={quantity} last={F0(last)} pnl={(hasPnl ? F0(pnl) : "n/a")} " +
                        $"tpLong={FormatOrderSnapshot(ordemTPLong)} tpShort={FormatOrderSnapshot(ordemTPShort)} stopLong={FormatOrderSnapshot(ordemStopLong)} stopShort={FormatOrderSnapshot(ordemStopShort)} " +
                        $"activeEntrySignal={activeEntrySignal} activeEntrySignalDay={activeEntrySignalDay:yyyy-MM-dd}";
                    Log("AutoCloseSnapshot", snapshot);
                }
            }

            if (ninjaNow < scheduledCloseLocal)
            {
                LogAutoCloseGate("RETURN_BEFORE_SCHEDULED", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday);
                return;
            }

            if (lastAutoCloseTradingDay.Date == tradingDay.Date && (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0))
            {
                LogAutoCloseGate("RETURN_ALREADY_DONE_TRADINGDAY", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday);
                return;
            }

            // Se não há posição, cancela plano pendente e sai
            if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
            {
                if (invertPlanArmed)
                {
                    CancelInvertPlan("EOD", tradingDay);
                    Audit("AutoClose", $"entryTime={entryTimeLocal:HH\\:mm\\:ss} scheduledClose={scheduledCloseLocal:HH\\:mm\\:ss} ninjaNow={ninjaNow:HH\\:mm\\:ss} action=CancelInvertPlan");
                }

                lastAutoCloseTradingDay = tradingDay;
                autoCloseTriggeredToday = true;
                LogAutoCloseGate("RETURN_FLAT_CANCEL_PLAN", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday);
                PublishPanelSnapshot("AutoClose_flat");
                return;
            }

            if (ninjaNow > scheduledCloseLocal.Add(TimeSpan.FromMinutes(AutoCloseMaxWindowMinutes)))
            {
                LogAutoCloseGate("AFTER_CUTOFF_CONTINUE", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday, $"cutoffMinutes={AutoCloseMaxWindowMinutes}");
            }

            if (autoCloseExitAttemptCountToday >= AutoCloseMaxAttempts)
            {
                lastAutoCloseTradingDay = tradingDay;
                LogAutoCloseGate("EXIT_SKIP_MAX_ATTEMPTS", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday, $"maxAttempts={AutoCloseMaxAttempts}");
                return;
            }

            if (AutoCloseResendCooldownSeconds > 0 && lastAutoCloseAttemptUtc != Core.Globals.MinDate)
            {
                var nowUtc = DateTime.UtcNow;
                if ((nowUtc - lastAutoCloseAttemptUtc).TotalSeconds < AutoCloseResendCooldownSeconds)
                {
                    LogAutoCloseGate("EXIT_RESENT_COOLDOWN", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday, $"cooldownSeconds={AutoCloseResendCooldownSeconds}");
                    return;
                }
            }

            // Marca tentativa e executa
            autoCloseTriggeredToday = true;
            exitReasonHint = "AutoClose";
            exitReasonHintTradingDay = tradingDay;
            wasSentToday = autoCloseExitSentToday;

            Audit("AutoClose", $"entryTime={entryTimeLocal:HH\\:mm\\:ss} scheduledClose={scheduledCloseLocal:HH\\:mm\\:ss} ninjaNow={ninjaNow:HH\\:mm\\:ss} side={Position.MarketPosition} qty={Position.Quantity} avg={F0(Position.AveragePrice)}");

            try
            {
                Log("AutoCloseSnapshot", $"stage=PreCancel ninjaNow={ninjaNow:O} tpLong={FormatOrderSnapshot(ordemTPLong)} tpShort={FormatOrderSnapshot(ordemTPShort)} stopLong={FormatOrderSnapshot(ordemStopLong)} stopShort={FormatOrderSnapshot(ordemStopShort)}");
                TryCancelBracketOrder(ordemTPLong, "AutoClose", "AutoClose", true);
                TryCancelBracketOrder(ordemTPShort, "AutoClose", "AutoClose", true);
                TryCancelBracketOrder(ordemStopLong, "AutoClose", "AutoClose", true);
                TryCancelBracketOrder(ordemStopShort, "AutoClose", "AutoClose", true);
                Log("AutoCloseSnapshot", $"stage=PostCancel ninjaNow={ninjaNow:O} tpLong={FormatOrderSnapshot(ordemTPLong)} tpShort={FormatOrderSnapshot(ordemTPShort)} stopLong={FormatOrderSnapshot(ordemStopLong)} stopShort={FormatOrderSnapshot(ordemStopShort)}");

                string fromSignal = GetActiveEntrySignal(tradingDay);
                autoCloseExitSignalName = fromSignal;

                if (IsReplayMode())
                {
                    replayAutoCloseExitPending = true;
                    replayAutoCloseExitArmedTime = ninjaNow;
                    autoCloseExitSentToday = true;
                    autoCloseExitSentTimeFeed = ninjaNow;
                    autoCloseExitSentTradingDay = tradingDay;
                    string replayAction = wasSentToday ? "REPLAY_EXIT_REARMED" : "REPLAY_EXIT_ARMED";
                    Audit("AutoClose", $"action={replayAction} side={Position.MarketPosition} qty={Position.Quantity} avg={F0(Position.AveragePrice)} attempt={autoCloseExitAttemptCountToday} fromSignal={autoCloseExitSignalName} armedAt={replayAutoCloseExitArmedTime:O}");
                    LogAutoCloseGate(wasSentToday ? "REPLAY_EXIT_REARMED" : "REPLAY_EXIT_ARMED", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday,
                        $"attempt={autoCloseExitAttemptCountToday} fromSignal={autoCloseExitSignalName} armedAt={replayAutoCloseExitArmedTime:O}");
                    PublishPanelSnapshot("AutoClose_replay_exit_armed");
                    PublishPanelSnapshot("AutoClose");
                    return;
                }

                if (Position.MarketPosition == MarketPosition.Long && Position.Quantity > 0)
                {
                    if (!string.IsNullOrEmpty(fromSignal))
                        ExitLong("AutoClose", fromSignal);
                    else
                        ExitLong("AutoClose");
                }
                else if (Position.MarketPosition == MarketPosition.Short && Position.Quantity > 0)
                {
                    if (!string.IsNullOrEmpty(fromSignal))
                        ExitShort("AutoClose", fromSignal);
                    else
                        ExitShort("AutoClose");
                }

                autoCloseExitSentToday = true;
                autoCloseExitSentTimeFeed = ninjaNow;
                autoCloseExitSentTradingDay = tradingDay;
                autoCloseExitAttemptCountToday++;
                lastAutoCloseAttemptUtc = DateTime.UtcNow;
                string action = wasSentToday ? "ExitResent" : "ExitSent";
                Audit("AutoClose", $"action={action} side={Position.MarketPosition} qty={Position.Quantity} avg={F0(Position.AveragePrice)} attempt={autoCloseExitAttemptCountToday} fromSignal={autoCloseExitSignalName}");
                LogAutoCloseGate(wasSentToday ? "EXIT_RESENT" : "EXIT_SENT", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday,
                    $"attempt={autoCloseExitAttemptCountToday} fromSignal={autoCloseExitSignalName}");
                PublishPanelSnapshot("AutoClose_exit_sent");
                PublishPanelSnapshot("AutoClose");
            }
            catch (Exception ex)
            {
                LogAutoCloseGate("EXIT_EXCEPTION", barTime, ninjaNow, entryTimeLocal, scheduledCloseLocal, tradingDay, autoCloseTriggeredToday, $"error={ex.Message}");
                Log("AutoClose", $"Exception while attempting auto-close: {ex.Message}");
            }
        }

        private void ProcessReplayAutoCloseExitPending(DateTime barTime, DateTime tradingDay)
        {
            if (!IsReplayMode() || !replayAutoCloseExitPending)
                return;

            DateTime armedAt = replayAutoCloseExitArmedTime == Core.Globals.MinDate ? barTime : replayAutoCloseExitArmedTime;
            if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
            {
                replayAutoCloseExitPending = false;
                replayAutoCloseExitArmedTime = Core.Globals.MinDate;
                LogAutoCloseGate("REPLAY_EXIT_PENDING_CLEARED_FLAT", barTime, barTime, armedAt, armedAt, tradingDay, autoCloseTriggeredToday);
                return;
            }

            if (autoCloseExitAttemptCountToday >= AutoCloseMaxAttempts)
            {
                LogAutoCloseGate("REPLAY_EXIT_SKIP_MAX_ATTEMPTS", barTime, barTime, armedAt, armedAt, tradingDay, autoCloseTriggeredToday,
                    $"maxAttempts={AutoCloseMaxAttempts} armedAt={armedAt:O}");
                replayAutoCloseExitPending = false;
                replayAutoCloseExitArmedTime = Core.Globals.MinDate;
                PublishPanelSnapshot("AutoClose_replay_exit_max_attempts");
                return;
            }

            if (AutoCloseResendCooldownSeconds > 0 && lastAutoCloseAttemptUtc != Core.Globals.MinDate)
            {
                var nowUtc = DateTime.UtcNow;
                if ((nowUtc - lastAutoCloseAttemptUtc).TotalSeconds < AutoCloseResendCooldownSeconds)
                    return;
            }

            try
            {
                exitReasonHint = "AutoClose";
                exitReasonHintTradingDay = tradingDay;

                if (Position.MarketPosition == MarketPosition.Long && Position.Quantity > 0)
                    ExitLong("AutoClose");
                else if (Position.MarketPosition == MarketPosition.Short && Position.Quantity > 0)
                    ExitShort("AutoClose");

                autoCloseExitSentToday = true;
                autoCloseExitSentTradingDay = tradingDay;
                autoCloseExitSentTimeFeed = barTime;
                autoCloseExitAttemptCountToday++;
                lastAutoCloseAttemptUtc = DateTime.UtcNow;
                Audit("AutoClose", $"action=REPLAY_EXIT_SUBMITTED_BIP0 side={Position.MarketPosition} qty={Position.Quantity} avg={F0(Position.AveragePrice)} armedAt={armedAt:O} barTime={barTime:O} attempt={autoCloseExitAttemptCountToday}");
                LogAutoCloseGate("REPLAY_EXIT_SUBMITTED_BIP0", barTime, barTime, armedAt, armedAt, tradingDay, autoCloseTriggeredToday,
                    $"armedAt={armedAt:O} attempt={autoCloseExitAttemptCountToday}");
                PublishPanelSnapshot("AutoClose_replay_exit_submitted");
            }
            catch (Exception ex)
            {
                Log("AutoClose", $"Replay pending exit submit failed on BIP0: {ex.Message}");
            }
        }

