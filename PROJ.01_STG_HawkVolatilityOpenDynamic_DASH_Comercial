                    "reason=Enable message=" + enableMessage
                    + " overlayPenaltyArmedToday=" + overlayPenaltyArmedToday
                    + " isInsideOperationalWindow=" + isInsideOperationalWindow
                    + " offSnapshot=false state=" + State
                    + " td=" + overlayTradingDay.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
            }
            else if (State == State.Terminated)
            {
                if (terminatedHandled)
                    return;
                terminatedHandled = true;

                isStrategyActive = false;
                overlayEnableTimeLocal = Core.Globals.MinDate;
                overlayEnableTradingDay = Core.Globals.MinDate;
                overlayPenaltyArmedToday = false;
                overlayAttentionActive = false;
                overlayStartCached = Core.Globals.MinDate;
                overlayEndCached = Core.Globals.MinDate;
                overlayCutoffCached = Core.Globals.MinDate;
                PublishPanelOffSnapshot("Terminated");
                try { panelHelper?.Dispose(); panelHelper = null; } catch { }
                riskOverlayHelper?.Remove();
            }
        }

