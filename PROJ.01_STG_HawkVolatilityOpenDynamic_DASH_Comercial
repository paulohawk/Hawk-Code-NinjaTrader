        private void StartBracketCycle(Position position, double averagePrice, int qty, double stopTicks)
        {
            bracketCycleId++;
            cycleStartTime = DateTime.UtcNow;
            cycleFillAtUtc = cycleStartTime;
            cycleFillBarNumber = CurrentBar;
            lastBracketBarCheck = -1;
            cycleSide = position.MarketPosition;
            cycleQty = qty;
            entryPrice = averagePrice;
            double tickSize = Instrument.MasterInstrument.TickSize;
            initialRiskPoints = stopTicks * tickSize;
            frozenEntryPrice = averagePrice;
            frozenStopPrice = cycleSide == MarketPosition.Long
                ? frozenEntryPrice - initialRiskPoints
                : frozenEntryPrice + initialRiskPoints;
            frozenRiskPoints = Math.Abs(frozenEntryPrice - frozenStopPrice);

            double effectiveAtRR = GetEffectiveBreakEvenAtRR();
            double effectiveLockRR = GetEffectiveBreakEvenLockRR();

            beTriggerPrice = cycleSide == MarketPosition.Long
                ? frozenEntryPrice + frozenRiskPoints * effectiveAtRR
                : frozenEntryPrice - frozenRiskPoints * effectiveAtRR;
            beStopPrice = cycleSide == MarketPosition.Long
                ? frozenEntryPrice + frozenRiskPoints * effectiveLockRR
                : frozenEntryPrice - frozenRiskPoints * effectiveLockRR;

            bracketCreateArmed = true;
            breakEvenArmed = true;
            bracketConfirmed = false;
            stopWorking = false;
            targetWorking = false;
            breakEvenApplied = false;
            breakEvenAppliedCycleId = 0;
            bracketCreateAttempts = 0;
            attemptsTick = 0;
            attemptsBar = 0;
            attemptsRebuild = 0;
            bracketTickWindowStartUtc = cycleStartTime;
            bracketNextEligibleAttemptUtc = Core.Globals.MinDate;
            lastBracketCreateAttemptUtc = Core.Globals.MinDate;
            lastSafeModeBracketAttemptUtc = Core.Globals.MinDate;
            bracketBarRetryArmed = false;
            stopSeenSubmitted = false;
            targetSeenSubmitted = false;
            stopSeenWorking = false;
            targetSeenWorking = false;
            replayBracketLoggedCycleId = 0;
            replayBracketAttempts = 0;

            Log("CYCLE_START",
                $"cycleId={bracketCycleId} side={cycleSide} qty={cycleQty} entry={F0(entryPrice)} riskPx={F(initialRiskPoints)} frozenEntry={F0(frozenEntryPrice)} frozenRiskPx={F(frozenRiskPoints)} mode={GetModeTag()} env={GetEnvTag()}");
        }

