        private void EntryDiag(string tag, string msg)
        {
            if (!DebugMode) return;
            if (ExecutionMode == ExecutionModeType.RealtimePrecise && !IsFirstTickOfBar) return;
            DateTime now = Core.Globals.Now;
            if (lastEntryDiagLogAt.TryGetValue(tag, out var lastTime))
