        private void HandleMidasBar()
        {
            if (blockedAfterClose)
            {
                if (Times[vwapBip][0].Date != blockedAfterCloseDate)
                {
                    blockedAfterClose = false;
                    blockedAfterCloseLogged = false;
                }
            }

            if (blockedAfterClose)
            {
                statusText = "Blocked (após zera)";
                if (!blockedAfterCloseLogged)
                {
                    blockedAfterCloseLogged = true;
                    LogWindow("BLOCK", "AfterClose", Times[vwapBip][0]);
                }
                LogDecision("ENTRY_BLOCKED", "AfterClose");
                EntryDiag("BLOCKED_AFTER_CLOSE", BuildEntryDiagContext(null, null));
                return;
            }

            if (CurrentBars.Length <= vwapBip || CurrentBars[vwapBip] <= 0)
            {
                LogDecision("ENTRY_BLOCKED", "VwapBarsNotReady");
                EntryDiag("GATE_VWAP_BARS", BuildEntryDiagContext(null, null, "reason=vwap_bars_not_ready"));
                return;
            }
            DateTime midasDate = Times[vwapBip][0].Date;
            if (midasDate != lastMidasDate)
            {
                lastMidasDate = midasDate;
                hasValidMidasToday = false;
                lastMidasHigh = double.NaN;
                lastMidasMid = double.NaN;
                lastMidasLow = double.NaN;
            }
            if (CurrentBars[0] < BarsRequiredToTrade)
            {
                LogDecision("ENTRY_BLOCKED", "PrimaryBarsNotReady");
                EntryDiag("GATE_PRIMARY_BARS", BuildEntryDiagContext(null, null, $"reason=primary_bars_not_ready barsRequired={BarsRequiredToTrade}"));
                return;
            }

            DateTime agoraPrimary = Times[0][0];
            DateTime inicioHojeAllowed = IsUsaDst(agoraPrimary)
                ? new DateTime(agoraPrimary.Year, agoraPrimary.Month, agoraPrimary.Day, horarioInicioDstUsaDT.Hour, horarioInicioDstUsaDT.Minute, 0)
                : new DateTime(agoraPrimary.Year, agoraPrimary.Month, agoraPrimary.Day, horarioInicioNormalDT.Hour, horarioInicioNormalDT.Minute, 0);

            DateTime fimSessaoAllowed = new DateTime(agoraPrimary.Year, agoraPrimary.Month, agoraPrimary.Day, horarioFimSessaoDT.Hour, horarioFimSessaoDT.Minute, 0);
            horarioZeraDT = fimSessaoAllowed.AddMinutes(-EncerramentoOffsetMin);

            if (agoraPrimary < inicioHojeAllowed)
            {
                statusText = "Waiting (aguardando)";
                LogWindow("BLOCK", "BeforeStart", agoraPrimary);
                LogDecision("ENTRY_BLOCKED", "BeforeStart");
                EntryDiag("GATE_BEFORE_START", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT));
                return;
            }
            if (agoraPrimary >= horarioZeraDT)
            {
                blockedAfterClose = true;
                blockedAfterCloseDate = agoraPrimary.Date;
                statusText = "Blocked (após zera)";
                CancelAndClearWorkingOrders();
                sideLatched = LatchedSide.None; qtyLatched = 0;
                LogWindow("BLOCK", "AfterClose", agoraPrimary);
                LogDecision("ENTRY_BLOCKED", "AfterClose");
                EntryDiag("GATE_AFTER_CLOSE", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT));
                return;
            }

            if (vwap == null)
            {
                statusText = "VWAP não pronto";
                LogDecision("ENTRY_BLOCKED", "VwapNull");
                EntryDiag("GATE_VWAP_NULL", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT));
                return;
            }

            if (!TryGetMidasValues(out double vwapHigh, out double vwapMedian, out double vwapLow, out string source, out _, AllowMidasCacheFallbackForEntry))
            {
                statusText = "MIDAS indisponível";
                ClearPendingSnapshot();
                RPLog("[MIDAS] source=NONE handle=HandleMidasBar action=skip");
                LogDecision("ENTRY_BLOCKED", "MidasUnavailable");
                EntryDiag("MIDAS_FAIL", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT, $"source={source} allowCache={AllowMidasCacheFallbackForEntry}"));
                return;
            }

            string midasTag = source == "MIDAS_CACHE" ? " (MIDAS cache)" : "";
            if (source == "MIDAS_CACHE")
            {
                RPLog("[MIDAS] source=CACHE handle=HandleMidasBar action=continue");
            }

            double preco = Closes[0][0];
            bool aboveBands = preco > vwapHigh && preco > vwapMedian && preco > vwapLow;
            bool belowBands = preco < vwapHigh && preco < vwapMedian && preco < vwapLow;

            bool stReady = true, stBull = true, stBear = true;
            if (UseSuperTrendFilter)
            {
                if (st == null)
                {
                    statusText = "ST null";
                    LogDecision("ENTRY_BLOCKED", "SuperTrendNull");
                    EntryDiag("GATE_ST_NULL", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT));
                    return;
                }
                if (CurrentBars.Length <= stBip || CurrentBars[stBip] < Math.Max(ST_Length, ST_Smooth) + 2)
                {
                    statusText = "ST não pronto";
                    LogDecision("ENTRY_BLOCKED", "SuperTrendNotReady");
                    EntryDiag("GATE_ST_NOT_READY", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT));
                    return;
                }

                double stDn = st.DownTrend[0];
                double stUp = st.UpTrend[0];
                double stClose = Closes[stBip][0];

                stBull = (stDn == 0 && stUp > 0) || (stDn > 0 && stClose >= stDn);
                stBear = (stUp == 0 && stDn > 0) || (stUp > 0 && stClose <= stUp);
                if (ST_InvertSignal) { var tmp = stBull; stBull = stBear; stBear = tmp; }
                stReady = stBull || stBear;
            }

            if (Position.MarketPosition != MarketPosition.Flat)
            {
                statusText = $"Posição aberta{midasTag}";
                ClearPendingSnapshot();
                LogDecision("ENTRY_BLOCKED", "PositionOpen");
                EntryDiag("GATE_POSITION_OPEN", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT, $"midasSource={source} pos={Position.MarketPosition} qty={Position.Quantity}"));
                return;
            }

            if (IsOrderWorking(ordemHedgeBuyStop) || IsOrderWorking(ordemHedgeSellStop))
            {
                if (IsOrderWorking(ordemHedgeBuyStop)) CancelOrder(ordemHedgeBuyStop);
                if (IsOrderWorking(ordemHedgeSellStop)) CancelOrder(ordemHedgeSellStop);
                ordemHedgeBuyStop = null;
                ordemHedgeSellStop = null;
                LogDecision("SAFETY", "KilledHedgeStopWhileFlat");
            }

            if (HasWorkingEntryLimit())
            {
                currentState = TradeState.Armed;
                statusText = $"Contexto armado (reprecificando){midasTag}";
                RepriceWorkingEntryToMidasMedian(vwapMedian, midasTag, inicioHojeAllowed, horarioZeraDT, source);
                return;
            }

            bool contextoCompra = AllowLong && aboveBands && stReady && (!UseSuperTrendFilter || stBull);
            bool contextoVenda = AllowShort && belowBands && stReady && (!UseSuperTrendFilter || stBear);

            if (currentState == TradeState.Idle)
            {
                if (contextoCompra)
                {
                    sideLatched = LatchedSide.Long;
                    currentState = TradeState.Armed;
                }
                else if (contextoVenda)
                {
                    sideLatched = LatchedSide.Short;
                    currentState = TradeState.Armed;
                }
                else
                {
                    sideLatched = LatchedSide.None;
                    qtyLatched = 0;
                    statusText = $"Waiting (no valid MIDAS context){midasTag}";
                    ClearPendingSnapshot();
                    LogDecision("ENTRY_BLOCKED", "NoContext");
                    EntryDiag("GATE_NO_CONTEXT", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT, $"midasSource={source}"));
                    return;
                }
            }

            double riscoPrecoEstimado = 0.0, riscoPorContrato = 0.0;
            int qtyCalc = CalcQtyByRiskLatched(sideLatched, vwapMedian, vwapHigh, vwapLow, out riscoPrecoEstimado, out riscoPorContrato);
            if (qtyCalc < 1) qtyCalc = 1;
            qtyLatched = qtyCalc;

            pendingRiskCurrency = riscoPorContrato;
            pendingRiskTicks = riscoPrecoEstimado / tickSize;
            if (StopTypeIsATR && sideLatched != LatchedSide.None)
            {
                double atrVal = (atrInd != null) ? atrInd[0] * ATRMultiplier : 0.0;
                double stopTicks = riscoPrecoEstimado > 0 ? (riscoPrecoEstimado / tickSize) : 0.0;
                LogRiskSnapshot(MaxRiskPerTradeCurrency, atrVal, stopTicks, qtyCalc, qtyCalc);
            }

            CancelPendingLimitsIfAny();

            if (sideLatched == LatchedSide.Long)
            {
                double precoLimiteCompra = Instrument.MasterInstrument.RoundToTickSize(vwapMedian + LimitOffsetTicks * tickSize);
                statusText = $"Contexto Long (pendente){midasTag}";
                LogDecision("ENTRY_ALLOWED", "AllConditionsMet");
                EntryDiag("SUBMIT", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT, $"side={sideLatched} qty={qtyCalc} limit={precoLimiteCompra} vwapM={vwapMedian} source={source}"));
                SubmitOrReplaceLimitOrderSafe(true, qtyCalc, precoLimiteCompra, "LongAuto");
                currentState = TradeState.Armed;
            }
            else if (sideLatched == LatchedSide.Short)
            {
                double precoLimiteVenda = Instrument.MasterInstrument.RoundToTickSize(vwapMedian - LimitOffsetTicks * tickSize);
                statusText = $"Contexto Short (pendente){midasTag}";
                LogDecision("ENTRY_ALLOWED", "AllConditionsMet");
                EntryDiag("SUBMIT", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT, $"side={sideLatched} qty={qtyCalc} limit={precoLimiteVenda} vwapM={vwapMedian} source={source}"));
                SubmitOrReplaceLimitOrderSafe(false, qtyCalc, precoLimiteVenda, "ShortAuto");
                currentState = TradeState.Armed;
            }
            else
            {
                statusText = $"Waiting (no latched side){midasTag}";
                ClearPendingSnapshot();
                LogDecision("ENTRY_BLOCKED", "LatchedSideNone");
                EntryDiag("GATE_NO_LATCH", BuildEntryDiagContext(inicioHojeAllowed, horarioZeraDT, $"midasSource={source}"));
            }
        }

        private void ClearPendingSnapshot()
        {
            pendingEntryPrice = null;
            pendingStopPrice = null;
            pendingTargetPrice = null;
            pendingQty = null;
        }

        private int CalcQtyByRiskLatched(LatchedSide side, double vwapMedian, double vwapHigh, double vwapLow, out double riscoPrecoEstimado, out double riscoPorContrato)
        {
            riscoPrecoEstimado = 0.0;
            riscoPorContrato = 0.0;

            // Quando StopTypeIsATR == true, os campos FixedStopTicks e FixedQuantity são ignorados intencionalmente.
            // O sizing é determinado exclusivamente por ATR + risco monetário máximo.
            if (!StopTypeIsATR || MaxRiskPerTradeCurrency <= 0 || atrInd == null || CurrentBars.Length <= atrBip || CurrentBars[atrBip] <= ATRPeriod || side == LatchedSide.None)
                return Math.Max(1, FixedQuantity);

            double atrVal = atrInd[0] * ATRMultiplier;
            lastAtrVal = atrVal;
            if (atrInd[0] > 0 && !double.IsNaN(atrInd[0]))
                lastValidAtrValue = atrInd[0];
            if (atrVal <= 0)
                return Math.Max(1, FixedQuantity);

            double cushion = SlippageCushionTicksForRisk * tickSize;

            if (side == LatchedSide.Long)
            {
                double precoLimite = vwapMedian + LimitOffsetTicks * tickSize;
                double precoLimiteCushioned = precoLimite + cushion;
                double stopEstimado = vwapLow - atrVal - cushion;
                riscoPrecoEstimado = precoLimiteCushioned - stopEstimado;

                pendingEntryPrice = precoLimite;
                pendingStopPrice = stopEstimado;
                pendingTargetPrice = precoLimite + (riscoPrecoEstimado * TPFactor);
                pendingQty = qtyLatched;
            }
            else if (side == LatchedSide.Short)
            {
                double precoLimite = vwapMedian - LimitOffsetTicks * tickSize;
                double precoLimiteCushioned = precoLimite - cushion;
                double stopEstimado = vwapHigh + atrVal + cushion;
                riscoPrecoEstimado = stopEstimado - precoLimiteCushioned;

                pendingEntryPrice = precoLimite;
                pendingStopPrice = stopEstimado;
                pendingTargetPrice = precoLimite - (riscoPrecoEstimado * TPFactor);
                pendingQty = qtyLatched;
            }

            if (riscoPrecoEstimado <= 0) return Math.Max(1, FixedQuantity);

            riscoPorContrato = riscoPrecoEstimado * pontoValor;
            if (riscoPorContrato <= 0) return Math.Max(1, FixedQuantity);

            int qtyCalc = (int)Math.Floor(MaxRiskPerTradeCurrency / riscoPorContrato);
            if (qtyCalc < 1) qtyCalc = 1;
            if (qtyCalc > Contratos) qtyCalc = Contratos;
            return qtyCalc;
        }

        private void HandlePrimarySeries()
        {
            DateTime agoraPrimary2 = Times[0][0];
            DateTime tradingDayPrimary = new SessionIterator(Bars).GetTradingDay(agoraPrimary2);
            if (tradingDayPrimary != lastTradingDay)
            {
                lastTradingDay = tradingDayPrimary;
                tradingDayAnchor = tradingDayPrimary;
                tradingDayAnchorSet = true;

                longTradedToday = false; shortTradedToday = false;
                compraFeitaNaSessao = false; vendaFeitaNaSessao = false;
                cancelExecutedToday = false; closeExecutedToday = false;
                orderSubmissionAttempts.Clear();
                lastSubmissionTime.Clear();
                submissionAttemptsWindow.Clear();
                breakevenAtivado = false;
                stopAlvoConfigurados = false;
                lastKnownPositionQty = 0;
                entryStopTicksUsed = 0;
                plottedExecutions.Clear();
                sideLatched = LatchedSide.None;
                qtyLatched = 0;
                ClearPendingSnapshot();
                lastTradeQty = null; lastTradeEntry = null; lastTradeStop = null; lastTradeTarget = null; lastTradeStatus = "Waiting (aguardando)";
                currentPlannedStop = null; currentPlannedTarget = null; currentEntryPrice = null;
            }

            DateTime inicioHoje = IsUsaDst(agoraPrimary2)
                ? new DateTime(agoraPrimary2.Year, agoraPrimary2.Month, agoraPrimary2.Day, horarioInicioDstUsaDT.Hour, horarioInicioDstUsaDT.Minute, 0)
                : new DateTime(agoraPrimary2.Year, agoraPrimary2.Month, agoraPrimary2.Day, horarioInicioNormalDT.Hour, horarioInicioNormalDT.Minute, 0);
            DateTime fimSessaoHoje = new DateTime(agoraPrimary2.Year, agoraPrimary2.Month, agoraPrimary2.Day, horarioFimSessaoDT.Hour, horarioFimSessaoDT.Minute, 0);
            horarioZeraDT = fimSessaoHoje.AddMinutes(-EncerramentoOffsetMin);

            if (agoraPrimary2 >= horarioZeraDT)
            {
                blockedAfterClose = true;
                blockedAfterCloseDate = agoraPrimary2.Date;
                statusText = "Blocked (após zera)";
                CloseAllAndCancel();
                sideLatched = LatchedSide.None; qtyLatched = 0;
                ClearPendingSnapshot();
                return;
            }

            if (agoraPrimary2 < inicioHoje) { statusText = "Waiting (aguardando)"; return; }

            if (CurrentBars[0] < BarsRequiredToTrade) { statusText = "Waiting (poucas barras)"; return; }
            if (vwap == null) { statusText = "VWAP null"; return; }
            if (atrInd == null && StopTypeIsATR) { statusText = "ATR null"; return; }

            bool entryGate = ExecutionMode != ExecutionModeType.RealtimePrecise || IsFirstTickOfBar;

            if (Position.MarketPosition != MarketPosition.Flat)
            {
                statusText = "Posição aberta";
                if (entryGate)
                {
                    if (ordemLimiteCompra != null) CancelOrder(ordemLimiteCompra);
                    if (ordemLimiteVenda != null) CancelOrder(ordemLimiteVenda);
                    if (ordemHedgeBuyStop != null) CancelOrder(ordemHedgeBuyStop);
                    if (ordemHedgeSellStop != null) CancelOrder(ordemHedgeSellStop);
                }
            }
            else
            {
                statusText = lastTradeQty.HasValue ? "Closed" : "Waiting (aguardando)";
            }
        }

        private void EvaluateOverlayPenalty()
        {
            if (State != State.Realtime || _riskOverlay == null) return;

            DateTime nowLocal;
            try { nowLocal = Time[0]; }
            catch { nowLocal = DateTime.Now; }

            DateTime dateKey = nowLocal.Date;
            if (overlayPenaltyArmedDate != dateKey)
            {
                overlayPenaltyArmedDate = dateKey;
                overlayPenaltyArmedThisEnable = false;
                overlayStartCached = null;
                overlayEndCached = null;
            }

            GetOverlayTimes(nowLocal, out var overlayStart, out var overlayEnd);

            if (!overlayPenaltyArmedThisEnable &&
                strategyEnableTimeLocal != Core.Globals.MinDate &&
                strategyEnableTimeLocal.Date == dateKey &&
                strategyEnableTimeLocal.TimeOfDay >= overlayStart)
            {
                overlayPenaltyArmedThisEnable = true;
            }

            UpdateRiskWarningState(nowLocal, overlayStart);

            if (!overlayPenaltyArmedThisEnable) return;

            var nowTime = nowLocal.TimeOfDay;
            if (nowTime < overlayStart || nowTime > overlayEnd) return;

            string body =
                "Você ativou esta automação fora do horário operacional recomendado.\n\n" +
                "Para máxima estabilidade, recomenda-se manter a estratégia ativa antes das 10:30 ou utilizar VPS dedicada.\n\n" +
                "Ao prosseguir, você assume os riscos operacionais desta decisão.";

            _riskOverlay.TryShow("AVISO AO TRADER", body);
        }

        private void UpdateRiskWarningState(DateTime nowLocal, TimeSpan? overlayStartOverride = null)
        {
            GetOverlayTimes(nowLocal, out var overlayStart, out _);
            if (overlayStartOverride.HasValue)
                overlayStart = overlayStartOverride.Value;

            bool isAttention =
                strategyEnableTimeLocal != Core.Globals.MinDate &&
                strategyEnableTimeLocal.Date == nowLocal.Date &&
                strategyEnableTimeLocal.TimeOfDay >= overlayStart;

            SetRiskWarningText(isAttention);
        }

        private void SetRiskWarningText(bool isAttention)
        {
            if (isAttention)
            {
                riskWarningTitle = "Atenção";
                riskWarningText = "- automação ligada fora do horário operacional.\n- monitore possíveis falhas de stop e alvo.";
                riskWarningColor = Brushes.Red;
                riskWarningBulletFill = Brushes.Red;
            }
            else
            {
                riskWarningTitle = "Status";
                riskWarningText = "- sistema ativo e monitorando condições de mercado.";
                riskWarningColor = Brushes.LightGreen;
                riskWarningBulletFill = Brushes.LightGreen;
            }
        }

        private void GetOverlayTimes(DateTime nowLocal, out TimeSpan overlayStart, out TimeSpan overlayEnd)
        {
            if (!overlayStartCached.HasValue || !overlayEndCached.HasValue || overlayPenaltyArmedDate != nowLocal.Date)
            {
                TimeSpan startOps = IsUsaDst(nowLocal)
                    ? horarioInicioDstUsaDT.TimeOfDay
                    : horarioInicioNormalDT.TimeOfDay;
                overlayStart = startOps - TimeSpan.FromMinutes(30);
                overlayEnd = horarioFimSessaoDT.TimeOfDay;
                overlayStartCached = overlayStart;
                overlayEndCached = overlayEnd;
                return;
            }

            overlayStart = overlayStartCached.Value;
            overlayEnd = overlayEndCached.Value;
        }
