        private void EvaluateStopMissingWatchdog()
        {
            if (Position.MarketPosition == MarketPosition.Flat)
            {
                stopMissingConsecutive = 0;
                return;
            }

            if (stopReplaceInProgress)
                return;

            if (HasActiveStopForPosition())
            {
                stopMissingConsecutive = 0;
                return;
            }

            stopMissingConsecutive++;
            if (stopMissingConsecutive < stopMissingMaxCycles)
                return;

            stopMissingConsecutive = 0;
            if ((DateTime.UtcNow - lastStopMissingLogUtc).TotalSeconds < 1)
                return;

            lastStopMissingLogUtc = DateTime.UtcNow;
            Print($"[HawkRisk][STOP_MISSING_EMERGENCY] time0={(CurrentBar >= 0 ? Time[0] : Core.Globals.Now):O} pos={Position.MarketPosition} qty={Position.Quantity} entry={Position.AveragePrice}");
            RPLog($"[HawkRisk][STOP_MISSING_EMERGENCY] time0={(CurrentBar >= 0 ? Time[0] : Core.Globals.Now):O} pos={Position.MarketPosition} qty={Position.Quantity} entry={Position.AveragePrice}");
            ArmEmergencyStop("STOP_MISSING");
        }

        private void EvaluateStopReplaceTimeout()
        {
            if (!stopReplaceInProgress)
                return;

            if (stopReplaceStartedAt == Core.Globals.MinDate)
                return;

            TimeSpan elapsed = Core.Globals.Now - stopReplaceStartedAt;
            if (elapsed.TotalSeconds <= 5)
                return;

            Print($"[HawkBE][STOP_REPLACE_TIMEOUT] time0={(CurrentBar >= 0 ? Time[0] : Core.Globals.Now):O} elapsedSec={elapsed.TotalSeconds:F1} side={stopReplaceSide} pendingStop={pendingBeStopPrice}");
            RPLog($"[HawkRisk][STOP_REPLACE_TIMEOUT] time0={(CurrentBar >= 0 ? Time[0] : Core.Globals.Now):O} elapsedSec={elapsed.TotalSeconds:F1} side={stopReplaceSide} pendingStop={pendingBeStopPrice}");

            bool hasFallbackStop = HasActiveStopForPosition();
            ClearBreakEvenReplaceState();

            if (!hasFallbackStop && Position.MarketPosition != MarketPosition.Flat)
            {
                ArmEmergencyStop("REPLACE_TIMEOUT");
            }
        }

        private void ArmEmergencyStop(string reason)
        {
            if (Position.MarketPosition == MarketPosition.Flat) return;
            if (HasActiveStopForPosition()) return;

            double entry = Position.AveragePrice > 0 ? Position.AveragePrice : currentEntryPrice ?? 0;
            if (entry <= 0) return;

            int stopTicks = entryStopTicksUsed > 0 ? entryStopTicksUsed : FixedStopTicks;
            double stopPrice = Position.MarketPosition == MarketPosition.Long
                ? entry - stopTicks * tickSize
                : entry + stopTicks * tickSize;
            stopPrice = Instrument.MasterInstrument.RoundToTickSize(stopPrice);

            if (Position.MarketPosition == MarketPosition.Long)
            {
                ordemStopLong = ExitLongStopMarket(0, true, Math.Abs(Position.Quantity), stopPrice, "StopLoss_Emergency", "LongAuto");
            }
            else if (Position.MarketPosition == MarketPosition.Short)
            {
                ordemStopShort = ExitShortStopMarket(0, true, Math.Abs(Position.Quantity), stopPrice, "StopLoss_Emergency", "ShortAuto");
            }

            currentPlannedStop = stopPrice;
            Print($"[HawkRisk][STOP_EMERGENCY_ARMED] reason={reason} side={Position.MarketPosition} stopPrice={stopPrice} qty={Position.Quantity}");
            LogStopEvent(Position.MarketPosition == MarketPosition.Long ? ordemStopLong?.Name ?? "StopLoss_Emergency" : ordemStopShort?.Name ?? "StopLoss_Emergency", stopPrice, Position.MarketPosition == MarketPosition.Long ? "LongAuto" : "ShortAuto");
        }

        private int CalculateStopTicksByATR()
        {
            try
            {
                double atrVal = (atrInd != null) ? atrInd[0] * ATRMultiplier : 0;
                if (atrVal <= 0) return FixedStopTicks;
                int ticks = (int)Math.Max(1, Math.Round(atrVal / tickSize));
                return ticks;
            }
            catch { return FixedStopTicks; }
        }

        private bool TryGetMidasValues(out double vwapHigh, out double vwapMedian, out double vwapLow, out string source, out DateTime timestamp, bool allowCacheFallback = true)
        {
            vwapHigh = double.NaN;
            vwapMedian = double.NaN;
            vwapLow = double.NaN;
            timestamp = Core.Globals.MinDate;
            source = "MIDAS_NONE";

            if (vwap == null)
            {
                EntryDiag("MIDAS_NULL", BuildEntryDiagContext(null, null, "reason=vwap_null"));
                return false;
            }

            try
            {
                vwapHigh = vwap.Values[0][0];
                vwapMedian = vwap.Values[1][0];
                vwapLow = vwap.Values[2][0];
                bool valid = !(double.IsNaN(vwapHigh) || double.IsNaN(vwapMedian) || double.IsNaN(vwapLow)
                    || double.IsInfinity(vwapHigh) || double.IsInfinity(vwapMedian) || double.IsInfinity(vwapLow));
                if (valid)
                {
                    source = "MIDAS_CURRENT";
                    DateTime midasDate = Times[vwapBip][0].Date;
                    lastMidasDate = midasDate;
                    hasValidMidasToday = true;
                    lastMidasHigh = vwapHigh;
                    lastMidasMid = vwapMedian;
                    lastMidasLow = vwapLow;
                    return true;
                }
                EntryDiag("MIDAS_NOT_READY", BuildEntryDiagContext(null, null, "reason=midas_invalid"));
            }
            catch
            {
                EntryDiag("MIDAS_NOT_READY", BuildEntryDiagContext(null, null, "reason=midas_read_error"));
            }

            if (hasValidMidasToday && lastMidasDate == Times[vwapBip][0].Date)
            {
                vwapHigh = lastMidasHigh;
                vwapMedian = lastMidasMid;
                vwapLow = lastMidasLow;
                source = "MIDAS_DAY_CACHE";
                RPLog($"[MIDAS] source=DAY_CACHE date={Times[vwapBip][0]:yyyy-MM-dd} H={vwapHigh} M={vwapMedian} L={vwapLow}");
                EntryDiag("MIDAS_DAY_CACHE", BuildEntryDiagContext(null, null, $"date={Times[vwapBip][0]:yyyy-MM-dd}"));
                return true;
            }

            if (allowCacheFallback && vwap.TryGetLastValidValues(out vwapHigh, out vwapMedian, out vwapLow, out timestamp))
            {
                source = "MIDAS_CACHE";
                return true;
            }

            return false;
        }

        private bool TryComputeStopTarget(MarketPosition marketPosition, double entryPrice, out double stopPrice, out double targetPrice, out string source)
        {
            stopPrice = double.NaN;
            targetPrice = double.NaN;
            source = "UNKNOWN";

            if (marketPosition == MarketPosition.Flat)
                return false;

            double cushion = SlippageCushionTicksForRisk * tickSize;
            double atrRaw = GetAtrValueForStops();
            double atrStop = (!double.IsNaN(atrRaw) && atrRaw > 0) ? atrRaw * ATRMultiplier : double.NaN;

            bool hasMidas = TryGetMidasValues(out double vwapHigh, out double vwapMedian, out double vwapLow, out string midasSource, out _, true);

            double stopBase;
            if (StopTypeIsATR)
            {
                if (hasMidas && !double.IsNaN(atrStop) && atrStop > 0)
                {
                    stopBase = marketPosition == MarketPosition.Long
                        ? vwapLow - atrStop
                        : vwapHigh + atrStop;
                    source = midasSource;
                }
                else if (!double.IsNaN(atrStop) && atrStop > 0)
                {
                    stopBase = marketPosition == MarketPosition.Long
                        ? entryPrice - atrStop
                        : entryPrice + atrStop;
                    source = "FALLBACK_ATR";
                }
                else
                {
                    double fixedOffset = FixedStopTicks * tickSize;
                    stopBase = marketPosition == MarketPosition.Long
                        ? entryPrice - fixedOffset
                        : entryPrice + fixedOffset;
                    source = "FALLBACK_FIXED";
                }
            }
            else
            {
                double fixedOffset = FixedStopTicks * tickSize;
                stopBase = marketPosition == MarketPosition.Long
                    ? entryPrice - fixedOffset
                    : entryPrice + fixedOffset;
                source = "FIXED";
            }

            stopPrice = Instrument.MasterInstrument.RoundToTickSize(marketPosition == MarketPosition.Long
                ? stopBase - cushion
                : stopBase + cushion);

            if (double.IsNaN(stopPrice) || stopPrice <= 0)
            {
                double fixedOffset = FixedStopTicks * tickSize;
                stopPrice = Instrument.MasterInstrument.RoundToTickSize(marketPosition == MarketPosition.Long
                    ? entryPrice - fixedOffset
                    : entryPrice + fixedOffset);
                source = "FALLBACK_FIXED";
            }

            double riscoPreco = marketPosition == MarketPosition.Long
                ? entryPrice - stopPrice
                : stopPrice - entryPrice;

            if (double.IsNaN(riscoPreco) || riscoPreco <= 0)
            {
                double fixedOffset = FixedStopTicks * tickSize;
                stopPrice = Instrument.MasterInstrument.RoundToTickSize(marketPosition == MarketPosition.Long
                    ? entryPrice - fixedOffset
                    : entryPrice + fixedOffset);
                riscoPreco = fixedOffset;
                source = "FALLBACK_FIXED";
            }

            targetPrice = Instrument.MasterInstrument.RoundToTickSize(marketPosition == MarketPosition.Long
                ? entryPrice + riscoPreco * TPFactor
                : entryPrice - riscoPreco * TPFactor);

            return true;
        }

        private void ConfigureStopsTargetsForEntry(MarketPosition marketPosition, double entryPrice, int qty, string triggerTag, DateTime? marketTime = null, bool allowRealtimeReconfigure = false)
        {
            if (qty <= 0)
                return;

            if (!TryComputeStopTarget(marketPosition, entryPrice, out double stopPrice, out double targetPrice, out string source))
                return;

            bool hadConfig = stopAlvoConfigurados;
            if (ExecutionMode == ExecutionModeType.RealtimePrecise && hadConfig && !allowRealtimeReconfigure)
            {
                RPLog($"[ENTRY_STOPS][SKIP_RECONFIG] trigger={triggerTag} qty={qty} entry={entryPrice} reason=alreadyConfigured");
                return;
            }

            double? prevStop = currentPlannedStop;
            double? prevTarget = currentPlannedTarget;
            int prevQty = Math.Abs(lastKnownPositionQty);
            if (prevQty == 0) prevQty = qty;
            bool qtyChanged = hadConfig && prevQty != qty;
            bool stopChanged = hadConfig && prevStop.HasValue && Math.Abs(prevStop.Value - stopPrice) > tickSize * 0.5;
            bool targetChanged = hadConfig && prevTarget.HasValue && Math.Abs(prevTarget.Value - targetPrice) > tickSize * 0.5;

            if (ExecutionMode == ExecutionModeType.RealtimePrecise && hadConfig && (qtyChanged || stopChanged || targetChanged))
            {
                RPLog($"[ENTRY_STOPS][RECONFIG] trigger={triggerTag} source={source} qtyPrev={prevQty} qtyNew={qty} stopPrev={prevStop} stopNew={stopPrice} targetPrev={prevTarget} targetNew={targetPrice}");
            }

            double riscoPreco = marketPosition == MarketPosition.Long
                ? entryPrice - stopPrice
                : stopPrice - entryPrice;

            precoEntradaAtual = entryPrice;
            riscoPrecoAtual = riscoPreco;
            breakevenAtivado = false;
            entryStopTicksUsed = Math.Max(1, (int)Math.Round(riscoPreco / tickSize));
            currentPlannedStop = stopPrice;
            currentPlannedTarget = targetPrice;
            currentEntryPrice = entryPrice;
            stopAlvoConfigurados = true;
            bracketQtyLatched = qty;

            string entrySignal = marketPosition == MarketPosition.Long ? "LongAuto" : "ShortAuto";
            DateTime marketTs = marketTime ?? (CurrentBar >= 0 ? Time[0] : Core.Globals.Now);
            DateTime localTs = Core.Globals.Now;
            lastBracketMarketTime = marketTs;
            Print(
                $"[HawkBRACKET_CREATE] " +
                $"timeMarket={marketTs:O} " +
                $"timeLocal={localTs:O} " +
                $"entrySignal={entrySignal} " +
                $"side={marketPosition} " +
                $"qty={qty} " +
                $"stopPrice={stopPrice} " +
                $"targetPrice={targetPrice} " +
                $"source={triggerTag}"
            );

            if (marketPosition == MarketPosition.Long)
            {
                EnsureLongStopsTargets(qty, stopPrice, targetPrice);
                ordemLimiteCompra = null;
                compraFeitaNaSessao = true;
                statusText = "Posição Long";
            }
            else if (marketPosition == MarketPosition.Short)
            {
                EnsureShortStopsTargets(qty, stopPrice, targetPrice);
                ordemLimiteVenda = null;
                vendaFeitaNaSessao = true;
                statusText = "Posição Short";
            }

            ClearPendingSnapshot();
            PrintCurrentOrdersState("AFTER_STOP_TARGET_SETUP");

            RPLog($"[ENTRY_STOPS] trigger={triggerTag} pos={marketPosition} qty={qty} entry={entryPrice} stop={stopPrice} target={targetPrice} source={source}");

            if (marketPosition == MarketPosition.Long && (ordemStopLong == null || ordemTargetLong == null))
                RPLog($"[ENTRY_STOPS][WARN] missingOrders pos=Long stopNull={ordemStopLong == null} targetNull={ordemTargetLong == null}");
            if (marketPosition == MarketPosition.Short && (ordemStopShort == null || ordemTargetShort == null))
                RPLog($"[ENTRY_STOPS][WARN] missingOrders pos=Short stopNull={ordemStopShort == null} targetNull={ordemTargetShort == null}");
        }
