        #region Core OnBarUpdate
        protected override void OnBarUpdate()
        {
            if (!Bars.BarsType.IsIntraday) return;

            ResetDailyBlockIfNewTradingDay(Times[BarsInProgress][0]);

            if (BarsInProgress == schedulerBip)
            {
                HandleScheduler();
                return;
            }

            if (BarsInProgress == vwapBip)
            {
                HandleMidasBar();
                return;
            }

            if (BarsInProgress == atrBip)
            {
                UpdateAtrCache();
                return;
            }

            if (BarsInProgress == beBip)
            {
                EvaluateBreakEvenFromSecondarySeries();
                EvaluateStopReplaceTimeout();
                EvaluateStopMissingWatchdog();
                return;
            }

            if (BarsInProgress != 0) return;

            EvaluateOverlayPenalty();
            HandlePrimarySeries();
            // Watchdog de segurança para RealtimePrecise.
            // Após a implementação do bracket no primeiro consumo,
            // este método atua apenas como fallback extremo.
            EvaluateRealtimeBracketWatchdog();
            EvaluateRealtimeBracketConsolidation();
            EvaluateStopReplaceTimeout();
            EvaluateStopMissingWatchdog();

            if (State == State.Realtime)
            {
                if (!performanceFinalizedForThisLoad)
                {
                    ConsolidatePerformanceIfNeeded(force: true);

                    if (!tradingDayAnchorSet)
                    {
                        tradingDayAnchor = GetTradingDayFromTime(Time[0]);
                        tradingDayAnchorSet = true;
                    }

                    performanceFinalizedForThisLoad = true;
                    lastSnapshotUtc = DateTime.MinValue; // força snapshot imediato
                }
                else
                {
                    ConsolidatePerformanceIfNeeded(force: false);
                }
            }

            PublishSnapshotHeartbeat();
        }
