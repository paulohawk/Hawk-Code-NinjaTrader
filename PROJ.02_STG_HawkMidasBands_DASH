                    overlayPenaltyArmedThisEnable = false;
                    overlayPenaltyArmedDate = Core.Globals.MinDate;
                    overlayStartCached = null;
                    overlayEndCached = null;
                    UpdateRiskWarningState(DateTime.Now);
                    lastSnapshotUtc = DateTime.MinValue;
                    PublishSnapshotHeartbeat();
                }
                catch (Exception ex)
                {
                    Print("[HawkDiag][STATE][ERROR] " + ex.Message);
                }
            }
            else if (State == State.Terminated)
            {
                try { panelHelper?.Dispose(); panelHelper = null; } catch { }
            }
        }
