    public class RiskOverlayHelper
    {
        private static readonly Brush OverlayWarningRed = new SolidColorBrush(Color.FromRgb(255, 64, 64));
        private readonly Strategy _strategy;
        private Border overlayGrid;
        private TextBlock titleBlock;
        private TextBlock bodyBlock;
        private bool isVisible;
        private DispatcherTimer hideTimer;

        public RiskOverlayHelper(Strategy strategy)
        {
            _strategy = strategy;
        }

        public void TryShow(string title, string body)
        {
            if (_strategy?.ChartControl == null) return;
            var chartControl = _strategy.ChartControl;
            if (chartControl.Dispatcher == null) return;

            chartControl.Dispatcher.InvokeAsync(() =>
            {
                EnsureOverlay();
                if (titleBlock != null) titleBlock.Text = title ?? "AVISO AO TRADER";
                if (bodyBlock != null) bodyBlock.Text = body ?? string.Empty;
                var parent = FindParentPanel(chartControl);
                if (parent == null) return;

                if (!parent.Children.Contains(overlayGrid))
                    parent.Children.Add(overlayGrid);

                Panel.SetZIndex(overlayGrid, 9999);
                isVisible = true;
                StartHideTimer(parent);
            });
        }

        private void EnsureOverlay()
        {
            if (overlayGrid != null) return;

            overlayGrid = new Border
            {
                Background = new SolidColorBrush(Color.FromArgb(190, 0, 0, 0)),
                BorderThickness = new Thickness(2),
                BorderBrush = OverlayWarningRed,
                CornerRadius = new CornerRadius(10),
                HorizontalAlignment = HorizontalAlignment.Stretch,
                VerticalAlignment = VerticalAlignment.Stretch,
                Margin = new Thickness(20),
                Padding = new Thickness(20)
            };

            var content = new StackPanel
            {
                HorizontalAlignment = HorizontalAlignment.Center,
                VerticalAlignment = VerticalAlignment.Center
            };

            titleBlock = new TextBlock
            {
                Text = "AVISO AO TRADER",
                Foreground = OverlayWarningRed,
                FontSize = 22,
                FontWeight = FontWeights.SemiBold,
                TextAlignment = TextAlignment.Center,
                Margin = new Thickness(0, 0, 0, 8)
            };

            bodyBlock = new TextBlock
            {
                Text = string.Empty,
                Foreground = Brushes.White,
                FontSize = 16,
                TextWrapping = TextWrapping.Wrap,
                TextAlignment = TextAlignment.Center
            };

            content.Children.Add(titleBlock);
            content.Children.Add(bodyBlock);
            overlayGrid.Child = content;
        }

        private Panel FindParentPanel(DependencyObject node)
        {
            while (node != null)
            {
                if (node is Panel panel) return panel;
                node = VisualTreeHelper.GetParent(node);
            }
            return null;
        }

        private void StartHideTimer(Panel parent)
        {
            if (hideTimer == null)
            {
                hideTimer = new DispatcherTimer { Interval = TimeSpan.FromSeconds(20) };
                hideTimer.Tick += (s, e) =>
                {
                    hideTimer.Stop();
                    try
                    {
                        if (overlayGrid != null && parent.Children.Contains(overlayGrid))
                            parent.Children.Remove(overlayGrid);
                    }
                    catch { }
                    isVisible = false;
                };
            }
            hideTimer.Stop();
            hideTimer.Start();
        }
    }
