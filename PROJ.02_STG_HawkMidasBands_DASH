        private void EvaluateBreakEvenFromSecondarySeries()
        {
            if (Position.MarketPosition == MarketPosition.Flat || breakevenAtivado || !stopAlvoConfigurados) return;

            bool isHistoricalLike = State == State.Historical || State == State.Transition;
            if (!isHistoricalLike) return;

            double high = Highs[beBip][0];
            double low = Lows[beBip][0];
            double lastProxy = Position.MarketPosition == MarketPosition.Long ? high : low;
            EvaluateBreakEven("BIP_1M_HIST", lastProxy, high, low, Times[beBip][0]);
        }

        private void EvaluateBreakEven(string source, double priceUsed, double high, double low, DateTime eventTime)
        {
            if (BE_TriggerMultiple <= 0 || BE_ProtectMultiple <= 0) return;
            if (Position.MarketPosition == MarketPosition.Flat || breakevenAtivado) return;

            int baseStopTicks = entryStopTicksUsed;
            if (baseStopTicks <= 0)
                baseStopTicks = StopTypeIsATR ? CalculateStopTicksByATR() : FixedStopTicks;

            double triggerTicks = BE_TriggerMultiple * baseStopTicks;
            double protectTicks = BE_ProtectMultiple * baseStopTicks;
            double entry = Position.AveragePrice;
            double triggerPrice = Position.MarketPosition == MarketPosition.Long
                ? entry + (triggerTicks * tickSize)
                : entry - (triggerTicks * tickSize);
            double beStopPrice = Position.MarketPosition == MarketPosition.Long
                ? entry + (protectTicks * tickSize)
                : entry - (protectTicks * tickSize);
            beStopPrice = Instrument.MasterInstrument.RoundToTickSize(beStopPrice);

            bool touched = Position.MarketPosition == MarketPosition.Long
                ? ((source == "BIP_1M_HIST" && !double.IsNaN(high)) ? high >= triggerPrice : priceUsed >= triggerPrice)
                : ((source == "BIP_1M_HIST" && !double.IsNaN(low)) ? low <= triggerPrice : priceUsed <= triggerPrice);

            bool shouldLogEval = touched || (DateTime.UtcNow - lastBEEvalLogUtc).TotalSeconds >= 5;
            if (shouldLogEval)
            {
                lastBEEvalLogUtc = DateTime.UtcNow;
                Print($"[HawkBE][EVAL] time={eventTime:O} source={source} side={Position.MarketPosition} last={priceUsed} high={high} low={low} triggerPrice={triggerPrice} beStopPrice={beStopPrice} touched={(touched ? 1 : 0)} posQty={Position.Quantity}");
            }

            if (!touched) return;

            ApplyBreakEvenStop(source, eventTime, priceUsed, triggerPrice, beStopPrice, baseStopTicks, triggerTicks, protectTicks);
        }


        #region BreakEven (com log padronizado)
        private void ApplyBreakEvenStop(string source, DateTime eventTime, double priceUsed, double triggerPrice, double newStop, int baseStopTicks, double triggerTicks, double protectTicks)
        {
            try
            {
                if (Position.MarketPosition == MarketPosition.Flat) return;
                if (breakevenAtivado)
                {
                    Print($"[HawkBE][SKIP_ALREADY_ACTIVATED] time={eventTime:O} source={source} side={Position.MarketPosition} pendingStop={pendingBeStopPrice}");
                    return;
                }
                if (stopReplaceInProgress)
                {
                    Print($"[HawkBE][REPLACE_SKIP] time={eventTime:O} source={source} reason=in_progress side={Position.MarketPosition} pendingStop={pendingBeStopPrice}");
                    return;
                }

                string side = Position.MarketPosition == MarketPosition.Long ? "Long" : "Short";
                string prevStopText = currentPlannedStop.HasValue ? currentPlannedStop.Value.ToString(CultureInfo.InvariantCulture) : "null";
                string prevTargetText = currentPlannedTarget.HasValue ? currentPlannedTarget.Value.ToString(CultureInfo.InvariantCulture) : "null";

                Print($"[HawkBE][TRIGGER] time={eventTime:O} source={source} side={side} priceUsed={priceUsed} triggerPrice={triggerPrice} beStopPrice={newStop} entryPrice={Position.AveragePrice} baseStopTicks={baseStopTicks} triggerMultiple={BE_TriggerMultiple} protectMultiple={BE_ProtectMultiple} prevStop={prevStopText} prevTarget={prevTargetText} posQty={Position.Quantity}");

                if (Position.MarketPosition == MarketPosition.Long)
                {
                    pendingStopToCancel = ordemStopLong;
                    pendingBeStopOrder = ExitLongStopMarket(0, true, Position.Quantity, newStop, "BE_Stop", "LongAuto");
                }
                else
                {
                    pendingStopToCancel = ordemStopShort;
                    pendingBeStopOrder = ExitShortStopMarket(0, true, Position.Quantity, newStop, "BE_Stop", "ShortAuto");
                }

                if (pendingBeStopOrder == null)
                {
                    Print($"[HawkBE][STOP_REPLACE_FAILED] time={eventTime:O} source={source} side={side} state=SubmitNull pendingStop={newStop}");
                    RPLog($"[HawkRisk][STOP_REPLACE_FAILED] time0={eventTime:O} source={source} side={side} state=SubmitNull pendingStop={newStop}");
                    bool hasFallbackStop = HasActiveStopForPosition();
                    pendingStopToCancel = null;
                    pendingBeStopOrder = null;
                    pendingBeStopPrice = null;
                    stopReplaceInProgress = false;
                    stopReplaceStartedAt = Core.Globals.MinDate;
                    stopReplaceSide = "";
                    stopReplaceSource = "";
                    stopReplaceMarketTime = Core.Globals.MinDate;
                    if (!hasFallbackStop && Position.MarketPosition != MarketPosition.Flat)
                        ArmEmergencyStop("REPLACE_SUBMIT_NULL");
                    return;
                }

                pendingBeStopPrice = newStop;
                stopReplaceInProgress = true;
                stopReplaceStartedAt = Core.Globals.Now;
                stopReplaceSide = side;
                stopReplaceSource = source;
                stopReplaceMarketTime = eventTime;
                Print($"[HawkBE][STOP_REPLACE_PREPARE] time={eventTime:O} source={source} side={side} pendingStop={newStop} prevStop={(pendingStopToCancel != null ? pendingStopToCancel.StopPrice.ToString(CultureInfo.InvariantCulture) : "null")} pendingOrderId={pendingBeStopOrder?.OrderId}");
                LogStopEvent(pendingBeStopOrder?.Name ?? "BE_Stop", newStop, pendingBeStopOrder?.FromEntrySignal ?? string.Empty);

                double? targetPrice = currentPlannedTarget
                    ?? (Position.MarketPosition == MarketPosition.Long ? ordemTargetLong?.LimitPrice : ordemTargetShort?.LimitPrice);
                string targetText = targetPrice.HasValue ? targetPrice.Value.ToString(CultureInfo.InvariantCulture) : "null";
                Print($"[HawkBE][REPLACE] time={eventTime:O} source={source} side={side} beStopPrice={newStop} targetPrice={targetText} signalStop=BE_Stop signalTarget=TakeProfit posNow={Position.MarketPosition} posQty={Position.Quantity}");
                PrintCurrentOrdersState("AFTER_BE");
                Print($"[HawkDiag][BE_TRIGGER] time0={eventTime:O} source={source} pos={Position.MarketPosition} entry={Position.AveragePrice} probePrice={priceUsed} triggerPrice={triggerPrice} newStop={newStop} baseStopTicks={baseStopTicks} triggerTicks={triggerTicks} protectTicks={protectTicks}");
                RPLog($"[BE_TRIGGER] time0={eventTime:O} source={source} pos={Position.MarketPosition} entry={Position.AveragePrice} probePrice={priceUsed} triggerPrice={triggerPrice} newStop={newStop} baseStopTicks={baseStopTicks} triggerTicks={triggerTicks} protectTicks={protectTicks}");
            }
            catch (Exception ex) { Log("[Strategy] BE error: " + ex.Message, LogLevel.Error); }
        }

        private bool IsOrderActive(Order order)
        {
            if (order == null) return false;
            return order.OrderState == OrderState.Working
                || order.OrderState == OrderState.Accepted;
        }

        private bool HasActiveStopForPosition()
        {
            if (Position.MarketPosition == MarketPosition.Long)
                return IsOrderActive(ordemStopLong) || IsOrderActive(pendingBeStopOrder);
            if (Position.MarketPosition == MarketPosition.Short)
                return IsOrderActive(ordemStopShort) || IsOrderActive(pendingBeStopOrder);
            return true;
        }

        private void CommitBreakEvenReplace(Order acceptedOrder)
        {
            if (!stopReplaceInProgress) return;

            if (Position.MarketPosition == MarketPosition.Long)
                ordemStopLong = acceptedOrder;
            else if (Position.MarketPosition == MarketPosition.Short)
                ordemStopShort = acceptedOrder;

            if (pendingStopToCancel != null && IsOrderActive(pendingStopToCancel))
            {
                Print($"[HawkBE][STOP_REPLACE_COMMIT] time={stopReplaceMarketTime:O} source={stopReplaceSource} side={stopReplaceSide} cancelPrevId={pendingStopToCancel.OrderId} prevStop={pendingStopToCancel.StopPrice} newStop={pendingBeStopPrice}");
                CancelOrder(pendingStopToCancel);
            }
            else
            {
                Print($"[HawkBE][STOP_REPLACE_COMMIT] time={stopReplaceMarketTime:O} source={stopReplaceSource} side={stopReplaceSide} cancelPrevId=null prevStop=null newStop={pendingBeStopPrice}");
            }

            currentPlannedStop = pendingBeStopPrice;
            breakevenAtivado = true;
            ClearBreakEvenReplaceState();
            PrintCurrentOrdersState("AFTER_BE_COMMIT");
        }

        private void FailBreakEvenReplace(Order failedOrder, OrderState state, ErrorCode error, string nativeError)
        {
            Print($"[HawkBE][STOP_REPLACE_FAILED] time={stopReplaceMarketTime:O} source={stopReplaceSource} side={stopReplaceSide} state={state} error={error} nativeError={nativeError} pendingStop={pendingBeStopPrice}");
