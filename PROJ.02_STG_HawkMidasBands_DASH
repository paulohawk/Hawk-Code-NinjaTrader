        #region Daily Reset
        private void ResetDailyBlockIfNewTradingDay(DateTime barTime)
        {
            try
            {
                DateTime dateKey = barTime.Date;
                if (dateKey == lastResetDate)
                    return;

                DateTime currentTradingDay = Core.Globals.MinDate;
                if (Bars != null)
                {
                    try
                    {
                        var si = new SessionIterator(Bars);
                        currentTradingDay = si.GetTradingDay(barTime);
                    }
                    catch { }
                }

                DateTime prevTradingDay = lastResetTradingDay;
                DateTime prevDate = lastResetDate;
                string prevStatus = statusText;
                bool prevBlocked = blockedAfterClose;

                lastResetDate = dateKey;
                if (currentTradingDay != Core.Globals.MinDate)
                    lastResetTradingDay = currentTradingDay;

                blockedAfterClose = false;
                blockedAfterCloseLogged = false;
                blockedAfterCloseDate = Core.Globals.MinDate;
                cancelExecutedToday = false;
                closeExecutedToday = false;

                if (prevStatus == "Blocked (após zera)")
                    statusText = "Waiting (aguardando)";

                Print($"[HawkDiag][DAY_RESET] barTime={barTime:O} prevDate={prevDate:yyyy-MM-dd} newDate={dateKey:yyyy-MM-dd} prevTD={prevTradingDay:O} newTD={lastResetTradingDay:O} afterCloseBlocked:{(prevBlocked ? 1 : 0)}->0 status:\"{prevStatus}\"->\"{statusText}\"");
            }
            catch (Exception ex)
            {
                Print($"[HawkDiag][DAY_RESET][ERROR] {ex.Message}");
            }
        }
