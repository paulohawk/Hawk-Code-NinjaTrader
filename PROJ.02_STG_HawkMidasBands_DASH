        private string GetStopTypeFromName(string orderName)
        {
            if (string.IsNullOrWhiteSpace(orderName)) return "STOPLOSS";
            return orderName.IndexOf("BE", StringComparison.OrdinalIgnoreCase) >= 0
                || orderName.IndexOf("BreakEven", StringComparison.OrdinalIgnoreCase) >= 0
                ? "BREAKEVEN"
                : "STOPLOSS";
        }

        private bool IsStopOrder(NinjaTrader.Cbi.Order order)
        {
            if (order == null) return false;
            if (order.OrderType == OrderType.StopMarket || order.OrderType == OrderType.StopLimit) return true;
            string name = order.Name ?? string.Empty;
            return name.IndexOf("Stop", StringComparison.OrdinalIgnoreCase) >= 0
                || name.IndexOf("BE", StringComparison.OrdinalIgnoreCase) >= 0
                || name.IndexOf("BreakEven", StringComparison.OrdinalIgnoreCase) >= 0;
        }

        private bool IsTargetOrder(NinjaTrader.Cbi.Order order)
        {
            if (order == null) return false;
            string orderName = order.Name ?? string.Empty;
            return orderName.IndexOf("TakeProfit", StringComparison.OrdinalIgnoreCase) >= 0
                || orderName.IndexOf("Target", StringComparison.OrdinalIgnoreCase) >= 0;
        }

        private bool IsAutoCloseOrder(NinjaTrader.Cbi.Order order)
        {
            if (order == null) return false;
            string orderName = order.Name ?? string.Empty;
            return orderName.IndexOf("AutoClose", StringComparison.OrdinalIgnoreCase) >= 0;
        }

        private bool IsPureEntryOrder(NinjaTrader.Cbi.Order order)
        {
            if (order == null) return false;
            string name = order.Name ?? string.Empty;
            return name.Equals("LongAuto", StringComparison.OrdinalIgnoreCase)
                || name.Equals("ShortAuto", StringComparison.OrdinalIgnoreCase);
        }

        private bool IsEntryDerivedOrder(NinjaTrader.Cbi.Order order)
        {
            return IsStopOrder(order) || IsTargetOrder(order) || IsAutoCloseOrder(order);
        }

        private bool IsFromMainSignal(NinjaTrader.Cbi.Order order)
        {
            if (order == null) return false;
            string signal = order.FromEntrySignal ?? string.Empty;
            return signal.Equals("LongAuto", StringComparison.OrdinalIgnoreCase)
                || signal.Equals("ShortAuto", StringComparison.OrdinalIgnoreCase);
        }

        private void LogStopEvent(string orderName, double stopPrice, string fromSignal)
        {
            string stopType = GetStopTypeFromName(orderName);
            Print($"[HawkSTOP] type={stopType} orderName={orderName} price={stopPrice} fromSignal={fromSignal}");
        }

        protected override void OnOrderUpdate(
            NinjaTrader.Cbi.Order order,
            double limitPrice,
            double stopPrice,
            int quantity,
            int filled,
            double averageFillPrice,
            OrderState orderState,
            DateTime time,
            ErrorCode error,
            string nativeError)
        {
            try
            {
                if (order == null) return;
                bool isEntryDerived = IsEntryDerivedOrder(order);
                if (isEntryDerived)
                {
                    LogDecision("ORDER_DERIVED", $"name={order.Name}");
                }
                if (!isEntryDerived && IsPureEntryOrder(order))
                {
                    if (order.OrderType != OrderType.Limit)
                    {
                        LogDecision("ENTRY_BLOCKED", $"BlockedMarketOrder type={order.OrderType}");
                        CancelOrder(order);
                        return;
                    }
                    return;
                }

                if (!isEntryDerived
                    && IsFromMainSignal(order)
                    && order.OrderState != OrderState.Filled
                    && order.OrderState != OrderState.PartFilled)
                {
                    LogDecision("ENTRY_BLOCKED", $"InvalidMainSignalOrder type={order.OrderType}");
                    CancelOrder(order);
                    return;
                }
                DateTime orderTime = order.Time;
                if (stopReplaceInProgress && pendingBeStopOrder != null && order == pendingBeStopOrder)
                {
                    if (orderState == OrderState.Working)
                    {
                        CommitBreakEvenReplace(order);
                    }
                    else if (orderState == OrderState.Filled)
                    {
                        ClearBreakEvenReplaceState();
                    }
                    else if (orderState == OrderState.Rejected || orderState == OrderState.Cancelled)
                    {
                        FailBreakEvenReplace(order, orderState, error, nativeError);
                    }
                }
                if (orderState == OrderState.Filled || orderState == OrderState.Cancelled || orderState == OrderState.Rejected)
                {
                    Print($"[HawkORDER_REAL] orderTime={orderTime:O} cbTime={time:O} source=order.Time name={order.Name} id={order.OrderId} state={orderState} action={order.OrderAction} type={order.OrderType} qty={order.Quantity} filled={order.Filled} avgFill={order.AverageFillPrice} limit={order.LimitPrice} stop={order.StopPrice} oco={order.Oco} error={error} nativeError={nativeError}");
                    if (orderState == OrderState.Rejected)
                    {
                        LogOrder("REJECT", order.OrderType.ToString().ToUpperInvariant(), order.OrderType == OrderType.StopMarket ? order.StopPrice : order.LimitPrice, order.Quantity, error.ToString());
                        RPLog($"[ORDER_REJECT] name={order.Name} id={order.OrderId} action={order.OrderAction} type={order.OrderType} qty={order.Quantity} filled={order.Filled} avgFill={order.AverageFillPrice} limit={order.LimitPrice} stop={order.StopPrice} orderTime={orderTime:O} cbTime={time:O} source=order.Time error={error} nativeError={nativeError} pos={Position.MarketPosition} posQty={Position.Quantity} entry={currentEntryPrice} plannedStop={currentPlannedStop} plannedTarget={currentPlannedTarget}");
                    }
                    else if (orderState == OrderState.Cancelled)
                    {
                        LogOrder("CANCEL", order.OrderType.ToString().ToUpperInvariant(), order.OrderType == OrderType.StopMarket ? order.StopPrice : order.LimitPrice, order.Quantity);
                    }
                }
            }
            catch { }
        }

        protected override void OnPositionUpdate(Position position, double averagePrice, int quantity, MarketPosition marketPosition)
        {
            try
            {
                if (position.Account != Account || position.Instrument != Instrument) return;

                if (marketPosition == MarketPosition.Flat)
                {
                    currentState = TradeState.Idle;
                    if (lastKnownPositionQty != 0 && currentEntryPrice.HasValue)
                    {
                        lastTradeQty = Math.Abs(lastKnownPositionQty);
                        lastTradeEntry = currentEntryPrice;
                        lastTradeStop = currentPlannedStop;
                        lastTradeTarget = currentPlannedTarget;
                        lastTradeStatus = "Closed";

                        AddLedgerItem(currentEntryPrice.Value, averagePrice, lastKnownPositionQty > 0, currentPlannedStop, currentPlannedTarget);
                    }

                    string closeSide = lastKnownPositionQty > 0 ? "LONG" : lastKnownPositionQty < 0 ? "SHORT" : "FLAT";
                    LogPosition("CLOSE", closeSide, Math.Abs(lastKnownPositionQty), "PositionFlat");
                    CancelAndClearWorkingOrders();
                    stopAlvoConfigurados = false;
                    bracketQtyLatched = 0;
                    riscoPrecoAtual = 0;
                    ordemStopLong = null; ordemStopShort = null;
                    ordemTargetLong = null; ordemTargetShort = null;
                    breakevenAtivado = false;
                    stopReplaceInProgress = false;
                    pendingBeStopOrder = null;
                    pendingStopToCancel = null;
                    pendingBeStopPrice = null;
                    stopReplaceStartedAt = Core.Globals.MinDate;
                    stopReplaceSide = "";
                    stopReplaceSource = "";
                    stopReplaceMarketTime = Core.Globals.MinDate;
                    stopMissingConsecutive = 0;
                    lastKnownPositionQty = 0;
                    entryStopTicksUsed = 0;
                    sideLatched = LatchedSide.None;
                    qtyLatched = 0;
                    currentPlannedStop = null;
                    currentPlannedTarget = null;
                    currentEntryPrice = null;
                    statusText = lastTradeQty.HasValue ? "Closed" : "Waiting (aguardando)";
                    realtimeEntryFirstFillTime = Core.Globals.MinDate;
                    lastBracketMarketTime = Core.Globals.MinDate;

                    ConsolidatePerformanceIfNeeded(force: true);
                    return;
                }

                if (ordemHedgeBuyStop != null) CancelOrder(ordemHedgeBuyStop);
                if (ordemHedgeSellStop != null) CancelOrder(ordemHedgeSellStop);
                ordemHedgeBuyStop = null; ordemHedgeSellStop = null;

                int desiredQty = Math.Abs(position.Quantity);
                lastKnownPositionQty = position.Quantity;

                if (ExecutionMode == ExecutionModeType.RealtimePrecise)
                {
                    currentState = TradeState.PositionOpen;
                    // Em modo RealtimePrecise o bracket é configurado apenas no fill final
                    // (OnExecutionUpdate com OrderState.Filled), evitando churn em PartFilled.
                    currentEntryPrice = currentEntryPrice ?? averagePrice;

                    statusText = marketPosition == MarketPosition.Long ? "Posição Long" : "Posição Short";
                    LogPosition("OPEN", marketPosition == MarketPosition.Long ? "LONG" : "SHORT", desiredQty);
                    return;
                }

                double vwapHigh = double.NaN, vwapLow = double.NaN;
                try { vwapHigh = vwap.Values[0][0]; vwapLow = vwap.Values[2][0]; } catch { }

                double atrVal = (atrInd != null) ? atrInd[0] * ATRMultiplier : 0.0;
                double cushion = SlippageCushionTicksForRisk * tickSize;

                if (marketPosition == MarketPosition.Long)
                {
                    currentState = TradeState.PositionOpen;
                    double stopBase = StopTypeIsATR ? vwapLow - atrVal : averagePrice - FixedStopTicks * tickSize;
                    double stopPrice = Instrument.MasterInstrument.RoundToTickSize(stopBase - cushion);
                    double riscoPreco = averagePrice - stopPrice;
                    double alvoPrice = Instrument.MasterInstrument.RoundToTickSize(averagePrice + riscoPreco * TPFactor);

                    precoEntradaAtual = averagePrice; riscoPrecoAtual = riscoPreco; breakevenAtivado = false;
                    entryStopTicksUsed = Math.Max(1, (int)Math.Round((precoEntradaAtual - stopPrice) / tickSize));

                    EnsureLongStopsTargets(desiredQty, stopPrice, alvoPrice);
                    currentPlannedStop = stopPrice;
                    currentPlannedTarget = alvoPrice;
                    currentEntryPrice = averagePrice;
                    stopAlvoConfigurados = true; ordemLimiteCompra = null; compraFeitaNaSessao = true;

                    statusText = "Posição Long";
                    LogPosition("OPEN", "LONG", desiredQty);
                    PrintCurrentOrdersState("AFTER_STOP_TARGET_SETUP");
                    ClearPendingSnapshot();
                }
                else if (marketPosition == MarketPosition.Short)
                {
                    currentState = TradeState.PositionOpen;
                    double stopBase = StopTypeIsATR ? vwapHigh + atrVal : averagePrice + FixedStopTicks * tickSize;
                    double stopPrice = Instrument.MasterInstrument.RoundToTickSize(stopBase + cushion);
                    double riscoPreco = stopPrice - averagePrice;
                    double alvoPrice = Instrument.MasterInstrument.RoundToTickSize(averagePrice - riscoPreco * TPFactor);

                    precoEntradaAtual = averagePrice; riscoPrecoAtual = riscoPreco; breakevenAtivado = false;
                    entryStopTicksUsed = Math.Max(1, (int)Math.Round((stopPrice - precoEntradaAtual) / tickSize));

                    EnsureShortStopsTargets(desiredQty, stopPrice, alvoPrice);
                    currentPlannedStop = stopPrice;
                    currentPlannedTarget = alvoPrice;
                    currentEntryPrice = averagePrice;
                    stopAlvoConfigurados = true; ordemLimiteVenda = null; vendaFeitaNaSessao = true;

                    statusText = "Posição Short";
                    LogPosition("OPEN", "SHORT", desiredQty);
                    PrintCurrentOrdersState("AFTER_STOP_TARGET_SETUP");
                    ClearPendingSnapshot();
                }
            }
            catch (Exception ex) { Log("[Strategy] OnPositionUpdate error: " + ex.Message, LogLevel.Error); }
        }

        private void AddLedgerItem(double entryPrice, double exitPrice, bool isLong, double? plannedStop, double? plannedTarget)
        {
            try
            {
                var cache = GetOrCreateCache();
                double profit = (exitPrice - entryPrice) * pontoValor * (isLong ? 1 : -1) * Math.Abs(lastKnownPositionQty);
                var li = new LedgerItem
                {
                    ExitTime = Time[0],
                    TradingDay = GetTradingDayFromTime(Time[0]),
                    Qty = Math.Abs(lastKnownPositionQty),
                    EntryPrice = entryPrice,
                    ExitPrice = exitPrice,
                    Profit = profit,
                    IsLong = isLong,
                    PlannedStop = plannedStop,
                    PlannedTarget = plannedTarget,
                    BEApplied = breakevenAtivado
                };
                cache.Ledger.Add(li);
                if (EnableDiskCache)
                    SaveSnapshot(cache);
            }
            catch (Exception ex)
            {
                DPrint("[Ledger] erro: " + ex.Message);
            }
        }

        protected override void OnExecutionUpdate(Execution execution, string executionId, double price, int quantity, MarketPosition marketPosition, string orderId, DateTime time)
        {
            try
            {
                if (execution == null) return;
                DateTime execTime = execution.Time;
                if (execution.Order != null)
                {
                    if (execution.Order.OrderAction == OrderAction.Buy) longTradedToday = true;
                    else if (execution.Order.OrderAction == OrderAction.SellShort) shortTradedToday = true;
                }

                // Log de execução preenchida
                if (execution?.Order != null && quantity > 0)
                {
                    Print($"[HawkEXEC_REAL] execTime={execTime:O} source=execution.Time orderName={execution.Order.Name} orderAction={execution.Order.OrderAction} orderType={execution.Order.OrderType} orderState={execution.Order.OrderState} filledQty={quantity} fillPrice={price} mpArg={marketPosition} posNow={Position.MarketPosition} posQty={Position.Quantity} posAvg={Position.AveragePrice} oco={execution.Order.Oco} fromSignal={execution.Order.FromEntrySignal}");
                    LogExecution(price, quantity);
                    if (IsStopOrder(execution.Order))
                    {
                        LogStopEvent(execution.Order.Name, price, execution.Order.FromEntrySignal);
                    }
                }

                if (execution.Order != null && execution.Order.OrderState == OrderState.Filled)
                {
                    bool isExitOrder = IsStopOrder(execution.Order)
                        || IsTargetOrder(execution.Order)
                        || IsAutoCloseOrder(execution.Order);
                    if (isExitOrder)
                    {
                        sideLatched = LatchedSide.None;
                        qtyLatched = 0;
                        currentState = TradeState.Idle;
                        if (IsOrderWorking(ordemLimiteCompra)) CancelOrder(ordemLimiteCompra);
                        if (IsOrderWorking(ordemLimiteVenda)) CancelOrder(ordemLimiteVenda);
                        ordemLimiteCompra = null;
                        ordemLimiteVenda = null;
                        if (IsOrderWorking(ordemHedgeBuyStop)) CancelOrder(ordemHedgeBuyStop);
                        if (IsOrderWorking(ordemHedgeSellStop)) CancelOrder(ordemHedgeSellStop);
                        ordemHedgeBuyStop = null;
                        ordemHedgeSellStop = null;
                    }
                }

                if (ExecutionMode == ExecutionModeType.RealtimePrecise && execution.Order != null)
                {
                    /*
                    FLUXO REALTIME — BRACKET:
                    1) Primeiro consumo (PartFilled ou Filled):
                       → cria imediatamente o bracket com a quantidade atual.
                    2) Fills adicionais no mesmo candle:
                       → ignorados (sem reconfiguração).
                    3) Fechamento do candle de 1 minuto:
                       → se a quantidade aumentou, cancela e recria o bracket consolidado.
                    4) Histórico e backtest:
                       → comportamento inalterado.
                    */
                    bool isEntryAction = execution.Order.OrderAction == OrderAction.Buy || execution.Order.OrderAction == OrderAction.SellShort;
                    bool isEntryCandidate = isEntryAction && IsPureEntryOrder(execution.Order);

                    if (isEntryCandidate && marketPosition != MarketPosition.Flat && quantity > 0
                        && (execution.Order.OrderState == OrderState.PartFilled || execution.Order.OrderState == OrderState.Filled)
                        && realtimeEntryFirstFillTime == Core.Globals.MinDate)
                    {
                        realtimeEntryFirstFillTime = execution.Time;
                        RPLog($"[ENTRY_FIRST_FILL] timeMarket={execution.Time:O} timeLocal={Core.Globals.Now:O} name={execution.Order.Name} signal={execution.Order.FromEntrySignal} qty={quantity} pos={marketPosition}");
                    }

                    bool isEntryFillEvent = execution.Order.OrderState == OrderState.PartFilled || execution.Order.OrderState == OrderState.Filled;
                    if (isEntryCandidate && isEntryFillEvent && marketPosition != MarketPosition.Flat && !stopAlvoConfigurados)
                    {
                        int desiredQty = Math.Abs(Position.Quantity);
                        if (desiredQty == 0) desiredQty = Math.Abs(quantity);
                        if (desiredQty == 0) desiredQty = Math.Abs(execution.Order.Filled);

                        double entryPrice = Position.AveragePrice > 0 ? Position.AveragePrice : price;
                        RPLog($"[ENTRY_FILL] timeMarket={execution.Time:O} timeLocal={Core.Globals.Now:O} source=ExecutionUpdate.FirstConsumption name={execution.Order.Name} signal={execution.Order.FromEntrySignal} action={execution.Order.OrderAction} qty={desiredQty} entryPrice={entryPrice} mp={marketPosition}");
                        ConfigureStopsTargetsForEntry(marketPosition, entryPrice, desiredQty, "ExecutionUpdate.FirstConsumption", execution.Time);
                    }

                    if (isEntryCandidate && execution.Order.OrderState == OrderState.PartFilled)
                    {
                        RPLog($"[ENTRY_PARTIAL_SKIP] timeMarket={execution.Time:O} timeLocal={Core.Globals.Now:O} source=ExecutionUpdate.PartFilled name={execution.Order.Name} signal={execution.Order.FromEntrySignal} orderFilled={execution.Order.Filled} execQty={quantity} pos={marketPosition}");
                        return;
                    }
                }

                if (!PlotExitLines) return;
                if (execution.Order != null)
                {
                    string execKey = execution.Order.OrderId + "_" + execution.ExecutionId;
                    if (!plottedExecutions.Contains(execKey))
                    {
                        TryDrawExitFromExecution(execution);
                        plottedExecutions.Add(execKey);
                    }
                }
            }
            catch (Exception ex) { Log("[Strategy] OnExecutionUpdate error: " + ex.Message, LogLevel.Error); }
        }


        private void EvaluateRealtimeBracketWatchdog()
        {
            if (ExecutionMode != ExecutionModeType.RealtimePrecise) return;
            if (Position.MarketPosition == MarketPosition.Flat) return;
            if (stopAlvoConfigurados) return;
            if (realtimeEntryFirstFillTime == Core.Globals.MinDate) return;

            TimeSpan elapsed = Core.Globals.Now - realtimeEntryFirstFillTime;
            if (elapsed.TotalSeconds < realtimeBracketWatchdogSeconds) return;

            int desiredQty = Math.Abs(Position.Quantity);
            if (desiredQty <= 0) return;

            double entryPrice = Position.AveragePrice > 0 ? Position.AveragePrice : currentEntryPrice ?? 0;
            if (entryPrice <= 0) return;

            RPLog($"[ENTRY_WATCHDOG] timeMarket={(CurrentBar >= 0 ? Time[0] : Core.Globals.Now):O} timeLocal={Core.Globals.Now:O} elapsedSec={elapsed.TotalSeconds:F1} qty={desiredQty} entryPrice={entryPrice} pos={Position.MarketPosition} source=RealtimePreciseWatchdog");
            ConfigureStopsTargetsForEntry(Position.MarketPosition, entryPrice, desiredQty, "RealtimeWatchdog", CurrentBar >= 0 ? Time[0] : Core.Globals.Now);
            realtimeEntryFirstFillTime = Core.Globals.MinDate;
        }

        private void EvaluateRealtimeBracketConsolidation()
        {
            if (ExecutionMode != ExecutionModeType.RealtimePrecise) return;
            if (BarsInProgress != 0) return;
            if (Position.MarketPosition == MarketPosition.Flat || !stopAlvoConfigurados) return;

            // Dispara no fechamento do candle (OnBarClose) ou no primeiro tick do candle novo (OnEachTick).
            if (!(Calculate == Calculate.OnBarClose || IsFirstTickOfBar)) return;

            int desiredQty = Math.Abs(Position.Quantity);
            if (desiredQty <= 0 || desiredQty == bracketQtyLatched) return;

            double entryPrice = Position.AveragePrice > 0 ? Position.AveragePrice : currentEntryPrice ?? 0;
            if (entryPrice <= 0) return;

            DateTime marketTs = (Calculate == Calculate.OnBarClose)
                ? Time[0] // candle que acabou de fechar (modo OnBarClose)
                : (CurrentBar > 0 ? Time[1] : Time[0]); // candle recém-fechado (modo OnEachTick)

            RPLog($"[ENTRY_CONSOLIDATE] timeMarket={marketTs:O} timeLocal={Core.Globals.Now:O} source=BracketConsolidation qtyPrev={bracketQtyLatched} qtyNew={desiredQty} mp={Position.MarketPosition}");
            ConfigureStopsTargetsForEntry(Position.MarketPosition, entryPrice, desiredQty, "BracketConsolidation", marketTs, true);
        }

        private void TryDrawExitFromExecution(Execution execution)
        {
            try
            {
                if (execution.Order == null) return;
                string name = execution.Order.Name ?? "";
                double px = execution.Price;
                DateTime execTime = execution.Time;

                bool isTP = name.IndexOf("TakeProfit", StringComparison.OrdinalIgnoreCase) >= 0 || name.IndexOf("TARGET", StringComparison.OrdinalIgnoreCase) >= 0;
                bool isSL = name.IndexOf("StopLoss", StringComparison.OrdinalIgnoreCase) >= 0 || name.IndexOf("STOP", StringComparison.OrdinalIgnoreCase) >= 0;
                bool isBE = name.IndexOf("BE", StringComparison.OrdinalIgnoreCase) >= 0 || name.IndexOf("BreakEven", StringComparison.OrdinalIgnoreCase) >= 0;
                bool isEND = name.IndexOf("CloseByTime", StringComparison.OrdinalIgnoreCase) >= 0 || name.IndexOf("SaidaAutomatica", StringComparison.OrdinalIgnoreCase) >= 0;

                if (!isTP && !isSL && !isBE && !isEND)
                    return;

                string label = isTP ? "TP" : isBE ? "BR" : isSL ? "SL" : "END";
                Brush brush = isTP ? Brushes.Green : isBE ? Brushes.DodgerBlue : isSL ? Brushes.Red : Brushes.Gold;
                DrawExitWithSessionLimit(execTime, px, label, brush);
            }
            catch { }
        }

        private void DrawExitWithSessionLimit(DateTime execTime, double price, string label, Brush brush)
        {
            int barIdx = Bars.GetBar(execTime);
            if (barIdx < 0) return;

            SessionIterator si = new SessionIterator(Bars);
            si.GetNextSession(Times[0][0], true);
            DateTime sessStart = si.ActualSessionBegin;
            int barSessStart = Bars.GetBar(sessStart);
            if (barSessStart < 0) barSessStart = 0;

            int barsIntoSession = barIdx - barSessStart;
            if (barsIntoSession < 1) barsIntoSession = 1;

            int sessionLenEstimate = Math.Max(1, barsIntoSession + 1);
            int halfSession = Math.Max(1, sessionLenEstimate / 2);
            int L = Math.Min(Math.Max(1, LineLengthBars), halfSession);
            L = Math.Min(L, barsIntoSession);
            if (L < 1) L = 1;

            int arrowBarsAgo = -(L + 1);
            int labelBarsAgo = -(L + 2);

            double tick = Instrument.MasterInstrument.TickSize;
            double lineY = price + 2 * tick;
            double arrowY = lineY - 0.5 * tick;
            double labelY = lineY + 0.5 * tick;

            string arrowGlyph = label.Equals("SL", StringComparison.OrdinalIgnoreCase) ? "▼" : "▲";

            Draw.Line(this, $"exit_{label}_{execTime:HHmmss}_{CurrentBar}_line", 0, lineY, -L, lineY, brush);
            Draw.Text(this, $"exit_{label}_{execTime:HHmmss}_{CurrentBar}_arrow", arrowGlyph, arrowBarsAgo, arrowY, brush);
            Draw.Text(this, $"exit_{label}_{execTime:HHmmss}_{CurrentBar}_lbl", label, labelBarsAgo, labelY, brush);
        }
