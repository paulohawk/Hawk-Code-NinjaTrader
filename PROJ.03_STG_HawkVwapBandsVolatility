		#region PreClose (start flatten a few minutes before FlattenTime)
		private DateTime _lastPreCloseDate = DateTime.MinValue;

		private bool TryPreCloseIfScheduled(DateTime barTime, int minutesBeforeFlatten)
		{
			if (isLockedForDay) return false;

			DateTime calDay = ConvertToBrasilia(barTime).AddMinutes(UserBrtOffsetMinutes).Date;

			if (_lastPreCloseDate.Date == calDay.Date)
				return false;

			TimeSpan brNow = ConvertToBrasilia(barTime).AddMinutes(UserBrtOffsetMinutes).TimeOfDay;

			TimeSpan preCloseTime = flattenSpan - TimeSpan.FromMinutes(Math.Max(1, minutesBeforeFlatten));
			if (preCloseTime < TimeSpan.Zero) preCloseTime = TimeSpan.Zero;

			if (brNow < preCloseTime)
				return false;

			_lastPreCloseDate = calDay.Date;

			LogMsg("PreClose", $"Starting flatten early at {brNow} (preClose={preCloseTime}, FlattenTime={flattenSpan})", 2);

			// Do NOT lock day yet; lock only at AutoClose.
			RequestFlatten("PreClose", allowAccountFallback: State == State.Realtime && !isAnalyzerMode);

			PublishPanelSnapshot("PreClose");
			return true;
		}
		#endregion

		#region AutoClose (flatten + lock 1x por dia calendário BRT)
		private bool TryAutoCloseIfScheduled(DateTime barTime)
		{
			DateTime calDay = ConvertToBrasilia(barTime).AddMinutes(UserBrtOffsetMinutes).Date;

			if (lastAutoCloseDate.Date == calDay.Date)
				return false;

			TimeSpan brNow = ConvertToBrasilia(barTime).AddMinutes(UserBrtOffsetMinutes).TimeOfDay;

			if (brNow < flattenSpan)
				return false;

			lastAutoCloseDate = calDay.Date;

			LogMsg("AutoClose", $"Horário atingido (FlattenTime={flattenSpan}); cancel + FLATTEN MKT + lock até 00:00 BRT", 2);

			RequestFlatten("AutoClose", allowAccountFallback: State == State.Realtime && !isAnalyzerMode);
			LockDay("AutoClose", barTime.ToUniversalTime());

			PublishPanelSnapshot("AutoClose");
			return true;
		}
