								else
								{
									EnterShort(0, QuantityPerGridOrder, "SlowStoch_Short");
									MarkActionExecuted();
								}
							}
						}
					}

					if (Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
						ApplyBreakEvenIfTriggered();

					CheckFlattenProgress();
					PublishPanelSnapshot("OnBarUpdate");
				}
			}
