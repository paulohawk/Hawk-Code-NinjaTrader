		#region VWAP exit
		private void MaintainVwapExitOrder(double vwap)
		{
			if (isLockedForDay || flattenInProgress) { CancelExitVwap(); return; }

			int qty = Math.Abs(Position.Quantity);
			if (qty <= 0) { CancelExitVwap(); return; }

			double ts = Instrument.MasterInstrument.TickSize;
			double repricingThreshold = ts * 0.5;

			if (exitVwapOrderReplace != null && IsActiveOrSubmitted(exitVwapOrderReplace))
			{
				return;
			}

			if (exitVwapOrder != null && (exitVwapOrder.OrderState == OrderState.CancelPending || exitVwapOrder.OrderState == OrderState.CancelSubmitted))
			{
				LogMsg("VWAPExitSkipReprice", $"state={exitVwapOrder.OrderState} reason=cancel_in_progress", 3);
				return;
			}

			if (Position.MarketPosition == MarketPosition.Long)
			{
				if (exitVwapOrder != null && IsActiveOrSubmitted(exitVwapOrder))
				{
					if (Math.Abs(exitVwapOrder.LimitPrice - vwap) > repricingThreshold ||
					    exitVwapOrder.Quantity != qty)
					{
						if (BlockIfSameBar("VWAPExitReplace")) return;
						if (HasWorkingOrders(exitVwapOrderReplace))
						{
							_lastBlockReason = "block_working_exit:VWAPExitReplace";
							SupportDump("trade_blocked");
							LogMsg("OrderBlock", "blocked working exit order for VWAPExitReplace", 3);
							return;
						}
						exitVwapOrderReplace = ExitLongLimit(0, true, qty, vwap, "VWAPExitL_R", null);
						if (exitVwapOrderReplace != null)
						{
							MarkActionExecuted();
							SupportDump($"order_sent:{exitVwapOrderReplace.Name}");
						}
						LogMsg("VWAPExitReplaceSubmit", $"old={exitVwapOrder.LimitPrice:0.00} new={vwap:0.00}", 2);
					}
					return;
				}

				if (BlockIfSameBar("VWAPExitNew")) return;
				if (HasWorkingOrders(exitVwapOrder))
				{
					_lastBlockReason = "block_working_exit:VWAPExitNew";
					SupportDump("trade_blocked");
					LogMsg("OrderBlock", "blocked working exit order for VWAPExitNew", 3);
					return;
				}
				exitVwapOrder = ExitLongLimit(0, true, qty, vwap, "VWAPExitL", null);
				if (exitVwapOrder != null)
				{
					MarkActionExecuted();
					SupportDump($"order_sent:{exitVwapOrder.Name}");
				}
			}
			else if (Position.MarketPosition == MarketPosition.Short)
			{
				if (exitVwapOrder != null && IsActiveOrSubmitted(exitVwapOrder))
				{
					if (Math.Abs(exitVwapOrder.LimitPrice - vwap) > repricingThreshold ||
					    exitVwapOrder.Quantity != qty)
					{
						if (BlockIfSameBar("VWAPExitReplace")) return;
						if (HasWorkingOrders(exitVwapOrderReplace))
						{
							_lastBlockReason = "block_working_exit:VWAPExitReplace";
							SupportDump("trade_blocked");
							LogMsg("OrderBlock", "blocked working exit order for VWAPExitReplace", 3);
							return;
						}
						exitVwapOrderReplace = ExitShortLimit(0, true, qty, vwap, "VWAPExitS_R", null);
						if (exitVwapOrderReplace != null)
						{
							MarkActionExecuted();
							SupportDump($"order_sent:{exitVwapOrderReplace.Name}");
						}
						LogMsg("VWAPExitReplaceSubmit", $"old={exitVwapOrder.LimitPrice:0.00} new={vwap:0.00}", 2);
					}
					return;
				}

				if (BlockIfSameBar("VWAPExitNew")) return;
				if (HasWorkingOrders(exitVwapOrder))
				{
					_lastBlockReason = "block_working_exit:VWAPExitNew";
					SupportDump("trade_blocked");
					LogMsg("OrderBlock", "blocked working exit order for VWAPExitNew", 3);
					return;
				}
				exitVwapOrder = ExitShortLimit(0, true, qty, vwap, "VWAPExitS", null);
				if (exitVwapOrder != null)
				{
					MarkActionExecuted();
					SupportDump($"order_sent:{exitVwapOrder.Name}");
				}
			}
		}

