					$"avg={snap.AvgPrice:0.00} pnl={snap.UnrealizedPnL:0.00} signal={snap.LastSignal} " +
					$"block={snap.LastBlockReason} action={snap.LastAction}");
			}
			catch { }
		}

		private void UpdateSnapshot(string action = null)
		{
			try
			{
				if (!string.IsNullOrEmpty(action))
					_lastAction = action;

				DateTime stamp = DateTime.UtcNow;
				try
				{
					if (BarsInProgress == 1 && Times != null && Times.Length > 1)
						stamp = Times[1][0];
					else if (Time != null && CurrentBar >= 0)
						stamp = Time[0];
				}
				catch { }

				_snap = new StrategySnapshot
				{
					Time = stamp,
					State = State,
					Position = Position?.MarketPosition ?? MarketPosition.Flat,
					AvgPrice = Position?.AveragePrice ?? 0,
					UnrealizedPnL = _unrealizedPnlManual,
					LastSignal = _lastSignal,
					LastBlockReason = _lastBlockReason,
					LastAction = _lastAction
				};
			}
			catch { }
		}

