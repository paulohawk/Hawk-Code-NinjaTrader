		private void TryAutoCloseByClock(DateTime nowBrt, DateTime barTime)
		{
			DateTime brtDay = nowBrt.Date;
			if (_autoCloseDayBrt != brtDay)
			{
				_autoCloseDayBrt = brtDay;
				_autoCloseExitSentToday = false;
			}
			TimeSpan scheduledTime = GetAutoCloseTimeBrt(brtDay);
			DateTime scheduled = new DateTime(brtDay.Year, brtDay.Month, brtDay.Day, scheduledTime.Hours, scheduledTime.Minutes, scheduledTime.Seconds);

			if (nowBrt < scheduled) return;
			if (_autoCloseExitSentToday) return;


			bool isFlat = Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0;
			if (isFlat)
			{
				_autoCloseExitSentToday = true;
				return;
			}

			if (flattenInProgress) return;

			CancelAllGrid("autoclose");
			CancelExitVwap();
			CancelOppositeBandExit();
			CancelFinancialTarget();
			CancelStopLossForce();
			RequestFlatten("AutoClose", allowAccountFallback: true);
			_autoCloseExitSentToday = true;
		}

