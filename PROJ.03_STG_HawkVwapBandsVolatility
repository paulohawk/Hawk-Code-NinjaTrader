		private int ParseHms(string s)
		{
			if (string.IsNullOrWhiteSpace(s)) return 0;
			var parts = s.Split(':');
			int h = 0, m = 0, sec = 0;
			try { h = int.Parse(parts[0]); m = parts.Length > 1 ? int.Parse(parts[1]) : 0; sec = parts.Length > 2 ? int.Parse(parts[2]) : 0; } catch { }
			return h * 10000 + m * 100 + sec;
		}

		private int ToHhmmss(TimeSpan time)
		{
			return time.Hours * 10000 + time.Minutes * 100 + time.Seconds;
		}

		private TimeZoneInfo GetBrasiliaTimeZone()
		{
			try
			{
				if (_brtTimeZone != null) return _brtTimeZone;

				TimeZoneInfo brt = null;
				string[] possibleIds = new string[] { "E. South America Standard Time", "America/Sao_Paulo", "SA Eastern Standard Time" };
				foreach (var id in possibleIds)
				{
					try { brt = TimeZoneInfo.FindSystemTimeZoneById(id); if (brt != null) break; } catch { }
				}
				_brtTimeZone = brt;
				return brt;
			}
			catch { return null; }
		}

		private TimeZoneInfo GetUsEasternTimeZone()
		{
			try
			{
				if (_usEasternTimeZone != null) return _usEasternTimeZone;

				TimeZoneInfo eastern = null;
				string[] possibleIds = new string[] { "Eastern Standard Time", "America/New_York" };
				foreach (var id in possibleIds)
				{
					try { eastern = TimeZoneInfo.FindSystemTimeZoneById(id); if (eastern != null) break; } catch { }
				}
				_usEasternTimeZone = eastern;
				return eastern;
			}
			catch { return null; }
		}

		private DateTime ConvertToBrasilia(DateTime dt)
		{
			try
			{
				TimeZoneInfo brt = GetBrasiliaTimeZone();

				if (brt == null) return dt.ToLocalTime();

				if (dt.Kind == DateTimeKind.Utc) return TimeZoneInfo.ConvertTimeFromUtc(dt, brt);
				if (dt.Kind == DateTimeKind.Local)
				{
					DateTime utc = dt.ToUniversalTime();
					return TimeZoneInfo.ConvertTimeFromUtc(utc, brt);
				}
				else
				{
					DateTime local = DateTime.SpecifyKind(dt, DateTimeKind.Local);
					DateTime utc = local.ToUniversalTime();
					return TimeZoneInfo.ConvertTimeFromUtc(utc, brt);
				}
			}
			catch { return dt; }
		}

		private DateTime ConvertToUsEastern(DateTime dt)
		{
			try
			{
				TimeZoneInfo eastern = GetUsEasternTimeZone();
				if (eastern == null) return dt;

				if (dt.Kind == DateTimeKind.Utc) return TimeZoneInfo.ConvertTimeFromUtc(dt, eastern);
				if (dt.Kind == DateTimeKind.Local)
					return TimeZoneInfo.ConvertTime(dt, TimeZoneInfo.Local, eastern);

				TimeZoneInfo brt = GetBrasiliaTimeZone();
				if (brt != null)
				{
					var unspecified = DateTime.SpecifyKind(dt, DateTimeKind.Unspecified);
					return TimeZoneInfo.ConvertTime(unspecified, brt, eastern);
				}

				return TimeZoneInfo.ConvertTime(DateTime.SpecifyKind(dt, DateTimeKind.Unspecified), eastern);
			}
			catch { return dt; }
		}

		private bool IsUsaDstForTradingDay(DateTime tradingDayBrt)
		{
			try
			{
				TimeZoneInfo eastern = GetUsEasternTimeZone();
				if (eastern == null) return false;

				DateTime referenceBrt = tradingDayBrt.Date.AddHours(12);
				DateTime easternTime = ConvertToUsEastern(referenceBrt);
				return eastern.IsDaylightSavingTime(easternTime);
			}
			catch { return false; }
		}

		private TimeSpan GetStartAnalysisTimeBrt(DateTime tradingDayBrt)
		{
			bool usaDst = IsUsaDstForTradingDay(tradingDayBrt);

