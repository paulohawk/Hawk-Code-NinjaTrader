		#region Flatten robusto (2 camadas)
		// Guard rails to avoid duplicate/rapid-fire flatten submits (which can trigger strategy disablement
		// under certain RealtimeErrorHandling modes when an exit is submitted while the position is already closing).
		private int _lastFlattenSubmitBar = -1;
		private DateTime _lastFlattenSubmitUtc = DateTime.MinValue;
		private void RequestFlatten(string reason, bool allowAccountFallback)
		{
			if (flattenInProgress)
			{
				return;
			}

			flattenReason = reason;
			flattenAllowFallback = allowAccountFallback;

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				flattenInProgress = false;
				flattenOrder = null;
				return;
			}

			CancelExitVwap();
			CancelOppositeBandExit();
			CancelFinancialTarget();
			CancelStopLoss();
			CancelAllGrid("force_flatten");

			if (_lastFlattenSubmitBar == CurrentBar)
			{
				return;
			}

			if (_lastFlattenSubmitUtc != DateTime.MinValue &&
				(DateTime.UtcNow - _lastFlattenSubmitUtc).TotalSeconds < 2)
			{
				return;
			}

			flattenAttemptCount = 0;
			flattenStartBar = CurrentBar;
			flattenInProgress = true;

			SubmitFlattenOrder(reason);
		}

		private void SubmitFlattenOrder(string reason)
		{
			int qty = Math.Abs(Position?.Quantity ?? 0);
			if (qty <= 0)
			{
				flattenInProgress = false;
				flattenOrder = null;
				return;
			}

			// If we already have a live flatten order working/accepted/submitted, do not re-submit.
			if (flattenOrder != null && IsActiveOrSubmitted(flattenOrder))
			{
				return;
			}

			// Prevent double-submission on the same bar (e.g., multi-series timing or post-fill lag).
			if (BlockIfSameBar("FlattenSubmit")) return;
			if (_lastFlattenSubmitBar == CurrentBar)
			{
				return;
			}

			flattenAttemptCount++;
			flattenStartBar = CurrentBar;
			_lastFlattenSubmitBar = CurrentBar;
			_lastFlattenSubmitUtc = DateTime.UtcNow;

			// Use explicit-qty market exit to guarantee the command is sent even when entries use named signals.
			// Avoid Account.Flatten() here because it can trigger strategy disablement in some brokerage/connection contexts.
			try
			{
				// Managed approach: market exits do not expose an 'isLiveUntilCancelled' overload.
				// Use the 4-arg overload: (barsInProgressIndex, quantity, signalName, fromEntrySignal).
				if (Position.MarketPosition == MarketPosition.Long)
					flattenOrder = ExitLong(0, qty, "FlattenMktL", string.Empty);
				else if (Position.MarketPosition == MarketPosition.Short)
					flattenOrder = ExitShort(0, qty, "FlattenMktS", string.Empty);
				else
					flattenOrder = null;
			}
			catch (Exception ex)
			{
				flattenOrder = null;
			}

			if (flattenOrder == null)
			else
				MarkActionExecuted();

		}

		private void CheckFlattenProgress()
		{
			if (!flattenInProgress) return;

			// If the flatten order is still live, wait. This prevents rapid re-submits that can
			// trigger strategy disablement via Realtime error handling.
			if (flattenOrder != null && IsActiveOrSubmitted(flattenOrder))
				return;

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				flattenInProgress = false;
				flattenOrder = null;
				return;
			}

			int barsElapsed = CurrentBar - flattenStartBar;
			int minBarsWait = Math.Max(1, flattenRetryBars);
			if (barsElapsed < minBarsWait) return;

			// Keep retrying market-exit submits until the position is flat.
			// We cap the "attempt" counter for logging, but we do not disable the strategy and we avoid Account.Flatten().
			if (flattenAttemptCount < maxFlattenAttempts)
			{
				SubmitFlattenOrder(flattenReason);
				return;
			}

			// After max attempts, continue re-submitting at the same cadence, but do not increase attempts further.

			// Do not increment attempt count anymore; submit directly using the same submit helper but with a temporary decrement.
			int savedAttempts = flattenAttemptCount;
			try
			{
				flattenAttemptCount = maxFlattenAttempts - 1;
				SubmitFlattenOrder(flattenReason);
			}
			finally
			{
				flattenAttemptCount = savedAttempts;
			}
		}
		#endregion

		#region Stop maintenance (ticks + financial priority)
		private void UpdateUnrealizedTicksFromPosition()
		{
			bool isFlat = Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0;
			double openTicksFromEntry = 0;
			unrealizedTicks = 0;
			if (!isFlat && TickSize > 0)
			{
				if (Position.MarketPosition == MarketPosition.Long)
					openTicksFromEntry = (Close[0] - Position.AveragePrice) / TickSize;
				else if (Position.MarketPosition == MarketPosition.Short)
					openTicksFromEntry = (Position.AveragePrice - Close[0]) / TickSize;
				unrealizedTicks = openTicksFromEntry;
			}
			_openTicksFromEntry = openTicksFromEntry;
		}

		private void ApplyBreakEvenIfTriggered()
		{
			if (!EnableBreakEven || breakEvenActivated)
				return;
			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
				return;
			if (IsFailSafeBlocking())
				return;
			if (!EnsureProtectionIntegrity("BreakEven", allowRepair: false, requireProtectionReady: true))
				return;
			if (TickSize <= 0)
				return;
			if (entryPrice == 0)
				return;

			string bracketReason;
			if (!IsBracketValid(GetExitMode(), out bracketReason))
			{
				return;
			}

			double riskTriggerUsd = TradeStopLossUsd * BreakEvenTriggerRiskMultiple;
			if (riskTriggerUsd <= 0)
				return;

			double unrealizedUsd = 0;
			if (Position.MarketPosition == MarketPosition.Long)
			{
				double priceMove = Close[0] - entryPrice;
				unrealizedUsd = priceMove * Instrument.MasterInstrument.PointValue * Position.Quantity;
				if (unrealizedUsd >= riskTriggerUsd)
				{
					double newStop = entryPrice + (BreakEvenOffsetTicks * TickSize);
					newStop = Instrument.MasterInstrument.RoundToTickSize(newStop);
					newStop = AdjustStopPriceForBracket(newStop, Position.MarketPosition, "BreakEven");
					CancelStopLoss();
					CancelFinancialTarget();
					if (BlockIfSameBar("BreakEven")) return;
					if (HasWorkingOrders(stopLossOrder)) return;
					int qty = Math.Abs(Position.Quantity);
					string fromEntry = GetFromEntrySignal();
					stopLossOrder = ExitLongStopMarket(0, true, qty, newStop, "BreakEvenStopL", fromEntry);
					breakEvenActivated = true;
					dayBreakevenDollars = "ON";
					if (GetExitMode() == ExitMode.Financial && !isLockedForDay && !flattenInProgress)
						MaintainFinancialTargetLimit();
					PublishPanelSnapshot("BreakEvenTriggered");
				}
			}
			else if (Position.MarketPosition == MarketPosition.Short)
			{
				double priceMove = entryPrice - Close[0];
				unrealizedUsd = priceMove * Instrument.MasterInstrument.PointValue * Position.Quantity;
				if (unrealizedUsd >= riskTriggerUsd)
				{
					double newStop = entryPrice - (BreakEvenOffsetTicks * TickSize);
					newStop = Instrument.MasterInstrument.RoundToTickSize(newStop);
					newStop = AdjustStopPriceForBracket(newStop, Position.MarketPosition, "BreakEven");
					CancelStopLoss();
					CancelFinancialTarget();
					if (BlockIfSameBar("BreakEven")) return;
					if (HasWorkingOrders(stopLossOrder)) return;
					int qty = Math.Abs(Position.Quantity);
					string fromEntry = GetFromEntrySignal();
					stopLossOrder = ExitShortStopMarket(0, true, qty, newStop, "BreakEvenStopS", fromEntry);
					breakEvenActivated = true;
					dayBreakevenDollars = "ON";
					if (GetExitMode() == ExitMode.Financial && !isLockedForDay && !flattenInProgress)
						MaintainFinancialTargetLimit();
					PublishPanelSnapshot("BreakEvenTriggered");
				}
			}
		}

