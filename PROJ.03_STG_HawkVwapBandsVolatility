		#region Trade limits helpers (por ciclo fechado)
		private void ResetTradeCounters(DateTime calDay)
		{
			tradesClosedTodayTotal = 0;
			tradesClosedTodayBuy = 0;
			tradesClosedTodaySell = 0;
			tradeCountersBrtDate = calDay.Date;

			if (Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
			{
				cycleOpen = true;
				cycleDirection = Position.MarketPosition == MarketPosition.Long ? Regime.Buy : Regime.Sell;
				_cycleRealizedAtEntry = GetCumProfitSafe();
				_entryFilled = true;
				_lastEntryFillUtc = DateTime.UtcNow;
			}
			else
			{
				cycleOpen = false;
				cycleDirection = Regime.None;
				_cycleRealizedAtEntry = 0;
				ResetExecutionCycleGuard("trade_counters_reset");
			}
			breakEvenActivated = false;
			entryPrice = 0.0;
			_lastEntrySignalName = string.Empty;
			_entrySignalCycleId = 0;

			for (int i = 0; i < 5; i++)
			{
				_lastGridRepriceBarLong[i] = -1;
				_lastGridRepriceBarShort[i] = -1;
				gridLongReplace[i] = null;
				gridShortReplace[i] = null;
			}

			_panelCacheSaveRequested = true;
		}

		private bool CanStartNewCycle(Regime side)
		{
			if (side == Regime.None) return false;
			if (_bracketFailSafeActive || _executionCycleLocked) return false;

			if (MaxTradesPerDay > 0 && tradesClosedTodayTotal >= MaxTradesPerDay)
				return false;

			if (EnableTradeDirectionLimits)
			{
				if (side == Regime.Buy && MaxBuysPerDay > 0 && tradesClosedTodayBuy >= MaxBuysPerDay)
					return false;
				if (side == Regime.Sell && MaxSellsPerDay > 0 && tradesClosedTodaySell >= MaxSellsPerDay)
					return false;
			}
			return true;
		}

		private void TrackCycleCounters(DateTime execTime)
		{
			var nowPos = Position?.MarketPosition ?? MarketPosition.Flat;
			int qty = Math.Abs(Position?.Quantity ?? 0);
			Regime side = nowPos == MarketPosition.Long ? Regime.Buy : nowPos == MarketPosition.Short ? Regime.Sell : Regime.None;

			DateTime execDay = ConvertToBrasilia(execTime).AddMinutes(UserBrtOffsetMinutes).Date;
			if (execDay != tradeCountersBrtDate.Date)
				ResetTradeCounters(execDay);

			if (!cycleOpen && nowPos != MarketPosition.Flat && qty > 0)
			{
				_currentCycleId++;
				if (!string.IsNullOrWhiteSpace(_lastEntrySignalName))
					_entrySignalCycleId = _currentCycleId;
				else
					_entrySignalCycleId = 0;
				cycleOpen = true;
				cycleDirection = side;
				breakEvenActivated = false;
				entryPrice = 0.0;
				_cycleRealizedAtEntry = GetCumProfitSafe();
			}

			if (cycleOpen && nowPos == MarketPosition.Flat)
			{
				tradesClosedTodayTotal++;
				if (cycleDirection == Regime.Buy) tradesClosedTodayBuy++;
				else if (cycleDirection == Regime.Sell) tradesClosedTodaySell++;


				try { CancelAllGrid("cycle_closed"); } catch { }
				try { CancelExitVwap(); } catch { }
				try { CancelOppositeBandExit(); } catch { }
				try { CancelFinancialTarget(); } catch { }
				try { CancelStopLoss(); } catch { }

				// Reset per-band fill guards for next cycle
				try { ResetBandFillGuards(); } catch { }

				cycleOpen = false;
				cycleDirection = Regime.None;
				breakEvenActivated = false;
				entryPrice = 0.0;
				_lastEntrySignalName = string.Empty;
				_entrySignalCycleId = 0;
				_cycleRealizedAtEntry = 0;
				ResetExecutionCycleGuard("cycle_closed");
			}
		}
