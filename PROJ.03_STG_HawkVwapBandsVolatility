		#region PnL + streak recalc
		private void ResetHistoricalPanelStats()
		{
			_overallPnl = 0;
			_monthPnl = 0;
			realizedPnlDay = 0;
			_totalPnlDay = 0;
			_unrealizedPnlManual = 0;
			_cachedPnlDay = "0.00";
			_cachedPnlMonth = "0.00";
			_cachedPnlTotal = "0.00";

			_currentStreak = 0;
			_maxGainStreak = 0;
			_maxLossStreak = 0;
			_lastStreakTradesCount = 0;

			_histNetProfit = 0;
			_histGrossProfit = 0;
			_histGrossLoss = 0;
			_histMaxDrawdown = 0;
			_histWinRate = 0;
			_histLossRate = 0;
			_histMaxConsecutiveWins = 0;
			_histMaxConsecutiveLosses = 0;
			_histTotalTrades = 0;
			_histWinningTrades = 0;
			_histLosingTrades = 0;
			_lastSavedHistoricalTradesCount = -1;
		}

		private void RebuildHistoricalStats()
		{
			if (PanelPnlMode != PanelPnLMode.ChartHistorical) return;

			ResetHistoricalPanelStats();

			var trades = SystemPerformance.AllTrades;
			if (trades == null) return;

			DateTime nowLocalBrt;
			try
			{
				nowLocalBrt = ConvertToBrasilia(Time[0]).AddMinutes(UserBrtOffsetMinutes);
			}
			catch
			{
				nowLocalBrt = ConvertToBrasilia(DateTime.UtcNow).AddMinutes(UserBrtOffsetMinutes);
			}

			DateTime today = nowLocalBrt.Date;
			double cumulative = 0;
			double peak = 0;
			int currentWinStreak = 0;
			int currentLossStreak = 0;

			foreach (Trade trade in trades)
			{
				if (trade == null) continue;
				if (trade.Exit == null) continue;

				double pnl = trade.ProfitCurrency;
				_histTotalTrades++;
				cumulative += pnl;

				if (pnl > 0)
				{
					_histGrossProfit += pnl;
					_histWinningTrades++;
					currentWinStreak++;
					currentLossStreak = 0;
					_histMaxConsecutiveWins = Math.Max(_histMaxConsecutiveWins, currentWinStreak);
				}
				else if (pnl < 0)
				{
					_histGrossLoss += pnl;
					_histLosingTrades++;
					currentLossStreak++;
					currentWinStreak = 0;
					_histMaxConsecutiveLosses = Math.Max(_histMaxConsecutiveLosses, currentLossStreak);
				}
				else
				{
					currentWinStreak = 0;
					currentLossStreak = 0;
				}

				if (cumulative > peak) peak = cumulative;
				double drawdown = peak - cumulative;
				if (drawdown > _histMaxDrawdown) _histMaxDrawdown = drawdown;

				DateTime exitBrt = ConvertToBrasilia(trade.Exit.Time).AddMinutes(UserBrtOffsetMinutes);
				DateTime exitDay = exitBrt.Date;
				if (exitDay == today) realizedPnlDay += pnl;
				if (exitDay.Year == today.Year && exitDay.Month == today.Month) _monthPnl += pnl;
			}

			_histNetProfit = _histGrossProfit + _histGrossLoss;
			_overallPnl = _histNetProfit;
			_totalPnlDay = realizedPnlDay;
			_cachedPnlDay = realizedPnlDay.ToString("0.00");
			_cachedPnlMonth = _monthPnl.ToString("0.00");
			_cachedPnlTotal = _overallPnl.ToString("0.00");

			if (_histTotalTrades > 0)
			{
				_histWinRate = (_histWinningTrades / (double)_histTotalTrades) * 100.0;
				_histLossRate = (_histLosingTrades / (double)_histTotalTrades) * 100.0;
			}

			_maxGainStreak = _histMaxConsecutiveWins;
			_maxLossStreak = _histMaxConsecutiveLosses;

			if (trades.Count != _lastSavedHistoricalTradesCount)
			{
				_lastSavedHistoricalTradesCount = trades.Count;
				_panelCacheSaveRequested = true;
			}
		}

		private void RecalcPnLIfNeeded(DateTime nowLocalBrt)
		{
			try
			{
				var all = SystemPerformance.AllTrades;
				int count = all.Count;
				DateTime referenceLocal = nowLocalBrt;
				if (State == State.Historical && CurrentBar >= 0)
					referenceLocal = ConvertToBrasilia(Time[0]).AddMinutes(UserBrtOffsetMinutes);
				double total = all.TradesPerformance.Currency.CumProfit;
				double day = 0;
				double month = 0;
				DateTime todayLocal = referenceLocal.Date;
				DateTime monthStartLocal = new DateTime(referenceLocal.Year, referenceLocal.Month, 1);
				DateTime nextMonthStartLocal = monthStartLocal.AddMonths(1);

				for (int i = 0; i < count; i++)
				{
					var tr = all[i];
					if (tr?.Exit == null) continue;
					DateTime exitBrt = ConvertToBrasilia(tr.Exit.Time).AddMinutes(UserBrtOffsetMinutes);
					DateTime exitDay = exitBrt.Date;
					if (exitDay == todayLocal) day += tr.ProfitCurrency;
					if (exitDay >= monthStartLocal && exitDay < nextMonthStartLocal) month += tr.ProfitCurrency;
				}

				_totalPnlDay = day;
				_overallPnl = total;
				_monthPnl = month;
				realizedPnlDay = day;
				_lastPnlCalcCount = count;
				_lastPnlCalcUtc = DateTime.UtcNow;

				_cachedPnlDay = _totalPnlDay.ToString("0.00");
				_cachedPnlMonth = _monthPnl.ToString("0.00");
				_cachedPnlTotal = _overallPnl.ToString("0.00");
			}
			catch (Exception ex)
			{
				LogMsg("PnLCalcError", "RecalcPnLIfNeeded ex: " + ex.Message, 1);
			}
		}

		private void UpdateUnrealizedAndTotalPnL()
		{
			try
			{
				double pointValue = Instrument?.MasterInstrument?.PointValue ?? 1.0;
				int qty = Math.Abs(Position?.Quantity ?? 0);

				if (Position != null && Position.MarketPosition == MarketPosition.Long && qty > 0)
					_unrealizedPnlManual = (Close[0] - Position.AveragePrice) * pointValue * qty;
				else if (Position != null && Position.MarketPosition == MarketPosition.Short && qty > 0)
					_unrealizedPnlManual = (Position.AveragePrice - Close[0]) * pointValue * qty;
				else
					_unrealizedPnlManual = 0;

				_totalPnlDay = realizedPnlDay + _unrealizedPnlManual;

				_cachedPnlDay = _totalPnlDay.ToString("0.00");
			}
			catch
			{
				_unrealizedPnlManual = 0;
				_totalPnlDay = realizedPnlDay;
			}
		}

		private void UpdateStreaksIfClosedTradesChanged()
		{
			try
			{
				var all = SystemPerformance.AllTrades;
				int count = all.Count;
				if (count <= _lastStreakTradesCount) return;

				var tr = all[count - 1];
				if (tr == null) { _lastStreakTradesCount = count; return; }

				double p = tr.ProfitCurrency;
				if (p > 0)
				{
					_currentStreak = _currentStreak > 0 ? _currentStreak + 1 : 1;
					_maxGainStreak = Math.Max(_maxGainStreak, _currentStreak);
				}
				else if (p < 0)
				{
					_currentStreak = _currentStreak < 0 ? _currentStreak - 1 : -1;
					_maxLossStreak = Math.Max(_maxLossStreak, -_currentStreak);
				}
				else
				{
					_currentStreak = 0;
				}

				_lastStreakTradesCount = count;
			}
			catch (Exception ex)
			{
				LogMsg("StreakCalcError", "UpdateStreaks ex: " + ex.Message, 1);
			}
		}
