		#region OnOrderUpdate / Execution logging
		protected override void OnOrderUpdate(Order order, double limitPrice, double stopPrice, int quantity, int filled, double averageFillPrice, OrderState orderState, DateTime time, ErrorCode error, string nativeError)
		{
			if (order == null) return;

			bool isGrid2 = order.Name != null && (order.Name.Contains("Grid2_Buy") || order.Name.Contains("Grid2_Sell"));
			bool isGrid = order.Name != null && order.Name.StartsWith("Grid", StringComparison.OrdinalIgnoreCase);
			bool isReplace = order.Name != null && order.Name.IndexOf("_R", StringComparison.OrdinalIgnoreCase) >= 0;
			bool isOppBand = order.Name != null && order.Name.StartsWith("OppBandExit", StringComparison.OrdinalIgnoreCase);
			bool isVwap = order.Name != null && order.Name.StartsWith("VWAPExit", StringComparison.OrdinalIgnoreCase);
			bool isFinTarget = order.Name != null && order.Name.StartsWith("FinTarget", StringComparison.OrdinalIgnoreCase);
			bool isCloseBarEntry = order.Name != null &&
				(order.Name.StartsWith(CloseBarEntryLongName, StringComparison.OrdinalIgnoreCase) ||
				 order.Name.StartsWith(CloseBarEntryShortName, StringComparison.OrdinalIgnoreCase));

			if (isGrid2)
				LogMsg("Grid2State", $"state={orderState} name={order.Name} lim={limitPrice:0.00} stop={stopPrice:0.00} filled={filled}/{quantity} err={error} native={nativeError}", 3);
			else
				LogMsg("OrderUpdate", $"{order.Name} state={orderState} qty={quantity} filled={filled} lim={limitPrice:0.00} stop={stopPrice:0.00} avg={averageFillPrice:0.00} err={error} native={nativeError}", error != ErrorCode.NoError ? 1 : 3);

			if (isOppBand && isReplace)
			{
				if (orderState == OrderState.Rejected || orderState == OrderState.Cancelled)
				{
					if (oppositeBandExitOrderReplace == order) oppositeBandExitOrderReplace = null;
					if (orderState == OrderState.Rejected)
						LogMsg("OppBandExitReplaceFailed", $"name={order.Name} err={error} native={nativeError} lim={limitPrice:0.00}", 1);
					return;
				}

				if (orderState == OrderState.Accepted || orderState == OrderState.Working)
				{
					if (oppositeBandExitOrder != null && IsActiveOrSubmitted(oppositeBandExitOrder) && oppositeBandExitOrder != order)
					{
						try { CancelOrder(oppositeBandExitOrder); } catch { }
					}
					oppositeBandExitOrder = order;
					oppositeBandExitOrderReplace = null;
					LogMsg("OppBandExitReplaced", $"name={order.Name} newLim={limitPrice:0.00}", 2);
					return;
				}
			}

			if (isVwap && isReplace)
			{
				if (orderState == OrderState.Rejected || orderState == OrderState.Cancelled)
				{
					if (exitVwapOrderReplace == order) exitVwapOrderReplace = null;
					if (orderState == OrderState.Rejected)
						LogMsg("VWAPExitReplaceFailed", $"name={order.Name} err={error} native={nativeError} lim={limitPrice:0.00}", 1);
					return;
				}

				if (orderState == OrderState.Accepted || orderState == OrderState.Working)
				{
					if (exitVwapOrder != null && IsActiveOrSubmitted(exitVwapOrder) && exitVwapOrder != order)
					{
						try { CancelOrder(exitVwapOrder); } catch { }
					}
					exitVwapOrder = order;
					exitVwapOrderReplace = null;
					LogMsg("VWAPExitReplaced", $"name={order.Name} newLim={limitPrice:0.00}", 2);
					return;
				}
			}

			if (isFinTarget && isReplace)
			{
				if (orderState == OrderState.Rejected || orderState == OrderState.Cancelled)
				{
					if (financialTargetOrderReplace == order) financialTargetOrderReplace = null;
					if (orderState == OrderState.Rejected)
						LogMsg("FinTargetReplaceFailed", $"name={order.Name} err={error} native={nativeError} lim={limitPrice:0.00}", 1);
					return;
				}

				if (orderState == OrderState.Accepted || orderState == OrderState.Working)
				{
					if (financialTargetOrder != null && IsActiveOrSubmitted(financialTargetOrder) && financialTargetOrder != order)
					{
						try { CancelOrder(financialTargetOrder); } catch { }
					}
					financialTargetOrder = order;
					financialTargetOrderReplace = null;
					LogMsg("FinTargetReplaced", $"name={order.Name} newLim={limitPrice:0.00}", 2);
					return;
				}
			}

			if (isGrid && isReplace)
			{
				int idx = -1;
				for (int i = 0; i < 5; i++)
				{
					if (order.Name.IndexOf($"Grid{i + 1}_", StringComparison.OrdinalIgnoreCase) >= 0)
					{
						idx = i; break;
					}
				}
				if (idx >= 0)
				{
					bool isBuy = order.Name.IndexOf("_Buy", StringComparison.OrdinalIgnoreCase) >= 0;
					if (orderState == OrderState.Rejected || orderState == OrderState.Cancelled)
					{
						if (isBuy && gridLongReplace[idx] == order) gridLongReplace[idx] = null;
						if (!isBuy && gridShortReplace[idx] == order) gridShortReplace[idx] = null;
						if (orderState == OrderState.Rejected)
							LogMsg("GridReplaceFailed", $"Grid{idx + 1} {order.OrderAction} rejected lim={limitPrice:0.00} err={error} native={nativeError}", 1);
						return;
					}

					if (orderState == OrderState.Accepted || orderState == OrderState.Working)
					{
						if (isBuy)
						{
							if (gridLong[idx] != null && IsActiveOrSubmitted(gridLong[idx]) && gridLong[idx] != order)
							{
								try { CancelOrder(gridLong[idx]); } catch { }
							}
							gridLong[idx] = order;
							gridLongReplace[idx] = null;
						}
						else
						{
							if (gridShort[idx] != null && IsActiveOrSubmitted(gridShort[idx]) && gridShort[idx] != order)
							{
								try { CancelOrder(gridShort[idx]); } catch { }
							}
							gridShort[idx] = order;
							gridShortReplace[idx] = null;
						}
						LogMsg("GridReplaced", $"Grid{idx + 1} action={order.OrderAction} newLim={limitPrice:0.00}", 3);
						return;
					}
				}
			}

			if (isGrid && orderState == OrderState.Rejected)
			{
				LogMsg("GridRejected", $"name={order.Name} err={error} native={nativeError} lim={limitPrice:0.00} stop={stopPrice:0.00}", 1);
			}

			if (orderState == OrderState.Rejected || orderState == OrderState.Cancelled)
			{
				if (flattenOrder == order) flattenOrder = null;
				if (isCloseBarEntry)
				{
					if (closeBarRearmAfterCancel)
					{
						closeBarRearmAfterCancel = false;
					}
					else
					{
						closeBarOrderPending = false;
						closeBarOrderDirection = Regime.None;
						closeBarOrderSignalClose = double.NaN;
						closeBarOrderCancelBar = -1;
					}
					closeBarOrderActiveDirection = Regime.None;
					closeBarOrderActiveBar = -1;
				}
				ClearOrderReference(order);
			}
			else
			{
				MapOrderReference(order);
			}
		}

		protected override void OnExecutionUpdate(Execution execution, string executionId, double price, int quantity, MarketPosition marketPosition, string orderId, DateTime time)
		{
			if (execution?.Order == null) return;
			if (execution.Order.OrderState == OrderState.Filled)
			{
				LogMsg("OrderFill", $"{execution.Order.Name} {execution.Order.OrderAction} qty={quantity} price={price:0.00}", 2);

				MarkBandFilledFromOrderName(execution.Order.Name);

				if (execution.Order.Name != null &&
					(execution.Order.Name.StartsWith(CloseBarEntryLongName, StringComparison.OrdinalIgnoreCase) ||
					 execution.Order.Name.StartsWith(CloseBarEntryShortName, StringComparison.OrdinalIgnoreCase)))
				{
					closeBarOrderPending = false;
					closeBarOrder = null;
					closeBarOrderDirection = Regime.None;
					closeBarOrderSignalClose = double.NaN;
					closeBarOrderActiveDirection = Regime.None;
					closeBarOrderActiveBar = -1;
					closeBarOrderCancelBar = -1;
					closeBarRearmAfterCancel = false;
				}
			}

			TrackCycleCounters(time);

			if (flattenInProgress && flattenOrder != null && execution.Order == flattenOrder)
			{
				// Treat the flatten order fill as success immediately. Depending on connection timing,
				// the Position object may still report the pre-fill state for a short moment.
				LogMsg("FlattenSuccess", $"reason={flattenReason} byExecution attempt={flattenAttemptCount}", 2);
				flattenInProgress = false;
				flattenOrder = null;
			}

			ProcessNewRealtimeTrades();
		}
