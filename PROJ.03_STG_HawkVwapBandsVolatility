		#region VWAP exit
		private void MaintainVwapExitOrder(double vwap)
		{
			if (isLockedForDay || flattenInProgress || IsFailSafeBlocking()) { CancelExitVwap(); return; }

			int qty = Math.Abs(Position.Quantity);
			if (qty <= 0) { CancelExitVwap(); return; }

			if (!EnsureProtectionIntegrity("MaintainVwapExit", allowRepair: true, requireProtectionReady: false))
				return;

			vwap = AdjustTargetPriceForBracket(vwap, Position.MarketPosition, "MaintainVwapExit");

			double ts = Instrument.MasterInstrument.TickSize;
			double repricingThreshold = ts * 0.5;

			if (exitVwapOrderReplace != null && IsActiveOrSubmitted(exitVwapOrderReplace))
			{
				return;
			}

			if (exitVwapOrder != null && (exitVwapOrder.OrderState == OrderState.CancelPending || exitVwapOrder.OrderState == OrderState.CancelSubmitted))
			{
				return;
			}

			if (Position.MarketPosition == MarketPosition.Long)
			{
				string fromEntry = null;
				if (exitVwapOrder != null && IsActiveOrSubmitted(exitVwapOrder))
				{
					if (Math.Abs(exitVwapOrder.LimitPrice - vwap) > repricingThreshold ||
					    exitVwapOrder.Quantity != qty)
					{
						if (BlockIfSameBar("VWAPExitReplace")) return;
						if (HasWorkingOrders(exitVwapOrderReplace))
						{
							return;
						}
						fromEntry = GetFromEntrySignal();
						exitVwapOrderReplace = ExitLongLimit(0, true, qty, vwap, "VWAPExitL_R", fromEntry);
						if (exitVwapOrderReplace != null)
						{
							MarkActionExecuted();
						}
					}
					return;
				}

				if (BlockIfSameBar("VWAPExitNew")) return;
				if (HasWorkingOrders(exitVwapOrder))
				{
					return;
				}
				fromEntry = GetFromEntrySignal();
				exitVwapOrder = ExitLongLimit(0, true, qty, vwap, "VWAPExitL", fromEntry);
				if (exitVwapOrder != null)
				{
					MarkActionExecuted();
				}
			}
			else if (Position.MarketPosition == MarketPosition.Short)
			{
				string fromEntry = null;
				if (exitVwapOrder != null && IsActiveOrSubmitted(exitVwapOrder))
				{
					if (Math.Abs(exitVwapOrder.LimitPrice - vwap) > repricingThreshold ||
					    exitVwapOrder.Quantity != qty)
					{
						if (BlockIfSameBar("VWAPExitReplace")) return;
						if (HasWorkingOrders(exitVwapOrderReplace))
						{
							return;
						}
						fromEntry = GetFromEntrySignal();
						exitVwapOrderReplace = ExitShortLimit(0, true, qty, vwap, "VWAPExitS_R", fromEntry);
						if (exitVwapOrderReplace != null)
						{
							MarkActionExecuted();
						}
					}
					return;
				}

				if (BlockIfSameBar("VWAPExitNew")) return;
				if (HasWorkingOrders(exitVwapOrder))
				{
					return;
				}
				fromEntry = GetFromEntrySignal();
				exitVwapOrder = ExitShortLimit(0, true, qty, vwap, "VWAPExitS", fromEntry);
				if (exitVwapOrder != null)
				{
					MarkActionExecuted();
				}
			}
		}

		private void CancelExitVwap()
		{
			if (Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
			{
				if (IsBracketOrderActive(exitVwapOrder) && !IsBracketOrderActive(stopLossOrder))
				{
					return;
				}
			}

			try { if (exitVwapOrder != null && !IsCancelling(exitVwapOrder)) CancelOrder(exitVwapOrder); } catch { }
			try { if (exitVwapOrderReplace != null && !IsCancelling(exitVwapOrderReplace)) CancelOrder(exitVwapOrderReplace); } catch { }
		}

