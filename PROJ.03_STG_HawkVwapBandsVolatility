		#region Flatten timer helpers
		private void StartFlattenTimerIfNeeded()
		{
			if (State != State.Realtime) return;
			if (isAnalyzerMode) return;
			if (_flattenTimer != null) return;

			_flattenTimer = new System.Timers.Timer(1000);
			_flattenTimer.AutoReset = true;
			_flattenTimer.Elapsed += (s, e) =>
			{
				try
				{
					if (flattenInProgress && State == State.Realtime)
					{
						TriggerCustomEvent(_ => CheckFlattenProgress(), null);
					}
				}
				catch { }
			};
			_flattenTimer.Start();
		}

		private void StopFlattenTimer()
		{
			try
			{
				if (_flattenTimer != null)
				{
					_flattenTimer.Stop();
					_flattenTimer.Dispose();
					_flattenTimer = null;
				}
			}
			catch { }
		}
