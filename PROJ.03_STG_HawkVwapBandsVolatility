		#region Trade limits helpers (por ciclo fechado)
		private void ResetTradeCounters(DateTime calDay)
		{
			tradesClosedTodayTotal = 0;
			tradesClosedTodayBuy = 0;
			tradesClosedTodaySell = 0;
			tradeCountersBrtDate = calDay.Date;

			if (Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
			{
				cycleOpen = true;
				cycleDirection = Position.MarketPosition == MarketPosition.Long ? Regime.Buy : Regime.Sell;
			}
			else
			{
				cycleOpen = false;
				cycleDirection = Regime.None;
			}

			for (int i = 0; i < 5; i++)
			{
				_lastGridRepriceBarLong[i] = -1;
