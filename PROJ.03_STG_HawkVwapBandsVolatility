		#region Lifecycle
		protected override void OnStateChange()
		{
			try
			{
				if (State == State.SetDefaults)
				{
					Name = "HawkVwapBandsVolatility";
					Description = "Hawk VWAP Bands Grid Strategy (regime por VWAP, grids 1..5, exit na VWAP, limites diários, painel HVB).";
					Calculate = Calculate.OnBarClose;

					try { EntriesPerDirection = 5; } catch { }
					try { EntryHandling = EntryHandling.UniqueEntries; } catch { }
					try { StopTargetHandling = StopTargetHandling.PerEntryExecution; } catch { }

					for (int i = 0; i < 5; i++)
					{
						_lastGridRepriceBarLong[i] = -1;
						_lastGridRepriceBarShort[i] = -1;
						gridLongReplace[i] = null;
						gridShortReplace[i] = null;
						_bandFilledBuy[i] = false;
						_bandFilledSell[i] = false;
					}

					DisableExitOnSessionCloseSafely();
					try { IsExitOnSessionCloseStrategy = false; } catch { }
					LogMsg("Config", "ExitOnSessionClose disabled (SetDefaults)", 2);
				}
				else if (State == State.Configure)
				{
					startHHmmss = ParseHms(StartTimeBrt);
					stopHHmmss = ParseHms(StopNewTradesTimeBrt);
					flattenHHmmss = ParseHms(FlattenTimeBrt);
					TimeSpan ts;
					if (TimeSpan.TryParse(FlattenTimeBrt, out ts)) flattenSpan = ts;

					if (UseFiboBands && UseFixedBands)
					{
						UseFixedBands = false;
						LogMsg("ConfigFix", "UseFiboBands and UseFixedBands were both true; forcing UseFixedBands=false.", 2);
					}

					if (ExitAtOppositeBandEnabled && ExitAtVwapEnabled)
					{
						ExitAtVwapEnabled = false;
						LogMsg("ConfigFix", "OppBand enabled; forcing ExitAtVwapEnabled=false (exclusive mode).", 2);
					}

					AddDataSeries(BarsPeriodType.Minute, 1);
				}
				else if (State == State.DataLoaded)
				{
					Log(HawkLogLevel.Info, "DataLoaded", "state=entered");
					hvb = HawkVwapBands(
						Input,
						NumDeviations,
						UseFiboBands,
						UseFixedBands,
						Fixed1Pct, Fixed2Pct, Fixed3Pct, Fixed4Pct, Fixed5Pct,
						false,
						"Off",
						600,
						TouchMarginTicks,
						false
					);
					_stoch = StochasticsFast(StochPeriodD, StochPeriodK);

					chartToken = (ChartControl != null) ? RuntimeHelpers.GetHashCode(ChartControl).ToString("X") : "HEADLESS";
					cacheKey = "";
					isAnalyzerMode = (ChartControl == null);
				}
				else if (State == State.Historical)
				{
					Log(HawkLogLevel.Info, "Historical", "state=entered");
				}
				else if (State == State.Realtime)
				{
					Log(HawkLogLevel.Info, "Realtime", "state=entered");
					if (string.IsNullOrWhiteSpace(cacheKey))
						cacheKey = GetCacheKey();

					bool cacheLoadedNow = false;
					if (!_panelCacheLoaded)
						cacheLoadedNow = TryLoadPanelCache();
				if (PanelPnlMode == PanelPnLMode.RealtimeOnly)
					ClearRealtimePanelStats(resetProcessedCount: true);
					if (!cacheLoadedNow)
					{
						_rtRealizedTotal = 0;
						_rtRealizedMonth = 0;
						_rtRealizedDay = 0;
					}

					_rtLastProcessedTradeCount = SystemPerformance.AllTrades.Count;
					if (PanelPnlMode == PanelPnLMode.RealtimeOnly)
						ClearRealtimePanelStats(resetProcessedCount: false);

					if (PanelPnlMode == PanelPnLMode.RealtimeOnly)
						ClearRealtimePanelStats(resetProcessedCount: false);
					if (PanelPnlMode == PanelPnLMode.RealtimeOnly)
					{
						DateTime brtNow = ConvertToBrasilia(DateTime.UtcNow).AddMinutes(UserBrtOffsetMinutes);
						DateTime brtDay = brtNow.Date;
						int brtYm = brtDay.Year * 100 + brtDay.Month;
						_rtBrtDay = brtDay;
						_rtBrtYearMonth = brtYm;
					}
					else
					{
						_rtBrtDay = DateTime.MinValue;
						_rtBrtYearMonth = 0;
					}

					for (int i = 0; i < 5; i++)
					{
						gridLong[i] = null;
						gridShort[i] = null;
						gridLongReplace[i] = null;
						gridShortReplace[i] = null;
						_lastGridRepriceBarLong[i] = -1;
						_lastGridRepriceBarShort[i] = -1;
						_bandFilledBuy[i] = false;
						_bandFilledSell[i] = false;
					}
					exitVwapOrder = null;
					exitVwapOrderReplace = null;
					oppositeBandExitOrder = null;
					oppositeBandExitOrderReplace = null;
					financialTargetOrder = null;
					financialTargetOrderReplace = null;
					stopLossOrder = null;
					flattenOrder = null;
					flattenInProgress = false;

					EnsurePanelInitializedOnce();
					StartFlattenTimerIfNeeded();
					PublishPanelSnapshot("StateRealtime");
				}
				else if (State == State.Terminated)
				{
					if (terminatedHandled) return;
					terminatedHandled = true;
					Log(HawkLogLevel.Info, "Terminated", "state=entered");
					PublishPanelOffSnapshot("Terminated");
					try { HVB_PanelStateHub.Remove(cacheKey); } catch { }
					try { StopFlattenTimer(); } catch { }
					try { panelHelper?.Dispose(); panelHelper = null; } catch { }
				}
			}
			catch (Exception ex)
			{
				Print($"[HawkVwapBandsVolatility] OnStateChange exception: {ex}");
			}
		}
