		private int ParseHms(string s)
		{
			if (string.IsNullOrWhiteSpace(s)) return 0;
			var parts = s.Split(':');
			int h = 0, m = 0, sec = 0;
			try { h = int.Parse(parts[0]); m = parts.Length > 1 ? int.Parse(parts[1]) : 0; sec = parts.Length > 2 ? int.Parse(parts[2]) : 0; } catch { }
			return h * 10000 + m * 100 + sec;
		}

		private DateTime ConvertToBrasilia(DateTime dt)
		{
			try
			{
				TimeZoneInfo brt = null;
				string[] possibleIds = new string[] { "E. South America Standard Time", "America/Sao_Paulo", "SA Eastern Standard Time" };
				foreach (var id in possibleIds)
				{
					try { brt = TimeZoneInfo.FindSystemTimeZoneById(id); if (brt != null) break; } catch { }
				}

				if (brt == null) return dt.ToLocalTime();

				if (dt.Kind == DateTimeKind.Utc) return TimeZoneInfo.ConvertTimeFromUtc(dt, brt);
				if (dt.Kind == DateTimeKind.Local)
				{
					DateTime utc = dt.ToUniversalTime();
					return TimeZoneInfo.ConvertTimeFromUtc(utc, brt);
				}
				else
				{
					DateTime local = DateTime.SpecifyKind(dt, DateTimeKind.Local);
					DateTime utc = local.ToUniversalTime();
					return TimeZoneInfo.ConvertTimeFromUtc(utc, brt);
				}
			}
			catch { return dt; }
		}

		private int ToBrtHHmmss(DateTime t)
		{
			var brt = ConvertToBrasilia(t).AddMinutes(UserBrtOffsetMinutes);
			return ToTime(brt);
		}

