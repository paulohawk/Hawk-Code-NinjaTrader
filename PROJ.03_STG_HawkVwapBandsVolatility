		#region Grid logic
		// NOTE (Option A):
		// AggressiveGridMode is a NinjaScriptProperty in Part 2A.
		// _bandFilledBuy/_bandFilledSell are private fields in Part 2A.
		// Therefore, Part 2B MUST NOT re-declare them.

		private void ResetBandFillGuards()
		{
			for (int i = 0; i < 5; i++)
			{
				_bandFilledBuy[i] = false;
				_bandFilledSell[i] = false;
			}
		}

		private bool IsBandBlockedForNewOrder(int idx, Regime side)
		{
			if (AggressiveGridMode) return false;
			if (idx < 0 || idx >= 5) return false;

			if (side == Regime.Buy) return _bandFilledBuy[idx];
			if (side == Regime.Sell) return _bandFilledSell[idx];
			return false;
		}

		private void MarkBandFilledFromOrderName(string orderName)
		{
			if (string.IsNullOrEmpty(orderName)) return;

			int idx = -1;
			for (int i = 0; i < 5; i++)
			{
				if (orderName.IndexOf($"Grid{i + 1}_", StringComparison.OrdinalIgnoreCase) >= 0)
				{
					idx = i; break;
				}
			}
			if (idx < 0 || idx > 4) return;

			bool isBuy = orderName.IndexOf("_Buy", StringComparison.OrdinalIgnoreCase) >= 0;
			bool isSell = orderName.IndexOf("_Sell", StringComparison.OrdinalIgnoreCase) >= 0;

			if (isBuy)
			{
				_bandFilledBuy[idx] = true;
				LogMsg("BandFillGuard", $"BUY Grid{idx + 1} marked filled; AggressiveGridMode={AggressiveGridMode}", 2);
			}
			else if (isSell)
			{
				_bandFilledSell[idx] = true;
				LogMsg("BandFillGuard", $"SELL Grid{idx + 1} marked filled; AggressiveGridMode={AggressiveGridMode}", 2);
			}
		}

		private void RepriceOrPlaceGrid(double[] u, double[] l)
		{
			int bands = Math.Max(1, Math.Min(5, NumDeviations));
			double ts = Instrument.MasterInstrument.TickSize;
			double repricingThreshold = Math.Max(2 * ts, RepriceThresholdTicks * ts);
			bool[] enabled = new[] { EnableGrid1, EnableGrid2, EnableGrid3, EnableGrid4, EnableGrid5 };

			int startIdx = (Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0) ? 1 : 0;

			for (int i = startIdx; i < 5; i++)
			{
				if (i >= bands || !enabled[i] || isLockedForDay)
				{
					CancelGridIndex(i, "band_disabled");
					continue;
				}

				// Default behavior: do not re-arm same band after it filled once in this cycle.
				if (IsBandBlockedForNewOrder(i, currentRegime))
				{
					_lastBlockReason = $"band_filled_guard:Grid{i + 1}";
					SupportDump("trade_blocked");
					CancelGridIndex(i, "band_filled_guard");
					continue;
				}

				double up = u[i];
				double lo = l[i];
				if (double.IsNaN(up) || double.IsNaN(lo))
				{
					CancelGridIndex(i, "nan_band");
					continue;
				}

				double price = double.NaN;
				if (currentRegime == Regime.Sell)
					price = up - EntryOffsetTicks * ts;
				else if (currentRegime == Regime.Buy)
					price = lo + EntryOffsetTicks * ts;

				if (double.IsNaN(price) || price <= 0)
				{
					CancelGridIndex(i, "invalid_price");
					continue;
				}

				// ===== DIAG: Grid2 only (idx=1) when pos is not flat =====
				if (i == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
				{
					var ordL = gridLong[i];
					var repL = gridLongReplace[i];
					var ordS = gridShort[i];
					var repS = gridShortReplace[i];

					string ordInfo = ordL != null ? $"L:{ordL.Name} {ordL.OrderState} lim={ordL.LimitPrice:0.00}" :
									   ordS != null ? $"S:{ordS.Name} {ordS.OrderState} lim={ordS.LimitPrice:0.00}" : "none";
					string repInfo = repL != null ? $"L_R:{repL.Name} {repL.OrderState} lim={repL.LimitPrice:0.00}" :
									   repS != null ? $"S_R:{repS.Name} {repS.OrderState} lim={repS.LimitPrice:0.00}" : "none";

					LogMsg("Grid2Diag_Pre",
						$"pos={Position.MarketPosition} qty={Position.Quantity} regime={currentRegime} bands={bands} enabled={enabled[i]} " +
						$"lo={lo:0.00} up={up:0.00} calc={price:0.00} thr={repricingThreshold:0.0000} tick={ts:0.0000} " +
						$"ord={ordInfo} rep={repInfo}",
						3);
				}
				// ===== end DIAG =====

				if (currentRegime == Regime.Sell)
					PlaceOrRepriceShort(i, price, QuantityPerGridOrder, repricingThreshold);
				else
					PlaceOrRepriceLong(i, price, QuantityPerGridOrder, repricingThreshold);
			}
		}

		private bool IsActiveOrSubmitted(Order ord) =>
			ord != null && (ord.OrderState == OrderState.Working || ord.OrderState == OrderState.Accepted || ord.OrderState == OrderState.Submitted);

		private bool IsCancelling(Order ord) =>
			ord != null && (ord.OrderState == OrderState.CancelPending || ord.OrderState == OrderState.CancelSubmitted);

		private bool HasWorkingOrders(params Order[] orders)
		{
			if (orders == null) return false;
			foreach (var ord in orders)
			{
				if (ord != null && ord.OrderState == OrderState.Working)
					return true;
			}
			return false;
		}

		private bool HasAnyWorkingOrders()
		{
			if (HasWorkingOrders(exitVwapOrder, exitVwapOrderReplace, oppositeBandExitOrder, oppositeBandExitOrderReplace,
				stopLossOrder, financialTargetOrder, financialTargetOrderReplace, flattenOrder, closeBarOrder))
				return true;

			for (int i = 0; i < 5; i++)
			{
				if (HasWorkingOrders(gridLong[i], gridLongReplace[i], gridShort[i], gridShortReplace[i]))
					return true;
			}

			return false;
		}

		// SINGLE definition of IsDeadOrder in Part 2B (removed from 2A to avoid duplicates)
		private bool IsDeadOrder(Order ord) =>
			ord == null || ord.OrderState == OrderState.Cancelled || ord.OrderState == OrderState.Rejected;

		private void PlaceOrRepriceLong(int idx, double price, int qty, double repricingThreshold)
		{
			// Extra guard at placement layer (covers cases where calls happen outside RepriceOrPlaceGrid)
			if (IsBandBlockedForNewOrder(idx, Regime.Buy))
			{
				_lastBlockReason = $"band_filled_guard:Grid{idx + 1}";
				SupportDump("trade_blocked");
				CancelGridIndex(idx, "band_filled_guard");
				return;
			}

			var ord = gridLong[idx];
			var rep = gridLongReplace[idx];

			// FIX: if replace reference points to the same order as main, clear replace ref to avoid permanent deadlock.
			if (ord != null && rep != null && ReferenceEquals(ord, rep))
			{
				gridLongReplace[idx] = null;
				rep = null;
				LogMsg("GridReplaceHeal", $"Grid{idx + 1} BUY detected rep==ord; cleared replace ref name={ord.Name} lim={ord.LimitPrice:0.00}", 2);
			}

			// ===== DIAG: Grid2 only =====
			if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
			{
				string ordS = ord == null ? "null" : $"{ord.Name} {ord.OrderState} lim={ord.LimitPrice:0.00}";
				string repS = rep == null ? "null" : $"{rep.Name} {rep.OrderState} lim={rep.LimitPrice:0.00}";
				double diff = ord != null ? Math.Abs(ord.LimitPrice - price) : double.NaN;
				double diffTicks = (!double.IsNaN(diff) && Instrument?.MasterInstrument?.TickSize > 0) ? diff / Instrument.MasterInstrument.TickSize : double.NaN;

				LogMsg("Grid2Diag_Long_Entry",
					$"calc={price:0.00} thr={repricingThreshold:0.0000} diff={diff:0.0000} diffTicks={diffTicks:0.00} ord={ordS} rep={repS} lastBar={_lastGridRepriceBarLong[idx]} curBar={CurrentBar}",
					3);
			}
			// ===== end DIAG =====

			// Auto-heal: if we have a replacement working but the main order is missing/dead, promote it.
			if (rep != null && IsActiveOrSubmitted(rep) && (ord == null || IsDeadOrder(ord)))
			{
				gridLong[idx] = rep;
				gridLongReplace[idx] = null;
				ord = gridLong[idx];
				rep = null;
				LogMsg("GridReplaceHeal", $"Grid{idx + 1} BUY promoted replace->main name={ord?.Name} lim={ord?.LimitPrice:0.00}", 2);
			}

			// Only block if we truly have a replacement pending AND the main is still active (handshake in progress)
			if (rep != null && IsActiveOrSubmitted(rep) && ord != null && IsActiveOrSubmitted(ord))
			{
				if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
					LogMsg("Grid2Diag_Long_Return", "reason=rep_active_and_main_active", 3);
				return;
			}

			if (ord != null && IsCancelling(ord))
			{
				if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
					LogMsg("Grid2Diag_Long_Return", $"reason=main_cancelling state={ord.OrderState}", 3);

				LogMsg("GridSkipRecreate", $"Grid{idx + 1} BUY reason=cancel_in_progress state={ord.OrderState}", 3);
				return;
			}

			if (ord != null && IsActiveOrSubmitted(ord))
			{
				if (DisableRepriceWhenFlat && (Position == null || Position.MarketPosition == MarketPosition.Flat))
				{
					if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
						LogMsg("Grid2Diag_Long_Return", "reason=DisableRepriceWhenFlat (unexpected while pos!=flat)", 3);
					return;
				}

				if (Math.Abs(ord.LimitPrice - price) < repricingThreshold)
				{
					if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
						LogMsg("Grid2Diag_Long_Return", $"reason=below_threshold diff={Math.Abs(ord.LimitPrice - price):0.0000} thr={repricingThreshold:0.0000}", 3);
					return;
				}

				int minBars = Math.Max(1, RepriceEveryNBars);
				if (_lastGridRepriceBarLong[idx] >= 0 && (CurrentBar - _lastGridRepriceBarLong[idx]) < minBars)
				{
					if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
						LogMsg("Grid2Diag_Long_Return", $"reason=throttle barsSinceLast={CurrentBar - _lastGridRepriceBarLong[idx]} < {minBars}", 3);

					LogMsg("GridRepriceThrottle", $"Grid{idx + 1} BUY skip; barsSinceLast={CurrentBar - _lastGridRepriceBarLong[idx]} < {RepriceEveryNBars}", 3);
					return;
				}

				if (BlockIfSameBar($"Grid{idx + 1}_Buy_R")) return;
				if (HasWorkingOrders(gridLongReplace[idx]))
				{
					_lastBlockReason = $"block_working_entry:Grid{idx + 1}_Buy_R";
					SupportDump("trade_blocked");
					LogMsg("OrderBlock", $"blocked working entry order for Grid{idx + 1} Buy replace", 3);
					return;
				}
				var o = EnterLongLimit(0, true, qty, price, $"Grid{idx + 1}_Buy_R");
				if (o == null)
				{
					LogMsg("GridReplaceFailed", $"Grid{idx + 1} BUY replacement returned null qty={qty} price={price:0.00}", 1);
					return;
				}
				gridLongReplace[idx] = o;
				_lastGridRepriceBarLong[idx] = CurrentBar;
				MarkActionExecuted();
				SupportDump($"order_sent:{o.Name}");

				if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
					LogMsg("Grid2Diag_Long_Action", $"action=submit_replace old={ord.LimitPrice:0.00} new={price:0.00}", 2);

				LogMsg("GridReplaceSubmit", $"Grid{idx + 1} BUY old={ord.LimitPrice:0.00} new={price:0.00}", 3);
				return;
			}

			if (BlockIfSameBar($"Grid{idx + 1}_Buy")) return;
			if (HasWorkingOrders(gridLong[idx]))
			{
				_lastBlockReason = $"block_working_entry:Grid{idx + 1}_Buy";
				SupportDump("trade_blocked");
				LogMsg("OrderBlock", $"blocked working entry order for Grid{idx + 1} Buy", 3);
				return;
			}
			var newOrd = EnterLongLimit(0, true, qty, price, $"Grid{idx + 1}_Buy");
			if (newOrd == null)
			{
				LogMsg("GridOrderNull", $"Grid{idx + 1} BUY returned null qty={qty} price={price:0.00}", 1);
				return;
			}
			gridLong[idx] = newOrd;
			MarkActionExecuted();
			SupportDump($"order_sent:{newOrd.Name}");

			if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
				LogMsg("Grid2Diag_Long_Action", $"action=create_new name={newOrd.Name} lim={price:0.00}", 2);

			LogMsg("GridSubmit", $"Grid{idx + 1} BUY name={newOrd.Name} qty={qty} lim={price:0.00}", 2);
		}

		private void PlaceOrRepriceShort(int idx, double price, int qty, double repricingThreshold)
		{
			// Extra guard at placement layer
			if (IsBandBlockedForNewOrder(idx, Regime.Sell))
			{
				_lastBlockReason = $"band_filled_guard:Grid{idx + 1}";
				SupportDump("trade_blocked");
				CancelGridIndex(idx, "band_filled_guard");
				return;
			}

			var ord = gridShort[idx];
			var rep = gridShortReplace[idx];

			// FIX: if replace reference points to the same order as main, clear replace ref to avoid permanent deadlock.
			if (ord != null && rep != null && ReferenceEquals(ord, rep))
			{
				gridShortReplace[idx] = null;
				rep = null;
				LogMsg("GridReplaceHeal", $"Grid{idx + 1} SELL detected rep==ord; cleared replace ref name={ord.Name} lim={ord.LimitPrice:0.00}", 2);
			}

			// ===== DIAG: Grid2 only =====
			if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
			{
				string ordS = ord == null ? "null" : $"{ord.Name} {ord.OrderState} lim={ord.LimitPrice:0.00}";
				string repS = rep == null ? "null" : $"{rep.Name} {rep.OrderState} lim={rep.LimitPrice:0.00}";
				double diff = ord != null ? Math.Abs(ord.LimitPrice - price) : double.NaN;
				double diffTicks = (!double.IsNaN(diff) && Instrument?.MasterInstrument?.TickSize > 0) ? diff / Instrument.MasterInstrument.TickSize : double.NaN;

				LogMsg("Grid2Diag_Short_Entry",
					$"calc={price:0.00} thr={repricingThreshold:0.0000} diff={diff:0.0000} diffTicks={diffTicks:0.00} ord={ordS} rep={repS} lastBar={_lastGridRepriceBarShort[idx]} curBar={CurrentBar}",
					3);
			}
			// ===== end DIAG =====

			// Auto-heal: if we have a replacement working but the main order is missing/dead, promote it.
			if (rep != null && IsActiveOrSubmitted(rep) && (ord == null || IsDeadOrder(ord)))
			{
				gridShort[idx] = rep;
				gridShortReplace[idx] = null;
				ord = gridShort[idx];
				rep = null;
				LogMsg("GridReplaceHeal", $"Grid{idx + 1} SELL promoted replace->main name={ord?.Name} lim={ord?.LimitPrice:0.00}", 2);
			}

			// Only block if we truly have a replacement pending AND the main is still active (handshake in progress)
			if (rep != null && IsActiveOrSubmitted(rep) && ord != null && IsActiveOrSubmitted(ord))
			{
				if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
					LogMsg("Grid2Diag_Short_Return", "reason=rep_active_and_main_active", 3);
				return;
			}

			if (ord != null && IsCancelling(ord))
			{
				if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
					LogMsg("Grid2Diag_Short_Return", $"reason=main_cancelling state={ord.OrderState}", 3);

				LogMsg("GridSkipRecreate", $"Grid{idx + 1} SELL reason=cancel_in_progress state={ord.OrderState}", 3);
				return;
			}

			if (ord != null && IsActiveOrSubmitted(ord))
			{
				if (DisableRepriceWhenFlat && (Position == null || Position.MarketPosition == MarketPosition.Flat))
				{
					if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
						LogMsg("Grid2Diag_Short_Return", "reason=DisableRepriceWhenFlat (unexpected while pos!=flat)", 3);
					return;
				}

				if (Math.Abs(ord.LimitPrice - price) < repricingThreshold)
				{
					if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
						LogMsg("Grid2Diag_Short_Return", $"reason=below_threshold diff={Math.Abs(ord.LimitPrice - price):0.0000} thr={repricingThreshold:0.0000}", 3);
					return;
				}

				int minBars = Math.Max(1, RepriceEveryNBars);
				if (_lastGridRepriceBarShort[idx] >= 0 && (CurrentBar - _lastGridRepriceBarShort[idx]) < minBars)
				{
					if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
						LogMsg("Grid2Diag_Short_Return", $"reason=throttle barsSinceLast={CurrentBar - _lastGridRepriceBarShort[idx]} < {minBars}", 3);

					LogMsg("GridRepriceThrottle", $"Grid{idx + 1} SELL skip; barsSinceLast={CurrentBar - _lastGridRepriceBarShort[idx]} < {RepriceEveryNBars}", 3);
					return;
				}

				if (BlockIfSameBar($"Grid{idx + 1}_Sell_R")) return;
				if (HasWorkingOrders(gridShortReplace[idx]))
				{
					_lastBlockReason = $"block_working_entry:Grid{idx + 1}_Sell_R";
					SupportDump("trade_blocked");
					LogMsg("OrderBlock", $"blocked working entry order for Grid{idx + 1} Sell replace", 3);
					return;
				}
				var o = EnterShortLimit(0, true, qty, price, $"Grid{idx + 1}_Sell_R");
				if (o == null)
				{
					LogMsg("GridReplaceFailed", $"Grid{idx + 1} SELL replacement returned null qty={qty} price={price:0.00}", 1);
					return;
				}
				gridShortReplace[idx] = o;
				_lastGridRepriceBarShort[idx] = CurrentBar;
				MarkActionExecuted();
				SupportDump($"order_sent:{o.Name}");

				if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
					LogMsg("Grid2Diag_Short_Action", $"action=submit_replace old={ord.LimitPrice:0.00} new={price:0.00}", 2);

				LogMsg("GridReplaceSubmit", $"Grid{idx + 1} SELL old={ord.LimitPrice:0.00} new={price:0.00}", 3);
				return;
			}

			if (BlockIfSameBar($"Grid{idx + 1}_Sell")) return;
			if (HasWorkingOrders(gridShort[idx]))
			{
				_lastBlockReason = $"block_working_entry:Grid{idx + 1}_Sell";
				SupportDump("trade_blocked");
				LogMsg("OrderBlock", $"blocked working entry order for Grid{idx + 1} Sell", 3);
				return;
			}
			var newOrd = EnterShortLimit(0, true, qty, price, $"Grid{idx + 1}_Sell");
			if (newOrd == null)
			{
				LogMsg("GridOrderNull", $"Grid{idx + 1} SELL returned null qty={qty} price={price:0.00}", 1);
				return;
			}
			gridShort[idx] = newOrd;
			MarkActionExecuted();
			SupportDump($"order_sent:{newOrd.Name}");

			if (idx == 1 && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
				LogMsg("Grid2Diag_Short_Action", $"action=create_new name={newOrd.Name} lim={price:0.00}", 2);

			LogMsg("GridSubmit", $"Grid{idx + 1} SELL name={newOrd.Name} qty={qty} lim={price:0.00}", 2);
		}

		private void CancelGridIndex(int idx, string reason = "cancel")
		{
			try
			{
				if (gridLong[idx] != null) CancelOrder(gridLong[idx]);
				if (gridShort[idx] != null) CancelOrder(gridShort[idx]);
				if (gridLongReplace[idx] != null) CancelOrder(gridLongReplace[idx]);
				if (gridShortReplace[idx] != null) CancelOrder(gridShortReplace[idx]);
				_lastGridRepriceBarLong[idx] = -1;
				_lastGridRepriceBarShort[idx] = -1;
				gridLongReplace[idx] = null;
				gridShortReplace[idx] = null;
				LogMsg("GridCancel", $"Grid{idx + 1} reason={reason}", 3);
			}
			catch { }
			gridLong[idx] = null;
			gridShort[idx] = null;
		}

		private void CancelAllGrid(string reason = "cancel_all")
		{
			for (int i = 0; i < 5; i++) CancelGridIndex(i, reason);
		}

		private void CancelSideGrid(Regime side, string reason = "cancel_side")
		{
			for (int i = 0; i < 5; i++)
			{
				if (side == Regime.Buy)
				{
					try { if (gridLong[i] != null) CancelOrder(gridLong[i]); } catch { }
					try { if (gridLongReplace[i] != null) CancelOrder(gridLongReplace[i]); } catch { }
					gridLong[i] = null;
					gridLongReplace[i] = null;
					_lastGridRepriceBarLong[i] = -1;
				}
				else if (side == Regime.Sell)
				{
					try { if (gridShort[i] != null) CancelOrder(gridShort[i]); } catch { }
					try { if (gridShortReplace[i] != null) CancelOrder(gridShortReplace[i]); } catch { }
					gridShort[i] = null;
					gridShortReplace[i] = null;
					_lastGridRepriceBarShort[i] = -1;
				}
			}
			LogMsg("GridCancelSide", $"side={side} reason={reason}", 2);
		}
