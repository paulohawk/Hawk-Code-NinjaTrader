		private void MaintainBracketStopLoss()
		{
			if (isLockedForDay || flattenInProgress || IsFailSafeBlocking())
			{
				CancelStopLoss();
				return;
			}

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				CancelStopLoss();
				return;
			}

			string reason;
			double stopPrice;
			if (!TryGetBracketStopPrice(out stopPrice, out reason))
			{
				return;
			}

			int qty = Math.Abs(Position.Quantity);
			double ts = Instrument.MasterInstrument.TickSize;
			double repricingThreshold = ts * 0.5;
			bool needReprice = true;

			if (stopLossOrder != null &&
			    (stopLossOrder.OrderState == OrderState.Working || stopLossOrder.OrderState == OrderState.Accepted || stopLossOrder.OrderState == OrderState.Submitted || stopLossOrder.OrderState == OrderState.CancelPending || stopLossOrder.OrderState == OrderState.CancelSubmitted))
			{
				if (Math.Abs(stopLossOrder.StopPrice - stopPrice) <= repricingThreshold &&
				    stopLossOrder.Quantity == qty)
					needReprice = false;
			}

			if (!needReprice) return;

			try
			{
				if (stopLossOrder != null && !IsCancelling(stopLossOrder)) CancelOrder(stopLossOrder);
			}
			catch { }

			if (BlockIfSameBar("BracketStop")) return;
			if (HasWorkingOrders(stopLossOrder))
			{
				return;
			}

			string fromEntry = GetFromEntrySignal();
			if (Position.MarketPosition == MarketPosition.Long)
				stopLossOrder = ExitLongStopMarket(0, true, qty, stopPrice, "FinStopL", fromEntry);
			else if (Position.MarketPosition == MarketPosition.Short)
				stopLossOrder = ExitShortStopMarket(0, true, qty, stopPrice, "FinStopS", fromEntry);

			if (stopLossOrder != null)
			{
				MarkActionExecuted();
			}
		}

		private void MaintainStopLoss()
		{
			if (isLockedForDay || flattenInProgress || IsFailSafeBlocking())
			{
				CancelStopLoss();
				return;
			}

			if (breakEvenActivated)
				return;

			if (EnableFinancialStop && FinancialStopUsd > 0)
			{
				MaintainFinancialStopLoss();
				return;
			}

			if (TradeStopLossUsd > 0 || (EnableStopLoss && StopLossTicks > 0))
			{
				MaintainBracketStopLoss();
				return;
			}

			CancelStopLoss();
			return;
		}

		private void CancelStopLoss()
		{
			if (Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
			{
				Order targetOrder = GetActiveTargetOrder(GetExitMode());
				if (IsBracketOrderActive(stopLossOrder) && !IsBracketOrderActive(targetOrder))
				{
					return;
				}
			}

			try { if (stopLossOrder != null && !IsCancelling(stopLossOrder)) CancelOrder(stopLossOrder); } catch { }
		}

		private void CancelStopLossForce()
		{
			try
			{
				if (stopLossOrder != null && !IsCancelling(stopLossOrder))
					CancelOrder(stopLossOrder);
			}
			catch { }
		}
