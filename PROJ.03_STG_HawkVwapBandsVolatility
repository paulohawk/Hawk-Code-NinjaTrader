		private bool TryLoadPanelCache()
		{
			_panelCacheLoaded = true;

			if (!ShouldPersistPanelCache()) return false;
			string path = GetPanelCachePath();
			if (string.IsNullOrWhiteSpace(path) || !File.Exists(path)) return false;

			try
			{
				using (var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read))
				{
					var ser = new XmlSerializer(typeof(HVB_PanelPersistedState));
					var state = ser.Deserialize(fs) as HVB_PanelPersistedState;
					if (state == null || state.Snapshot == null) return false;

					_cachedPnlDay = state.Snapshot.PnLDiaText ?? _cachedPnlDay;
					_cachedPnlMonth = state.Snapshot.PnLMesText ?? _cachedPnlMonth;
					_cachedPnlTotal = state.Snapshot.PnLTotalText ?? _cachedPnlTotal;
					_maxGainStreak = state.MaxGainStreak;
					_maxLossStreak = state.MaxLossStreak;

					if (Enum.TryParse(state.PanelPnLMode, out PanelPnLMode savedMode))
						PanelPnlMode = savedMode;

					_lastSavedHistoricalTradesCount = state.TradesCountAtSave;

					if (PanelPnlMode == PanelPnLMode.RealtimeOnly)
					{
						_rtRealizedTotal = ParseDoubleFlexible(state.Snapshot.PnLTotalText ?? _cachedPnlTotal);
						_rtRealizedMonth = ParseDoubleFlexible(state.Snapshot.PnLMesText ?? _cachedPnlMonth);
						_rtRealizedDay = ParseDoubleFlexible(state.Snapshot.PnLDiaText ?? _cachedPnlDay);
						_rtLastProcessedTradeCount = state.TradesCountAtSave;
					}
					else
					{
						ClearRealtimePanelStats(resetProcessedCount: true);
					}

					HVB_PanelStateHub.Set(cacheKey, state.Snapshot);
					try { panelHelper?.ApplySnapshot(state.Snapshot); } catch { }
					LogMsg("PanelCacheLoad", $"Loaded panel cache from {path}", 2);
					return true;
				}
			}
			catch (Exception ex)
			{
				LogMsg("PanelCacheLoadErr", ex.Message, 1);
				return false;
			}
		}

		private void TrySavePanelCache(HVB_PanelStateHub.PanelSnapshot snap, int tradesCount)
		{
			if (snap == null) return;
			if (!ShouldPersistPanelCache()) return;

			var now = DateTime.UtcNow;
			if ((now - _lastPanelCacheSaveUtc) < _panelCacheSaveThrottle)
				return;

			string path = GetPanelCachePath();
			if (string.IsNullOrWhiteSpace(path)) return;

			try
			{
				string dir = IOPath.GetDirectoryName(path);
				if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);

				var state = new HVB_PanelPersistedState
				{
					StrategyKey = cacheKey,
					StrategyName = snap.StrategyName,
					AccountName = Account?.Name ?? "",
					InstrumentName = Instrument?.FullName ?? "",
					PanelPnLMode = PanelPnlMode.ToString(),
					SavedAtUtc = now,
					TradesCountAtSave = tradesCount,
					MaxGainStreak = _maxGainStreak,
					MaxLossStreak = _maxLossStreak,
					Snapshot = snap
				};

				var ser = new XmlSerializer(typeof(HVB_PanelPersistedState));
				using (var fs = new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.None))
				{
					ser.Serialize(fs, state);
				}

				_lastPanelCacheSaveUtc = now;
				LogMsg("PanelCacheSave", $"Saved panel cache to {path}", 2);
			}
			catch (Exception ex)
			{
				LogMsg("PanelCacheSaveErr", ex.Message, 1);
			}
		}
