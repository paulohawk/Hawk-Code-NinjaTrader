#region Financial target maintenance (USD -> preço, Limit)
		private void CancelFinancialTarget()
		{
			try { if (financialTargetOrder != null && !IsCancelling(financialTargetOrder)) CancelOrder(financialTargetOrder); } catch { }
			try { if (financialTargetOrderReplace != null && !IsCancelling(financialTargetOrderReplace)) CancelOrder(financialTargetOrderReplace); } catch { }
		}

		private void MaintainFinancialTargetLimit()
		{
			if (isLockedForDay || flattenInProgress)
			{
				CancelFinancialTarget();
				return;
			}

			if (GetExitMode() != ExitMode.Financial)
			{
				CancelFinancialTarget();
				return;
			}

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				CancelFinancialTarget();
				return;
			}

			if (TradeProfitTargetUsd <= 0)
			{
				CancelFinancialTarget();
				return;
			}

			double pointValue = Instrument?.MasterInstrument?.PointValue ?? 1.0;
			int qty = Math.Abs(Position.Quantity);
			double profitPerContract = TradeProfitTargetUsd / qty;
			double points = profitPerContract / pointValue;
			double target = double.NaN;

			if (Position.MarketPosition == MarketPosition.Long)
				target = Position.AveragePrice + points;
			else if (Position.MarketPosition == MarketPosition.Short)
				target = Position.AveragePrice - points;

			if (double.IsNaN(target) || target <= 0)
			{
				CancelFinancialTarget();
				return;
			}

			target = Instrument.MasterInstrument.RoundToTickSize(target);

			double ts = Instrument.MasterInstrument.TickSize;
			double repricingThreshold = ts * 0.5;
			bool needReprice = true;

			if (financialTargetOrderReplace != null && IsActiveOrSubmitted(financialTargetOrderReplace))
				needReprice = false;

			if (financialTargetOrder != null &&
			    (financialTargetOrder.OrderState == OrderState.Working || financialTargetOrder.OrderState == OrderState.Accepted || financialTargetOrder.OrderState == OrderState.Submitted || financialTargetOrder.OrderState == OrderState.CancelPending || financialTargetOrder.OrderState == OrderState.CancelSubmitted))
			{
				if (Math.Abs(financialTargetOrder.LimitPrice - target) <= repricingThreshold &&
				    financialTargetOrder.Quantity == qty)
					needReprice = false;
			}

			if (!needReprice) return;

			if (BlockIfSameBar("FinTargetReplace")) return;
			if (HasWorkingOrders(financialTargetOrderReplace))
			{
				_lastBlockReason = "block_working_exit:FinTargetReplace";
				SupportDump("trade_blocked");
				LogMsg("OrderBlock", "blocked working exit order for FinTargetReplace", 3);
				return;
			}
			if (Position.MarketPosition == MarketPosition.Long)
				financialTargetOrderReplace = ExitLongLimit(0, true, qty, target, "FinTargetL_R", null);
			else if (Position.MarketPosition == MarketPosition.Short)
				financialTargetOrderReplace = ExitShortLimit(0, true, qty, target, "FinTargetS_R", null);

			if (financialTargetOrderReplace != null)
			{
				MarkActionExecuted();
				SupportDump($"order_sent:{financialTargetOrderReplace.Name}");
			}
			LogMsg("FinTargetUpdated", $"side={Position.MarketPosition} qty={qty} avg={Position.AveragePrice:0.00} tgt={target:0.00} usd={TradeProfitTargetUsd:0.00}", 2);
		}
		#endregion

		#region Financial stop maintenance (USD -> preço)
		private void MaintainFinancialStopLoss()
		{
			if (isLockedForDay || flattenInProgress)
			{
				CancelStopLoss();
				return;
			}

			if (!EnableFinancialStop || FinancialStopUsd <= 0)
			{
				return;
			}

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				CancelStopLoss();
				return;
			}

			double pointValue = Instrument?.MasterInstrument?.PointValue ?? 1.0;
			int qty = Math.Abs(Position.Quantity);
			double riskPerContract = FinancialStopUsd / qty;
			double points = riskPerContract / pointValue;
			double stopPrice = double.NaN;

			if (Position.MarketPosition == MarketPosition.Long)
				stopPrice = Position.AveragePrice - points;
			else if (Position.MarketPosition == MarketPosition.Short)
				stopPrice = Position.AveragePrice + points;

			if (double.IsNaN(stopPrice) || stopPrice <= 0)
			{
				CancelStopLoss();
				return;
			}

			stopPrice = Instrument.MasterInstrument.RoundToTickSize(stopPrice);

			double ts = Instrument.MasterInstrument.TickSize;
			double repricingThreshold = ts * 0.5;
			bool needReprice = true;

			if (stopLossOrder != null &&
			    (stopLossOrder.OrderState == OrderState.Working || stopLossOrder.OrderState == OrderState.Accepted || stopLossOrder.OrderState == OrderState.Submitted || stopLossOrder.OrderState == OrderState.CancelPending || stopLossOrder.OrderState == OrderState.CancelSubmitted))
			{
				if (Math.Abs(stopLossOrder.StopPrice - stopPrice) <= repricingThreshold &&
				    stopLossOrder.Quantity == qty)
					needReprice = false;
			}

			if (!needReprice) return;

			try
			{
				if (stopLossOrder != null && !IsCancelling(stopLossOrder)) CancelOrder(stopLossOrder);
			}
			catch { }

			if (BlockIfSameBar("FinStop")) return;
			if (HasWorkingOrders(stopLossOrder))
			{
				_lastBlockReason = "block_working_exit:FinStop";
				SupportDump("trade_blocked");
				LogMsg("OrderBlock", "blocked working exit order for FinStop", 3);
				return;
			}
			if (Position.MarketPosition == MarketPosition.Long)
				stopLossOrder = ExitLongStopMarket(0, true, qty, stopPrice, "FinStopL", null);
			else if (Position.MarketPosition == MarketPosition.Short)
				stopLossOrder = ExitShortStopMarket(0, true, qty, stopPrice, "FinStopS", null);

			if (stopLossOrder != null)
			{
				MarkActionExecuted();
				SupportDump($"order_sent:{stopLossOrder.Name}");
			}
			LogMsg("FinStopUpdated", $"side={Position.MarketPosition} qty={qty} avg={Position.AveragePrice:0.00} stop={stopPrice:0.00} usd={FinancialStopUsd:0.00}", 2);
		}
