		private double ParseDoubleFlexible(string text)
		{
			if (string.IsNullOrWhiteSpace(text)) return 0;
			if (double.TryParse(text, NumberStyles.Any, CultureInfo.CurrentCulture, out double v1)) return v1;
			if (double.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out double v2)) return v2;
			return 0;
		}

