		private void ResetCloseBarState(string reason)
		{
			bool hasState = closeBarOrderPending ||
				closeBarOrder != null ||
				closeBarOrderDirection != Regime.None ||
				closeBarOrderActiveDirection != Regime.None ||
				closeBarOrderActiveBar >= 0 ||
				closeBarOrderCancelBar >= 0 ||
				closeBarRearmAfterCancel;

			if (!hasState)
				return;

			try
			{
				if (closeBarOrder != null && IsActiveOrSubmitted(closeBarOrder) && !IsCancelling(closeBarOrder))
					CancelOrder(closeBarOrder);
			}
			catch { }

			closeBarOrderPending = false;
			closeBarOrderDirection = Regime.None;
			closeBarOrderSignalClose = double.NaN;
			closeBarOrderActiveDirection = Regime.None;
			closeBarOrderActiveBar = -1;
			closeBarOrderCancelBar = -1;
			closeBarRearmAfterCancel = false;

			if (IsDeadOrder(closeBarOrder))
				closeBarOrder = null;

		}

