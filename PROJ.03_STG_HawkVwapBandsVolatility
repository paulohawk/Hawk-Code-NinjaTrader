		#region Exit helpers (VWAP / Opposite band / Financial)
		private void CancelOppositeBandExit()
		{
			try
			{
				if (oppositeBandExitOrder != null && !IsCancelling(oppositeBandExitOrder))
					CancelOrder(oppositeBandExitOrder);
				if (oppositeBandExitOrderReplace != null && !IsCancelling(oppositeBandExitOrderReplace))
					CancelOrder(oppositeBandExitOrderReplace);
			}
			catch { }

			// IMPORTANT:
			// IsDeadOrder(Order) is defined in Part 2B (single definition). Part 2A must not define it.
			// These calls will compile once Part 2B is appended.
			if (IsDeadOrder(oppositeBandExitOrder)) oppositeBandExitOrder = null;
			if (IsDeadOrder(oppositeBandExitOrderReplace)) oppositeBandExitOrderReplace = null;
		}

		private void MaintainOppositeBandExitOrder()
		{
			if (isLockedForDay || flattenInProgress)
			{
				CancelOppositeBandExit();
				return;
			}

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				CancelOppositeBandExit();
				return;
			}

			int idxBand = Math.Max(1, Math.Min(5, OppBandExitDeviation)) - 1;
			double ts = Instrument.MasterInstrument.TickSize;
			double repricingThreshold = ts * 0.5;

			double target = double.NaN;
			if (Position.MarketPosition == MarketPosition.Long)
				target = upper[idxBand];
			else if (Position.MarketPosition == MarketPosition.Short)
				target = lower[idxBand];

			if (double.IsNaN(target) || target <= 0)
			{
				CancelOppositeBandExit();
				return;
			}

			target = Instrument.MasterInstrument.RoundToTickSize(target);

			int qty = Math.Abs(Position.Quantity);

			var ord = oppositeBandExitOrder;
			var rep = oppositeBandExitOrderReplace;

			// heal rep==ord deadlock
			if (ord != null && rep != null && ReferenceEquals(ord, rep))
			{
				oppositeBandExitOrderReplace = null;
				rep = null;
				LogMsg("OppBandExitHeal", $"rep==ord cleared name={ord.Name} lim={ord.LimitPrice:0.00}", 2);
			}

			// promote replace->main if main is dead/missing
			if (rep != null && IsActiveOrSubmitted(rep) && (ord == null || IsDeadOrder(ord)))
			{
				oppositeBandExitOrder = rep;
				oppositeBandExitOrderReplace = null;
				ord = oppositeBandExitOrder;
				rep = null;
				LogMsg("OppBandExitHeal", $"promoted replace->main name={ord?.Name} lim={ord?.LimitPrice:0.00}", 2);
			}

			string ordInfo = ord == null ? "null" : $"{ord.Name} {ord.OrderState} lim={ord.LimitPrice:0.00} qty={ord.Quantity}";
			string repInfo = rep == null ? "null" : $"{rep.Name} {rep.OrderState} lim={rep.LimitPrice:0.00} qty={rep.Quantity}";
			double diff = (ord != null && ord.LimitPrice > 0) ? Math.Abs(ord.LimitPrice - target) : double.NaN;
			double diffTicks = (!double.IsNaN(diff) && ts > 0) ? diff / ts : double.NaN;

			LogMsg("OppBandExitCheck",
				$"pos={Position.MarketPosition} qty={qty} idx={idxBand + 1} target={target:0.00} thr={repricingThreshold:0.0000} diffTicks={diffTicks:0.00} ord={ordInfo} rep={repInfo}",
				2);

			// only block if replace is active AND main is active
			if (rep != null && IsActiveOrSubmitted(rep) && ord != null && IsActiveOrSubmitted(ord))
				return;

			// If main is cancelling, don't submit a new replace
			if (ord != null && IsCancelling(ord))
			{
				LogMsg("OppBandSkipReprice", $"reason=main_cancelling state={ord.OrderState}", 3);
				return;
			}

			// If we have an active main, submit replace when needed
			if (ord != null && IsActiveOrSubmitted(ord))
			{
				if (Math.Abs(ord.LimitPrice - target) > repricingThreshold ||
				    ord.Quantity != qty)
				{
					if (BlockIfSameBar("OppBandExitReplace")) return;
					if (HasWorkingOrders(oppositeBandExitOrderReplace))
					{
						_lastBlockReason = "block_working_exit:OppBandExitReplace";
						SupportDump("trade_blocked");
						LogMsg("OrderBlock", "blocked working exit order for OppBandExitReplace", 3);
						return;
					}
					if (Position.MarketPosition == MarketPosition.Long)
						oppositeBandExitOrderReplace = ExitLongLimit(0, true, qty, target, "OppBandExitL_R", null);
					else
						oppositeBandExitOrderReplace = ExitShortLimit(0, true, qty, target, "OppBandExitS_R", null);

					if (oppositeBandExitOrderReplace != null)
					{
						MarkActionExecuted();
						SupportDump($"order_sent:{oppositeBandExitOrderReplace.Name}");
					}
					LogMsg("OppBandExitReplaceSubmit", $"pos={Position.MarketPosition} old={ord.LimitPrice:0.00} new={target:0.00}", 2);
				}
				return;
			}

			// No active main => place new
			if (Position.MarketPosition == MarketPosition.Long)
			{
				if (BlockIfSameBar("OppBandExitNew")) return;
				if (HasWorkingOrders(oppositeBandExitOrder))
				{
					_lastBlockReason = "block_working_exit:OppBandExitNew";
					SupportDump("trade_blocked");
					LogMsg("OrderBlock", "blocked working exit order for OppBandExitNew", 3);
					return;
				}
				oppositeBandExitOrder = ExitLongLimit(0, true, qty, target, "OppBandExitL", null);
				if (oppositeBandExitOrder != null)
				{
					MarkActionExecuted();
					SupportDump($"order_sent:{oppositeBandExitOrder.Name}");
				}
				LogMsg("OppBandExitPlaced", $"L target={target:0.00}", 2);
			}
			else if (Position.MarketPosition == MarketPosition.Short)
			{
				if (BlockIfSameBar("OppBandExitNew")) return;
				if (HasWorkingOrders(oppositeBandExitOrder))
				{
					_lastBlockReason = "block_working_exit:OppBandExitNew";
					SupportDump("trade_blocked");
					LogMsg("OrderBlock", "blocked working exit order for OppBandExitNew", 3);
					return;
				}
				oppositeBandExitOrder = ExitShortLimit(0, true, qty, target, "OppBandExitS", null);
				if (oppositeBandExitOrder != null)
				{
					MarkActionExecuted();
					SupportDump($"order_sent:{oppositeBandExitOrder.Name}");
				}
				LogMsg("OppBandExitPlaced", $"S target={target:0.00}", 2);
			}
		}

		private void CheckFinancialExitPerTrade()
		{
			if (isLockedForDay) return;
			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0) return;

			double pointValue = Instrument?.MasterInstrument?.PointValue ?? 1.0;
			int qty = Math.Abs(Position.Quantity);
			double avg = Position.AveragePrice;
			double pnl = 0;

			if (Position.MarketPosition == MarketPosition.Long)
				pnl = (Close[0] - avg) * pointValue * qty;
			else if (Position.MarketPosition == MarketPosition.Short)
				pnl = (avg - Close[0]) * pointValue * qty;

			bool hasTarget = TradeProfitTargetUsd > 0;
			bool hasStop = TradeStopLossUsd > 0;

			if (hasTarget && pnl >= TradeProfitTargetUsd)
			{
				LogMsg("TradeCycleTargetHit", $"pnl={pnl:0.00} target={TradeProfitTargetUsd:0.00}", 2);
				RequestFlatten("TradeProfitTarget", allowAccountFallback: State == State.Realtime && !isAnalyzerMode);
				return;
			}
			if (hasStop && pnl <= -TradeStopLossUsd)
			{
				LogMsg("TradeCycleStopHit", $"pnl={pnl:0.00} stop={-TradeStopLossUsd:0.00}", 2);
				RequestFlatten("TradeStopLoss", allowAccountFallback: State == State.Realtime && !isAnalyzerMode);
				return;
			}
		}
