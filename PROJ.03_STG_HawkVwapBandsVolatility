		#region Lock helper
		private void LockDay(string reason, DateTime? utcOverride = null)
		{
			if (isLockedForDay) return;
			isLockedForDay = true;
			dayStatus = "Locked";
			_lockReason = reason;
			_lastBlockReason = reason;
			SupportDump("trade_blocked");

			DateTime fallbackUtc = (Time != null && CurrentBar >= 0) ? Time[0].ToUniversalTime() : DateTime.UtcNow;
			_lockedAtUtc = utcOverride ?? fallbackUtc;

			LogMsg("DayLock", $"LOCKED reason={reason} utc={_lockedAtUtc:O} brt={ConvertToBrasilia(Time[0]).AddMinutes(UserBrtOffsetMinutes):yyyy-MM-dd HH:mm:ss}", 2);
		}
