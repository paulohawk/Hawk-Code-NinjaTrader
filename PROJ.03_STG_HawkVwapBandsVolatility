		#region Bracket watchdog helpers
		private string GetFromEntrySignal()
		{
			if (string.IsNullOrWhiteSpace(_lastEntrySignalName)) return null;
			if (!cycleOpen) return null;
			if (_entrySignalCycleId != _currentCycleId) return null;
			return _lastEntrySignalName;
		}

		private bool IsFailSafeBlocking() =>
			_bracketFailSafeActive && Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0;

		private bool ShouldRepairBracket() =>
			State == State.Realtime && !isAnalyzerMode && !flattenInProgress && !IsFailSafeBlocking();

		private bool IsBracketOrderActive(Order ord) =>
			ord != null && (ord.OrderState == OrderState.Working || ord.OrderState == OrderState.Accepted || ord.OrderState == OrderState.Submitted);

		private bool IsBracketOrderCancelling(Order ord) =>
			ord != null && (ord.OrderState == OrderState.CancelPending || ord.OrderState == OrderState.CancelSubmitted);

		private bool IsBracketOrderDead(Order ord) =>
			ord == null || ord.OrderState == OrderState.Cancelled || ord.OrderState == OrderState.Rejected || ord.OrderState == OrderState.Unknown;

		private void ResetExecutionCycleGuard(string reason)
		{
			if (!_entryFilled && !_stopConfirmed && !_targetConfirmed && !_protectionReady && _unprotectedPositionCount == 0)
				return;

			_entryFilled = false;
			_stopConfirmed = false;
			_targetConfirmed = false;
			_protectionReady = false;
			_unprotectedPositionCount = 0;
		}

		private void UpdateProtectionState(ExitMode mode)
		{
			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				ResetExecutionCycleGuard("position_flat");
				return;
			}

			int qty = Math.Abs(Position.Quantity);
			Order targetOrder = GetActiveTargetOrder(mode);
			bool stopActive = IsBracketOrderActive(stopLossOrder);
			bool targetActive = IsBracketOrderActive(targetOrder);
			bool stopConfirmed = stopActive && stopLossOrder.Quantity == qty;
			bool targetConfirmed = targetActive && targetOrder.Quantity == qty;
			bool protectionReady = _entryFilled && stopConfirmed && targetConfirmed;

			_stopConfirmed = stopConfirmed;
			_targetConfirmed = targetConfirmed;
			_protectionReady = protectionReady;

			if (protectionReady)
				_unprotectedPositionCount = 0;
		}

		private void TriggerExecutionFailSafe(string reason, string sourceTag)
		{
			if (_executionCycleLocked) return;
			_executionCycleLocked = true;
			_bracketFailSafeActive = true;


			RequestFlatten(reason, allowAccountFallback: State == State.Realtime && !isAnalyzerMode);
		}

		private bool EnsureProtectionIntegrity(string sourceTag, bool allowRepair, bool requireProtectionReady)
		{
			if (_executionCycleLocked)
				return false;

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				ResetExecutionCycleGuard("position_flat");
				return true;
			}

			ExitMode mode = GetExitMode();
			UpdateProtectionState(mode);

			if (_protectionReady)
				return true;

			if (_bracketValidationSuspended)
				return false;

			if (allowRepair && ShouldRepairBracket())
				BracketWatchdog($"{sourceTag}_guard");

			return false;
		}

		private void RegisterUnprotectedState(string sourceTag, string reason)
		{
			_unprotectedPositionCount++;

			if (_unprotectedPositionCount >= UnprotectedPositionLimit)
				TriggerExecutionFailSafe("UnprotectedPosition", sourceTag);
		}

		private bool IsSamePrice(Order order, double price)
		{
			if (order == null) return false;
			double tick = Instrument?.MasterInstrument?.TickSize ?? TickSize;
			double threshold = tick * 0.1;
			if (order.StopPrice > 0 && Math.Abs(order.StopPrice - price) < threshold) return true;
			if (order.LimitPrice > 0 && Math.Abs(order.LimitPrice - price) < threshold) return true;
			return false;
		}

		private void PlaceInitialBracketAfterEntry()
		{
			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
				return;
			if (_entryBracketPlacedCycleId == _currentCycleId)
				return;

			ExitMode mode = GetExitMode();
			Order targetOrder = GetActiveTargetOrder(mode);
			if (IsBracketOrderActive(stopLossOrder) || IsBracketOrderActive(targetOrder))
				return;

			double stopPrice;
			double targetPrice;
			string stopReason;
			string targetReason;

			if (!TryGetBracketStopPrice(out stopPrice, out stopReason))
				return;

			if (!TryGetBracketTargetPrice(mode, out targetPrice, out targetReason))
				return;

			int qty = Math.Abs(Position.Quantity);
			string fromEntry = _lastEntrySignalName;
			Order createdStop = null;
			Order createdTarget = null;

			if (Position.MarketPosition == MarketPosition.Long)
			{
				createdStop = ExitLongStopMarket(0, true, qty, stopPrice, "FinStopL", fromEntry);
				if (mode == ExitMode.Vwap)
					createdTarget = ExitLongLimit(0, true, qty, targetPrice, "VWAPExitL", fromEntry);
				else if (mode == ExitMode.OppositeBand)
					createdTarget = ExitLongLimit(0, true, qty, targetPrice, "OppBandExitL", fromEntry);
				else
					createdTarget = ExitLongLimit(0, true, qty, targetPrice, "FinTargetL", fromEntry);
			}
			else if (Position.MarketPosition == MarketPosition.Short)
			{
				createdStop = ExitShortStopMarket(0, true, qty, stopPrice, "FinStopS", fromEntry);
				if (mode == ExitMode.Vwap)
					createdTarget = ExitShortLimit(0, true, qty, targetPrice, "VWAPExitS", fromEntry);
				else if (mode == ExitMode.OppositeBand)
					createdTarget = ExitShortLimit(0, true, qty, targetPrice, "OppBandExitS", fromEntry);
				else
					createdTarget = ExitShortLimit(0, true, qty, targetPrice, "FinTargetS", fromEntry);
			}

			bool stopValid = IsBracketOrderActive(createdStop);
			bool targetValid = IsBracketOrderActive(createdTarget);
			if (stopValid && targetValid)
			{
				stopLossOrder = createdStop;
				if (mode == ExitMode.Vwap)
					exitVwapOrder = createdTarget;
				else if (mode == ExitMode.OppositeBand)
					oppositeBandExitOrder = createdTarget;
				else
					financialTargetOrder = createdTarget;

				_bracketRebuildCount = 0;
				_lastBracketConfirmedUtc = DateTime.UtcNow;
				_entryBracketPlacedCycleId = _currentCycleId;
			}
			else
			{
				_bracketRebuildCount++;
			}
		}

		private bool TryGetBidAsk(out double bid, out double ask)
		{
			bid = 0;
			ask = 0;
			try
			{
				bid = GetCurrentBid();
				ask = GetCurrentAsk();
			}
			catch { }
			return bid > 0 && ask > 0;
		}

		private double AdjustStopPriceForBracket(double price, MarketPosition side, string sourceTag)
		{
			double original = price;
			bool adjusted = false;
			double bid, ask;
			double tick = Instrument?.MasterInstrument?.TickSize ?? TickSize;

			if (TryGetBidAsk(out bid, out ask) && tick > 0)
			{
				if (side == MarketPosition.Long && price > bid - tick)
				{
					price = Math.Max(tick, bid - tick);
					adjusted = true;
				}
				else if (side == MarketPosition.Short && price < ask + tick)
				{
					price = ask + tick;
					adjusted = true;
				}
			}

			if (Instrument?.MasterInstrument != null)
				price = Instrument.MasterInstrument.RoundToTickSize(price);

			if (adjusted)

			return price;
		}

		private double AdjustTargetPriceForBracket(double price, MarketPosition side, string sourceTag)
		{
			double original = price;
			bool adjusted = false;
			double bid, ask;
			double tick = Instrument?.MasterInstrument?.TickSize ?? TickSize;

			if (TryGetBidAsk(out bid, out ask) && tick > 0)
			{
				if (side == MarketPosition.Long && price < ask + tick)
				{
					price = ask + tick;
					adjusted = true;
				}
				else if (side == MarketPosition.Short && price > bid - tick)
				{
					price = Math.Max(tick, bid - tick);
					adjusted = true;
				}
			}

			if (Instrument?.MasterInstrument != null)
				price = Instrument.MasterInstrument.RoundToTickSize(price);

			if (adjusted)

			return price;
		}

		private Order GetActiveTargetOrder(ExitMode mode)
		{
			switch (mode)
			{
				case ExitMode.Vwap:
					return IsBracketOrderActive(exitVwapOrder) ? exitVwapOrder :
						IsBracketOrderActive(exitVwapOrderReplace) ? exitVwapOrderReplace : exitVwapOrder ?? exitVwapOrderReplace;
				case ExitMode.OppositeBand:
					return IsBracketOrderActive(oppositeBandExitOrder) ? oppositeBandExitOrder :
						IsBracketOrderActive(oppositeBandExitOrderReplace) ? oppositeBandExitOrderReplace : oppositeBandExitOrder ?? oppositeBandExitOrderReplace;
				default:
					return IsBracketOrderActive(financialTargetOrder) ? financialTargetOrder :
						IsBracketOrderActive(financialTargetOrderReplace) ? financialTargetOrderReplace : financialTargetOrder ?? financialTargetOrderReplace;
			}
		}

		private bool TryGetBracketStopPrice(out double stopPrice, out string reason)
		{
			stopPrice = double.NaN;
			reason = string.Empty;

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				reason = "position_flat";
				return false;
			}

			int qty = Math.Abs(Position.Quantity);
			double pointValue = Instrument?.MasterInstrument?.PointValue ?? 1.0;
			double tick = Instrument?.MasterInstrument?.TickSize ?? TickSize;
			double usdRisk = 0;

			if (EnableFinancialStop && FinancialStopUsd > 0)
				usdRisk = FinancialStopUsd;
			else if (TradeStopLossUsd > 0)
				usdRisk = TradeStopLossUsd;

			if (usdRisk > 0)
			{
				double riskPerContract = usdRisk / Math.Max(1, qty);
				double points = riskPerContract / pointValue;
				if (Position.MarketPosition == MarketPosition.Long)
					stopPrice = Position.AveragePrice - points;
				else if (Position.MarketPosition == MarketPosition.Short)
					stopPrice = Position.AveragePrice + points;
			}
			else if (EnableStopLoss && StopLossTicks > 0 && tick > 0)
			{
				double points = StopLossTicks * tick;
				if (Position.MarketPosition == MarketPosition.Long)
					stopPrice = Position.AveragePrice - points;
				else if (Position.MarketPosition == MarketPosition.Short)
					stopPrice = Position.AveragePrice + points;
			}

			if (double.IsNaN(stopPrice) || stopPrice <= 0)
			{
				reason = "invalid_stop_price";
				return false;
			}

			stopPrice = AdjustStopPriceForBracket(stopPrice, Position.MarketPosition, "Watchdog");
			return true;
		}

		private bool TryGetBracketTargetPrice(ExitMode mode, out double targetPrice, out string reason)
		{
			targetPrice = double.NaN;
			reason = string.Empty;

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				reason = "position_flat";
				return false;
			}

			int qty = Math.Abs(Position.Quantity);
			double pointValue = Instrument?.MasterInstrument?.PointValue ?? 1.0;

			switch (mode)
			{
				case ExitMode.Vwap:
					if (double.IsNaN(lastSnapVwap) || lastSnapVwap <= 0)
					{
						reason = "vwap_unavailable";
						return false;
					}
					targetPrice = lastSnapVwap;
					break;
				case ExitMode.OppositeBand:
					int idxBand = Math.Max(1, Math.Min(5, OppBandExitDeviation)) - 1;
					if (Position.MarketPosition == MarketPosition.Long)
						targetPrice = upper[idxBand];
					else if (Position.MarketPosition == MarketPosition.Short)
						targetPrice = lower[idxBand];
					if (double.IsNaN(targetPrice) || targetPrice <= 0)
					{
						reason = "band_unavailable";
						return false;
					}
					break;
				default:
					if (TradeProfitTargetUsd <= 0)
					{
						reason = "target_usd_disabled";
						return false;
					}
					double profitPerContract = TradeProfitTargetUsd / Math.Max(1, qty);
					double points = profitPerContract / pointValue;
					if (Position.MarketPosition == MarketPosition.Long)
						targetPrice = Position.AveragePrice + points;
					else if (Position.MarketPosition == MarketPosition.Short)
						targetPrice = Position.AveragePrice - points;
					break;
			}

			if (double.IsNaN(targetPrice) || targetPrice <= 0)
			{
				reason = "invalid_target_price";
				return false;
			}

			targetPrice = AdjustTargetPriceForBracket(targetPrice, Position.MarketPosition, "Watchdog");
			return true;
		}

		private bool IsBracketValid(ExitMode mode, out string reason)
		{
			reason = string.Empty;
			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				reason = "position_flat";
				return false;
			}

			int qty = Math.Abs(Position.Quantity);
			Order targetOrder = GetActiveTargetOrder(mode);

			if (!IsBracketOrderActive(stopLossOrder))
			{
				reason = "stop_missing_or_dead";
				return false;
			}
			if (!IsBracketOrderActive(targetOrder))
			{
				reason = "target_missing_or_dead";
				return false;
			}

			if (stopLossOrder.Quantity != qty)
			{
				reason = $"stop_qty_mismatch stop={stopLossOrder.Quantity} pos={qty}";
				return false;
			}
			if (targetOrder.Quantity != qty)
			{
				reason = $"target_qty_mismatch target={targetOrder.Quantity} pos={qty}";
				return false;
			}

			if (_lastBracketFillUtc != DateTime.MinValue)
			{
				if (stopLossOrder.Time < _lastBracketFillUtc || targetOrder.Time < _lastBracketFillUtc)
				{
					reason = "post_fill_unconfirmed";
					return false;
				}
			}

			return true;
		}

		private bool TryCancelBracketOrders(string reasonTag, ExitMode mode)
		{
			Order targetOrder = GetActiveTargetOrder(mode);
			if (IsBracketOrderCancelling(stopLossOrder) || IsBracketOrderCancelling(targetOrder))
			{
				return false;
			}

			if (IsBracketOrderActive(stopLossOrder))
			{
				try { CancelOrder(stopLossOrder); } catch { }
			}
			if (IsBracketOrderActive(targetOrder))
			{
				try { CancelOrder(targetOrder); } catch { }
			}

			if (IsBracketOrderActive(stopLossOrder) || IsBracketOrderActive(targetOrder) ||
				IsBracketOrderCancelling(stopLossOrder) || IsBracketOrderCancelling(targetOrder))
			{
				return false;
			}

			return true;
		}

		private void BracketWatchdog(string sourceTag)
		{
			if (flattenInProgress) return;

			if (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0)
			{
				_lastBracketQty = 0;
				_lastBracketFillUtc = DateTime.MinValue;
				_lastBracketConfirmedUtc = DateTime.MinValue;
				_bracketFailSafeActive = false;
				_bracketValidationSuspended = false;
				_bracketValidationSuspensionLogged = false;
				_unprotectedPositionCount = 0;
				ResetExecutionCycleGuard("bracket_watchdog_flat");
				return;
			}

			ExitMode mode = GetExitMode();
			string reason = string.Empty;
			string stopReason = string.Empty;
			string targetReason = string.Empty;
			double stopPrice = 0.0;
			double targetPrice = 0.0;
			_lastBracketCheckUtc = DateTime.UtcNow;
			double elapsedMs = (DateTime.UtcNow - _lastEntryFillUtc).TotalMilliseconds;
			if (_bracketValidationSuspended)
			{
				if (elapsedMs > 5000)
				{
					_bracketValidationSuspended = false;
					_bracketValidationSuspensionLogged = false;
				}
			}

			if (_bracketValidationSuspended)
			{
				Order targetOrder = GetActiveTargetOrder(mode);
				bool stopActive = IsBracketOrderActive(stopLossOrder);
				bool targetActive = IsBracketOrderActive(targetOrder);

				if (stopActive && targetActive)
				{
					_bracketValidationSuspended = false;
					_bracketValidationSuspensionLogged = false;
					_lastBracketConfirmedUtc = DateTime.UtcNow;
				}
				else
				{
					bool inGrace = elapsedMs < _bracketValidationGracePeriod.TotalMilliseconds;
					string skipReason = inGrace ? "post_fill_grace_period" : "waiting_bracket_active";
					if (!_bracketValidationSuspensionLogged ||
						(DateTime.UtcNow - _lastBracketValidationSkipUtc).TotalSeconds >= 2)
					{
						_bracketValidationSuspensionLogged = true;
						_lastBracketValidationSkipUtc = DateTime.UtcNow;
					}
					return;
				}
			}

			UpdateProtectionState(mode);

			if (IsBracketValid(mode, out reason))
			{
				_lastBracketQty = Math.Abs(Position.Quantity);
				_lastBracketConfirmedUtc = DateTime.UtcNow;
				return;
			}

			if (reason.IndexOf("qty_mismatch", StringComparison.OrdinalIgnoreCase) >= 0)


			if (!_bracketValidationSuspended)
				RegisterUnprotectedState(sourceTag, reason);

			if (_executionCycleLocked)
				return;

			if (!ShouldRepairBracket())
			{
				return;
			}

			Order activeTargetOrder = GetActiveTargetOrder(mode);

			bool isFixedTarget = mode != ExitMode.Vwap;
			if (TryGetBracketStopPrice(out stopPrice, out stopReason) &&
				TryGetBracketTargetPrice(mode, out targetPrice, out targetReason) &&
				IsBracketOrderActive(stopLossOrder) && IsSamePrice(stopLossOrder, stopPrice) &&
				IsBracketOrderActive(activeTargetOrder) &&
				(!isFixedTarget || IsSamePrice(activeTargetOrder, targetPrice)))
			{
				_lastBracketQty = Math.Abs(Position.Quantity);
				_lastBracketConfirmedUtc = DateTime.UtcNow;
				return;
			}

			if ((DateTime.UtcNow - _lastBracketRebuildUtc) < _bracketRebuildCooldown)
			{
				return;
			}

			if (IsBracketOrderCancelling(stopLossOrder) || IsBracketOrderCancelling(GetActiveTargetOrder(mode)))
			{
				return;
			}

			if (_bracketRebuildCount >= BracketRebuildLimit)
			{
				if (_lastBracketConfirmedUtc != DateTime.MinValue &&
					(DateTime.UtcNow - _lastBracketConfirmedUtc).TotalSeconds < 10)
				{
					return;
				}
				TriggerExecutionFailSafe("BracketRebuildLimit", sourceTag);
				return;
			}

			if (BlockIfSameBar("BracketRebuild")) return;

			if (!TryCancelBracketOrders(sourceTag, mode))
				return;

			if (!TryGetBracketStopPrice(out stopPrice, out stopReason) ||
				!TryGetBracketTargetPrice(mode, out targetPrice, out targetReason))
			{
				_bracketRebuildCount++;
				_lastBracketRebuildUtc = DateTime.UtcNow;
				return;
			}

			int qty = Math.Abs(Position.Quantity);
			string fromEntry = GetFromEntrySignal();
			Order newStop = null;
			Order newTarget = null;

			if (Position.MarketPosition == MarketPosition.Long)
			{
				newStop = ExitLongStopMarket(0, true, qty, stopPrice, "FinStopL", fromEntry);
				if (mode == ExitMode.Vwap)
					newTarget = ExitLongLimit(0, true, qty, targetPrice, "VWAPExitL", fromEntry);
				else if (mode == ExitMode.OppositeBand)
					newTarget = ExitLongLimit(0, true, qty, targetPrice, "OppBandExitL", fromEntry);
				else
					newTarget = ExitLongLimit(0, true, qty, targetPrice, "FinTargetL", fromEntry);
			}
			else if (Position.MarketPosition == MarketPosition.Short)
			{
				newStop = ExitShortStopMarket(0, true, qty, stopPrice, "FinStopS", fromEntry);
				if (mode == ExitMode.Vwap)
					newTarget = ExitShortLimit(0, true, qty, targetPrice, "VWAPExitS", fromEntry);
				else if (mode == ExitMode.OppositeBand)
					newTarget = ExitShortLimit(0, true, qty, targetPrice, "OppBandExitS", fromEntry);
				else
					newTarget = ExitShortLimit(0, true, qty, targetPrice, "FinTargetS", fromEntry);
			}

				_lastBracketRebuildUtc = DateTime.UtcNow;
				_bracketRebuildCount++;
				_lastBracketQty = qty;
				MarkActionExecuted();
			}
