		private ExitMode GetExitMode()
		{
			if (ExitAtOppositeBandEnabled) return ExitMode.OppositeBand;
			if (ExitAtVwapEnabled) return ExitMode.Vwap;
			return ExitMode.Financial;
		}

		// === Added by paper: keep regime direction locked during an open cycle/position ===
		private Regime GetEffectiveRegime(double vwap)
		{
			// If there is an open position, do NOT invert direction (Long -> Buy, Short -> Sell)
			if (Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
				return (Position.MarketPosition == MarketPosition.Long) ? Regime.Buy : Regime.Sell;

			// If the cycle is marked open, also keep direction (helps when Position is not yet updated)
			if (cycleOpen && cycleDirection != Regime.None)
				return cycleDirection;

			// Flat: regime comes from price vs VWAP
			return (Close[0] < vwap) ? Regime.Buy : Regime.Sell;
		}
