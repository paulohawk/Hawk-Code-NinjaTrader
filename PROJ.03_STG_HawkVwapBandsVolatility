								closeBarOrderSignalClose = double.NaN;
								closeBarOrderActiveDirection = Regime.Buy;
								closeBarOrderActiveBar = CurrentBar;
								closeBarOrderCancelBar = -1;
								closeBarRearmAfterCancel = false;
								_lastSignal = "CloseBar_Long_Limit";
								_lastAction = "EnterLongLimitCloseBar";
								MarkActionExecuted();
							}
							else if (closeBarOrderDirection == Regime.Sell)
							{
								double limitPrice = Close[0] - offset;
								closeBarOrder = EnterShortLimit(0, true, QuantityPerGridOrder, limitPrice, CloseBarEntryShortName);
								closeBarOrderPending = false;
								closeBarOrderDirection = Regime.None;
								closeBarOrderSignalClose = double.NaN;
								closeBarOrderActiveDirection = Regime.Sell;
								closeBarOrderActiveBar = CurrentBar;
								closeBarOrderCancelBar = -1;
								closeBarRearmAfterCancel = false;
								_lastSignal = "CloseBar_Short_Limit";
								_lastAction = "EnterShortLimitCloseBar";
								MarkActionExecuted();
							}
						}
					}

					if (inWindow && !isLockedForDay && isFlat && !hasWorkingOrders && !hasCloseBarWorkingOrder && canStartCycle && !closeBarOrderPending && !double.IsNaN(stochD))
					{
						if (!BlockIfSameBar("slow_stoch_entry"))
						{
							if (newRegime == Regime.Buy && Close[0] <= lower[1] && stochD <= StochLowerThreshold)
							{
								if (EnableCloseBarFilter)
								{
									if (!closeBarOrderPending)
									{
										closeBarOrderPending = true;
										closeBarOrderDirection = Regime.Buy;
										closeBarOrderSignalClose = Close[0];
										_lastSignal = "SlowStoch_Long_CloseBarPending";
										_lastAction = "MarkCloseBarPendingLong";
										MarkActionExecuted();
									}
								}
								else
								{
									EnterLong(0, QuantityPerGridOrder, "SlowStoch_Long");
									_lastAction = "EnterLongMarket";
									MarkActionExecuted();
								}
							}
							else if (newRegime == Regime.Sell && Close[0] >= upper[1] && stochD >= StochUpperThreshold)
							{
								if (EnableCloseBarFilter)
								{
									if (!closeBarOrderPending)
									{
										closeBarOrderPending = true;
										closeBarOrderDirection = Regime.Sell;
										closeBarOrderSignalClose = Close[0];
										_lastSignal = "SlowStoch_Short_CloseBarPending";
										_lastAction = "MarkCloseBarPendingShort";
										MarkActionExecuted();
									}
								}
								else
								{
									EnterShort(0, QuantityPerGridOrder, "SlowStoch_Short");
									_lastAction = "EnterShortMarket";
									MarkActionExecuted();
								}
							}
						}
					}

					CheckFlattenProgress();
					PublishPanelSnapshot("OnBarUpdate");
				}
			}
			catch (Exception ex)
			{
				Print($"[HawkVwapBandsVolatility] OnBarUpdate exception: {ex}");
			}
		}

		private void ApplyDailyResetIfNeeded(DateTime calDay)
		{
			if (lastCalendarDayBrt.Date != calDay.Date)
			{
				lastCalendarDayBrt = calDay.Date;
				isLockedForDay = false;
				_lockReason = "";
				_lockedAtUtc = DateTime.MinValue;
				realizedPnlDay = 0;
				_unrealizedPnlManual = 0;
				_totalPnlDay = 0;
				_cachedPnlDay = "0.00";
				dayStatus = "Waiting";
				lastAutoCloseDate = DateTime.MinValue;
				_lastPreCloseDate = DateTime.MinValue;

				lastRegime = currentRegime;
				currentRegime = Regime.None;
				closeBarOrderPending = false;
				closeBarOrder = null;
				closeBarOrderDirection = Regime.None;
				closeBarOrderSignalClose = double.NaN;
				closeBarOrderActiveDirection = Regime.None;
				closeBarOrderActiveBar = -1;
				closeBarOrderCancelBar = -1;
				closeBarRearmAfterCancel = false;

				ResetTradeCounters(calDay);

				if (PanelPnlMode == PanelPnLMode.RealtimeOnly)
				{
					_rtBrtDay = calDay.Date;
					int newYm = calDay.Year * 100 + calDay.Month;
					if (_rtBrtYearMonth != newYm)
					{
						_rtRealizedMonth = 0;
						_rtBrtYearMonth = newYm;
					}
					_rtRealizedDay = 0;
				}

				LogMsg("DayReset", $"Novo dia calendário BRT {lastCalendarDayBrt:yyyy-MM-dd} (unlock; pnl reset; trade counters reset)", 2);
			}
		}
