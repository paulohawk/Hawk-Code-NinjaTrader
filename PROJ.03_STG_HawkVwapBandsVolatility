			return (int)level <= (int)LogLevel;
		}

		private void Log(HawkLogLevel level, string tag, string msg)
		{
			if (!ShouldLog(level)) return;
			string levelText = level.ToString().ToUpperInvariant();
			string body = string.IsNullOrWhiteSpace(msg) ? "msg=" : msg;
			try { Print($"[{Name}][{levelText}][{tag}] {body}"); }
			catch { Print($"[{Name}][{levelText}][{tag}] {body}"); }
			lastEvent = tag;
		}

		private HawkLogLevel MapLogLevel(int level)
		{
			switch (level)
			{
				case 1: return HawkLogLevel.Error;
				case 2: return HawkLogLevel.Info;
				case 3: return HawkLogLevel.Debug;
				default: return HawkLogLevel.Trace;
			}
		}

		private void LogMsg(string tag, string msg, int level = 2)
		{
