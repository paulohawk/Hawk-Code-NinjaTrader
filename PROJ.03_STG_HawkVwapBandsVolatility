		#region Realtime ledger helpers

		// Realtime panel must NEVER inherit cached/historical PnL. It starts blank and only
		// accumulates executions that happen while this strategy instance is running in realtime
		// on an eligible account (non-Playback and not Sim101).
		private void ClearRealtimePanelStats(bool resetProcessedCount)
		{
			_rtRealizedTotal = 0;
			_rtRealizedMonth = 0;
			_rtRealizedDay = 0;
			_rtBrtDay = DateTime.MinValue;
			_rtBrtYearMonth = 0;

			realizedPnlDay = 0;
			_cachedPnlDay = "-";
			_cachedPnlMonth = "-";
			_cachedPnlTotal = "-";
			_maxGainStreak = 0;
			_maxLossStreak = 0;

			if (resetProcessedCount)
			{
				try { _rtLastProcessedTradeCount = SystemPerformance?.AllTrades?.Count ?? 0; } catch { _rtLastProcessedTradeCount = 0; }
			}
		}

		private bool IsEligibleRealtimeAccount()
		{
			// Realtime-only mode: only count executions that happened in REALTIME on non-sim/non-replay accounts.
			if (PanelPnlMode != PanelPnLMode.RealtimeOnly)
				return true;

			if (State != State.Realtime)
				return false;

			if (Account == null)
				return false;

			try
			{
				string an = Account.Name ?? string.Empty;

				// Default NT sim account
				if (an.Equals("Sim101", StringComparison.OrdinalIgnoreCase))
					return false;

				// Playback/replay accounts (defensive match)
				if (an.IndexOf("Playback", StringComparison.OrdinalIgnoreCase) >= 0)
					return false;

				if (an.IndexOf("Replay", StringComparison.OrdinalIgnoreCase) >= 0)
					return false;
			}
			catch
			{
				return false;
			}

			return true;
		}
		private void ProcessNewRealtimeTrades()
		{
			if (PanelPnlMode != PanelPnLMode.RealtimeOnly) return;

			// In realtime-only mode we show ONLY executions from eligible realtime accounts.
			if (!IsEligibleRealtimeAccount()) { ClearRealtimePanelStats(resetProcessedCount: true); return; }
			var all = SystemPerformance.AllTrades;
			int count = all.Count;
			if (count <= _rtLastProcessedTradeCount) return;

			for (int idx = _rtLastProcessedTradeCount; idx < count; idx++)
			{
				var tr = all[idx];
				if (tr?.Exit == null) continue;

				var exitBrt = ConvertToBrasilia(tr.Exit.Time).AddMinutes(UserBrtOffsetMinutes);
				var exitDay = exitBrt.Date;
				int exitYm = exitDay.Year * 100 + exitDay.Month;

				if (_rtBrtDay == DateTime.MinValue || _rtBrtDay.Date != exitDay)
				{
					_rtRealizedDay = 0;
					_rtBrtDay = exitDay;
				}
				if (_rtBrtYearMonth == 0 || _rtBrtYearMonth != exitYm)
				{
					_rtRealizedMonth = 0;
					_rtBrtYearMonth = exitYm;
				}

				_rtRealizedTotal += tr.ProfitCurrency;
				_rtRealizedMonth += tr.ProfitCurrency;
				_rtRealizedDay += tr.ProfitCurrency;
			}

			_rtLastProcessedTradeCount = count;

			_cachedPnlMonth = _rtRealizedMonth.ToString("0.00");
			_cachedPnlTotal = _rtRealizedTotal.ToString("0.00");

			realizedPnlDay = _rtRealizedDay;
			_cachedPnlDay = realizedPnlDay.ToString("0.00");

			_panelCacheSaveRequested = true;
		}
		#endregion

		private SignalDecision EvaluateSignals(double vwap, bool inWindow)
		{
			SignalDecision decision = new SignalDecision();

			Regime newRegime = GetEffectiveRegime(vwap);
			bool canFlip = (Position == null || Position.MarketPosition == MarketPosition.Flat || Position.Quantity == 0) && !cycleOpen;

			decision.RegimeChanged = canFlip && newRegime != currentRegime;
			decision.SignalName = decision.RegimeChanged ? $"RegimeChanged:{newRegime}" : string.Empty;
			decision.NextRegime = newRegime;

			var mode = GetExitMode();
			decision.ExitMode = mode;
			decision.ExitModeChanged = lastExitMode == null || lastExitMode != mode;

			bool canMaintainExit = !isLockedForDay && Position.MarketPosition != MarketPosition.Flat;
			decision.UseVwapExit = mode == ExitMode.Vwap && canMaintainExit;
			decision.UseOppositeBandExit = mode == ExitMode.OppositeBand && canMaintainExit;
			decision.UseFinancialExit = !decision.UseVwapExit && !decision.UseOppositeBandExit;
			decision.CheckFinancialExit = decision.UseFinancialExit && !isLockedForDay;
			decision.MaintainFinancialTarget = decision.UseFinancialExit;
			decision.MaintainStopLoss = true;

			bool cycleAlreadyOpen = cycleOpen || (Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0);
			bool canStartCycle = cycleAlreadyOpen || CanStartNewCycle(newRegime);

			decision.RepriceGrid = inWindow && newRegime != Regime.None && !isLockedForDay && canStartCycle && !IsFailSafeBlocking() && !_executionCycleLocked;
			decision.CancelSideGridForLimit = !canStartCycle && newRegime != Regime.None;
			decision.CancelAllGrid = !decision.RepriceGrid && !decision.CancelSideGridForLimit;
			decision.CancelStopsWhenFlat = decision.CancelAllGrid && (Position == null || Position.MarketPosition == MarketPosition.Flat);

			return decision;
		}

		private void TryExecute(SignalDecision decision, double vwap, int touched, DateTime nowBrtDt, int nowBrtInt, bool inWindow)
		{
			if (_executionCycleLocked)
			{
				CancelAllGrid("execution_lock");
				CheckFlattenProgress();
				return;
			}

			if (IsFailSafeBlocking())
			{
				CancelAllGrid("failsafe");
				CheckFlattenProgress();
				return;
			}

			if (decision.RegimeChanged)
			{
				lastRegime = currentRegime;
				currentRegime = decision.NextRegime;

				CancelAllGrid("regime_flip_price_vs_vwap");
			}
			else
			{
				currentRegime = decision.NextRegime;
			}


			if (decision.ExitModeChanged)
			{
				lastExitMode = decision.ExitMode;
			}

			if (decision.UseVwapExit)
			{
				MaintainVwapExitOrder(vwap);
				CancelOppositeBandExit();
				CancelFinancialTarget();
			}
			else if (decision.UseOppositeBandExit)
			{
				CancelExitVwap();
				MaintainOppositeBandExitOrder();
				CancelFinancialTarget();
			}
			else
			{
				CancelExitVwap();
				CancelOppositeBandExit();
				if (decision.CheckFinancialExit)
					CheckFinancialExitPerTrade();
				MaintainFinancialTargetLimit();
			}

			if (decision.MaintainStopLoss)
				MaintainStopLoss();

			if (decision.RepriceGrid)
			{
				RepriceOrPlaceGrid(upper, lower);
			}
			else
			{
				if (decision.CancelSideGridForLimit)
				{
					CancelSideGrid(currentRegime, "trade_limit_cycle");
					dayStatus = "TradeLimitHit";
					lastEvent = "TradeLimitHit";
				}
				else
