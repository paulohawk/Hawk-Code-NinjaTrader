		#region Panel snapshot helpers
		private HVB_PanelStateHub.PanelSnapshot BuildSnapshot(bool offSnapshot, string statusOverride = null)
		{
			if (string.IsNullOrWhiteSpace(cacheKey))
				return null;

			var snap = new HVB_PanelStateHub.PanelSnapshot();
			snap.LastUpdatedUtc = (State == State.Historical) ? Time[0].ToUniversalTime() : DateTime.UtcNow;
			snap.StrategyName = PanelTitle;
			snap.StrategyKey = cacheKey;

			string status = statusOverride ?? dayStatus;
			var mode = GetExitMode();
			snap.DayTradeStatus = status;
			snap.StatusText = $"{lastEvent} | Mode={mode} | PanelPnL={PanelPnlMode} | Persist={(ShouldPersistPanelCache() ? "On" : "Off")}";

			if (PanelPnlMode == PanelPnLMode.ChartHistorical)
			{
				DateTime referenceTime = Time[0];
				DateTime nowLocalBrt = ConvertToBrasilia(referenceTime).AddMinutes(UserBrtOffsetMinutes);
				RecalcPnLIfNeeded(nowLocalBrt);
			}

			snap.PnLDiaText = _cachedPnlDay;
			snap.PnLMesText = _cachedPnlMonth;
			snap.PnLTotalText = _cachedPnlTotal;
			snap.ATREnabled = EnableSlowStochFilter;
			snap.AtrDisplayText = EnableSlowStochFilter ? "On" : "Off";
			snap.BEEnabled = breakEvenActivated;

			snap.DayStopDollar = dayStopDollars;
			snap.DayTargetDollar = dayTargetDollars;
			snap.DayBreakevenDollar = dayBreakevenDollars;

			snap.EndDayText = "-";

			snap.MainEnabled = (status == "Trading" || status == "StopNewTrades") && !isLockedForDay;

			if (offSnapshot)
			{
				snap.EntryPrice = null;
				snap.StopChart = null;
				snap.ExitTarget = null;
				snap.Qty = null;
				snap.PendingEntryPrice = null;
				snap.PendingQty = null;
				snap.PendingStopPrice = null;
				snap.PendingTargetPrice = null;
				snap.FinancialStopText = snap.DayStopDollar;
				snap.TakeDollarText = snap.DayTargetDollar;
				return snap;
			}

			if (stopLossOrder != null && stopLossOrder.StopPrice > 0 &&
			    (stopLossOrder.OrderState == OrderState.Working || stopLossOrder.OrderState == OrderState.Accepted || stopLossOrder.OrderState == OrderState.Submitted || stopLossOrder.OrderState == OrderState.CancelPending || stopLossOrder.OrderState == OrderState.CancelSubmitted))
			{
				if (Position != null && Position.MarketPosition != MarketPosition.Flat && Position.Quantity != 0)
					snap.StopChart = stopLossOrder.StopPrice;
				else
					snap.PendingStopPrice = stopLossOrder.StopPrice;
			}

			if (Position != null && Position.MarketPosition != MarketPosition.Flat)
			{
				snap.EntryPrice = Position.AveragePrice;
				snap.Qty = Math.Abs(Position.Quantity);

				if (mode == ExitMode.Vwap)
					snap.ExitTarget = double.IsNaN(lastSnapVwap) ? (double?)null : lastSnapVwap;
				else if (mode == ExitMode.OppositeBand)
				{
					int idx = Math.Max(1, Math.Min(5, OppBandExitDeviation)) - 1;
					snap.ExitTarget = Position.MarketPosition == MarketPosition.Long ? upper[idx] : lower[idx];
				}
				else
					snap.ExitTarget = null;
			}
			else
			{
				double? pendingPrice = null;
				int? pendingQty = null;
				if (currentRegime == Regime.Buy && gridLong[0] != null)
				{
					pendingPrice = gridLong[0].LimitPrice;
					pendingQty = gridLong[0].Quantity;
				}
				if (currentRegime == Regime.Sell && gridShort[0] != null)
				{
					pendingPrice = gridShort[0].LimitPrice;
					pendingQty = gridShort[0].Quantity;
				}
				snap.PendingEntryPrice = pendingPrice;
				snap.PendingQty = pendingQty;
			}

			snap.FinancialStopText = dayStopDollars;
			snap.TakeDollarText = dayTargetDollars;
			snap.MaxGainStreak = _maxGainStreak;
			snap.MaxLossStreak = _maxLossStreak;

			return snap;
		}

		private void PublishPanelSnapshot(string context = "")
		{
			if (string.IsNullOrWhiteSpace(cacheKey))
				return;

			var snap = BuildSnapshot(false, dayStatus);
			if (snap == null) return;
			HVB_PanelStateHub.Set(cacheKey, snap);
			if (panelHelper != null)
			{
				var now = DateTime.UtcNow;
				if ((now - lastPanelPub).TotalSeconds >= Math.Max(1, PanelPublishIntervalSeconds))
				{
					lastPanelPub = now;
					panelHelper.ApplySnapshot(snap);
				}
			}

			int tradesCount = PanelPnlMode == PanelPnLMode.ChartHistorical ? SystemPerformance.AllTrades.Count : _rtLastProcessedTradeCount;
			if (_panelCacheSaveRequested && ShouldPersistPanelCache())
			{
				TrySavePanelCache(snap, tradesCount);
				_panelCacheSaveRequested = false;
			}
		}

		private void PublishPanelOffSnapshot(string context = "")
		{
			if (string.IsNullOrWhiteSpace(cacheKey))
				return;

			var snap = BuildSnapshot(true, "Waiting");
			if (snap == null) return;
			HVB_PanelStateHub.Set(cacheKey, snap);
			try { panelHelper?.ApplySnapshot(snap); } catch { }
		}
