					_lastEntrySignalName = execution.Order.Name;
					_entrySignalCycleId = _currentCycleId;
					_lastEntryFillUtc = DateTime.UtcNow;
					_entryFilled = true;
					_stopConfirmed = false;
					_targetConfirmed = false;
					_protectionReady = false;
					_unprotectedPositionCount = 0;
					_bracketValidationSuspended = true;
					_bracketValidationSuspensionLogged = false;
					_lastBracketValidationSkipUtc = DateTime.MinValue;
					PlaceInitialBracketAfterEntry();
				}

				_lastBracketFillUtc = time.ToUniversalTime();

				if (execution.Order.Name != null &&
					(execution.Order.Name.StartsWith(CloseBarEntryLongName, StringComparison.OrdinalIgnoreCase) ||
					 execution.Order.Name.StartsWith(CloseBarEntryShortName, StringComparison.OrdinalIgnoreCase)))
				{
					closeBarOrderPending = false;
					closeBarOrder = null;
					closeBarOrderDirection = Regime.None;
					closeBarOrderSignalClose = double.NaN;
					closeBarOrderActiveDirection = Regime.None;
					closeBarOrderActiveBar = -1;
					closeBarOrderCancelBar = -1;
					closeBarRearmAfterCancel = false;
				}
			}

			TrackCycleCounters(time);

			if (flattenInProgress && flattenOrder != null && execution.Order == flattenOrder)
			{
				// Treat the flatten order fill as success immediately. Depending on connection timing,
				// the Position object may still report the pre-fill state for a short moment.
				flattenInProgress = false;
				flattenOrder = null;
			}

			ProcessNewRealtimeTrades();
			if (!_bracketValidationSuspended)
				BracketWatchdog("OnExecutionUpdate");
		}
		#endregion

		// Helper kept for compatibility (no longer required, but harmless)
		private void OnCycleClosed_ResetBandGuards()
		{
			ResetBandFillGuards();
		}

