protected override void OnBarUpdate()
{
    try
    {
        // Série secundária (ATR FIXO)
        if (BarsInProgress == 1)
        {
            // ✅ FIX: ATR FIXO só recalcula no FECHAMENTO do candle (da série secundária)
            // (IsFirstTickOfBar ocorre no primeiro tick da nova barra => a barra anterior fechou)
            if (!AtrAuto && IsFirstTickOfBar)
                ComputeAtrFixedAndApply();

            return;
        }

        // Série principal
        if (BarsInProgress != 0)
            return;

        // ✅ FIX: ATR Auto (no TF do gráfico) só recalcula no FECHAMENTO do candle (do gráfico)
        if (AtrAuto && IsFirstTickOfBar)
            ComputeAtrAutoAndApply();

        // Refresh periódico de feeds e estado
        RunPeriodicRefresh();
    }
    catch (Exception ex)
    {
        SmartLog("OnBarUpdate ex: " + ex.Message);
    }
}

private void ComputeAtrAutoAndApply()
{
    try
    {
        if (embeddedControl != null && !embeddedControl.IsAtrEnabled())
        {
            ClearAtrDraws();
            return;
        }

        if (CurrentBar < 1) return;

        double high = High[0];
        double low = Low[0];
        double prevClose = Close[1];
        double tr = Math.Max(high - low, Math.Max(Math.Abs(high - prevClose), Math.Abs(low - prevClose)));

        trQueue.Enqueue(tr);
        trSum += tr;
        if (trQueue.Count > AtrPeriod)
            trSum -= trQueue.Dequeue();

        double currentAtr = trQueue.Count > 0 ? trSum / trQueue.Count : 0.0;

        double tickSize = Instrument?.MasterInstrument?.TickSize ?? 1.0;
        int atrTicks = (tickSize > 0 && currentAtr > 0)
            ? (int)Math.Round((currentAtr * AtrMultiplier) / tickSize)
            : 0;

        double tickValue = 0.0;
        try
        {
            var mi = Instrument?.MasterInstrument;
            tickValue = (mi?.TickSize ?? 0) * (mi?.PointValue ?? 0);
        }
        catch { }

        double atrDollarPerContract = atrTicks * tickValue;

        ApplyAtrValues(atrTicks, atrDollarPerContract, tickSize);
    }
    catch (Exception ex)
    {
        SmartLog("ComputeAtrAutoAndApply ex: " + ex.Message);
    }
}

private void RunPeriodicRefresh()
{
    try
    {
        if (ScanIntervalSeconds <= 0) return;

        var now = DateTime.UtcNow;
        if ((now - _lastScanUtc).TotalSeconds < ScanIntervalSeconds)
            return;

        _lastScanUtc = now;

        if (embeddedControl == null) return;

        BindPnlAccountListener(false, "periodic_refresh");
        UpdatePnlDisplay();

        RefreshRrDisplay();
        RefreshPositionAndOrders();

        // ✅ HARDLOCK: garante que, mesmo sem interação do usuário,
        // o hardlock persistido seja reaplicado periodicamente (reconexões / glitches / troca de UI).
        // - não dá spam: TryRead só vai achar se tiver lock; RefreshCache tem logs próprios.
        try { HardLock_RefreshCacheAndApplyUi("periodic_refresh"); } catch { }

        EvaluateRisk(false);
        LogSystemSnapshot();

        // ✅ PATCH PARCIAL (VISUAL): garante que o botão do RISK reflita o estado real (_riskOn)
        // (o fix definitivo é no Bloco B, mas isso melhora o caso "fica OFF após OK")
        try { embeddedControl.SetRiskToggleVisual(_riskOn); } catch { }

        // =========================================================
        // ✅ MOTOR DO BE (opção B1: "arma e espera", aplica e desliga)
        //
        // ✅ FIX DE SPAM:
        // - A mensagem "Break-even: ticks insuficientes." NÃO pode ficar reaparecendo.
        // - Feedback ao usuário acontece apenas 1x, quando ele liga (fireRequest).
        // - Depois disso, o BE tenta aplicar silenciosamente em cada scan até conseguir.
        // =========================================================
        try
        {
            if (_beActive || _beFireRequest)
            {
                // 1) Ao ligar (fireRequest), mostra popup 1x e arma.
                if (_beFireRequest)
                {
                    _beActive = true;

                    ShowTransientPopup("Break-even armado: aguardando ticks mínimos.");
                    SmartLog("BE armado: aguardando ticks mínimos para aplicar.");

                    // limpa o request one-shot para não spammar popup
                    _beFireRequest = false;

                    // mantém o toggle visual ON (controle já deve estar ON, mas garantimos)
                    try { embeddedControl?.SetBeState(true); } catch { }

                    SavePrefs();
                }

                // 2) Enquanto armado, tenta aplicar silenciosamente.
                if (_beActive)
                {
                    bool applied = false;

                    try { applied = TryApplyBreakEvenOneShot(); }
                    catch (Exception exBe)
                    {
                        SmartLog("TryApplyBreakEvenOneShot ex: " + exBe.Message);
                        applied = false;
                    }

                    if (applied)
                    {
                        // ✅ B1: desliga sozinho após aplicar
                        _beActive = false;
                        _beFireRequest = false;

                        // Atualiza o visual do botão BE (se existir no controle)
                        try { embeddedControl?.SetBeState(false); } catch { }

                        SavePrefs();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            SmartLog("BE motor ex: " + ex.Message);
        }

        // NOVO: polling (mesmo princípio do ATR). Detecta a transição "não-flat -> flat" e dispara overlay se RISK bloqueou.
        PollFlatEdgeAndMaybeShowRiskOverlay();

        // Mantém: se Risk bloqueou durante posição aberta, dispara overlay assim que ficar FLAT (fallback)
        // (agora usa conta/escopo corretos internamente)
        TryShowRiskOverlayIfArmedAndFlat();

        ComputeOrderDecorations();
    }
    catch (Exception ex)
    {
        SmartLog("RunPeriodicRefresh ex: " + ex.Message);
    }
}

private void LogSystemSnapshot()
{
    try
    {
        var acc = GetSelectedAccount();
        var pos = GetPositionForInstrument(acc, Instrument);
        int qty = pos?.Quantity ?? 0;

        int ordersOpen = 0;
        try
        {
            if (acc != null)
            {
                foreach (var ord in acc.Orders)
                {
                    if (ord == null) continue;
                    if (ord.Instrument != Instrument) continue;

                    if (ord.OrderState == OrderState.Accepted ||
                        ord.OrderState == OrderState.Working ||
                        ord.OrderState == OrderState.PartFilled ||
                        ord.OrderState == OrderState.Submitted)
                    {
                        ordersOpen++;
                    }
                }
            }
        }
        catch { }

        SmartLog(
            $"[SNAPSHOT] acc={(acc?.Name ?? "null")} " +
            $"pnl={TryGetAccountValue(acc, AccountItem.RealizedProfitLoss)} " +
            $"posQty={qty} " +
            $"ordersOpen={ordersOpen} " +
            $"risk={_riskOn} " +
            $"overlay={_riskOverlayShown}");
    }
    catch (Exception ex)
    {
        SmartLog("Snapshot ex: " + ex.Message);
    }
}

