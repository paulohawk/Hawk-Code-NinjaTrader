        // ===== RR reflection helpers (build-safe) =====
        private static IEnumerable<object> TryEnumerateEnumerableProperty(object instance, string propName)
        {
            if (instance == null || string.IsNullOrWhiteSpace(propName))
                return Enumerable.Empty<object>();

            try
            {
                var pi = instance.GetType().GetProperty(propName, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
                var val = pi?.GetValue(instance);
                if (val is System.Collections.IEnumerable ie)
                    return ie.Cast<object>();
            }
            catch { }

            return Enumerable.Empty<object>();
        }

        private IEnumerable<object> EnumerateChartObjectsReflection()
        {
            var list = new List<object>();

            try
            {
                // 1) ChartControl.ChartObjects
                list.AddRange(TryEnumerateEnumerableProperty(ChartControl, "ChartObjects"));

                // 2) ChartBars.ChartObjects
                list.AddRange(TryEnumerateEnumerableProperty(ChartBars, "ChartObjects"));

                // 3) ChartBars.DrawObjects
                list.AddRange(TryEnumerateEnumerableProperty(ChartBars, "DrawObjects"));

                // 4) ChartControl.ChartPanels[*].ChartObjects
                var panels = ChartControl?.ChartPanels;
                if (panels != null)
                {
                    for (int i = 0; i < panels.Count; i++)
                        list.AddRange(TryEnumerateEnumerableProperty(panels[i], "ChartObjects"));
                }
            }
            catch { }

            return list;
        }

        private bool TryGetActiveRiskRewardStopTicks(out double entryPrice, out double stopPrice, out int stopTicks)
        {
            entryPrice = 0;
            stopPrice = 0;
            stopTicks = 0;

            try
            {
                if (ChartControl == null || Instrument == null) return false;

                double tickSize = 0.0;
                try { tickSize = Instrument.MasterInstrument?.TickSize ?? 0.0; } catch { }
                if (tickSize <= 0) return false;

                NinjaTrader.NinjaScript.DrawingTools.RiskReward best = null;
                DateTime bestTime = DateTime.MinValue;
                int bestSlot = int.MinValue;

                foreach (var obj in EnumerateChartObjectsReflection())
                {
                    // ✅ compatível (evita "is not" que pode quebrar em alguns ambientes)
                    var rr = obj as NinjaTrader.NinjaScript.DrawingTools.RiskReward;
                    if (rr == null)
                        continue;

                    // filtro por instrumento (se possível)
                    try
                    {
                        var inst = rr.AttachedTo?.Instrument;
                        if (inst != null)
                        {
                            bool match = inst.FullName == Instrument.FullName ||
                                         inst.MasterInstrument?.Name == Instrument.MasterInstrument?.Name;
                            if (!match) continue;
                        }
                    }
                    catch { }

                    DateTime t = DateTime.MinValue;
                    int slot = int.MinValue;

                    try { t = rr.EntryAnchor?.Time ?? DateTime.MinValue; } catch { }

                    // SlotIndex varia por build (int?, int, etc). Converter de forma robusta.
                    try
                    {
                        object siObj = null;
                        try
                        {
                            siObj = rr.EntryAnchor?.GetType().GetProperty("SlotIndex")?.GetValue(rr.EntryAnchor);
                        }
                        catch { siObj = null; }

                        slot = (siObj == null) ? int.MinValue : Convert.ToInt32(siObj, CultureInfo.InvariantCulture);
                    }
                    catch { slot = int.MinValue; }

                    bool better = (t > bestTime) || (t == bestTime && slot > bestSlot);
                    if (best == null || better)
                    {
                        best = rr;
                        bestTime = t;
                        bestSlot = slot;
                    }
                }

                if (best == null)
                    return false;

                double ep = 0.0, sp = 0.0;
                try { ep = best.EntryAnchor?.Price ?? 0.0; } catch { }
                try { sp = best.RiskAnchor?.Price ?? 0.0; } catch { }

                if (Math.Abs(ep) <= double.Epsilon || Math.Abs(sp) <= double.Epsilon)
                    return false;

                double dist = Math.Abs(ep - sp);
                if (dist <= double.Epsilon) return false;

                int ticks = (int)Math.Round(dist / tickSize);
                if (ticks <= 0) return false;

                entryPrice = ep;
                stopPrice = sp;
                stopTicks = ticks;
                return true;
            }
            catch
            {
                return false;
            }
        }

        // =========================================================
        // ✅ HARDLOCK (Parte 1B): aplicar lock persistido ao criar UI / trocar conta
        //
        // Objetivo:
        // - Se existir hard lock vigente (arquivo) para a conta/escopo atual,
        //   marcar cache em memória (_hardLockActive/_hardLockUntilLocal/_hardLockKey/_hardLockKind)
        //   e forçar o estado visual/operacional de bloqueio.
        //
        // Importante: aqui NÃO gravamos lock. Só lemos/aplicamos.
        // O "Upsert" vai acontecer no TriggerRiskBlock (Parte 3).
        // =========================================================

        private void HardLock_RefreshCacheAndApplyUi(string reason)
        {
            try
            {
                var acc = GetSelectedAccount();
                string accName = acc != null ? acc.Name : null;

                // scope: EsteGrafico => chart key, senão => global key
                bool chartScope = (EscopoRisk == SRiskScope.EsteGrafico);

                string key = chartScope
                    ? HardLock_BuildChartKey(accName)
                    : HardLock_BuildGlobalKey(accName);

                DateTime untilUtc;
                string kind;

                bool ok = false;
                try { ok = HardLock_TryRead(key, out untilUtc, out kind); }
                catch { ok = false; untilUtc = DateTime.MinValue; kind = "generic"; }

                // ✅ HARDLOCK DIAG: sempre registra tentativa de leitura
                try
                {
                    HardLockDiag($"RefreshCache reason='{reason}' acc='{(accName ?? "null")}' scope='{(chartScope ? "chart" : "global")}' key='{key}' ok={ok} untilUtc='{(ok ? untilUtc.ToString("O") : "null")}' kind='{(kind ?? "null")}' uiReady={(embeddedControl != null)}");
                }
                catch { }

                if (!ok)
                {
                    // sem lock vigente: apenas limpa cache (não altera estados do Risk normal)
                    _hardLockActive = false;
                    _hardLockUntilLocal = DateTime.MinValue;
                    _hardLockKey = key;
                    _hardLockKind = "generic";
                    return;
                }

                // lock vigente
                _hardLockActive = true;
                _hardLockKey = key;
                _hardLockKind = string.IsNullOrWhiteSpace(kind) ? "generic" : kind;

                try { _hardLockUntilLocal = untilUtc.ToLocalTime(); }
                catch { _hardLockUntilLocal = DateTime.Now.Date.AddDays(1); }

                // Força bloqueio em memória do Risk (sem depender de AtivarRisk/_riskOn)
                _riskBlocked = true;
                _riskBlockedUntil = _hardLockUntilLocal;

                // Sem UI ainda: mantém cache/estado, e aplica visual quando a UI existir.
                if (embeddedControl == null)
                {
                    SmartLog($"[HARDLOCK] cache atualizado sem UI. reason={reason} acc={(accName ?? "null")} scope={(chartScope ? "chart" : "global")} until={_hardLockUntilLocal:HH:mm} key={(_hardLockKey ?? "null")} kind={_hardLockKind}");
                    return;
                }

                // ✅ Ajuste: HardLock aplica estado de Risk + desarma OnClick,
                // mas NÃO chama ForceMainToggleBlocked (isso gerava efeitos colaterais / regressões de UI).
                try { embeddedControl.SetRiskState(SmartBoletaRiskState.Blocked, true, "bloqueado"); } catch { }

                // Bloqueia envio via onclick (engine)
                try { SetTradingFromChartEnabled(false); } catch { }

                // Overlay: mostrar apenas 1x e somente quando estiver FLAT no escopo.
                // Se houver posição aberta, apenas arma para disparar no fechamento.
                try
                {
                    if (!_riskOverlayShown)
                    {
                        string msg = RiskOverlayMessage;
                        if (!string.IsNullOrWhiteSpace(_hardLockKind) && _hardLockKind == "profit")
                            msg = RiskOverlayProfitMessage;

                        _riskOverlayArmed = true;
                        _riskOverlayPendingMessage = msg;

                        TryShowRiskOverlayIfArmedAndFlat(acc, "hardlock_refresh_" + reason);
                    }
                }
                catch { }

                SmartLog($"[HARDLOCK] aplicado. reason={reason} acc={(accName ?? "null")} scope={(chartScope ? "chart" : "global")} until={_hardLockUntilLocal:HH:mm} key={(_hardLockKey ?? "null")} kind={_hardLockKind}");
            }
            catch (Exception ex)
            {
                SmartLog("HardLock_RefreshCacheAndApplyUi ex: " + ex.Message);
            }
        }

