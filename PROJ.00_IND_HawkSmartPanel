        private void ReapplyRiskVisualState(string reason)
        {
            try
            {
                if (embeddedControl == null)
                    return;

                try { HardLock_RefreshCacheAndApplyUi("reapply_" + reason); } catch { }

                if (IsHardLockActiveNow() || IsRiskBlocked())
                {
                    embeddedControl.SetRiskState(SmartBoletaRiskState.Blocked, true, "bloqueado");
                    return;
                }

                if (!AtivarRisk || !_riskOn)
                {
                    embeddedControl.SetRiskState(SmartBoletaRiskState.Off, false, "");
                    return;
                }

                double pnl = 0.0;
                var acc = GetSelectedAccount();
                var pVal = AccountValueProvider.TryGetRealizedPnlUsd(acc, SmartLog);
                pnl = pVal ?? 0.0;

                bool warn = false;

                if (LimitePerdaUSD > 0 && (-pnl) >= PercentualAviso * LimitePerdaUSD)
                    warn = true;

                if (LimiteTradesDia > 0 && _riskTrades >= (int)Math.Floor(PercentualAviso * LimiteTradesDia))
                    warn = true;

                if (LimiteContratosDia > 0 && _riskContracts >= (int)Math.Floor(PercentualAviso * LimiteContratosDia))
                    warn = true;

                if (LimiteLucroUSD > 0 && pnl >= PercentualAviso * LimiteLucroUSD)
                    warn = true;

                embeddedControl.SetRiskState(warn ? SmartBoletaRiskState.Pre : SmartBoletaRiskState.Ok, true, warn ? "pré-limite" : "");
                SmartLog($"ReapplyRiskVisualState: reason={reason} state={(warn ? "Pre" : "Ok")} hardlock={_hardLockActive} riskOn={_riskOn} trades={_riskTrades} contracts={_riskContracts}");
            }
            catch (Exception ex)
            {
                SmartLog("ReapplyRiskVisualState ex: " + ex.Message);
            }
        }

