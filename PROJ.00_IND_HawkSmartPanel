        private void OnPositionUpdateDecorator(object sender, PositionEventArgs e)
        {
            try
            {
                if (e?.Position == null) return;

                // ===== LOGS (PositionUpdate) =====
                bool matchChart = false;
                try
                {
                    string eInst = e.Position?.Instrument?.FullName ?? "null";
                    string accName = e.Position?.Account?.Name ?? "null";
                    int qty = e.Position != null ? e.Position.Quantity : 0;

                    matchChart = (e.Position?.Instrument != null && Instrument != null) &&
                                 (e.Position.Instrument.FullName == Instrument.FullName ||
                                  e.Position.Instrument.MasterInstrument?.Name == Instrument.MasterInstrument?.Name);

                    SmartLog($"[TRACE][PosUpdate] acc={accName} eInst={eInst} chartInst={(Instrument?.FullName ?? "null")} matchChart={matchChart} qty={qty} trades={_riskTrades} contracts={_riskContracts} blocked={IsRiskBlocked()} armed={_riskOverlayArmed} shown={_riskOverlayShown}");
                }
                catch { }

                // ✅ NOVO: round-trip contado aqui (evento confiável)
                try { RiskOnPositionUpdateMaybeCountRoundTrip(e, matchChart); } catch { }

                // Se ficou flat, limpa ordens pendentes do instrumento
                if (matchChart && e.Position.Quantity == 0)
                {
                    // ===== LOGS (FLAT via PositionUpdate) =====
                    try
                    {
                        SmartLog($"[TRACE][PosUpdateFlat] acc={(e.Position?.Account?.Name ?? "null")} inst={(Instrument?.FullName ?? "null")} qty=0 trades={_riskTrades} contracts={_riskContracts} blocked={IsRiskBlocked()} armed={_riskOverlayArmed} shown={_riskOverlayShown}");
                    }
                    catch { }

                    CleanupFlatOrders(e.Position.Account);

                    // ✅ evento de posição é o gatilho mais confiável de "virou FLAT"
                    TryShowRiskOverlayIfArmedAndFlat(e.Position.Account, "position");

                    // =========================================================
                    // ✅ BE: ao ficar FLAT, SEMPRE desarma e força o toggle para OFF
                    // =========================================================
                    _beActive = false;
                    _beFireRequest = false;

                    SetBeToggleVisualSafe(false, "auto_off_flat_forced");

                    SavePrefs();
                    SmartLog("BE auto-off (FORCED): posição ficou FLAT (matchChart).");

                    // ✅ reavalia risk ao ficar flat (principalmente quando limite é por trades)
                    EvaluateRisk(false);
                }

                ComputeOrderDecorations();
            }
            catch (Exception ex) { SmartLog("OnPositionUpdateDecorator ex: " + ex.Message); }
        }

