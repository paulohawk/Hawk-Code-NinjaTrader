        // ===== RR sizing toggle =====
        private void ToggleRrSizing()
        {
            if (_parent.IsRiskBlocked())
            {
                _parent.ShowTransientPopup("Bloqueado por RISK até 00:00.");
                return;
            }

            bool turningOn = !_rrSizingEnabled;

            if (turningOn)
            {
                if (!_rrFeedAvailable || _parent.LastRrTicks() <= 0 || _parent.LastRrDollarPerContract() <= 0)
                {
                    _parent.ShowTransientPopup("RR indisponível: desenhe Recompensa-Risco no gráfico.");
                    _rrSizingEnabled = false;
                    ApplyRrVisuals();
                    return;
                }

                // exclusividade: liga RR => desliga ATR
                _parent.DisableAtrSizingFromRr();

                bool ok = _parent.ApplyRrSizingWithValidationProxy(_parent.LastRrTicks(), _parent.LastRrDollarPerContract(), true);
                if (!ok)
                {
                    _rrSizingEnabled = false;
                    ApplyRrVisuals();
                    return;
                }

                _rrSizingEnabled = true;
                SetQtyButtonsEnabled(false);
                ApplyRrVisuals();
                _parent.SavePrefs();
                return;
            }

            _rrSizingEnabled = false;
            SetQtyButtonsEnabled(true);
            ApplyRrVisuals();
            _parent.SavePrefs();
        }

