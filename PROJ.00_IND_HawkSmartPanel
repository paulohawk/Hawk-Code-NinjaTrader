        // ✅ NOVO: helper central para contagem de round-trip no evento confiável (PositionUpdate)
        // Regras:
        // - conta SOMENTE para a conta selecionada (GetSelectedAccount)
        // - EsteGrafico: conta quando a posição do instrumento do gráfico vira FLAT (prev != 0 -> now == 0)
        // - Escopo "global" (qualquer != EsteGrafico): conta quando a conta selecionada fica sem posições (wasFlat=false -> isFlat=true)
        private void RiskOnPositionUpdateMaybeCountRoundTrip(PositionEventArgs e, bool matchChart)
        {
            try
            {
                if (!AtivarRisk || !_riskOn) return;
                if (e?.Position == null) return;

                var sel = GetSelectedAccount();
                if (sel == null) return;

                // somente conta selecionada
                if (e.Position.Account == null || !string.Equals(e.Position.Account.Name, sel.Name, StringComparison.OrdinalIgnoreCase))
                    return;

                EnsureRiskResetDaily();

                // ===== Escopo global (qualquer != EsteGrafico) =====
                if (EscopoRisk != SRiskScope.EsteGrafico)
                {
                    bool isFlatNow = true;
                    try { isFlatNow = IsFlatForRiskScope(sel); } catch { isFlatNow = true; }

                    if (!_lastFlatForRisk.HasValue)
                    {
                        _lastFlatForRisk = isFlatNow;
                        SmartLog($"[TRACE][RiskRT] init(global) acc={sel.Name} flat={isFlatNow} trades={_riskTrades}");
                        return;
                    }

                    bool wasFlat = _lastFlatForRisk.Value;
                    _lastFlatForRisk = isFlatNow;

                    if (!wasFlat && isFlatNow)
                    {
                        _riskTrades += 1;
                        SmartLog($"Risk round-trip contabilizado (global flat): trades={_riskTrades}");
                    }

                    return;
                }

                // ===== Escopo EsteGrafico =====
                if (!matchChart) return;

                int qtyNow = e.Position.Quantity;

                lock (_riskPosLock)
                {
                    // se o tracking está apontando para outra conta, reseta
                    if (_riskTrackedAccountName == null ||
                        !string.Equals(_riskTrackedAccountName, sel.Name, StringComparison.OrdinalIgnoreCase))
                    {
                        _riskTrackedAccountName = sel.Name;
                        _riskLastPositionInitialized = false;
                        _riskLastPositionQty = 0;
                    }

                    if (!_riskLastPositionInitialized)
                    {
                        _riskLastPositionQty = qtyNow;
                        _riskLastPositionInitialized = true;

                        SmartLog($"[TRACE][RiskRT] init(chart) acc={sel.Name} inst={(Instrument?.FullName ?? "null")} qtyNow={qtyNow} trades={_riskTrades}");
                        return;
                    }

                    int qtyPrev = _riskLastPositionQty;

                    // Trade fechado = estava posicionado e virou flat
                    if (qtyPrev != 0 && qtyNow == 0)
                    {
                        _riskTrades += 1;
                        SmartLog($"Risk round-trip contabilizado (flat via PositionUpdate): trades={_riskTrades}");
                    }

                    _riskLastPositionQty = qtyNow;
                }
            }
            catch (Exception ex)
            {
                SmartLog("RiskOnPositionUpdateMaybeCountRoundTrip ex: " + ex.Message);
            }
        }

        private void EvaluateRisk(bool fromExec)
        {
            try
            {
                // ===== LOGS (entrada eval) =====
                try
                {
                    var acc0 = GetSelectedAccount();
                    int posQtyNowDbg = 0;
                    try { posQtyNowDbg = GetPositionForInstrument(acc0, Instrument)?.Quantity ?? 0; } catch { }
                    SmartLog($"[TRACE][EvalRisk] enter fromExec={fromExec} acc={(acc0?.Name ?? "null")} inst={(Instrument?.FullName ?? "null")} posQtyNow={posQtyNowDbg} trades={_riskTrades} contracts={_riskContracts} blocked={IsRiskBlocked()} armed={_riskOverlayArmed} shown={_riskOverlayShown}");
                }
                catch { }

                EnsureRiskResetDaily();

                // ✅ HARDLOCK: se vigente, é soberano e trava tudo (independente de AtivarRisk/_riskOn)
                if (IsHardLockActiveNow())
                {
                    try
                    {
                        embeddedControl?.SetRiskState(SmartBoletaRiskState.Blocked, true, "bloqueado");

                        // ✅ NÃO chamar ForceMainToggleBlocked (efeitos colaterais / regressões).
                        // O lock visual do MAIN deve ser responsabilidade do EmbeddedControl via SetRiskState(Blocked...).
                        SetTradingFromChartEnabled(false);

                        // Overlay só deve aparecer uma vez e apenas quando FLAT.
                        // Em posição aberta, fica armado e dispara no fechamento.
                        if (!_riskOverlayShown)
                        {
                            string msg = RiskOverlayMessage;
                            try
                            {
                                if (!string.IsNullOrWhiteSpace(_hardLockKind) && _hardLockKind == "profit")
                                    msg = RiskOverlayProfitMessage;
                            }
                            catch { }

                            _riskOverlayArmed = true;
                            _riskOverlayPendingMessage = msg;

                            TryShowRiskOverlayIfArmedAndFlat(GetSelectedAccount(), "hardlock_evaluate");
                        }

                        SmartLog("[HARDLOCK] EvaluateRisk: bloqueio soberano aplicado.");
                    }
                    catch { }
                    return;
                }

                if (!AtivarRisk)
                {
                    embeddedControl?.SetRiskState(SmartBoletaRiskState.Off, false, "");

                    // ✅ HARDLOCK: aqui só limpa se NÃO há hardlock (já garantido acima)
                    _riskBlocked = false;
                    _riskBlockedUntil = DateTime.MinValue; // ✅ garante limpeza
                    _mainToggleLockedByRisk = false;

                    _riskOverlayArmed = false;
                    _riskOverlayPendingMessage = null;

                    try { SmartLog("[TRACE][EvalRisk] exit: AtivarRisk=false"); } catch { }
                    return;
                }

                if (!_riskOn)
                {
                    embeddedControl?.SetRiskState(SmartBoletaRiskState.Off, false, "");

                    // ✅ HARDLOCK: aqui só limpa se NÃO há hardlock (já garantido acima)
                    _riskBlocked = false;
                    _riskBlockedUntil = DateTime.MinValue; // ✅ garante limpeza
                    _mainToggleLockedByRisk = false;

                    _riskOverlayArmed = false;
                    _riskOverlayPendingMessage = null;

                    try { SmartLog("[TRACE][EvalRisk] exit: _riskOn=false"); } catch { }
                    return;
                }

                double pnl = 0.0;
                var acc = GetSelectedAccount();
                var pVal = AccountValueProvider.TryGetRealizedPnlUsd(acc, SmartLog);
                pnl = pVal ?? 0.0;

                bool breachLoss = false, breachTrades = false, breachContracts = false, breachProfit = false;
                bool warn = false;

                if (LimitePerdaUSD > 0 && (-pnl) >= LimitePerdaUSD)
                    breachLoss = true;
                else if (LimitePerdaUSD > 0 && (-pnl) >= PercentualAviso * LimitePerdaUSD)
                    warn = true;

                if (LimiteTradesDia > 0 && _riskTrades >= LimiteTradesDia)
                    breachTrades = true;
                else if (LimiteTradesDia > 0 && _riskTrades >= (int)Math.Floor(PercentualAviso * LimiteTradesDia))
                    warn = true;

                if (LimiteContratosDia > 0 && _riskContracts >= LimiteContratosDia)
                    breachContracts = true;
                else if (LimiteContratosDia > 0 && _riskContracts >= (int)Math.Floor(PercentualAviso * LimiteContratosDia))
                    warn = true;

                if (LimiteLucroUSD > 0 && pnl >= LimiteLucroUSD)
                    breachProfit = true;
                else if (LimiteLucroUSD > 0 && pnl >= PercentualAviso * LimiteLucroUSD)
                    warn = true;

                // ===== LOGS (decisão) =====
                try
                {
                    SmartLog($"[TRACE][EvalRisk] pnl={pnl:N2} breachLoss={breachLoss} breachTrades={breachTrades} breachContracts={breachContracts} breachProfit={breachProfit} warn={warn} trades={_riskTrades} contracts={_riskContracts}");
                }
                catch { }

                // ✅ FIX: se já está bloqueado, NÃO derrubar toggle do Risk no painel.
                // O Risk está ON (enabled=true), mas o estado é Blocked.
                if (IsRiskBlocked())
                {
                    embeddedControl?.SetRiskState(SmartBoletaRiskState.Blocked, true, "bloqueado");

                    // ✅ NÃO chamar ForceMainToggleBlocked (efeitos colaterais / regressões).
                    SetTradingFromChartEnabled(false);

                    try { SmartLog("[TRACE][EvalRisk] exit: already blocked"); } catch { }
                    return;
                }

                if (breachLoss || breachTrades || breachContracts)
                {
                    TriggerRiskBlock("Limite diário atingido.", RiskOverlayMessage, true);
                    return;
                }

                if (breachProfit)
                {
                    if (BloquearAoAtingirLucro)
                    {
                        TriggerRiskBlock("Limite de lucro diário atingido.", RiskOverlayProfitMessage, true);
                    }
                    else
                    {
                        if (!_warnedProfit)
                        {
                            ShowTransientPopup("Limite de lucro diário atingido.");
                            _warnedProfit = true;
                        }
                        embeddedControl?.SetRiskState(SmartBoletaRiskState.Pre, true, "pré-limite");
                    }
                    return;
                }

                if (warn)
                {
                    if (!_warnedLoss && LimitePerdaUSD > 0 && (-pnl) >= PercentualAviso * LimitePerdaUSD)
                    {
                        ShowTransientPopup("Atenção: próximo do limite de perda diário.");
                        _warnedLoss = true;
                    }
                    if (!_warnedTrades && LimiteTradesDia > 0 && _riskTrades >= (int)Math.Floor(PercentualAviso * LimiteTradesDia))
                    {
                        ShowTransientPopup("Atenção: próximo do limite de trades diário.");
                        _warnedTrades = true;
                    }
                    if (!_warnedContracts && LimiteContratosDia > 0 && _riskContracts >= (int)Math.Floor(PercentualAviso * LimiteContratosDia))
                    {
                        ShowTransientPopup("Atenção: próximo do limite de contratos diário.");
                        _warnedContracts = true;
                    }
                    embeddedControl?.SetRiskState(SmartBoletaRiskState.Pre, true, "pré-limite");
                    return;
                }

                // OK
                embeddedControl?.SetRiskState(SmartBoletaRiskState.Ok, true, "");
                _warnedLoss = _warnedTrades = _warnedContracts = _warnedProfit = false;
                _riskBlocked = false;
                _mainToggleLockedByRisk = false;

                _riskOverlayArmed = false;
                _riskOverlayPendingMessage = null;

                try { SmartLog("[TRACE][EvalRisk] exit: OK"); } catch { }
            }
            catch (Exception ex)
            {
                SmartLog("EvaluateRisk ex: " + ex.Message);
            }
        }

        private void TriggerRiskBlock(string logMsg, string overlayMsg, bool lockMain)
        {
            // ===== LOGS (entrada block) =====
            try
            {
                var acc0 = GetSelectedAccount();
                int posQtyNowDbg = 0;
                try { posQtyNowDbg = GetPositionForInstrument(acc0, Instrument)?.Quantity ?? 0; } catch { }
                bool flatNowDbg = true;
                try { flatNowDbg = IsFlatForRiskScope(acc0); } catch { }

                SmartLog($"[TRACE][RiskBlock] msg='{logMsg}' acc={(acc0?.Name ?? "null")} inst={(Instrument?.FullName ?? "null")} scope={EscopoRisk} flat={flatNowDbg} qty={posQtyNowDbg} trades={_riskTrades} contracts={_riskContracts} blocked(before)={IsRiskBlocked()} armed={_riskOverlayArmed} shown={_riskOverlayShown}");
            }
            catch { }

            // ✅ idempotência: se já bloqueado, não refaz tudo
            if (IsRiskBlocked())
                return;

            _riskBlocked = true;
            _riskBlockedUntil = NextMidnight();
            _mainToggleLockedByRisk = lockMain;
            SmartLog("RISK BLOQUEADO: " + logMsg + $" até {_riskBlockedUntil:HH:mm}");

            // =========================================================
            // ✅ HARDLOCK: persistir no arquivo + atualizar cache em memória
            // =========================================================
            try
            {
                var acc = GetSelectedAccount();
                string accName = acc != null ? acc.Name : null;

                bool chartScope = (EscopoRisk == SRiskScope.EsteGrafico);
                string key = chartScope
                    ? HardLock_BuildChartKey(accName)
                    : HardLock_BuildGlobalKey(accName);

                DateTime untilLocal = _riskBlockedUntil;
                DateTime untilUtc = DateTime.SpecifyKind(untilLocal, DateTimeKind.Local).ToUniversalTime();

                string kind = "loss";
                try
                {
                    if (!string.IsNullOrWhiteSpace(overlayMsg) && overlayMsg == RiskOverlayProfitMessage)
                        kind = "profit";
                }
                catch { kind = "loss"; }

                // ✅ HARDLOCK DIAG (crítico): registra antes/depois do Upsert
                try
                {
                    HardLockDiag($"TriggerRiskBlock calling Upsert key='{key}' untilLocal='{untilLocal:O}' untilUtc='{untilUtc:O}' kind='{kind}' acc='{(accName ?? "null")}' scope='{(chartScope ? "chart" : "global")}' msg='{logMsg}'");
                }
                catch { }

                HardLock_Upsert(key, untilUtc, kind);

                try { HardLockDiag("TriggerRiskBlock returned from Upsert"); } catch { }

                _hardLockActive = true;
                _hardLockUntilLocal = untilLocal;
                _hardLockKey = key;
                _hardLockKind = kind;

                SmartLog($"[HARDLOCK] Upsert key={key} untilUtc={untilUtc:yyyy-MM-dd HH:mm:ss} kind={kind}");
            }
            catch (Exception ex)
            {
                SmartLog("HardLock Upsert ex: " + ex.Message);
                try { HardLockDiag("TriggerRiskBlock HardLock Upsert ex: " + ex); } catch { }
            }

            SetTradingFromChartEnabled(false);

            // ✅ FIX: não forçar toggle OFF quando o Risk está bloqueando.
            // O Risk continua ON, apenas em estado BLOQ.
            embeddedControl?.SetRiskState(SmartBoletaRiskState.Blocked, true, "bloqueado");

            // ✅ NÃO chamar ForceMainToggleBlocked (efeitos colaterais / regressões).

            // ✅ FIX: não usar IsFlat() (ResolveAccountWithPosition pode cair em Sim101).
            // Usa conta selecionada + escopo configurado.
            var sel = GetSelectedAccount();
            bool isFlatScope = true;
            try { isFlatScope = IsFlatForRiskScope(sel); } catch { isFlatScope = true; }

            // Regra:
            // - se AINDA tem posição aberta => NÃO mostra overlay agora, só arma para quando ficar FLAT
            // - se já está FLAT => mostra overlay imediatamente
            if (isFlatScope)
            {
                if (!_riskOverlayShown)
                {
                    overlayController?.EnsureOverlayShown(OverlayOpacity, GetRiskOverlayDurationSeconds(), overlayMsg);

                    // Ao aparecer overlay (qualquer situação), forçamos o botão MAIN como OFF (somente visual).
                    ForceMainToggleOffDueToOverlay();

                    _riskOverlayShown = true;

                    try { SmartLog("[TRACE][RiskBlock] overlay shown immediately (flat in scope)"); } catch { }
                }
            }
            else
            {
                // ✅ Não rearma overlay se já foi mostrado
                if (!_riskOverlayShown)
                {
                    _riskOverlayArmed = true;
                    _riskOverlayPendingMessage = overlayMsg;
                    SmartLog("Risk overlay ARMADO (posição aberta). Será exibido ao ficar FLAT.");

                    try { SmartLog("[TRACE][RiskBlock] overlay ARMED (flat=false in scope)"); } catch { }
                }
            }

            // =========================================================
            // ✅ NOVO: após bloquear, força uma reaplicação do hardlock via arquivo
            // para garantir consistência caso a UI seja recriada (remove/add) logo em seguida.
            // (Não é estritamente necessário, mas ajuda a eliminar janelas de race.)
            // =========================================================
            try { HardLock_RefreshCacheAndApplyUi("after_trigger_block"); } catch { }
        }

