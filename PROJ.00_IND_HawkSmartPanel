                    return;

                string levelTag = level.ToString().ToUpperInvariant();
                Print($"[SmartBoleta][{levelTag}] {DateTime.Now:HH:mm:ss.fff} - {message}");
                if (!EnableDiagnosticLogging) return;

                string line = $"[SmartBoleta][{levelTag}] {DateTime.Now:yyyy-MM-dd HH:mm:ss.fff} - {message}";
