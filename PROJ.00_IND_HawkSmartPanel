                SavePrefs();
                return;
            }

            _riskOn = enabled;
            SmartLog("Risk toggle: " + enabled);

            // ✅ NOVO: ao ligar/desligar o Risk, não herdar tracking antigo da conta/posição
            try { ResetRiskPositionTrackingForSelectedAccount("risk_toggle"); } catch { }

            // ✅ FIX: ao desligar via painel, limpa imediatamente estados de bloqueio/armamento
            // (evita ficar "travado" até o próximo ciclo)
            // ⚠️ HARDLOCK: não limpar se hardlock estiver vigente
            if (!_riskOn)
