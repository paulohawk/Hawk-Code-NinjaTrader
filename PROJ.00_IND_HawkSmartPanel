        private bool IsHardLockActiveNow()
        {
            try
            {
                if (!_hardLockActive) return false;
                if (_hardLockUntilLocal == DateTime.MinValue) return false;
                return DateTime.Now < _hardLockUntilLocal;
            }
            catch { return false; }
        }

        private string GetHardLockUntilLabel()
        {
            try
            {
                if (_hardLockUntilLocal != DateTime.MinValue)
                    return _hardLockUntilLocal.ToString("HH:mm");
            }
            catch { }
            return "00:00";
        }

        internal bool IsRiskBlocked()
        {
            // ✅ HARDLOCK SOBERANO:
            // Se hardlock estiver vigente, bloqueia sempre (mesmo com AtivarRisk=false ou _riskOn=false)
            if (IsHardLockActiveNow())
                return true;

            // Risk normal (modo atual)
            if (!AtivarRisk) return false;
            if (!_riskOn) return false;

            return _riskBlocked && DateTime.Now < _riskBlockedUntil;
        }

