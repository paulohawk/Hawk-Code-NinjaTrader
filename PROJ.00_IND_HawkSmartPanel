public void SetRiskState(SmartBoletaRiskState state, bool enabled, string status)
{
    try
    {
        Brush bullet = InactiveBulletBrush;
        Brush statusColor = Brushes.Gray;

        switch (state)
        {
            case SmartBoletaRiskState.Ok:
                bullet = MainOnBrush;
                statusColor = MainOnBrush;
                UnlockMainToggle();
                break;

            case SmartBoletaRiskState.Pre:
                bullet = PreLimitBrush;
                statusColor = PreLimitBrush;
                break;

            case SmartBoletaRiskState.Blocked:
                bullet = BlockBrush;
                statusColor = BlockBrush;
                ForceMainToggleBlocked();
                break;

            case SmartBoletaRiskState.Off:
            default:
                bullet = InactiveBulletBrush;
                statusColor = Brushes.Gray;
                UnlockMainToggle();
                break;
        }

        _tbRiskToggle.Text = enabled ? "On" : "Off";
        _tbRiskToggle.Foreground = enabled ? statusColor : Brushes.Gray;

        _bulletRisk.Fill = enabled ? bullet : InactiveBulletBrush;

        _tbRiskStatus.Text = state switch
        {
            SmartBoletaRiskState.Ok => "OK",
            SmartBoletaRiskState.Pre => "PRE",
            SmartBoletaRiskState.Blocked => "BLOQ",
            SmartBoletaRiskState.Off => "OFF",
            _ => status ?? ""
        };
        _tbRiskStatus.ToolTip = "Estado atual do Risk.";
    }
    catch { }
}

