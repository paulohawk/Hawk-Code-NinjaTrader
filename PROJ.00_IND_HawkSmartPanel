                            ApplyRrSizingWithValidationProxy(_lastRrTicks, _lastRrDollarPerContract, false);
                        }
                    }
                    catch { }
                };
                rrTimer.Start();
                SmartLog("RR timer started (250ms).");
            }
            catch (Exception ex) { SmartLog("StartRrTimer ex: " + ex.Message); }
        }

