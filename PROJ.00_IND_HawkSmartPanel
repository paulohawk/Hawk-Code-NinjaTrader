// NOVO: Polling estilo ATR para detectar "virou FLAT"
// - EsteGrafico: flat do instrumento do chart
// - AllNinjaTrader: flat de TUDO (nenhuma posição em nenhum instrumento) na conta selecionada
// =========================================================
private bool? _lastFlatForRisk = null;
private DateTime _lastFlatEdgeUtc = DateTime.MinValue;

private bool IsFlatForRiskScope(Account acc)
{
    try
    {
        if (acc == null) return true;

        // Escopo: somente este instrumento (chart)
        if (EscopoRisk == SRiskScope.EsteGrafico)
        {
            var pos = GetPositionForInstrument(acc, Instrument);
            return pos == null || pos.Quantity == 0;
        }

        // ✅ FIX: SRiskScope.AllNinjaTrader NÃO existe. Então qualquer valor != EsteGrafico vira "escopo global".
        try
        {
            foreach (var p in acc.Positions)
            {
                if (p == null) continue;
                if (p.Quantity != 0)
                    return false;
            }
        }
        catch { }

        return true;
    }
    catch
    {
        return true;
    }
}

private void PollFlatEdgeAndMaybeShowRiskOverlay()
{
    try
    {
        if (_riskOverlayShown) return;

        // Conta base: a conta selecionada no ChartTrader (é a mesma referência do seu PnL/boleta).
        var acc = GetSelectedAccount();
        if (acc == null) return;

        bool isFlatNow = IsFlatForRiskScope(acc);

        // Inicializa sem disparar
        if (!_lastFlatForRisk.HasValue)
        {
            _lastFlatForRisk = isFlatNow;
            SmartLog($"RiskFlatPoll init: acc={acc.Name} scope={EscopoRisk} flat={isFlatNow}");
            return;
        }

        bool wasFlat = _lastFlatForRisk.Value;
        _lastFlatForRisk = isFlatNow;

        // Detecta borda: estava posicionado e virou flat
        if (!wasFlat && isFlatNow)
        {
            // Debounce (evita duplicar se o polling pegar 2 ciclos de edge)
            if ((DateTime.UtcNow - _lastFlatEdgeUtc).TotalMilliseconds < 500)
                return;

            _lastFlatEdgeUtc = DateTime.UtcNow;

            SmartLog($"RiskFlatPoll EDGE: acc={acc.Name} scope={EscopoRisk} => virou FLAT. blocked={IsRiskBlocked()} trades={_riskTrades} contracts={_riskContracts}");

            // Garante que o Risk foi reavaliado após o FLAT (caso limite de trades dependa disso)
            EvaluateRisk(false);

            if (IsRiskBlocked())
            {
                // ✅ HARDLOCK: usa cálculo centralizado (inclui opção até meia-noite)
                int dur = GetRiskOverlayDurationSeconds();

                overlayController?.EnsureOverlayShown(
                    OverlayOpacity,
                    dur,
                    RiskOverlayMessage);

                ForceMainToggleOffDueToOverlay();

                _riskOverlayShown = true;
                _riskOverlayArmed = false;
                _riskOverlayPendingMessage = null;

                SmartLog("RiskFlatPoll: overlay exibido (Risk bloqueado + virou FLAT).");
            }
        }
    }
    catch (Exception ex)
    {
        SmartLog("PollFlatEdgeAndMaybeShowRiskOverlay ex: " + ex.Message);
    }
}

// ✅ NOVO: se Risk já bloqueou e o overlay foi "armado", dispara quando ficar FLAT
// Agora recebe a conta a ser checada (não depende de ResolveAccountWithPosition).
private bool TryShowRiskOverlayIfArmedAndFlat(Account accForScope, string reason)
{
    try
    {
        // ===== LOGS (tentativa de disparo) =====
        try
        {
            int qtyNowDbg = 0;
            try { qtyNowDbg = GetPositionForInstrument(accForScope, Instrument)?.Quantity ?? 0; } catch { }
            bool flatNowDbg = true;
            try { flatNowDbg = IsFlatForRiskScope(accForScope); } catch { }

            SmartLog($"[TRACE][OverlayTry] reason={reason} acc={(accForScope?.Name ?? "null")} inst={(Instrument?.FullName ?? "null")} scope={EscopoRisk} flat={flatNowDbg} qty={qtyNowDbg} blocked={IsRiskBlocked()} armed={_riskOverlayArmed} shown={_riskOverlayShown} trades={_riskTrades} contracts={_riskContracts}");
        }
        catch { }

        if (!_riskOverlayArmed) return false;
        if (_riskOverlayShown) return false;
        if (!IsRiskBlocked()) return false;

        if (!IsFlatForRiskScope(accForScope))
            return false;

        // Debounce extra (evita disparo duplicado se vier exec + position update quase juntos)
        if ((DateTime.UtcNow - _lastRiskOverlayAttemptUtc).TotalMilliseconds < 250)
            return false;
        _lastRiskOverlayAttemptUtc = DateTime.UtcNow;

        string msg = _riskOverlayPendingMessage;
        if (string.IsNullOrWhiteSpace(msg))
            msg = RiskOverlayMessage;

        // ✅ HARDLOCK: usa cálculo centralizado (inclui opção até meia-noite)
        int dur = GetRiskOverlayDurationSeconds();

        overlayController?.EnsureOverlayShown(OverlayOpacity, dur, msg);

        // Ao aparecer overlay (qualquer situação), forçamos o botão MAIN como OFF (somente visual).
        ForceMainToggleOffDueToOverlay();

        _riskOverlayShown = true;
        _riskOverlayArmed = false;
        _riskOverlayPendingMessage = null;

        SmartLog($"Risk overlay disparado ao ficar FLAT (armed -> shown). reason={reason} acc={(accForScope?.Name ?? "null")} scope={EscopoRisk}");
        return true;
    }
    catch (Exception ex)
    {
        SmartLog("TryShowRiskOverlayIfArmedAndFlat(acc) ex: " + ex.Message);
        return false;
    }
}

