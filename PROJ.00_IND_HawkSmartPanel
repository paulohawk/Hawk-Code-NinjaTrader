        private struct RiskQtyDecision
        {
            public bool allowed;
            public int allowedQty;     // qty permitida para esta ordem (0 = não enviar)
            public int currentAbs;     // abs(position.Quantity) no momento
            public int projectedAbs;   // abs(projeção após a ordem)
            public string reason;      // texto p/ log/popup
        }

        private RiskQtyDecision EvaluateMaxContractsPerTradeDecision(Account account, Instrument inst, OrderAction action, int requestedQty)
        {
            var d = new RiskQtyDecision
            {
                allowed = true,
                allowedQty = Math.Max(0, requestedQty),
                currentAbs = 0,
                projectedAbs = 0,
                reason = ""
            };

            try
            {
                int max = Math.Max(0, MaxContractsPerTrade);
                if (max <= 0) return d; // disabled
                if (requestedQty <= 0) { d.allowed = false; d.allowedQty = 0; d.reason = "Qty inválida"; return d; }
                if (account == null || inst == null) return d;

                var pos = GetPositionForInstrument(account, inst);
                int qtyNow = pos?.Quantity ?? 0;

                int curAbs = Math.Abs(qtyNow);
                int reqAbs = Math.Abs(requestedQty);

                int delta = (action == OrderAction.Buy || action == OrderAction.BuyToCover) ? reqAbs : -reqAbs;
                int qtyProjectedSigned = qtyNow + delta;
                int projectedAbs = Math.Abs(qtyProjectedSigned);

                d.currentAbs = curAbs;
                d.projectedAbs = projectedAbs;

                if (curAbs > max)
                {
                    d.allowed = false;
                    d.allowedQty = 0;
                    d.reason = $"Posição atual ({curAbs}) já excede Máx({max}).";
                    return d;
                }

                if (projectedAbs <= max)
                {
                    d.allowed = true;
                    d.allowedQty = reqAbs;
                    d.reason = $"OK (cur={curAbs} → proj={projectedAbs}, max={max})";
                    return d;
                }

                int allowedDeltaAbs = 0;
                if (delta > 0)
                    allowedDeltaAbs = max - qtyNow;
                else
                    allowedDeltaAbs = qtyNow + max;

                allowedDeltaAbs = Math.Max(0, allowedDeltaAbs);

                int allowedQty = Math.Min(reqAbs, allowedDeltaAbs);

                if (allowedQty <= 0)
                {
                    d.allowed = false;
                    d.allowedQty = 0;
                    d.reason = $"Bloqueado: Máx contratos/trade={max} (cur={curAbs} → proj={projectedAbs}).";
                    return d;
                }

                int projectedAbsAfterClamp = Math.Abs(qtyNow + (delta > 0 ? allowedQty : -allowedQty));

                d.allowed = true;
                d.allowedQty = allowedQty;
                d.projectedAbs = projectedAbsAfterClamp;
                d.reason = $"Qty limitada por RISK: max={max} (cur={curAbs} → proj={projectedAbsAfterClamp})";
                return d;
            }
            catch (Exception ex)
            {
                SmartLog("EvaluateMaxContractsPerTradeDecision ex: " + ex.Message);
                return d; // fail-open
            }
        }

        private int ClampQtyToMaxContractsPerTradeForSizing(int desiredQty, string reasonForUser)
        {
            try
            {
                int max = Math.Max(0, MaxContractsPerTrade);
                if (max <= 0) return desiredQty;

                int q = Math.Max(1, desiredQty);
                if (q <= max) return q;

                int clamped = max;

                embeddedControl?.SetQty(clamped);
                embeddedControl?.SetLastOrderInfo($"RISK: Qty limitado a {max} (sizing).");

                ShowTransientPopup($"RISK: Quantidade limitada a {max} contratos.\nMotivo: {reasonForUser}");
                SmartLog($"[TRACE][QtyClamp] sizing desired={q} clamped={clamped} max={max} reason={reasonForUser}");

                SavePrefs();
                return clamped;
            }
            catch (Exception ex)
            {
                SmartLog("ClampQtyToMaxContractsPerTradeForSizing ex: " + ex.Message);
                return desiredQty;
            }
        }

