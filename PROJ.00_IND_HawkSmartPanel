        internal void NotifyStopChanged()
        {
            try
            {
                if (embeddedControl == null) return;

                // ✅ HARDLOCK/RISK: se estiver bloqueado, StopChanged não pode reativar/desativar sizing nem mexer em qty
                if (IsRiskBlocked())
                {
                    try { embeddedControl?.SetLastOrderInfo("RISK: bloqueado"); } catch { }
                    return;
                }

                // ===== RR ON =====
                if (embeddedControl.IsRrSizingEnabled())
                {
                    double stopFinancial = embeddedControl.GetStopFinancial();
                    if (stopFinancial <= 0)
                    {
                        embeddedControl.SetRrSizingState(false);
                        embeddedControl.SetQtyButtonsEnabled(true);
                        ShowTransientPopup("RR desligado: defina Stop ($) para usar RR.");
                        SmartLog("RR auto-off (NotifyStopChanged): Stop($) inválido.");
                        SavePrefs();
                        return;
                    }

                    if (_lastRrTicks > 0 && _lastRrDollarPerContract > 0)
                    {
                        bool ok = ApplyRrSizingWithValidationProxy(_lastRrTicks, _lastRrDollarPerContract, false);
                        if (!ok)
                        {
                            embeddedControl.SetRrSizingState(false);
                            embeddedControl.SetQtyButtonsEnabled(true);
                            ShowTransientPopup("RR desligado: não foi possível recalcular sizing.");
                        }
                        SavePrefs();
                        return;
                    }
                    else
                    {
                        embeddedControl.SetRrSizingState(false);
                        embeddedControl.SetQtyButtonsEnabled(true);
                        ShowTransientPopup("RR desligado: ferramenta Recompensa-Risco não encontrada.");
                        SavePrefs();
                        return;
                    }
                }
                // ===== ATR ON =====
                if (embeddedControl.IsAtrEnabled())
                {
                    double stopFinancial = embeddedControl.GetStopFinancial();
                    if (stopFinancial <= 0)
                    {
                        embeddedControl.ForceAtrOffAndEnableQty();
                        ShowTransientPopup("ATR desligado: defina Stop ($) para usar ATR.");
                        SmartLog("ATR auto-off (NotifyStopChanged): Stop($) inválido.");
                        SavePrefs();
                        return;
                    }

                    if (_lastAtrTicks > 0 && _lastAtrDollarPerContract > 0)
                    {
                        bool ok = ApplyAtrSizingWithValidationProxy(_lastAtrTicks, _lastAtrDollarPerContract, false);
                        if (!ok)
                        {
                            embeddedControl.ForceAtrOffAndEnableQty();
                            ShowTransientPopup("ATR desligado: não foi possível recalcular sizing.");
                        }
                        SavePrefs();
                    }
                }
                else
                {
                    SavePrefs();
                }
            }
            catch (Exception ex)
            {
                SmartLog("NotifyStopChanged ex: " + ex.Message);
            }
        }

