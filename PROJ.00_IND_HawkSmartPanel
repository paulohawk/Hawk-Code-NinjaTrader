        private string HardLock_BuildChartKey(string accountName)
        {
            string acc = string.IsNullOrWhiteSpace(accountName) ? "null" : accountName;

            string inst = "null";
            try
            {
                if (Instrument != null && !string.IsNullOrWhiteSpace(Instrument.FullName))
                    inst = Instrument.FullName;
            }
            catch { inst = "null"; }

            string day = DateTime.Now.Date.ToString("yyyyMMdd", CultureInfo.InvariantCulture);

            // ✅ removido "|bars=..." (para o lock ser por ativo, independente do timeframe)
            return "CHART|acc=" + acc + "|day=" + day + "|inst=" + inst;
        }

        // Remove locks expirados do arquivo (higiene)
        private void HardLock_CleanupExpired()
        {
            try
            {
                string path = HardLock_GetFilePath();
                if (!File.Exists(path)) return;

                string[] lines = null;
                try { lines = File.ReadAllLines(path); }
                catch (Exception exRead)
                {
                    HardLockDiag("CleanupExpired ReadAllLines ex: " + exRead);
                    lines = null;
                }

                if (lines == null || lines.Length == 0) return;

                DateTime nowUtc = DateTime.UtcNow;
                var kept = new List<string>(lines.Length);

                for (int i = 0; i < lines.Length; i++)
                {
                    string line = lines[i];
                    if (string.IsNullOrWhiteSpace(line)) continue;

                    // key<TAB>ticks<TAB>kind
                    string[] parts = line.Split(HardLock_FileSep);
                    if (parts == null || parts.Length < 2) continue;

                    long ticks = 0;
                    if (!long.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out ticks))
                        continue;

                    DateTime untilUtc;
                    try { untilUtc = new DateTime(ticks, DateTimeKind.Utc); }
                    catch { continue; }

                    if (untilUtc > nowUtc)
                        kept.Add(line);
                }

                // regrava somente se mudou
                if (kept.Count != lines.Length)
                {
                    try
                    {
                        string dir = IOPath.GetDirectoryName(path);
                        if (!string.IsNullOrWhiteSpace(dir))
                            Directory.CreateDirectory(dir);

                        // ✅ write atômico (evita 0KB)
                        string tmp = path + ".tmp";
                        File.WriteAllLines(tmp, kept.ToArray());
                        File.Copy(tmp, path, true);
                        try { File.Delete(tmp); } catch { }

                        HardLockDiag($"CleanupExpired WRITE OK kept={kept.Count} (was={lines.Length}) path='{path}'");
                    }
                    catch (Exception exWrite)
                    {
                        HardLockDiag("CleanupExpired WRITE ex: " + exWrite);
                    }
                }
            }
            catch (Exception ex)
            {
                HardLockDiag("CleanupExpired OUTER ex: " + ex);
            }
        }

        // Lê lock vigente do arquivo para uma key
        private bool HardLock_TryRead(string key, out DateTime blockedUntilUtc, out string kind)
        {
            blockedUntilUtc = DateTime.MinValue;
            kind = "generic";

            try
            {
                if (string.IsNullOrWhiteSpace(key))
                {
                    HardLockDiag("TryRead aborted: key is null/empty");
                    return false;
                }

                string path = HardLock_GetFilePath();

                if (!File.Exists(path))
                {
                    HardLockDiag($"TryRead file missing path='{path}' key='{key}'");
                    return false;
                }

                string[] lines = null;
                try { lines = File.ReadAllLines(path); }
                catch (Exception exRead)
                {
                    HardLockDiag("TryRead ReadAllLines ex: " + exRead);
                    lines = null;
                }

                if (lines == null || lines.Length == 0)
                {
                    HardLockDiag($"TryRead file empty path='{path}' key='{key}'");
                    return false;
                }

                DateTime nowUtc = DateTime.UtcNow;

                for (int i = 0; i < lines.Length; i++)
                {
                    string line = lines[i];
                    if (string.IsNullOrWhiteSpace(line)) continue;

                    string[] parts = line.Split(HardLock_FileSep);
                    if (parts == null || parts.Length < 2) continue;

                    if (!string.Equals(parts[0], key, StringComparison.Ordinal))
                        continue;

                    long ticks = 0;
                    if (!long.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out ticks))
                    {
                        HardLockDiag($"TryRead parse ticks FAIL key='{key}' raw='{parts[1]}' line='{line}'");
                        return false;
                    }

                    DateTime untilUtc;
                    try { untilUtc = new DateTime(ticks, DateTimeKind.Utc); }
                    catch
                    {
                        HardLockDiag($"TryRead new DateTime FAIL key='{key}' ticks='{ticks}' line='{line}'");
                        return false;
                    }

                    if (untilUtc <= nowUtc)
                    {
                        HardLockDiag($"TryRead FOUND but expired key='{key}' untilUtc='{untilUtc:O}' nowUtc='{nowUtc:O}'");
                        return false;
                    }

                    blockedUntilUtc = untilUtc;

                    if (parts.Length >= 3 && !string.IsNullOrWhiteSpace(parts[2]))
                        kind = parts[2].Trim().ToLowerInvariant();

                    HardLockDiag($"TryRead FOUND key='{key}' untilUtc='{blockedUntilUtc:O}' kind='{kind}'");
                    return true;
                }

                HardLockDiag($"TryRead NOT FOUND key='{key}' lines={lines.Length}");
                return false;
            }
            catch (Exception ex)
            {
                HardLockDiag("TryRead OUTER ex: " + ex);
                return false;
            }
        }

        // Grava/atualiza lock (Upsert)
        private void HardLock_Upsert(string key, DateTime blockedUntilUtc, string kind)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(key))
                {
                    HardLockDiag("Upsert aborted: key is null/empty");
                    return;
                }

                string path = HardLock_GetFilePath();
                HardLockDiag($"Upsert ENTER key='{key}' untilUtc='{blockedUntilUtc:O}' kind='{kind}' path='{path}'");

                // snapshot antes
                try
                {
                    if (File.Exists(path))
                    {
                        var fi0 = new FileInfo(path);
                        HardLockDiag($"Upsert BEFORE file exists size={fi0.Length}B lastWrite={fi0.LastWriteTime:O}");
                    }
                    else
                    {
                        HardLockDiag("Upsert BEFORE file does NOT exist");
                    }
                }
                catch { }

                var lines = new List<string>();
                try
                {
                    if (File.Exists(path))
                        lines.AddRange(File.ReadAllLines(path));
                }
                catch (Exception exRead)
                {
                    HardLockDiag("Upsert ReadAllLines ex: " + exRead);
                    lines.Clear();
                }

                // remove expirados e remove mesma key
                DateTime nowUtc = DateTime.UtcNow;
                var kept = new List<string>(lines.Count + 1);

                for (int i = 0; i < lines.Count; i++)
                {
                    string line = lines[i];
                    if (string.IsNullOrWhiteSpace(line)) continue;

                    string[] parts = line.Split(HardLock_FileSep);
                    if (parts == null || parts.Length < 2) continue;

                    // expiração
                    long ticks = 0;
                    if (!long.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out ticks))
                        continue;

                    DateTime untilUtc;
                    try { untilUtc = new DateTime(ticks, DateTimeKind.Utc); }
                    catch { continue; }

                    if (untilUtc <= nowUtc) continue;

                    // remove chave antiga
                    if (string.Equals(parts[0], key, StringComparison.Ordinal))
                        continue;

                    kept.Add(line);
                }

                string k = string.IsNullOrWhiteSpace(kind) ? "generic" : kind.Trim().ToLowerInvariant();

                // ✅ formato novo: key<TAB>ticks<TAB>kind
                string newLine = key
                    + HardLock_FileSep + blockedUntilUtc.Ticks.ToString(CultureInfo.InvariantCulture)
                    + HardLock_FileSep + k;

                kept.Add(newLine);

                try
                {
                    string dir = IOPath.GetDirectoryName(path);
                    if (!string.IsNullOrWhiteSpace(dir))
                        Directory.CreateDirectory(dir);

                    // ✅ write atômico (evita arquivo 0KB em caso de falha no meio)
                    string tmp = path + ".tmp";
                    File.WriteAllLines(tmp, kept.ToArray());
                    File.Copy(tmp, path, true);
                    try { File.Delete(tmp); } catch { }

                    HardLockDiag($"Upsert WRITE OK lines={kept.Count} newLine='{newLine}'");
                }
                catch (Exception exWrite)
                {
                    HardLockDiag("Upsert WRITE ex: " + exWrite);
                }

                // snapshot depois
                try
                {
                    if (File.Exists(path))
                    {
                        var fi1 = new FileInfo(path);
                        HardLockDiag($"Upsert AFTER file exists size={fi1.Length}B lastWrite={fi1.LastWriteTime:O}");
                    }
                    else
                    {
                        HardLockDiag("Upsert AFTER file does NOT exist (unexpected)");
                    }
                }
                catch { }
            }
            catch (Exception ex)
            {
                HardLockDiag("Upsert OUTER ex: " + ex);
            }
        }

