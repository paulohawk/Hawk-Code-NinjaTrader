// NOVO: segundos até meia-noite (mínimo 5s)
private int SecondsUntilMidnight()
{
    try
    {
        var now = DateTime.Now;
        var next = now.Date.AddDays(1);
        var sec = (int)Math.Ceiling((next - now).TotalSeconds);
        return Math.Max(5, sec);
    }
    catch
    {
        return 90;
    }
}

// NOVO: centraliza o cálculo da duração do overlay de RISK (configurável pelo usuário)
private int GetRiskOverlayDurationSeconds()
{
    if (RiskOverlayUntilMidnight)
        return SecondsUntilMidnight();

    return RiskOverlaySeconds > 0 ? RiskOverlaySeconds : 90;
}

