        protected override void OnStateChange()
        {
            if (State == State.SetDefaults)
            {
                SmartLog($"[RESTORE][LIFECYCLE] State={State} ChartKey={GetChartKey()} BoletaId={BoletaId ?? "null"}");
                Name = "SmartBoletaIndicator";
                Description = "Hawk - Smart Panel";
                Calculate = Calculate.OnPriceChange;
                IsOverlay = true;
                DrawOnPricePanel = true;
                DisplayInDataBox = false;
                IsSuspendedWhileInactive = true;

                AtrPeriod = 14;
                AtrMultiplier = 1.0;
                AtrAuto = true;
                AtrFixedMinutes = 60;
                AtrFixedPeriod = 14;
                AtrFixedMultiplier = 1.0;

                EnableDiagnosticLogging = false;
                BreakEvenTicks = 10;
                MinFavorFactor = 2.0;
                ScanIntervalSeconds = 30;

                MaxContractsPerTrade = 0;
                RiskOverlayUntilMidnight = false;

                DecorSymbol = "$";
                DecorDisplayTicks = true;
                DecorDisplayPoints = true;
                DecorDisplayCurrency = true;
                DecorDisplayPercent = true;
                DecorFlexGapWidth = 90;

                DecorStopFillBrush = CreateDefaultDecorStopFillBrush();

                DecorTargetFillBrush = Brushes.DarkGoldenrod;
                DecorOutlineBrush = Brushes.DimGray;
                DecorTextBrush = Brushes.White;

                LogRestoreSnapshot("SetDefaults");
                SmartLog("[RESTORE] SetDefaults completed.");
            }
            else if (State == State.Configure)
            {
                SmartLog($"[RESTORE][LIFECYCLE] State={State} ChartKey={GetChartKey()} BoletaId={BoletaId ?? "null"}");
                SmartLog("[RESTORE] Entering Configure.");
                LogRestoreSnapshot("Configure");
                try
                {
                    int mins = Math.Max(1, AtrFixedMinutes);
                    AddDataSeries(BarsPeriodType.Minute, mins);
                }
                catch { }
            }
            else if (State == State.DataLoaded)
            {
                SmartLog($"[RESTORE][LIFECYCLE] State={State} ChartKey={GetChartKey()} BoletaId={BoletaId ?? "null"}");
                SmartLog("[RESTORE] Entering DataLoaded.");
                LogRestoreSnapshot("DataLoaded");
                // ✅ HARDLOCK (higiene): remove locks expirados do arquivo
                // (não altera o comportamento do Risk ainda)
                try { HardLock_CleanupExpired(); } catch { }

                // ✅ HARDLOCK DIAG: caminho do arquivo (1x por load)
                try { HardLockDiag("DataLoaded: risk_file_path='" + HardLock_GetFilePath() + "'"); } catch { }

                int chartKey = GetChartKey();
                if (chartKey != 0)
                {
                    SmartLog($"[INSTANCE] Checking ActivePerChart ChartKey={chartKey}");
                    if (ActivePerChart.TryGetValue(chartKey, out var wr) && wr.TryGetTarget(out var existing) && existing != null && existing != this)
                    {
                        SmartLog($"[INSTANCE] Existing instance detected ChartKey={chartKey}");
                        SmartLog("Já existe boleta ativa neste chart; não criarei outra.");
                        return;
                    }
                    ActivePerChart[chartKey] = new WeakReference<SmartBoletaIndicator>(this);
                    SmartLog($"[INSTANCE] Registered new instance ChartKey={chartKey}");

                    if (BoletaIdPerChart.TryGetValue(chartKey, out var existingId) && !string.IsNullOrEmpty(existingId))
                        BoletaId = existingId;
                    else
                    {
                        if (string.IsNullOrEmpty(BoletaId))
                            BoletaId = $"B{Interlocked.Increment(ref BoletaCounter):D2}";
                        BoletaIdPerChart[chartKey] = BoletaId;
                    }
                }
                else if (string.IsNullOrEmpty(BoletaId))
                    BoletaId = $"B{Interlocked.Increment(ref BoletaCounter):D2}";

                MapDesiredKeys();
                orderType = (stopOrderType == StopOrderTypes.StopLimit) ? OrderType.StopLimit : OrderType.StopMarket;

                overlayController = new EndDayOverlayController(this);

                if (ChartControl != null)
                {
                    TryRegisterChartActivationHooks();
                    ChartControl.Dispatcher.InvokeAsync(HookChartTraderAndInsert, DispatcherPriority.Background);
                }

                StartAttachTimer();
                SmartLog($"DataLoaded: attach timer iniciado. BoletaId={BoletaId}");

                SubscribeExecutions();
                SubscribeDecoratorAccountEvents();
                BindPnlAccountListener(true, "data_loaded");
                _riskDay = DateTime.Now.Date;

                try
                {
                    var acc0 = GetSelectedAccount();
                    lock (_riskPosLock)
                    {
                        _riskTrackedAccountName = acc0?.Name;
                        _riskLastPositionInitialized = false;
                        _riskLastPositionQty = 0;
                    }
                }
                catch { }

                string uid = Guid.NewGuid().ToString("N");
                _atrLineTag = $"ATR_LINE_{uid}";
                _atrTextTag1 = $"ATR_TEXT1_{uid}";
                _atrTextTag2 = $"ATR_TEXT2_{uid}";

                LoadPrefs();
                ComputeOrderDecorations();
                ForceRefreshDecorations();
                StartDecoTimer();
            }
            else if (State == State.Historical)
            {
                SmartLog($"[RESTORE][LIFECYCLE] State={State} ChartKey={GetChartKey()} BoletaId={BoletaId ?? "null"}");
            }
            else if (State == State.Realtime)
            {
                SmartLog($"[RESTORE][LIFECYCLE] State={State} ChartKey={GetChartKey()} BoletaId={BoletaId ?? "null"}");
                ComputeOrderDecorations();
                ForceRefreshDecorations();
            }
            else if (State == State.Terminated)
            {
                SmartLog($"[RESTORE][LIFECYCLE] State={State} ChartKey={GetChartKey()} BoletaId={BoletaId ?? "null"}");
                SmartLog("Terminated: cleaning up.");
                StopAttachTimer();
                StopDecoTimer();
                RemoveEmbedded();
                UnregisterChartHandlers();
                overlayController?.DisposeOverlay();
                UnsubscribeExecutions();
                UnsubscribeDecoratorAccountEvents();
                UnwireAccountSelector();
                TryUnregisterChartActivationHooks();
                UnbindPnlAccountListener();

                SavePrefs();

                int chartKey = GetChartKey();
                if (chartKey != 0 && ActivePerChart.ContainsKey(chartKey))
                    ActivePerChart.Remove(chartKey);

                ClearAtrDraws();
                ClearDecorations();
            }
        }

        internal void SavePrefs()
        {
            try
            {
                if (string.IsNullOrEmpty(BoletaId) || embeddedControl == null) return;
                var sp = new SavedPrefs
                {
                    Qty = embeddedControl.GetQty(),
                    StopFinancial = embeddedControl.GetStopFinancial(),
                    AtrOn = embeddedControl.IsAtrEnabled(),

                    RrOn = embeddedControl.IsRrSizingEnabled(),

                    BeOn = embeddedControl.IsBeEnabled(),
                    OnClickOn = embeddedControl.IsOnClickEnabled(),
                    RiskOn = _riskOn,
                    BuyKey = buyKey,
                    SellKey = sellKey,
                    EndDayTime = EndDayTime,
                    EndDayScope = EndDayScope,
                    AtrAuto = AtrAuto,
                    AtrFixedMinutes = AtrFixedMinutes,
                    AtrFixedPeriod = AtrFixedPeriod,
                    AtrFixedMultiplier = AtrFixedMultiplier,

                    MaxContractsPerTrade = MaxContractsPerTrade,
                    RiskOverlayUntilMidnight = RiskOverlayUntilMidnight
                };
                PrefsById[BoletaId] = sp;
            }
            catch (Exception ex) { SmartLog("SavePrefs ex: " + ex.Message); }
        }

        private void LoadPrefs()
        {
            try
            {
                if (string.IsNullOrEmpty(BoletaId) || embeddedControl == null) return;
                if (!PrefsById.TryGetValue(BoletaId, out var sp)) return;

                buyKey = sp.BuyKey;
                sellKey = sp.SellKey;
                MapDesiredKeys();

                EndDayTime = sp.EndDayTime;
                EndDayScope = sp.EndDayScope;
                embeddedControl.SetEndDayLabel(EndDayTime, EndDayScope);

                if (sp.Qty > 0) embeddedControl.SetQty(sp.Qty);
                if (sp.StopFinancial > 0) embeddedControl.SetStopFinancial(sp.StopFinancial);

                _riskOn = sp.RiskOn;
                embeddedControl.SetRiskToggleVisual(_riskOn);

                MaxContractsPerTrade = Math.Max(0, sp.MaxContractsPerTrade);
                RiskOverlayUntilMidnight = sp.RiskOverlayUntilMidnight;

                AtrAuto = sp.AtrAuto;
                AtrFixedMinutes = Math.Max(1, sp.AtrFixedMinutes);
                AtrFixedPeriod = Math.Max(1, sp.AtrFixedPeriod);
                AtrFixedMultiplier = Math.Max(0.0, sp.AtrFixedMultiplier);

                embeddedControl.SetBeState(sp.BeOn);
                _beActive = sp.BeOn;

                if (sp.RrOn)
                {
                    embeddedControl.SetAtrState(false);
                    bool okRr = ApplyRrSizingWithValidationProxy(_lastRrTicks, _lastRrDollarPerContract, true);
                    if (okRr)
                    {
                        embeddedControl.SetRrSizingState(true);
                        embeddedControl.SetQtyButtonsEnabled(false);
                    }
                }
                else if (sp.AtrOn)
                {
                    bool ok = ApplyAtrSizingWithValidationProxy(_lastAtrTicks, _lastAtrDollarPerContract, true);
                    if (ok)
                    {
                        embeddedControl.SetAtrState(true);
                        embeddedControl.SetQtyButtonsEnabled(false);
                    }
                }
                else
                {
                    embeddedControl.SetAtrState(false);
                    embeddedControl.SetRrSizingState(false);
                    embeddedControl.SetQtyButtonsEnabled(true);
                    SmartLog("LoadPrefs: fallback para modo manual (prefs antigas/sem sizing).");
                }

                embeddedControl.SetOnClickState(sp.OnClickOn);
                SetTradingFromChartEnabled(sp.OnClickOn);

                embeddedControl.UpdateBulletsAfterStateChange();
            }
            catch (Exception ex) { SmartLog("LoadPrefs ex: " + ex.Message); }
        }

        private void StartDecoTimer()
        {
            try
            {
                if (decoTimer != null) return;
                decoTimer = new DispatcherTimer { Interval = TimeSpan.FromSeconds(2) };
                decoTimer.Tick += (s, e) =>
                {
                    try
                    {
                        ComputeOrderDecorations();
                        ForceRefreshDecorations();
                    }
                    catch (Exception ex) { SmartLog("DecoTimer ex: " + ex.Message); }
                };
                decoTimer.Start();
                SmartLog("DecoTimer started (2s).");
            }
            catch (Exception ex) { SmartLog("StartDecoTimer ex: " + ex.Message); }
        }

        private void StopDecoTimer()
        {
            try
            {
                if (decoTimer != null)
                {
                    decoTimer.Stop();
                    decoTimer = null;
                }
            }
            catch { }
        }

        private SmartLogLevel InferLogLevel(string message)
        {
            if (string.IsNullOrWhiteSpace(message))
                return SmartLogLevel.Info;

            if (message.IndexOf("[TRACE]", StringComparison.OrdinalIgnoreCase) >= 0)
                return SmartLogLevel.Trace;

            if (message.IndexOf(" ex:", StringComparison.OrdinalIgnoreCase) >= 0 ||
                message.IndexOf(" error", StringComparison.OrdinalIgnoreCase) >= 0)
                return SmartLogLevel.Error;

            if (message.IndexOf("fallback", StringComparison.OrdinalIgnoreCase) >= 0 ||
                message.IndexOf("sync", StringComparison.OrdinalIgnoreCase) >= 0 ||
                message.IndexOf("timer", StringComparison.OrdinalIgnoreCase) >= 0)
                return SmartLogLevel.Debug;

            return SmartLogLevel.Info;
        }

