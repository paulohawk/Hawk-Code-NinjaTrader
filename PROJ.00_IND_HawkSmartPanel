private bool WouldExceedMaxContractsPerTrade(Account account, OrderAction action, int qtyToAdd, out int currentAbs, out int projectedAbs)
{
    // ✅ Mantido por compatibilidade, mas o enforcement principal agora deve usar EvaluateMaxContractsPerTradeDecision(...)
    currentAbs = 0;
    projectedAbs = 0;

    try
    {
        int max = Math.Max(0, MaxContractsPerTrade);
        if (max <= 0) return false; // disabled

        if (account == null || Instrument == null) return false;

        var pos = GetPositionForInstrument(account, Instrument);
        int qtyNow = pos?.Quantity ?? 0;

        currentAbs = Math.Abs(qtyNow);

        // ✅ NOVO: inclui flip (virar posição) na projeção
        // delta conforme ação
        int delta = (action == OrderAction.Buy || action == OrderAction.BuyToCover) ? qtyToAdd : -qtyToAdd;
        int projectedSigned = qtyNow + delta;
        projectedAbs = Math.Abs(projectedSigned);

        return projectedAbs > max;
    }
    catch (Exception ex)
    {
        SmartLog("WouldExceedMaxContractsPerTrade ex: " + ex.Message);
        return false;
    }
}

private void OnExecutionUpdate(object sender, ExecutionEventArgs e)
{
    try
    {
        if (e == null || e.Execution == null) return;
        var exec = e.Execution;

        var ord = exec.Order;
        if (ord == null) return;
        var state = ord.OrderState;
        if (state != OrderState.Filled && state != OrderState.PartFilled) return;

        if (EscopoRisk == SRiskScope.EsteGrafico && Instrument != null)
        {
            var exInst = exec.Instrument;
            if (exInst == null) return;
            bool match = (exInst.FullName == Instrument.FullName) ||
                         (exInst.MasterInstrument?.Name == Instrument.MasterInstrument?.Name);
            if (!match) return;
        }

        // ✅ RISK do round-trip é por conta selecionada
        var sel = GetSelectedAccount();
        if (sel == null) return;
        if (exec.Account == null) return;
        if (!string.Equals(exec.Account.Name, sel.Name, StringComparison.OrdinalIgnoreCase))
            return;

        // ===== LOGS (entrada exec) =====
        try
        {
            int posQtyNowDbg = 0;
            try { posQtyNowDbg = GetPositionForInstrument(exec.Account, Instrument)?.Quantity ?? 0; } catch { }
            SmartLog($"[TRACE][ExecUpdate] acc={exec.Account?.Name} inst={exec.Instrument?.FullName} qtyExec={exec.Quantity} state={state} posQtyNow={posQtyNowDbg} trades={_riskTrades} contracts={_riskContracts} blocked={IsRiskBlocked()} armed={_riskOverlayArmed} shown={_riskOverlayShown}");
        }
        catch { }

        EnsureRiskResetDaily();

        // ===== Mantém: contratos/dia (volume executado) =====
        _riskContracts += Math.Abs(exec.Quantity);

        // ⚠️ Round-trip NÃO é atualizado por execução.
        // A contagem de _riskTrades acontece exclusivamente em PositionUpdate
        // ao detectar transição de posição != 0 para posição == 0.

        SmartLog($"Exec contabilizada para Risk: trades={_riskTrades} contratosDia={_riskContracts} qtyExec={exec.Quantity}");

        // Limpeza pós-flat imediatamente após execução
        CleanupFlatOrders(exec.Account);

        // tenta disparar overlay armado usando a conta do evento (gatilho imediato)
        TryShowRiskOverlayIfArmedAndFlat(exec.Account, "execution");

        EvaluateRisk(true);
        ComputeOrderDecorations();
    }
    catch (Exception ex)
    {
        SmartLog("OnExecutionUpdate Risk ex: " + ex.Message);
    }
}

private void EnsureRiskResetDaily()
{
