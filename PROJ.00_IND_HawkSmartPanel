                                SmartLog(SmartLogLevel.Debug, "Qty sync skipped: Quantity selector not found.");
                            }
                            return;
                        }

                        qtySelector.Value = qty;
                        if (_lastQtyLogged != qty)
                        {
                            _lastQtyLogged = qty;
                            SmartLog(SmartLogLevel.Debug, $"Qty sync to ChartTrader: {qty}");
                        }
                    }
                    catch (Exception ex) { SmartLog(SmartLogLevel.Error, "Qty sync error: " + ex.Message); }
                }));
            }
            catch { }
        }
