    private DispatcherTimer _fallbackTimer;

    public EndDayOverlayController(SmartBoletaIndicator parent)
    {
        _parent = parent;
    }

    public void ShowOverlay(TimeSpan triggerTime, double opacity, int durationSeconds, string message)
    {
        EnsureOverlayShown(opacity, durationSeconds, message);
    }

    public void EnsureOverlayShown(double opacity, int durationSeconds, string message)
    {
        try
        {
            RunOnUi(() =>
            {
                try
                {
                    _host = Window.GetWindow(_parent.ChartControl);
                    if (_host == null)
                    {
                        _parent.SmartLog("Overlay: host window null.");
                        return;
                    }

                    var root = _host.Content as FrameworkElement;
                    if (root == null)
                    {
                        _parent.SmartLog("Overlay: host root null (Window.Content não é FrameworkElement).");
                        return;
                    }

                    EnsureAdornerLayer(root);

                    if (_adorner == null)
                    {
                        _adorner = new OverlayAdorner(root);
                        _adornerLayer.Add(_adorner);
                        AttachHostEvents();
                    }

                    _adorner.SetContent(opacity, message);

                    ScheduleFallback(durationSeconds);

                    _parent.SmartLog("Overlay: exibido (Adorner).");
                }
                catch (Exception ex)
                {
                    _parent.SmartLog("Overlay EnsureOverlayShown ex: " + ex.Message);
                }
            });
        }
        catch { }
    }

    public void DisposeOverlay()
    {
        RunOnUi(() =>
        {
            CancelFallback();
            RemoveOverlay();
        });
    }

    private void EnsureAdornerLayer(FrameworkElement root)
    {
        try
        {
            _adornerLayer = AdornerLayer.GetAdornerLayer(root);

            // Se não houver AdornerLayer, criamos uma camada inserindo um AdornerDecorator
            // em volta do conteúdo da Window (uma vez).
            if (_adornerLayer == null)
            {
                if (_host.Content is UIElement current)
                {
                    var decorator = new AdornerDecorator();
                    _host.Content = null;
                    decorator.Child = current;
                    _host.Content = decorator;
                    _adornerLayer = decorator.AdornerLayer;
                }
            }

            if (_adornerLayer == null)
                _parent.SmartLog("Overlay: não foi possível obter/criar AdornerLayer.");
        }
        catch (Exception ex)
        {
            _parent.SmartLog("Overlay EnsureAdornerLayer ex: " + ex.Message);
        }
    }

    private void RemoveOverlay()
    {
        try
        {
            if (_adorner != null)
            {
                try
                {
                    if (_host != null)
                    {
                        _host.LocationChanged -= HostWindow_PositionOrSizeChanged;
                        _host.SizeChanged -= HostWindow_PositionOrSizeChanged;
                    }
                }
                catch { }

                try
                {
                    _adornerLayer?.Remove(_adorner);
                }
                catch { }

                _adorner = null;
                _parent.SmartLog("Overlay: removido.");
            }
        }
        catch (Exception ex)
        {
            _parent.SmartLog("Overlay RemoveOverlay ex: " + ex.Message);
        }
    }

    private void AttachHostEvents()
    {
        try
        {
            if (_host != null)
            {
                _host.LocationChanged += HostWindow_PositionOrSizeChanged;
                _host.SizeChanged += HostWindow_PositionOrSizeChanged;
            }
        }
        catch (Exception ex)
        {
            _parent.SmartLog("Overlay AttachHostEvents ex: " + ex.Message);
        }
    }

    private void HostWindow_PositionOrSizeChanged(object sender, EventArgs e)
    {
        try
        {
            // força re-render do adorner em resize/move
            _adorner?.InvalidateVisual();
        }
        catch (Exception ex)
        {
            _parent.SmartLog("Overlay HostWindow_PositionOrSizeChanged ex: " + ex.Message);
        }
    }

    private void ScheduleFallback(int seconds)
    {
        try
        {
            CancelFallback();
            if (seconds <= 0) return;

            _fallbackTimer = new DispatcherTimer { Interval = TimeSpan.FromSeconds(seconds) };
            _fallbackTimer.Tick += (s, e) =>
            {
                CancelFallback();
                RemoveOverlay();
            };
            _fallbackTimer.Start();
        }
        catch (Exception ex)
        {
            _parent.SmartLog("Overlay ScheduleFallback ex: " + ex.Message);
        }
    }

    private void CancelFallback()
    {
        try
        {
            if (_fallbackTimer != null)
            {
                _fallbackTimer.Stop();
                _fallbackTimer = null;
            }
        }
        catch { }
    }

    private void RunOnUi(Action action)
    {
        try
        {
            if (_parent.ChartControl != null && _parent.ChartControl.Dispatcher != null)
                _parent.ChartControl.Dispatcher.BeginInvoke(action);
            else
                Dispatcher.CurrentDispatcher.BeginInvoke(action);
        }
        catch (Exception ex)
        {
            _parent.SmartLog("Overlay RunOnUi ex: " + ex.Message);
        }
    }

    // ===== OverlayAdorner =====
    private sealed class OverlayAdorner : Adorner
    {
        private readonly Grid _root;
        private readonly TextBlock _subtitle;

        public OverlayAdorner(UIElement adornedElement)
            : base(adornedElement)
        {
            IsHitTestVisible = true;

            _root = new Grid
            {
                HorizontalAlignment = HorizontalAlignment.Stretch,
                VerticalAlignment = VerticalAlignment.Stretch,
                IsHitTestVisible = true
            };

            // bloquear input
            _root.PreviewKeyDown += (s, e) => e.Handled = true;
            _root.PreviewKeyUp += (s, e) => e.Handled = true;
            _root.PreviewMouseDown += (s, e) => e.Handled = true;
            _root.PreviewMouseUp += (s, e) => e.Handled = true;
            _root.PreviewMouseWheel += (s, e) => e.Handled = true;

            var inner = new StackPanel
            {
                VerticalAlignment = VerticalAlignment.Center,
                HorizontalAlignment = HorizontalAlignment.Center,
                Orientation = Orientation.Vertical,
                Margin = new Thickness(40)
            };

            var title = new TextBlock
            {
                Text = "Atenção, trader — Janela de bloqueio ativa!",
                Foreground = Brushes.White,
                FontSize = 18,
                FontWeight = FontWeights.Bold,
                TextAlignment = TextAlignment.Center,
                Margin = new Thickness(8)
            };

            var spacer = new Border { Height = 30, Background = Brushes.Transparent };

            _subtitle = new TextBlock
            {
                Text = "Envio de ordens bloqueado neste horário.",
                Foreground = Brushes.White,
                FontSize = 13,
                TextAlignment = TextAlignment.Center,
                Margin = new Thickness(6),
                TextWrapping = TextWrapping.Wrap,
                MaxWidth = 720
            };

            inner.Children.Add(title);
            inner.Children.Add(spacer);
            inner.Children.Add(_subtitle);

            _root.Children.Add(inner);

            AddVisualChild(_root);
            AddLogicalChild(_root);
        }

        public void SetContent(double opacity, string message)
        {
            var a = (byte)(Math.Max(0, Math.Min(1.0, opacity)) * 255);
            _root.Background = new SolidColorBrush(Color.FromArgb(a, 0, 0, 0));
            _subtitle.Text = string.IsNullOrWhiteSpace(message) ? "Envio de ordens bloqueado neste horário." : message;
            InvalidateVisual();
        }

        protected override int VisualChildrenCount => 1;

        protected override Visual GetVisualChild(int index)
        {
            if (index != 0) throw new ArgumentOutOfRangeException(nameof(index));
            return _root;
        }

        protected override Size ArrangeOverride(Size finalSize)
        {
            _root.Arrange(new Rect(new Point(0, 0), finalSize));
            return finalSize;
        }
    }
}

