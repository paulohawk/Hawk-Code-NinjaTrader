                                myAccount = accountSelectorLocal.SelectedAccount;
                            else
                                myAccount = GetSelectedAccount(); // fallback consistente

                            if (myAccount == null)
                                myAccount = FindAncestorAccount();

                            // ===== LOGS (preparação da ordem) =====
                            try
                            {
                                SmartLog($"[TRACE][ClickOrderPrep] acc={(myAccount?.Name ?? "null")} inst={(Instrument?.FullName ?? "null")} buy={buyButton} sell={sellButton} qty={myQuantity} priceClicked={priceClicked:F2} trades={_riskTrades} contracts={_riskContracts} blocked={IsRiskBlocked()}");
                            }
                            catch { }

                            // ===== RISK: Max contracts/trade (com clamp + flip) =====
                            // Observação: aqui é envio real. Aplicamos regra completa (abrir/aumentar/flip).
                            if (AtivarRisk && _riskOn && MaxContractsPerTrade > 0 && myAccount != null && myQuantity > 0)
                            {
                                OrderAction intendedAction = buyButton ? OrderAction.Buy : OrderAction.Sell;
                                var d = EvaluateMaxContractsPerTradeDecision(myAccount, Instrument, intendedAction, myQuantity);

                                if (!d.allowed || d.allowedQty <= 0)
                                {
                                    embeddedControl?.SetLastOrderInfo($"RISK: bloqueado. Máx contratos/trade = {MaxContractsPerTrade}.");
                                    ShowTransientPopup($"RISK: bloqueado.\nMáx contratos/trade = {MaxContractsPerTrade}\nAtual: {d.currentAbs}  |  Após ordem: {d.projectedAbs}");
                                    SmartLog($"[TRACE][MaxPerTrade] BLOCK click: acc={myAccount.Name} action={intendedAction} reqQty={myQuantity} curAbs={d.currentAbs} projAbs={d.projectedAbs} max={MaxContractsPerTrade}");
                                    return;
                                }

                                if (d.allowedQty != myQuantity)
                                {
                                    int old = myQuantity;
                                    myQuantity = d.allowedQty;

                                    // Congela na UI também (conforme requisito)
                                    try { embeddedControl?.SetQty(myQuantity); } catch { }
                                    try { SyncQtyToChartTrader(myQuantity); } catch { }

                                    embeddedControl?.SetLastOrderInfo($"RISK: Qty limitado a {myQuantity} (máx {MaxContractsPerTrade}).");
                                    ShowTransientPopup($"RISK: Quantidade limitada a {myQuantity} contratos.\nMáx por trade = {MaxContractsPerTrade}");
                                    SmartLog($"[TRACE][MaxPerTrade] CLAMP click: acc={myAccount.Name} action={intendedAction} reqQty={old} newQty={myQuantity} curAbs={d.currentAbs} projAbs={d.projectedAbs} max={MaxContractsPerTrade}");
                                }
                            }

                            var atmSelector = hostWin.FindFirst("ChartTraderControlATMStrategySelector") as NinjaTrader.Gui.NinjaScript.AtmStrategy.AtmStrategySelector;

                            if (buyButton == true)
                            {
                                if (priceClicked > Close[0])
                                    myOrder = myAccount?.CreateOrder(Instrument, OrderAction.Buy, orderType, OrderEntry.Manual, TimeInForce.Day, myQuantity, priceClicked, priceClicked, "", "Entry", DateTime.MaxValue, null);
                                else
                                    myOrder = myAccount?.CreateOrder(Instrument, OrderAction.Buy, OrderType.Limit, OrderEntry.Manual, TimeInForce.Day, myQuantity, priceClicked, 0, "", "Entry", DateTime.MaxValue, null);
                            }

                            if (sellButton == true)
                            {
                                if (priceClicked < Close[0])
                                    myOrder = myAccount?.CreateOrder(Instrument, OrderAction.Sell, orderType, OrderEntry.Manual, TimeInForce.Day, myQuantity, priceClicked, priceClicked, "", "Entry", DateTime.MaxValue, null);
                                else
                                    myOrder = myAccount?.CreateOrder(Instrument, OrderAction.Sell, OrderType.Limit, OrderEntry.Manual, TimeInForce.Day, myQuantity, priceClicked, 0, "", "Entry", DateTime.MaxValue, null);
                            }

                            if (myAccount == null)
                            {
                                embeddedControl?.SetLastOrderInfo("Conta não definida.");
                                return;
                            }

                            if (myQuantity <= 0)
                            {
                                embeddedControl?.SetLastOrderInfo("Quantidade inválida.");
                                return;
                            }

                            if (myOrder == null)
                            {
                                embeddedControl?.SetLastOrderInfo("Falha ao criar ordem.");
                                return;
                            }

                            if (atmSelector?.SelectedAtmStrategy != null)
                                NinjaTrader.NinjaScript.AtmStrategy.StartAtmStrategy(atmSelector.SelectedAtmStrategy, myOrder);
                        }

                        // ===== LOGS (submit) =====
                        try
                        {
                            SmartLog($"[TRACE][OrderSubmit] acc={(myAccount?.Name ?? "null")} inst={(Instrument?.FullName ?? "null")} order={(myOrder != null ? myOrder.ToString() : "null")} trades={_riskTrades} contracts={_riskContracts} blocked={IsRiskBlocked()}");
                        }
                        catch { }

                        myAccount?.Submit(new[] { myOrder });

                        embeddedControl?.SetLastOrderInfo(myOrder?.ToString() ?? "Order submitted");
                        SmartLog($"OnClick: order qty={myQuantity} price={priceClicked}");
                    }
                    catch (Exception ex2)
                    {
                        SmartLog("LeftMouseDown OnClick error: " + ex2.Message);
                        embeddedControl?.SetLastOrderInfo("Erro ao enviar ordem: " + ex2.Message);
                    }
                }, null);

                e.Handled = true;
            }
        }

