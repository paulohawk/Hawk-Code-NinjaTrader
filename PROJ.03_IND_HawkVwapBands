		private Brush FreezeForDataThread(Brush b)
		{
			if (b == null)
				return null;

			if (b.IsFrozen)
				return b;

			Brush clone = b.Clone();
			if (clone.CanFreeze)
				clone.Freeze();
			return clone;
		}

		private void RefreshFrozenBrushCache()
		{
			_sd1Frozen = FreezeForDataThread(SD1AreaBrush);
			_sd2Frozen = FreezeForDataThread(SD2AreaBrush);
			_sd3Frozen = FreezeForDataThread(SD3AreaBrush);
			_sd4Frozen = FreezeForDataThread(SD4AreaBrush);
			_sd5Frozen = FreezeForDataThread(SD5AreaBrush);
			_transparentFrozen = FreezeForDataThread(Brushes.Transparent);
		}

		private Brush GetFrozenOrTransparent(Brush frozenCandidate)
		{
			if (!EnableVisuals)
				return _transparentFrozen ?? Brushes.Transparent;

			return frozenCandidate ?? _transparentFrozen ?? Brushes.Transparent;
		}

