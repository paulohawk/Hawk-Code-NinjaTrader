        #region Render
        protected override void OnRender(ChartControl chartControl, ChartScale chartScale)
        {
            if (State == State.Terminated) return;
            var localCache = renderCache;
            if (localCache == null || localCache.Length == 0) return;
            if (ChartPanel == null) return;
            if (chartControl == null) { LogVerbose(LogLevelSetting.WARN, "OnRender", "Render aborted: chartControl null."); return; }
            if (ChartBars == null) { LogVerbose(LogLevelSetting.WARN, "OnRender", "Render aborted: ChartBars null."); return; }
            if (chartScale == null) { LogVerbose(LogLevelSetting.WARN, "OnRender", "Render aborted: chartScale null."); return; }
            if (chartScale.MinValue >= chartScale.MaxValue)
            {
                LogVerbose(LogLevelSetting.WARN, "OnRender", "Render aborted: chartScale invalid (Min >= Max).");
                return;
            }

            try
            {
                if (chartControl.Properties.LabelFont != chartFont)
                {
                    chartFont = chartControl.Properties.LabelFont;
                    textFormat = chartFont.ToDirectWriteTextFormat();
                    sampleTextWidth = MeasureTextWidth(chartFont, sampleText);
                }

                using (var borderDx = OutlineBrush.ToDxBrush(RenderTarget))
                using (var stopDx = StopFillBrush.ToDxBrush(RenderTarget))
                using (var targetDx = TargetFillBrush.ToDxBrush(RenderTarget))
                using (var textDx = TextBrush.ToDxBrush(RenderTarget))
                {
                    double barPct = chartControl.OwnerChart?.ChartTrader?.Properties?.OrderDisplayBarLength ?? 0;
                    double barPx = ChartPanel.W * (barPct / 100.0);

                    foreach (var item in localCache)
                    {
                        var layout = new SharpDX.DirectWrite.TextLayout(
                            NinjaTrader.Core.Globals.DirectWriteFactory,
                            item.Text,
                            textFormat,
                            ChartPanel.X + ChartPanel.W,
                            textFormat.FontSize);

                        float tw = layout.Metrics.Width;
                        float th = layout.Metrics.Height;

                        float x = (float)(ChartPanel.W - (barPx + tw + sampleTextWidth + FlexGapWidth));
                        int yPx = chartScale.GetYByValue(item.Price);
                        float y = yPx - ((th + 7) / 2);

                        var start = new SharpDX.Vector2(x, y);
                        var textPos = new SharpDX.Vector2(start.X + 4, start.Y + 3);
                        var lineStart = new SharpDX.Vector2(start.X + tw + 9, yPx);
                        var lineEnd = new SharpDX.Vector2(ChartPanel.W, yPx);

                        var rect = new SharpDX.RectangleF(start.X, start.Y, tw + 8, th + 6);
                        RenderTarget.FillRectangle(rect, item.Kind == DecorKind.STOP ? stopDx : targetDx);
                        RenderTarget.DrawRectangle(rect, borderDx, 1f);
                        RenderTarget.DrawLine(lineStart, lineEnd, borderDx);

                        RenderTarget.DrawTextLayout(textPos, layout, textDx, SharpDX.Direct2D1.DrawTextOptions.NoSnap);
                        layout.Dispose();
                    }
                }
            }
            catch (Exception ex)
            {
                LogVerbose(LogLevelSetting.ERROR, "OnRender", $"Render exception: {ex.GetType().Name} - {ex.Message}");
            }
        }

        private float MeasureTextWidth(SimpleFont font, string text)
        {
            var tf = font.ToDirectWriteTextFormat();
            using (var tl = new SharpDX.DirectWrite.TextLayout(
                NinjaTrader.Core.Globals.DirectWriteFactory,
                text,
                tf,
                ChartPanel.X + ChartPanel.W,
                tf.FontSize))
            {
                return tl.Metrics.Width;
            }
        }

        private void ForceRefresh()
        {
            var dispatcher = ChartControl?.Dispatcher;
            if (dispatcher == null)
                return;

            dispatcher.InvokeAsync(() =>
            {
                try { ChartControl?.InvalidateVisual(); } catch { }
            });
        }
        #endregion

        #region Logging
        private void LogVerbose(LogLevelSetting level, string context, string message)
        {
            if (!EnableVerboseLog)
                return;

            if (!ShouldLog(level))
                return;

            string instrument = Instrument?.FullName ?? "n/a";
            string bars = BarsPeriod == null ? "n/a" : $"{BarsPeriod.Value} {BarsPeriod.BarsPeriodType}";
            string chartId = ChartControl?.OwnerChart?.GetHashCode().ToString() ?? "n/a";
            string account = selectedAccount?.Name ?? "n/a";
            string threadLabel = GetThreadLabel();
            string timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff");

            string log = $"[{timestamp}] [HawkOrderDecorator] [{level}] [{context}] " +
                         $"Instrument={instrument} Bars={bars} ChartId={chartId} Account={account} " +
                         $"Thread={threadLabel} Message={message}";
            try
            {
                Print(log);
            }
            catch { }
        }

        private void LogVerboseThrottled(LogLevelSetting level, string context, string message)
        {
            if (!EnableVerboseLog)
                return;

            if (!ShouldLog(level))
                return;

            if (level == LogLevelSetting.DEBUG)
            {
                long nowTicks = DateTime.UtcNow.Ticks;
                long lastTicks = Interlocked.Read(ref lastComputeLogTicks);
                if (nowTicks - lastTicks < TimeSpan.FromMilliseconds(computeValuesDebugThrottleMs).Ticks)
                    return;
                Interlocked.Exchange(ref lastComputeLogTicks, nowTicks);
            }

            LogVerbose(level, context, message);
        }

        private bool ShouldLog(LogLevelSetting level)
        {
            int requested = GetLogRank(LogLevel);
            int current = GetLogRank(level);

            return current >= requested;
        }

        private int GetLogRank(LogLevelSetting level)
        {
            return level switch
            {
                LogLevelSetting.DEBUG => 1,
                LogLevelSetting.INFO => 2,
                LogLevelSetting.WARN => 3,
                LogLevelSetting.ERROR => 4,
                _ => 2
            };
        }

        private string GetThreadLabel()
        {
            try
            {
                var dispatcher = ChartControl?.Dispatcher;
                if (dispatcher != null && dispatcher.CheckAccess())
                    return "UI";
            }
            catch { }

            try
            {
                return $"Worker:{Thread.CurrentThread.ManagedThreadId}";
            }
            catch
            {
                return "Worker";
            }
        }
        #endregion

