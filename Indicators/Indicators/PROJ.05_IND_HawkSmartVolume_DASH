    /// <summary>
    /// Hawk Smart Volume indicator (Indicador Hawk Smart Volume).
    /// </summary>
    public class HawkSamartVolume : Indicator
    {
        #region Variables
        private int volumeThresholdLevel1 = 900;
        private int volumeThresholdLevel2 = 1500;
        private int volumeThresholdLevel3 = 2500;
        private int timeWindowSeconds = 1;
        private Brush level1Brush = Brushes.RoyalBlue;
        private Brush level2Brush = Brushes.DarkMagenta;
        private Brush level3Brush = Brushes.Gold;
        private Brush textBrush = Brushes.DarkGray;
        private Brush shadowBrush = Brushes.Red;
        private int ellipseOpacity = 1;
        private bool enableAlerts = true;
        private bool showEllipses = true;
        private bool showTime = false;
        private string alertSoundFile = "Alert4.wav";
        #endregion

        /// <summary>
        /// This method is used to configure the indicator and is called once before any bar data is loaded.
        /// </summary>
        private void Initialize()
        {
            Calculate = Calculate.OnBarClose;
            IsOverlay = true;
        }

        protected override void OnStateChange()
        {
            switch (State)
            {
                case State.SetDefaults:
                    Name = "Hawk Smart Volume";
                    Description = "Hawk Smart Volume - Detects large trade volumes with visual markers (Detecta grandes volumes com marcadores visuais).";
                    Initialize();
                    break;
            }

            if (State == State.Configure)
            {
                AddDataSeries(BarsPeriodType.Second, 1);
            }
        }

        /// <summary>
        /// Called on each bar update event (incoming tick).
        /// </summary>
        protected override void OnBarUpdate()
        {
            if (CurrentBar < 2)
                return;

            if (BarsInProgress == 1)
            {
                TimeSpan ts1 = Time[0] - new DateTime(1970, 1, 1, 0, 0, 0);
                TimeSpan ts2 = Time[1] - new DateTime(1970, 1, 1, 0, 0, 0);
                int timeGap = (int)ts1.TotalSeconds - (int)ts2.TotalSeconds;

                if (Math.Abs(timeGap) <= timeWindowSeconds)
                {
                    if (Volume[0] >= volumeThresholdLevel3)
                    {
                        if (showEllipses)
                            Draw.Ellipse(this, "ellipse" + CurrentBar, true, 3, High[0], -3, Low[0], level3Brush, shadowBrush, ellipseOpacity);

                        DrawLevelText();
                    }
                    else if (Volume[0] >= volumeThresholdLevel2)
                    {
                        if (showEllipses)
                            Draw.Ellipse(this, "ellipse" + CurrentBar, true, 3, High[0], -3, Low[0], level2Brush, shadowBrush, ellipseOpacity);

                        DrawLevelText();
                    }
                    else if (Volume[0] >= volumeThresholdLevel1)
                    {
                        if (showEllipses)
                            Draw.Ellipse(this, "ellipse" + CurrentBar, true, 3, High[0], -3, Low[0], level1Brush, shadowBrush, ellipseOpacity);

                        DrawLevelText();
                    }
                }
            }
        }

        private void DrawLevelText()
        {
            string textToShow = showTime ? Convert.ToString(Time[0]) : Convert.ToString(Volume[0]);
            Draw.Text(
                this,
                "TFx" + CurrentBar,
                true,
                textToShow,
                5,
                Median[0],
                0,
                textBrush,
                new SimpleFont("Small Fonts", 9),
                TextAlignment.Right,
                Brushes.Transparent,
                Brushes.Transparent,
                0);
        }

        #region Properties
        [NinjaScriptProperty]
        [Display(
            Name = "Volume Threshold Level 1 (Limite mínimo de volume – Nível 1)",
            Description = "Minimum volume threshold for level 1 (Limite mínimo de volume – Nível 1).",
            GroupName = "Volume Thresholds",
            Order = 1)]
        public int VolumeThresholdLevel1
        {
            get { return volumeThresholdLevel1; }
            set { volumeThresholdLevel1 = Math.Max(1, value); }
        }

        [NinjaScriptProperty]
        [Display(
            Name = "Volume Threshold Level 2 (Limite mínimo de volume – Nível 2)",
            Description = "Minimum volume threshold for level 2 (Limite mínimo de volume – Nível 2).",
            GroupName = "Volume Thresholds",
            Order = 2)]
        public int VolumeThresholdLevel2
        {
            get { return volumeThresholdLevel2; }
            set { volumeThresholdLevel2 = Math.Max(1, value); }
        }

        [NinjaScriptProperty]
        [Display(
            Name = "Volume Threshold Level 3 (Limite mínimo de volume – Nível 3)",
            Description = "Minimum volume threshold for level 3 (Limite mínimo de volume – Nível 3).",
            GroupName = "Volume Thresholds",
            Order = 3)]
        public int VolumeThresholdLevel3
        {
            get { return volumeThresholdLevel3; }
            set { volumeThresholdLevel3 = Math.Max(1, value); }
        }

        [NinjaScriptProperty]
        [Display(
            Name = "Time Window (Janela de tempo)",
            Description = "Time window in seconds for trade alignment (Janela de tempo em segundos para alinhamento das transações).",
            GroupName = "Time Window",
            Order = 4)]
        public int TimeWindowSeconds
        {
            get { return timeWindowSeconds; }
            set { timeWindowSeconds = Math.Max(1, value); }
        }

        [NinjaScriptProperty]
        [XmlIgnore]
        [Display(
            Name = "Level 1 Ellipse Color (Cor da elipse – Nível 1)",
            Description = "Ellipse color for level 1 (Cor da elipse – Nível 1).",
            GroupName = "Visual Settings",
            Order = 5)]
        public Brush Level1Brush
        {
            get { return level1Brush; }
            set { level1Brush = value; }
        }

        [NinjaScriptProperty]
        [XmlIgnore]
        [Display(
            Name = "Level 2 Ellipse Color (Cor da elipse – Nível 2)",
            Description = "Ellipse color for level 2 (Cor da elipse – Nível 2).",
            GroupName = "Visual Settings",
            Order = 6)]
        public Brush Level2Brush
        {
            get { return level2Brush; }
            set { level2Brush = value; }
        }

        [NinjaScriptProperty]
        [XmlIgnore]
        [Display(
            Name = "Level 3 Ellipse Color (Cor da elipse – Nível 3)",
            Description = "Ellipse color for level 3 (Cor da elipse – Nível 3).",
            GroupName = "Visual Settings",
            Order = 7)]
        public Brush Level3Brush
        {
            get { return level3Brush; }
            set { level3Brush = value; }
        }

        [Browsable(false)]
        public string Level1BrushSerialize
        {
            get { return Serialize.BrushToString(level1Brush); }
            set { level1Brush = Serialize.StringToBrush(value); }
        }

        [Browsable(false)]
        public string Level2BrushSerialize
        {
            get { return Serialize.BrushToString(level2Brush); }
            set { level2Brush = Serialize.StringToBrush(value); }
        }

        [Browsable(false)]
        public string Level3BrushSerialize
        {
            get { return Serialize.BrushToString(level3Brush); }
            set { level3Brush = Serialize.StringToBrush(value); }
        }

        [NinjaScriptProperty]
        [XmlIgnore]
        [Display(
            Name = "Text Color (Cor do texto)",
            Description = "Color used for text labels (Cor usada para os textos).",
            GroupName = "Visual Settings",
            Order = 8)]
        public Brush TextBrush
        {
            get { return textBrush; }
            set { textBrush = value; }
        }

        [Browsable(false)]
        public string TextBrushSerialize
        {
            get { return Serialize.BrushToString(TextBrush); }
            set { TextBrush = Serialize.StringToBrush(value); }
        }

        [NinjaScriptProperty]
        [XmlIgnore]
        [Display(
            Name = "Show Ellipses (Exibir elipses)",
            Description = "Enable ellipse markers on chart (Ativar marcações de elipse no gráfico).",
            GroupName = "Visual Settings",
            Order = 9)]
        public bool ShowEllipses
        {
            get { return showEllipses; }
            set { showEllipses = value; }
        }

        [NinjaScriptProperty]
        [Display(
            Name = "Show Time Instead of Volume (Mostrar horário em vez do volume)",
            Description = "Display trade time instead of volume value (Mostrar horário da transação no lugar do volume).",
            GroupName = "Visual Settings",
            Order = 10)]
        public bool ShowTime
        {
            get { return showTime; }
            set { showTime = value; }
        }

        [NinjaScriptProperty]
        [Display(
            Name = "Enable Alerts (Habilitar alertas)",
            Description = "Reserved for future versions (Reservado para versões futuras).",
            GroupName = "Advanced / Reserved",
            Order = 11)]
        public bool EnableAlerts
        {
            get { return enableAlerts; }
            set { enableAlerts = value; }
        }

        [NinjaScriptProperty]
        [Display(
            Name = "Alert Sound File (Arquivo de som do alerta)",
            Description = "Reserved for future versions (Reservado para versões futuras).",
            GroupName = "Advanced / Reserved",
            Order = 12)]
        public string AlertSoundFile
        {
            get { return alertSoundFile; }
            set { alertSoundFile = value; }
        }
        #endregion
    }
}

