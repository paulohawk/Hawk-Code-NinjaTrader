        protected override void OnStateChange()
        {
            switch (State)
            {
                case State.SetDefaults:
                    Name = "HawkSmartVolume";
                    Description = "Hawk Smart Volume - Detects large trade volumes with visual markers.";
                    Calculate = Calculate.OnEachTick;
                    IsOverlay = true;
                    BarsRequiredToPlot = 2;
                    // ===== Visual Defaults (Paper 02 – FINAL & LOCKED) =====
                    level1Brush = new SolidColorBrush(Colors.DimGray);       level1Brush.Freeze();
                    level2Brush = new SolidColorBrush(Colors.DarkGoldenrod); level2Brush.Freeze();
                    level3Brush = new SolidColorBrush(Colors.SaddleBrown);   level3Brush.Freeze();
                    textBrush = Brushes.DarkGray.Clone();                    textBrush.Freeze();

                    showPrintMarkers = true;
                    showTime = false;

                    markerScale = 2.0;
                    markerOpacity = 30;

                    markerFontSizeLevel1 = 12;
                    markerFontSizeLevel2 = 16;
                    markerFontSizeLevel3 = 20;
                    showInfoPanel = true;
                    enableTradeLocation = false;
                    tlThickness = 1;
                    tlExtendYears = 1;
                    break;
            }

            if (State == State.Configure)
            {
                AddDataSeries(BarsPeriodType.Second, 1);
            }
            else if (State == State.Terminated)
            {
                DisposeDx();
            }
        }

        /// <summary>
        /// Called on each bar update event (incoming tick).
        /// </summary>
        protected override void OnBarUpdate()
        {
            // Guarda mínima por série (evita Time[1], Volume[0] etc. inválidos)
            if (BarsInProgress == 0)
            {
                if (CurrentBars[0] < 2)
                    return;
            }
            else if (BarsInProgress == 1)
            {
                if (CurrentBars[1] < 2)     // precisa existir [0] e [1] na série secundária
                    return;
            }
            else
            {
                return;
            }

            if (BarsInProgress == 1)
            {
                if (debugDraw)
                {
                    Print($"[HSV][DBG] BIP={BarsInProgress} | CB0={CurrentBars[0]} | CB1={(BarsArray.Length > 1 ? CurrentBars[1] : -1)} | Time={Time[0]:HH:mm:ss} | Vol={Volume[0]}");
                }

                TimeSpan ts1 = Time[0] - new DateTime(1970, 1, 1, 0, 0, 0);
                TimeSpan ts2 = Time[1] - new DateTime(1970, 1, 1, 0, 0, 0);
                int timeGap = (int)ts1.TotalSeconds - (int)ts2.TotalSeconds;

                if (Math.Abs(timeGap) <= timeWindowSeconds)
                {
                    int level = 0;
                    double vol = Volume[0];
                    if (vol >= volumeThresholdLevel3)
                    {
                        level = 3;
                    }
                    else if (vol >= volumeThresholdLevel2)
                    {
                        level = 2;
                    }
                    else if (vol >= volumeThresholdLevel1)
                    {
                        level = 1;
                    }

                    if (level > 0)
                    {
                        DebugLog($"Level {level} triggered | Threshold OK | Enqueuing event");
                        var ev = new PrintEvent
                        {
                            Time = Time[0],
                            Price = Close[0],
                            Level = level,
                            Volume = Volume[0]
                        };

                        lastPrintLevel = ev.Level;
                        lastPrintTime = ev.Time;

                        if (currentSessionDate.Date != ev.Time.Date)
                        {
                            currentSessionDate = ev.Time.Date;
                            maxDayVolume = 0;
                            maxDayLevel = 0;
                            maxDayPrice = double.NaN;
                            maxDayTime = DateTime.MinValue;
                        }

                        if (ev.Volume > maxDayVolume)
                        {
                            maxDayVolume = ev.Volume;
                            maxDayLevel = ev.Level;
                            maxDayPrice = ev.Price;
                            maxDayTime = ev.Time;
                        }

                        pending.Enqueue(ev);
                        while (pending.Count > maxPending)
                            pending.Dequeue();
                    }
                }
            }

            if (BarsInProgress == 0)
            {
                if (Bars.IsFirstBarOfSession)
                    ClearTradeLocations();

                if (debugDraw)
                {
                    Print($"[HSV][DBG] BIP={BarsInProgress} | CB0={CurrentBars[0]} | CB1={(BarsArray.Length > 1 ? CurrentBars[1] : -1)} | Time={Time[0]:HH:mm:ss} | Vol={Volume[0]}");
                }

                int maxPerTick = 3;
                while (pending.Count > 0 && maxPerTick-- > 0)
                {
                    var ev = pending.Dequeue();

                    int barIdx = BarsArray[0].GetBar(ev.Time);
                    if (barIdx < 0)
                        barIdx = BarsArray[0].GetBar(Time[0]);

                    if (barIdx < 0)
                    {
                        DebugLog("DROP | Reason=InvalidBarsAgo | BarsAgo=-1");
                        continue;
                    }

                    int barsAgo = CurrentBar - barIdx;
                    if (barsAgo < 0 || barsAgo > CurrentBar)
                    {
                        DebugLog($"DROP | Reason=InvalidBarsAgo | BarsAgo={barsAgo}");
                        continue;
                    }

                    DebugLog(
                      $"EVENT | Level={ev.Level} | Vol={ev.Volume} | " +
                      $"EventTime={ev.Time:HH:mm:ss.fff} | BarIdx={barIdx} | BarsAgo={barsAgo}"
                    );
                    Brush brush =
                        ev.Level == 3 ? level3Brush :
                        ev.Level == 2 ? level2Brush :
                                        level1Brush;

                    bool drawn = false;

                    if (showPrintMarkers)
                        drawn = DrawPrintMarker_OnPrimary(
                            ev.Level,
                            brush,
                            ev.Price,
                            barsAgo,
                            ev.Time
                        );

                    if (drawn)
                    {
                        DrawLevelText_OnPrimary(ev.Level, ev.Price, barsAgo, ev.Time, ev.Volume);
                        TriggerAlert(ev.Level, brush, ev.Time);

                        if (enableTradeLocation)
                            CreateTradeLocation(ev);
                    }
                }

                UpdateInfoPanelText();
            }
        }

        private void UpdateInfoPanelText()
        {
            if (!showInfoPanel)
            {
                infoPanelText = string.Empty;
                return;
            }

            int minutesAgo = Math.Max(
                1,
                (int)Math.Floor((DateTime.Now - lastPrintTime).TotalMinutes)
            );

            string line1 = lastPrintTime == DateTime.MinValue
                ? "Fluxo: -"
                : $"Fluxo: Nível {lastPrintLevel} | Último print há {minutesAgo} min";

            string line2 =
                $"Filtro: {VolumeThresholdLevel1} / {VolumeThresholdLevel2} / {VolumeThresholdLevel3}";

            string line3 = maxDayVolume <= 0
                ? "Maior print: -"
                : $"Maior print: L{maxDayLevel} | {maxDayVolume:N0} | {maxDayPrice:N2} | {maxDayTime:HH:mm}";

            infoPanelText = $"{line1}\n{line2}\n{line3}";
        }

        private void DrawLevelText_OnPrimary(int level, double price, int barsAgo, DateTime eventTime, double eventVolume)
        {
            string textToShow = showTime ? Convert.ToString(eventTime) : Convert.ToString(eventVolume);
            Brush invisibleStroke = CreateInvisibleStroke();
            Brush textOpacityBrush = textBrush.Clone();
            textOpacityBrush.Opacity = 1.0 - (markerOpacity / 100.0);
            textOpacityBrush.Freeze();
            string tagKey = $"{CurrentBar}_{barsAgo}_{eventTime.Ticks}";
            // Default font — subject to refinement in future versions.
            Draw.Text(
                this,
                $"HSV_TX_{tagKey}",
                false,
                textToShow,
                barsAgo,
                price,
                0,
                textOpacityBrush,
                new SimpleFont("Segoe UI", 9),
                TextAlignment.Right,
                invisibleStroke,
                invisibleStroke,
                0);
        }

        private bool DrawPrintMarker_OnPrimary(int level, Brush levelBrush, double price, int barsAgo, DateTime eventTime)
        {
            try
            {
                DebugLog($"DrawPrintMarker START | Level={level} | BarsAgo={barsAgo}");
                if (barsAgo < 0 || barsAgo > CurrentBar)
                {
                    DebugLog($"DROP | Reason=InvalidBarsAgo | BarsAgo={barsAgo}");
                    return false;
                }

                // ================================
                // KELCH BULLET MARKER (Paper 02.3)
                // ================================
                int baseSize =
                    level == 1 ? markerFontSizeLevel1 :
                    level == 2 ? markerFontSizeLevel2 :
                                 markerFontSizeLevel3;

                int finalSize = Math.Max(6, (int)Math.Round(baseSize * markerScale));

                if (level == 1)
                {
                    if (markerFontL1 == null || Math.Abs(markerFontL1.Size - finalSize) > double.Epsilon)
                        markerFontL1 = new SimpleFont("Arial", finalSize);
                }
                else if (level == 2)
                {
                    if (markerFontL2 == null || Math.Abs(markerFontL2.Size - finalSize) > double.Epsilon)
                        markerFontL2 = new SimpleFont("Arial", finalSize);
                }
                else
                {
                    if (markerFontL3 == null || Math.Abs(markerFontL3.Size - finalSize) > double.Epsilon)
                        markerFontL3 = new SimpleFont("Arial", finalSize);
                }

                SimpleFont font =
                    level == 1 ? markerFontL1 :
                    level == 2 ? markerFontL2 :
                                 markerFontL3;

                string tag = $"HSV_PM_BULLET_{level}_{CurrentBar}_{barsAgo}_{eventTime.Ticks}";

                DebugLog($"DRAW | Type=BulletText | Level={level} | BarsAgo={barsAgo} | Price={price:F2} | Font={finalSize}");

                Brush bulletBrush = levelBrush.Clone();
                bulletBrush.Opacity = 1.0 - (markerOpacity / 100.0);
                bulletBrush.Freeze();

                Draw.Text(
                    this,
                    tag,
                    false,
                    "●",
                    barsAgo,
                    price,
                    0,
                    bulletBrush,
                    font,
                    TextAlignment.Center,
                    Brushes.Transparent,
                    Brushes.Transparent,
                    0);

                DebugLog("DrawPrintMarker END");
                return true;
            }
            catch (Exception ex)
            {
                Print($"[HSV][ERROR][DrawPrintMarker] {ex.Message}");
                return false;
            }
        }

        private void DebugLog(string message)
        {
            if (!debugDraw)
                return;

            Print($"[HSV][DRAW][{BarsInProgress}][Bar:{CurrentBar}] {message}");
        }

        private void CreateTradeLocation(PrintEvent ev)
        {
            string tag = $"HSV_TL_L{ev.Level}_{ev.Time.Ticks}";

            // PROTEÇÃO: evita criar TL duplicada para o mesmo evento
            if (tradeLocations.Any(t => t.Tag == tag))
                return;

            DateTime endTime = Bars.GetTime(CurrentBar).AddDays(1);

            Brush brush =
                ev.Level == 3 ? level3Brush :
                ev.Level == 2 ? level2Brush :
                                level1Brush;

            Draw.Line(
                this,
                tag,
                false,
                ev.Time,
                ev.Price,
                endTime,
                ev.Price,
                brush,
                DashStyleHelper.Solid,
                tlThickness
            );

            tradeLocations.Add(new TradeLocation
            {
                Tag = tag,
                Time = ev.Time,
                Price = ev.Price,
                Level = ev.Level
            });
        }

        private void ClearTradeLocations()
        {
            foreach (var tl in tradeLocations)
            {
                try { RemoveDrawObject(tl.Tag); } catch { }
            }
            tradeLocations.Clear();
        }

        private Brush CreateInvisibleStroke()
        {
            Brush invisibleStroke = Brushes.Black.Clone();
            invisibleStroke.Opacity = 0;
            if (invisibleStroke is SolidColorBrush solidStroke)
            {
                solidStroke.Color = System.Windows.Media.Color.FromArgb(1, 0, 0, 0);
            }

            return invisibleStroke;
        }

        public override void OnRenderTargetChanged()
        {
            DisposeDx();

            if (RenderTarget != null)
            {
                _dwriteFactory = new DW.Factory();

                _textFormat = new DW.TextFormat(_dwriteFactory, PanelFont, PanelFontSize)
                {
                    TextAlignment = DW.TextAlignment.Leading,
                    ParagraphAlignment = DW.ParagraphAlignment.Near
                };

                _dxBorderBrush = new D2D.SolidColorBrush(RenderTarget, ToColor4(Media.Color.FromArgb(0xFF, 0xD4, 0xA0, 0x17)));
                _dxTextBrush = new D2D.SolidColorBrush(RenderTarget, ToColor4(Media.Color.FromArgb(0xE6, 0xCC, 0xCC, 0xCC)));

                var stops = new[]
                {
                    new D2D.GradientStop { Color = ToColor4(Media.Color.FromArgb(0xC0, 0x50, 0x50, 0x50)), Position = 0.0f },
                    new D2D.GradientStop { Color = ToColor4(Media.Color.FromArgb(0xB4, 0x28, 0x28, 0x28)), Position = 1.0f }
                };
                _dxGradientStops = new D2D.GradientStopCollection(RenderTarget, stops, D2D.Gamma.StandardRgb, D2D.ExtendMode.Clamp);

                _dxGradientBrush = new D2D.LinearGradientBrush(
                    RenderTarget,
                    new D2D.LinearGradientBrushProperties
                    {
                        StartPoint = new Vector2(0f, 0f),
                        EndPoint = new Vector2(0f, 1f)
                    },
                    _dxGradientStops);

                _dxHighlightBrush = new D2D.SolidColorBrush(RenderTarget, ToColor4(Media.Color.FromArgb(0x30, 0xFF, 0xFF, 0xFF)));
            }

            base.OnRenderTargetChanged();
        }

        protected override void OnRender(ChartControl chartControl, ChartScale chartScale)
        {
            base.OnRender(chartControl, chartScale);

            if (!showInfoPanel || string.IsNullOrEmpty(infoPanelText))
                return;

            if (RenderTarget == null || ChartPanel == null)
                return;

            using (var textLayout = new DW.TextLayout(_dwriteFactory, infoPanelText, _textFormat, float.MaxValue, float.MaxValue))
            {
                float boxW = (float)textLayout.Metrics.Width + 2f * PanelPadding;
                float boxH = (float)textLayout.Metrics.Height + 2f * PanelPadding;

                float x = (float)Math.Floor(ChartPanel.X + PanelMargin) + 0.5f;
                float y = (float)Math.Floor(ChartPanel.Y + ChartPanel.H - PanelLift - boxH) + 0.5f;

                var rect = new D2D.RoundedRectangle
                {
                    Rect = new RectangleF(x, y, boxW, boxH),
                    RadiusX = PanelCornerRadius,
                    RadiusY = PanelCornerRadius
                };

                if (_dxGradientBrush != null)
                {
                    _dxGradientBrush.StartPoint = new Vector2(x, y);
                    _dxGradientBrush.EndPoint = new Vector2(x, y + boxH);
                }

                RenderTarget.FillRoundedRectangle(rect, _dxGradientBrush);
                RenderTarget.DrawLine(new Vector2(x + PanelCornerRadius, y + 1f), new Vector2(x + boxW - PanelCornerRadius, y + 1f), _dxHighlightBrush, 1.0f);
                RenderTarget.DrawRoundedRectangle(rect, _dxBorderBrush, 1.4f);

                float textX = x + PanelPadding;
                float textY = y + PanelPadding;
                RenderTarget.DrawTextLayout(new Vector2(textX, textY), textLayout, _dxTextBrush, D2D.DrawTextOptions.None);
            }
        }

        private static Color4 ToColor4(Media.Color c)
        {
            return new Color4(c.ScR, c.ScG, c.ScB, c.ScA);
        }

        private void DisposeDx()
        {
            try
            {
                _dxBorderBrush?.Dispose();
                _dxTextBrush?.Dispose();
                _dxGradientBrush?.Dispose();
                _dxGradientStops?.Dispose();
                _dxHighlightBrush?.Dispose();
                _textFormat?.Dispose();
                _dwriteFactory?.Dispose();
            }
            catch
            {
            }
            finally
            {
                _dxBorderBrush = null;
                _dxTextBrush = null;
                _dxGradientBrush = null;
                _dxGradientStops = null;
                _dxHighlightBrush = null;
                _textFormat = null;
                _dwriteFactory = null;
            }
        }

