        /// <summary>
        /// This method is used to configure the indicator and is called once before any bar data is loaded.
        /// </summary>
        private void Initialize()
        {
            Calculate = Calculate.OnEachTick;
            IsOverlay = true;
        }

        protected override void OnStateChange()
        {
            switch (State)
            {
                case State.SetDefaults:
                    Name = "Hawk Smart Volume";
                    Description = "Hawk Smart Volume - Detects large trade volumes with visual markers (Detecta grandes volumes com marcadores visuais).";
                    level1Brush = ResolveDefaultLevel1Brush();
                    level2Brush = new SolidColorBrush(Colors.DimGray);
                    level3Brush = new SolidColorBrush(Colors.DarkGoldenrod);
                    textBrush = Brushes.DarkGray;
                    Initialize();
                    break;
            }

            if (State == State.Configure)
            {
                AddDataSeries(BarsPeriodType.Second, 1);
            }
        }

        /// <summary>
        /// Called on each bar update event (incoming tick).
        /// </summary>
        protected override void OnBarUpdate()
        {
            // Guarda mínima por série (evita Time[1], Volume[0] etc. inválidos)
            if (BarsInProgress == 0)
            {
                if (CurrentBars[0] < 2)
                    return;
            }
            else if (BarsInProgress == 1)
            {
                if (CurrentBars[1] < 2)     // precisa existir [0] e [1] na série secundária
                    return;
            }
            else
            {
                return;
            }

            if (BarsInProgress == 1)
            {
                if (debugDraw)
                {
                    Print($"[HSV][DBG] BIP={BarsInProgress} | CB0={CurrentBars[0]} | CB1={(BarsArray.Length > 1 ? CurrentBars[1] : -1)} | Time={Time[0]:HH:mm:ss} | Vol={Volume[0]}");
                }

                TimeSpan ts1 = Time[0] - new DateTime(1970, 1, 1, 0, 0, 0);
                TimeSpan ts2 = Time[1] - new DateTime(1970, 1, 1, 0, 0, 0);
                int timeGap = (int)ts1.TotalSeconds - (int)ts2.TotalSeconds;

                if (Math.Abs(timeGap) <= timeWindowSeconds)
                {
                    int level = 0;
                    if (Volume[0] >= volumeThresholdLevel3)
                    {
                        level = 3;
                    }
                    else if (Volume[0] >= volumeThresholdLevel2)
                    {
                        level = 2;
                    }
                    else if (Volume[0] >= volumeThresholdLevel1)
                    {
                        level = 1;
                    }

                    if (level > 0)
                    {
                        DebugLog($"Level {level} triggered | Threshold OK | Enqueuing event");
                        var ev = new PrintEvent
                        {
                            Time = Time[0],
                            Price = Close[0],
                            Level = level,
                            Volume = Volume[0]
                        };

                        pending.Enqueue(ev);
                        while (pending.Count > maxPending)
                            pending.Dequeue();
                    }
                }
            }

            if (BarsInProgress == 0)
            {
                if (debugDraw)
                {
                    Print($"[HSV][DBG] BIP={BarsInProgress} | CB0={CurrentBars[0]} | CB1={(BarsArray.Length > 1 ? CurrentBars[1] : -1)} | Time={Time[0]:HH:mm:ss} | Vol={Volume[0]}");
                }

                if (pending.Count == 0)
                    // Single-event-per-tick design: return if nothing to process for this primary bar.
                    return;

                var ev = pending.Dequeue();

                int barIdx = BarsArray[0].GetBar(ev.Time);
                if (barIdx < 0)
                    barIdx = BarsArray[0].GetBar(Time[0]);

                if (barIdx < 0)
                {
                    DebugLog("DROP | Reason=InvalidBarsAgo | BarsAgo=-1");
                    return;
                }

                int barsAgo = CurrentBar - barIdx;
                if (barsAgo < 0)
                {
                    DebugLog($"DROP | Reason=InvalidBarsAgo | BarsAgo={barsAgo}");
                    return;
                }

                if (barsAgo > CurrentBar)
                {
                    DebugLog($"DROP | Reason=InvalidBarsAgo | BarsAgo={barsAgo}");
                    return;
                }

                DebugLog(
                  $"EVENT | Level={ev.Level} | Vol={ev.Volume} | " +
                  $"EventTime={ev.Time:HH:mm:ss.fff} | BarIdx={barIdx} | BarsAgo={barsAgo}"
                );

                Brush brush = ev.Level == 3 ? level3Brush : ev.Level == 2 ? level2Brush : level1Brush;

                bool drawn = false;
                if (showPrintMarkers)
                    drawn = DrawPrintMarker_OnPrimary(ev.Level, brush, ev.Price, barsAgo, ev.Time);

                if (drawn)
                {
                    DrawLevelText_OnPrimary(ev.Level, ev.Price, barsAgo, ev.Time, ev.Volume);
                    TriggerAlert(ev.Level, brush, ev.Time);
                }
            }
        }

        private void DrawLevelText_OnPrimary(int level, double price, int barsAgo, DateTime eventTime, double eventVolume)
        {
            string textToShow = showTime ? Convert.ToString(eventTime) : Convert.ToString(eventVolume);
            Brush invisibleStroke = CreateInvisibleStroke();
            string tagKey = $"{CurrentBar}_{barsAgo}_{eventTime.Ticks}";
            // Default font — subject to refinement in future versions.
            Draw.Text(
                this,
                $"HSV_TX_{tagKey}",
                false,
                textToShow,
                barsAgo,
                price,
                0,
                textBrush,
                new SimpleFont("Small Fonts", 9),
                TextAlignment.Right,
                invisibleStroke,
                invisibleStroke,
                0);
        }

        private bool DrawPrintMarker_OnPrimary(int level, Brush levelBrush, double price, int barsAgo, DateTime eventTime)
        {
            try
            {
                DebugLog($"DrawPrintMarker START | Level={level} | BarsAgo={barsAgo}");
                if (barsAgo < 0 || barsAgo > CurrentBar)
                {
                    DebugLog($"DROP | Reason=InvalidBarsAgo | BarsAgo={barsAgo}");
                    return false;
                }

                // ================================
                // KELCH BULLET MARKER (Paper 02.3)
                // ================================
                int baseSize =
                    level == 1 ? markerFontSizeLevel1 :
                    level == 2 ? markerFontSizeLevel2 :
                                 markerFontSizeLevel3;

                int finalSize = Math.Max(6, (int)Math.Round(baseSize * markerScale));

                if (level == 1)
                {
                    if (markerFontL1 == null || Math.Abs(markerFontL1.Size - finalSize) > double.Epsilon)
                        markerFontL1 = new SimpleFont("Arial", finalSize);
                }
                else if (level == 2)
                {
                    if (markerFontL2 == null || Math.Abs(markerFontL2.Size - finalSize) > double.Epsilon)
                        markerFontL2 = new SimpleFont("Arial", finalSize);
                }
                else
                {
                    if (markerFontL3 == null || Math.Abs(markerFontL3.Size - finalSize) > double.Epsilon)
                        markerFontL3 = new SimpleFont("Arial", finalSize);
                }

                SimpleFont font =
                    level == 1 ? markerFontL1 :
                    level == 2 ? markerFontL2 :
                                 markerFontL3;

                string tag = $"HSV_PM_BULLET_{level}_{CurrentBar}_{barsAgo}_{eventTime.Ticks}";

                DebugLog($"DRAW | Type=BulletText | Level={level} | BarsAgo={barsAgo} | Price={price:F2} | Font={finalSize}");

                Draw.Text(
                    this,
                    tag,
                    false,
                    "●",
                    barsAgo,
                    price,
                    0,
                    levelBrush,
                    font,
                    TextAlignment.Center,
                    Brushes.Transparent,
                    Brushes.Transparent,
                    0);

                DebugLog("DrawPrintMarker END");
                return true;
            }
            catch (Exception ex)
            {
                Print($"[HSV][ERROR][DrawPrintMarker] {ex.Message}");
                return false;
            }
        }

        private Brush ResolveDefaultLevel1Brush()
        {
            return new SolidColorBrush(Color.FromRgb(80, 80, 80));
        }

        private void DebugLog(string message)
        {
            if (!debugDraw)
                return;

            Print($"[HSV][DRAW][{BarsInProgress}][Bar:{CurrentBar}] {message}");
        }

        private Brush CreateInvisibleStroke()
        {
            Brush invisibleStroke = Brushes.Black.Clone();
            invisibleStroke.Opacity = 0;
            if (invisibleStroke is SolidColorBrush solidStroke)
            {
                solidStroke.Color = Color.FromArgb(1, 0, 0, 0);
            }

            return invisibleStroke;
        }

