        private void TriggerAlert(int level, Brush levelBrush, DateTime evTime)
        {
            if (debugDraw)
                Print($"[HSV][ALERT] Enter | Level={level} | Time={evTime:HH:mm:ss.fff}");

            if (!enableAlerts)
            {
                if (debugDraw) Print("[HSV][ALERT] Skipped | EnableAlerts=false");
                return;
            }

            if ((level == 1 && !alertLevel1Enabled) || (level == 2 && !alertLevel2Enabled) || (level == 3 && !alertLevel3Enabled))
            {
                if (debugDraw) Print("[HSV][ALERT] Skipped | Level disabled");
                return;
            }

            long eventKey = GetAlertEventKey(evTime);
            if (lastAlertEventKey == eventKey)
            {
                if (debugDraw) Print("[HSV][ALERT] Skipped | Duplicate eventKey");
                return;
            }

            lastAlertEventKey = eventKey;

            string soundToUse = SoundFileExists(alertSoundFile)
                ? alertSoundFile
                : "Alert1.wav";

            if (debugDraw)
                Print($"[HSV][ALERT] FIRE | Sound={soundToUse}");

            Alert(
                $"HSV_Alert_{level}_{eventKey}",
                Priority.High,
                $"Hawk Smart Volume - Level {level} print detected.",
                soundToUse,
                0,
                levelBrush,
                levelBrush);
        }

        private long GetAlertEventKey(DateTime evTime)
        {
            return ((long)BarsInProgress << 56) ^ evTime.Ticks;
        }

        private bool SoundFileExists(string fileName)
        {
            if (string.IsNullOrWhiteSpace(fileName))
                return false;

            string path = System.IO.Path.Combine(
                Core.Globals.UserDataDir,
                "sounds",
                fileName
            );

            return System.IO.File.Exists(path);
        }

