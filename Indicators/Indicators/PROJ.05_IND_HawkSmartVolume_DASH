    /// <summary>
    /// Hawk Smart Volume indicator (Indicador Hawk Smart Volume).
    /// </summary>
    public class HawkSamartVolume : Indicator
    {
        #region Variables
        private int volumeThresholdLevel1 = 900;
        private int volumeThresholdLevel2 = 1500;
        private int volumeThresholdLevel3 = 2500;
        private int timeWindowSeconds = 1;
        private Brush level1Brush = new SolidColorBrush(Color.FromRgb(80, 80, 80));
        private Brush level2Brush = new SolidColorBrush(Colors.DimGray);
        private Brush level3Brush = new SolidColorBrush(Colors.DarkGoldenrod);
        private Brush textBrush = Brushes.DarkGray;
        private bool enableAlerts = true;
        private bool alertLevel1Enabled = true;
        private bool alertLevel2Enabled = true;
        private bool alertLevel3Enabled = true;
        private bool showPrintMarkers = true;
        private bool showTime = false;
        private string alertSoundFile = "Alert4.wav";
        private double markerScale = 1.0;
        private bool useGradientFill = true;
        private long lastAlertEventKey = -1;
        #endregion

        /// <summary>
        /// This method is used to configure the indicator and is called once before any bar data is loaded.
        /// </summary>
        private void Initialize()
        {
            Calculate = Calculate.OnBarClose;
            IsOverlay = true;
        }

        protected override void OnStateChange()
        {
            switch (State)
            {
                case State.SetDefaults:
                    Name = "Hawk Smart Volume";
                    Description = "Hawk Smart Volume - Detects large trade volumes with visual markers (Detecta grandes volumes com marcadores visuais).";
                    level1Brush = new SolidColorBrush(Color.FromRgb(80, 80, 80));
                    level2Brush = new SolidColorBrush(Colors.DimGray);
                    level3Brush = new SolidColorBrush(Colors.DarkGoldenrod);
                    useGradientFill = false;
                    Initialize();
                    break;
            }

            if (State == State.Configure)
            {
                AddDataSeries(BarsPeriodType.Second, 1);
            }
        }

        /// <summary>
        /// Called on each bar update event (incoming tick).
        /// </summary>
        protected override void OnBarUpdate()
        {
            if (CurrentBar < 2)
                return;

            if (BarsInProgress == 1)
            {
                TimeSpan ts1 = Time[0] - new DateTime(1970, 1, 1, 0, 0, 0);
                TimeSpan ts2 = Time[1] - new DateTime(1970, 1, 1, 0, 0, 0);
                int timeGap = (int)ts1.TotalSeconds - (int)ts2.TotalSeconds;

                if (Math.Abs(timeGap) <= timeWindowSeconds)
                {
                    if (Volume[0] >= volumeThresholdLevel3)
                    {
                        if (showPrintMarkers)
                            DrawPrintMarker(3, level3Brush);

                        DrawLevelText();
                        TriggerAlert(3, level3Brush);
                    }
                    else if (Volume[0] >= volumeThresholdLevel2)
                    {
                        if (showPrintMarkers)
                            DrawPrintMarker(2, level2Brush);

                        DrawLevelText();
                        TriggerAlert(2, level2Brush);
                    }
                    else if (Volume[0] >= volumeThresholdLevel1)
                    {
                        if (showPrintMarkers)
                            DrawPrintMarker(1, level1Brush);

                        DrawLevelText();
                        TriggerAlert(1, level1Brush);
                    }
                }
            }
        }

        private void DrawLevelText()
        {
            string textToShow = showTime ? Convert.ToString(Time[0]) : Convert.ToString(Volume[0]);
            // Default font — subject to refinement in future versions.
            Draw.Text(
                this,
                $"HSV_TX_{CurrentBar}",
                true,
                textToShow,
                5,
                Median[0],
                0,
                textBrush,
                new SimpleFont("Small Fonts", 9),
                TextAlignment.Right,
                Brushes.Transparent,
                Brushes.Transparent,
                0);
        }

        private void DrawPrintMarker(int level, Brush levelBrush)
        {
            int baseSize = level == 1 ? 3 : level == 2 ? 4 : 5;
            int scaledSize = Math.Max(1, (int)Math.Round(baseSize * markerScale));
            int heightTicks = scaledSize * 2;

            double centerPrice = Median[0];
            double top = centerPrice + (heightTicks * TickSize);
            double bottom = centerPrice - (heightTicks * TickSize);

            // NOTE: No outline. We intentionally avoid any stroke to prevent border artifacts.
            // Build 3-layer radial overlay stack:
            // 1) Core (densest)
            // 2) Mid (fade)
            // 3) Highlight (small, slightly offset) for 3D depth
            byte coreAlpha = level == 3 ? (byte)225 : level == 2 ? (byte)200 : (byte)175;
            byte midAlpha = level == 3 ? (byte)130 : level == 2 ? (byte)105 : (byte)85;
            byte boostAmount = level == 3 ? (byte)42 : level == 2 ? (byte)28 : (byte)18;

            Brush core;
            Brush mid;
            Brush hi;
            var invisibleStroke = new SolidColorBrush(Color.FromArgb(1, 0, 0, 0));

            if (useGradientFill)
            {
                core = BuildOverlayBrushSafe(levelBrush, coreAlpha, boostAmount);
                mid = BuildOverlayBrushSafe(levelBrush, midAlpha, (byte)(boostAmount - 8));
                hi = BuildOverlayBrushSafe(levelBrush, (byte)(midAlpha + 10), (byte)(boostAmount + 12), highlight: true);
            }
            else
            {
                // Forced fallback: Solid overlays (guaranteed visible)
                Color baseColor = (levelBrush as SolidColorBrush)?.Color ?? Colors.White;

                Color cCore = BoostColor(baseColor, boostAmount, false);
                Color cMid = BoostColor(baseColor, (byte)Math.Max(0, boostAmount - 8), false);
                Color cHi = BoostColor(baseColor, (byte)Math.Min(255, boostAmount + 12), true);

                core = new SolidColorBrush(Color.FromArgb(coreAlpha, cCore.R, cCore.G, cCore.B));
                mid = new SolidColorBrush(Color.FromArgb(midAlpha, cMid.R, cMid.G, cMid.B));
                hi = new SolidColorBrush(Color.FromArgb((byte)(midAlpha + 10), cHi.R, cHi.G, cHi.B));
            }

            // Layer 1: Core (largest)
            Draw.Ellipse(
                this,
                $"HSV_PM_CORE_{level}_{CurrentBar}",
                true,
                scaledSize,
                top,
                -scaledSize,
                bottom,
                invisibleStroke,
                core,
                0);

            // Layer 2: Mid (slightly smaller)
            int midSize = Math.Max(1, scaledSize - 1);
            Draw.Ellipse(
                this,
                $"HSV_PM_MID_{level}_{CurrentBar}",
                true,
                midSize,
                top,
                -midSize,
                bottom,
                invisibleStroke,
                mid,
                0);

            // Layer 3: Highlight (small + subtle offset for 3D)
            int hiSize = Math.Max(1, scaledSize - 2);
            double hiTop = centerPrice + ((heightTicks - 1) * TickSize);
            double hiBottom = centerPrice - ((heightTicks - 3) * TickSize);

            Draw.Ellipse(
                this,
                $"HSV_PM_HI_{level}_{CurrentBar}",
                true,
                hiSize,
                hiTop,
                -hiSize,
                hiBottom,
                invisibleStroke,
                hi,
                0);
        }

        private Brush BuildRadialOverlayBrush(
            Brush baseBrush,
            byte centerAlpha,
            byte saturateBoost,
            bool highlight = false)
        {
            Color baseColor = (baseBrush as SolidColorBrush)?.Color ?? Colors.White;

            // Boost saturation/brightness slightly to keep level colors distinguishable on dark backgrounds,
            // especially bronze which otherwise collapses to gray under transparency.
            Color boosted = BoostColor(baseColor, saturateBoost, highlight);

            // Center is denser; edges dissolve.
            Color center = Color.FromArgb(centerAlpha, boosted.R, boosted.G, boosted.B);
            Color edge = Color.FromArgb(0, boosted.R, boosted.G, boosted.B);

            var gradient = new RadialGradientBrush();
            if (highlight)
            {
                gradient.GradientOrigin = new Point(0.35, 0.35);
                gradient.Center = new Point(0.35, 0.35);
            }
            else
            {
                // subtle asymmetry to avoid perfect rings
                gradient.GradientOrigin = new Point(0.48, 0.52);
                gradient.Center = new Point(0.50, 0.50);
            }
            gradient.RadiusX = highlight ? 0.45 : 0.55;
            gradient.RadiusY = highlight ? 0.45 : 0.55;
            gradient.GradientStops.Add(new GradientStop(center, 0.0));
            gradient.GradientStops.Add(new GradientStop(edge, 1.0));
            gradient.Freeze();

            return gradient;
        }

        private Brush BuildOverlayBrushSafe(
            Brush baseBrush,
            byte centerAlpha,
            byte saturateBoost,
            bool highlight = false)
        {
            // 1) Tenta RadialGradientBrush (premium)
            try
            {
                return BuildRadialOverlayBrush(baseBrush, centerAlpha, saturateBoost, highlight);
            }
            catch
            {
                // 2) Fallback: SolidColorBrush (garante render)
                Color baseColor = (baseBrush as SolidColorBrush)?.Color ?? Colors.White;
                Color boosted = BoostColor(baseColor, saturateBoost, highlight);
                return new SolidColorBrush(Color.FromArgb(centerAlpha, boosted.R, boosted.G, boosted.B));
            }
        }

        private Color BoostColor(Color color, byte boost, bool highlight)
        {
            int r = color.R;
            int g = color.G;
            int b = color.B;

            bool isGray = Math.Abs(r - g) < 8 && Math.Abs(g - b) < 8;

            if (isGray)
            {
                r = Math.Min(255, r + boost);
                g = Math.Min(255, g + boost);
                b = Math.Min(255, b + boost);
            }
            else
            {
                r = Math.Min(255, r + boost);
                g = Math.Min(255, g + (int)(boost * 0.75));
                b = Math.Min(255, b + (int)(boost * 0.15));
            }

            if (highlight)
            {
                r = Math.Min(255, r + 10);
                g = Math.Min(255, g + 10);
            }

            return Color.FromRgb((byte)r, (byte)g, (byte)b);
        }

        private void TriggerAlert(int level, Brush levelBrush)
        {
            if (!enableAlerts)
                return;

            if ((level == 1 && !alertLevel1Enabled) || (level == 2 && !alertLevel2Enabled) || (level == 3 && !alertLevel3Enabled))
                return;

            long eventKey = GetAlertEventKey();
            if (lastAlertEventKey == eventKey)
                return;

            lastAlertEventKey = eventKey;

            string message = $"Hawk Smart Volume - Level {level} print detected (Print nível {level} detectado).";
            Alert(
                $"HSV_Alert_{level}_{eventKey}",
                Priority.High,
                message,
                alertSoundFile,
                0,
                levelBrush,
                levelBrush);
        }

        private long GetAlertEventKey()
        {
            return ((long)BarsInProgress << 56) ^ Time[0].Ticks;
        }

