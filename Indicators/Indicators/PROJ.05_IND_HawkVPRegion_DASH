#region Using declarations
using System;
using System.ComponentModel;
using System.ComponentModel.DataAnnotations;
using System.Windows.Media;
using NinjaTrader.Code;
using NinjaTrader.Gui.Chart;
using NinjaTrader.Gui.Tools;
using NinjaTrader.NinjaScript;
using NinjaTrader.NinjaScript.Indicators.Hawk.Volume.Engine;
#endregion

//This namespace holds Drawing tools in this folder and is required. Do not change it. 
namespace NinjaTrader.NinjaScript.DrawingTools
{
	[CLSCompliant(false)]
	[EditorBrowsable(EditorBrowsableState.Always)]
	public class HawkVpRegion : RegionHighlightBase
	{
		private DateTime _lastPublishUtc = DateTime.MinValue;
		private DateTime _lastLogUtc = DateTime.MinValue;
		private int _chartKey;

		[NinjaScriptProperty]
		[Display(Name = "PublishRange", GroupName = "Parameters", Order = 1)]
		public bool PublishRange
		{ get; set; }

		[NinjaScriptProperty]
		[Range(1, int.MaxValue)]
		[Display(Name = "PublishThrottleMs", GroupName = "Parameters", Order = 2)]
		public int PublishThrottleMs
		{ get; set; }

		[NinjaScriptProperty]
		[Display(Name = "EnableToolLog", GroupName = "Parameters", Order = 3)]
		public bool EnableToolLog
		{ get; set; }

		protected override void OnStateChange()
		{
			base.OnStateChange();
			if (State == State.SetDefaults)
			{
				Name = "HawkVp Region";
				Mode = RegionHighlightMode.Time;
				PublishRange = true;
				PublishThrottleMs = 150;
				EnableToolLog = false;

				AreaBrush = Brushes.DimGray;
				AreaOpacity = 5;

				OutlineBrush = Brushes.Transparent;
				OutlineWidth = 2;
				OutlineOpacity = 100;
				OutlineVisible = true;

				if (EnableToolLog)
					Output.Process("[HawkVpRegion] SetDefaults ok", PrintTo.OutputTab1);
			}
			else if (State == State.Terminated)
			{
				if (EnableToolLog)
					Output.Process($"[HawkVpRegion] Terminated key={_chartKey}", PrintTo.OutputTab1);
				if (_chartKey != 0)
					HawkVpSelectionBus.Clear(_chartKey);
			}
		}

		public override void OnRender(ChartControl chartControl, ChartScale chartScale)
		{
			base.OnRender(chartControl, chartScale);
			LogTool("[HawkVpRegion] OnRender tick", 1000);
			TryPublishSelection(chartControl);
		}

		private void LogTool(string msg, int minMs = 250)
		{
			if (!EnableToolLog)
				return;

			DateTime nowUtc = DateTime.UtcNow;
			if ((nowUtc - _lastLogUtc).TotalMilliseconds < minMs)
				return;

			Output.Process(msg, PrintTo.OutputTab1);
			_lastLogUtc = nowUtc;
		}

		private void TryPublishSelection(ChartControl chartControl)
		{
			if (!PublishRange)
			{
				LogTool("[HawkVpRegion] PublishRange=false", 1500);
				return;
			}

			DateTime nowUtc = DateTime.UtcNow;
			if ((nowUtc - _lastPublishUtc).TotalMilliseconds < PublishThrottleMs)
				return;

			if (chartControl == null)
			{
				LogTool("[HawkVpRegion] chartControl=null", 1500);
				return;
			}

			if (StartAnchor == null || EndAnchor == null)
			{
				LogTool("[HawkVpRegion] anchors null", 1500);
				return;
			}

			DateTime t1 = StartAnchor.Time;
			DateTime t2 = EndAnchor.Time;
			if (t1 == DateTime.MinValue || t2 == DateTime.MinValue)
			{
				LogTool("[HawkVpRegion] anchor time invalid", 1500);
				return;
			}

			if (t1 > t2)
			{
				DateTime tmp = t1;
				t1 = t2;
				t2 = tmp;
			}

			const int startBar0 = -1;
			const int endBar0 = -1;

			if (_chartKey == 0)
				_chartKey = chartControl.GetHashCode();

			if (EnableToolLog)
				Output.Process($"[HawkVpRegion] PUBLISH key={_chartKey} {t1:HH:mm:ss}->{t2:HH:mm:ss} bars TIME_ONLY", PrintTo.OutputTab1);

			HawkVpSelectionBus.Set(_chartKey, new HawkVpSelection
			{
				ChartKey = _chartKey,
				StartTime = t1,
				EndTime = t2,
				StartBar0 = startBar0,
				EndBar0 = endBar0,
				UpdatedUtc = nowUtc
			});

			if (EnableToolLog)
				Output.Process($"[HawkVpRegion] PUBLISHED key={_chartKey} utc={nowUtc:O}", PrintTo.OutputTab1);

			_lastPublishUtc = nowUtc;
		}
	}	
}
